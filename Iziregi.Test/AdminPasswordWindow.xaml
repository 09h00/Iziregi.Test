<!-- File: AdminPasswordWindow.xaml -->
<!-- ✅ NOUVEAU (18.08.2026, demande de Joe) : extrait de la page Paramètres > Admin (section
     "Mot de passe Admin") en fenêtre séparée, ouverte depuis un bouton dédié. -->
<Window x:Class="Iziregi.Test.AdminPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mot de passe Admin"
        Width="528"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Arial"
        Background="{StaticResource PageBackgroundBrush}">

    <Window.Resources>
        <!-- ✅ Modèle propre, pas BasedOn PrimaryButtonStyle (18.08.2026, correction demandée
             par Joe, "le bouton Fermer est toujours le même au survol") : PrimaryButtonStyle
             force un survol bleu directement sur la bordure via son propre ControlTemplate.Trigger,
             qui écrasait toute tentative de le changer depuis un style dérivé. -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ Bordure noire au survol (demande de Joe, 18.08.2026, valable pour tous les
             boutons "Fermer" de l'app) : uniquement ce bouton, pas les autres boutons
             secondaires (ex: "Retirer") de cette fenêtre. -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Mot de passe Admin (accès à la page Admin)"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Foreground="#111827"
                   Margin="0,0,0,4"
                   TextWrapping="Wrap"/>

        <TextBlock Grid.Row="1"
                   Text="Protège l'accès à la page Admin de Paramètres (identité société, mot de passe général des dossiers, vos données, connexion). Réservé au directeur -- ne pas transmettre."
                   FontSize="13"
                   Foreground="#6B7280"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14"/>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Text="" FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <!-- ✅ Formulaire de changement de mot de passe intégré (18.08.2026, demande de Joe :
             "idem pour le mot de passe Admin") : plus de fenêtres séparées (PasswordPromptWindow
             / NewPasswordWindow), tout se passe ici. "Mot de passe actuel" n'est affiché que si
             un mot de passe est déjà défini, voir PopulateStatus. -->
        <StackPanel x:Name="CurrentPasswordSection" Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Mot de passe actuel" FontSize="13" Foreground="#6B7280" Margin="0,0,0,4"/>
            <PasswordBox x:Name="CurrentPasswordBox"
                         Height="34"
                         Padding="8,4"
                         BorderBrush="#D1D5DB"
                         BorderThickness="1"
                         Background="White"
                         VerticalContentAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="Nouveau mot de passe" FontSize="13" Foreground="#6B7280" Margin="0,0,0,4"/>
        <PasswordBox x:Name="NewPasswordBox"
                     Grid.Row="5"
                     Height="34"
                     Padding="8,4"
                     BorderBrush="#D1D5DB"
                     BorderThickness="1"
                     Background="White"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,10"/>

        <StackPanel Grid.Row="6" Margin="0,0,0,4">
            <TextBlock Text="Confirmer le nouveau mot de passe" FontSize="13" Foreground="#6B7280" Margin="0,0,0,4"/>
            <PasswordBox x:Name="ConfirmPasswordBox"
                         Height="34"
                         Padding="8,4"
                         BorderBrush="#D1D5DB"
                         BorderThickness="1"
                         Background="White"
                         VerticalContentAlignment="Center"/>
        </StackPanel>

        <TextBlock x:Name="ErrorTextBlock" Grid.Row="7" Text="" FontSize="12" Foreground="#B91C1C" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="ChangeButton" Content="Changer le mot de passe" Style="{StaticResource PrimaryButtonStyle}" FontWeight="Normal" Margin="0,0,8,0" Click="ChangeButton_Click"/>
            <Button Content="Mot de passe oublié ?" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="ForgotPassword_Click"/>
            <Button x:Name="RemoveButton" Content="Retirer la protection" Style="{StaticResource SecondaryButtonStyle}" Foreground="#B91C1C" BorderBrush="#FCA5A5" Click="RemoveButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Fermer" Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
