<Window x:Class="Iziregi.Test.ArchitectIdentityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Identité architecte"
        Height="520"
        Width="720"
        MinHeight="460"
        MinWidth="650"
        WindowStartupLocation="CenterOwner"
        Background="#F6F7FB">

    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Identité architecte"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#111827"/>

                <TextBlock Text="Modifier le nom, l’adresse et le logo affichés sur les bons de régie."
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Contenu -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <!-- Infos -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="Informations"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Nom" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="ArchitectNameTextBox"
                             Style="{StaticResource InputStyle}"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="Adresse" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="ArchitectAddressTextBox"
                             Height="120"
                             Padding="8"
                             BorderBrush="#D1D5DB"
                             BorderThickness="1"
                             Background="White"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Margin="0,0,0,12"/>

                    <TextBlock x:Name="StatusTextBlock"
                               Text=""
                               Foreground="#6B7280"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Logo -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="Logo"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               Margin="0,0,0,12"/>

                    <Border BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            CornerRadius="10"
                            Background="#F9FAFB"
                            Height="160"
                            Padding="10">
                        <Grid>
                            <Image x:Name="LogoImage" Stretch="Uniform"/>
                            <TextBlock x:Name="LogoEmptyText"
                                       Text="Aucun logo"
                                       Foreground="#9CA3AF"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Chemin du logo"
                               Style="{StaticResource LabelStyle}"
                               Margin="0,12,0,4"/>

                    <TextBox x:Name="LogoPathTextBox"
                             Style="{StaticResource InputStyle}"
                             IsReadOnly="True"/>

                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Importer logo"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ImportLogo_Click"
                                Margin="0,0,8,8"/>

                        <Button Content="Retirer logo"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="RemoveLogo_Click"
                                Margin="0,0,8,8"/>
                    </WrapPanel>

                    <TextBlock Text="Formats conseillés : PNG/JPG."
                               Foreground="#6B7280"
                               FontSize="12"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bas -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
            <DockPanel LastChildFill="False">
                <Button Content="Fermer"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Close_Click"
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"/>

                <Button Content="Enregistrer"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Save_Click"
                        DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>