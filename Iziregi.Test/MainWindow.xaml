<Window x:Class="Iziregi.Test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Iziregi.Test"
        Title="Iziregi"
        Height="560"
        Width="900"
        MinHeight="520"
        MinWidth="820"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ProjectComboStyle" TargetType="ComboBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="0" Padding="4">
                                <Grid>
                                    <TextBlock x:Name="ContentSite"
											   VerticalAlignment="Center"
											   Margin="6,0,22,0"
											   Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource TemplatedParent}}"
											   Foreground="{TemplateBinding Foreground}"/>

                                    <ToggleButton x:Name="DropDownToggle" Grid.Column="2" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Right" Width="20" Background="Transparent" BorderThickness="0">
                                        <TextBlock Text="▾" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button style with chevron on the right -->
        <Style x:Key="ButtonWithChevronStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <TextBlock Text="▾" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,6,0" Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <!-- ✅ 29.07.2026 (demande de Joe) : bordure plus épaisse au survol. -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ Modernisation du look (13.07.2026) : la navigation du haut utilisait le
             <Menu> Windows par défaut (fond lié au thème système, apparence "2007"),
             visible en permanence sur TOUTES les pages — remplacé par des boutons pilule
             cliquables, avec l'onglet actif mis en évidence (voir SetActiveNavButton dans
             MainWindow.xaml.cs). -->
        <Style x:Key="NavPillButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavPillButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource NavPillButtonStyle}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ 30.07.2026 (demande de Joe) : items du menu déroulant "Archives ▾" (Bons
             d'intervention / Tâches). -->
        <Style x:Key="ArchivesMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ✅ Bandeau haut : navigation par pilules + pastille projet -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- NAVIGATION -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- ✅ 31.07.2026 (demande de Joe) : nouveau vrai "Tableau de bord" (résumé
                         général, voir OverviewPage), l'ancien (liste des bons) est renommé
                         "Bons d'intervention" ci-dessous, sans changement de contenu. -->
                    <Button x:Name="NavOverviewButton" Content="Tableau de bord" Click="NavOverview_Click" Style="{StaticResource NavPillButtonActiveStyle}"/>
                    <Button x:Name="NavDashboardButton" Content="Bons d'intervention" Click="NavDashboard_Click" Style="{StaticResource NavPillButtonStyle}"/>
                    <Button x:Name="NavAccountingButton" Content="Comptabilité" Click="NavAccounting_Click" Style="{StaticResource NavPillButtonStyle}"/>
                    <!-- ✅ 30.07.2026 (demande de Joe) : "Archives" devient un menu déroulant avec
                         2 choix (Bons d'intervention / Tâches), voir ArchivesNavPopup ci-dessous. -->
                    <Button x:Name="NavArchivesButton" Content="Archives ▾" Click="NavArchivesDropdown_Click" Style="{StaticResource NavPillButtonStyle}"/>
                    <Button x:Name="NavTrashButton" Content="Corbeille" Click="NavTrash_Click" Style="{StaticResource NavPillButtonStyle}"/>
                    <Button x:Name="NavPlanningButton" Content="Planning" Click="NavPlanning_Click" Style="{StaticResource NavPillButtonStyle}"/>
                    <Button x:Name="NavListsButton" Content="Listes" Click="NavLists_Click" Style="{StaticResource NavPillButtonStyle}"/>
                    <Button x:Name="NavArchitectIdentityButton" Content="Identité Société" Click="NavArchitectIdentity_Click" Style="{StaticResource NavPillButtonStyle}"/>
                    <Button x:Name="NavSettingsButton" Content="Paramètres" Click="NavSettings_Click" Style="{StaticResource NavPillButtonStyle}"/>
                    <!-- ✅ Aide (24.07.2026, demande de Joe) : ouvre la page d'aide (mode d'emploi PDF)
                         dans le navigateur par défaut, ne devient jamais l'onglet "actif". -->
                    <Button x:Name="NavHelpButton" Content="Aide" Click="NavHelp_Click" Style="{StaticResource NavPillButtonStyle}"/>
                    <!-- ✅ Contact (29.07.2026, demande de Joe) : même principe que Aide, ouvre
                         la page /contact (adresse e-mail) dans le navigateur par défaut. -->
                    <Button x:Name="NavContactButton" Content="Contact" Click="NavContact_Click" Style="{StaticResource NavPillButtonStyle}"/>
                    <!-- ✅ CGU / Politique de confidentialité (30.07.2026, demande de Joe :
                         remplace la CGV d'essai) : même principe que Aide/Contact, ouvre la page
                         /cgu dans le navigateur par défaut. -->
                    <Button x:Name="NavCgvEssaiButton" Content="CGU" Click="NavCgvEssai_Click" Style="{StaticResource NavPillButtonStyle}"/>
                </StackPanel>

                <Popup x:Name="ArchivesNavPopup"
                       PlacementTarget="{Binding ElementName=NavArchivesButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4"
                            Effect="{StaticResource CardShadowEffect}">
                        <StackPanel>
                            <Button Content="Bons d'intervention" Style="{StaticResource ArchivesMenuItemStyle}" Click="NavArchivesBons_Click"/>
                            <Button Content="Tâches" Style="{StaticResource ArchivesMenuItemStyle}" Click="NavArchivesTasksMenuItem_Click"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Pastille projet (dans le même bandeau que la navigation) -->
                <!-- Project selector visible sur toutes les pages -->
                <StackPanel x:Name="ProjectSelectorPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,12,0">
                    <Button x:Name="ProjectSelectorButton" Width="200" Height="30" Click="ProjectSelectorButton_Click" Padding="10,2" HorizontalAlignment="Center" Style="{StaticResource ButtonWithChevronStyle}"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ✅ Bandeau de notification de mise à jour : non bloquant, remplace l'ancienne
             boîte de dialogue Oui/Non qui se refermait seule (résultat "No") sans
             intervention de l'utilisateur, quel que soit le moment où elle était
             affichée. Reste caché (Collapsed) tant qu'aucune mise à jour n'est
             disponible. L'utilisateur choisit lui-même quand installer, ou "Plus tard"
             pour continuer avec la version actuelle (la notification réapparaîtra au
             prochain démarrage tant que la mise à jour n'est pas installée). -->
        <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Background="#FFF3CD" BorderBrush="#FFECB5" BorderThickness="0,0,0,1" Padding="12,8" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" FontWeight="SemiBold" Text="Une nouvelle version d'Iziregi est disponible."/>
                <Button x:Name="UpdateBannerInstallButton" Content="Mettre à jour maintenant" Margin="16,0,8,0" Padding="10,4" Click="UpdateBannerInstall_Click"/>
                <Button x:Name="UpdateBannerDismissButton" Content="Plus tard" Padding="10,4" Click="UpdateBannerDismiss_Click"/>
            </StackPanel>
        </Border>

        <!-- ✅ Bandeau de confirmation affiché une seule fois, juste après une mise à jour
             réussie (l'installateur relance l'app avec un paramètre de ligne de commande
             dédié, voir Iziregi.iss). -->
        <Border x:Name="UpdateSuccessBanner" DockPanel.Dock="Top" Background="#D1E7DD" BorderBrush="#A3CFBB" BorderThickness="0,0,0,1" Padding="12,8" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock x:Name="UpdateSuccessBannerText" VerticalAlignment="Center" FontWeight="SemiBold" Text="Iziregi a été mis à jour avec succès."/>
                <Button x:Name="UpdateSuccessBannerOkButton" Content="OK" Margin="16,0,0,0" Padding="10,4" Click="UpdateSuccessBannerOk_Click"/>
            </StackPanel>
        </Border>

        <!-- CONTENU (PAGE) -->
        <Border Background="White" Padding="12">
            <Grid>
                <ContentControl x:Name="MainContent" Margin="0,0,0,0"/>
            </Grid>
        </Border>

    </DockPanel>
</Window>