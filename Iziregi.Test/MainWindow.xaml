<Window x:Class="Iziregi.Test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Iziregi.Test"
        Title="Iziregi"
        Height="560"
        Width="900"
        MinHeight="520"
        MinWidth="820"
        WindowStartupLocation="CenterScreen">

	<DockPanel>

		<!-- ✅ Bandeau haut : Menu + pastille alignée au Menu -->
		<Grid DockPanel.Dock="Top" Background="{DynamicResource {x:Static SystemColors.MenuBrushKey}}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<!-- MENU NAVIGATION -->
			<Menu Grid.Column="0">
				<MenuItem Header="Tableau de bord" Click="NavDashboard_Click"/>
				<MenuItem Header="Comptabilité" Click="NavAccounting_Click"/>
				<MenuItem Header="Archives" Click="NavArchives_Click"/>
				<MenuItem Header="Corbeille" Click="NavTrash_Click"/>
				<MenuItem Header="Listes" Click="NavLists_Click"/>
				<MenuItem Header="Planning" Click="NavPlanning_Click"/>
			</Menu>

			<!-- Pastille projet (dans le même bandeau que le Menu) -->
			<Border Grid.Column="1"
			        x:Name="ProjectBadgeContainer"
			        VerticalAlignment="Center"
			        Background="#111827"
			        CornerRadius="10"
			        Padding="8,5"
			        Margin="8,0,12,0">
				<TextBlock x:Name="ProjectBadgeTextBlock"
				           Text="Projet :"
				           Foreground="White"
				           FontSize="11"
				           FontWeight="SemiBold"/>
			</Border>
		</Grid>

		<!-- CONTENU (PAGE) -->
		<Border Background="White" Padding="12">
			<Grid>
				<ContentControl x:Name="MainContent" Margin="0,0,0,0"/>
			</Grid>
		</Border>

	</DockPanel>
</Window>