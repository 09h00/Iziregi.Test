<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	<UseWindowsForms>true</UseWindowsForms>
    <Version>1.0.56</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="obj\Pages\**" />
    <EmbeddedResource Remove="obj\Pages\**" />
    <None Remove="obj\Pages\**" />
    <Page Remove="obj\Pages\**" />
  </ItemGroup>
	

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.72" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
    <PackageReference Include="QuestPDF" Version="2026.2.4" />
    <!-- ✅ Chiffrement DPAPI de la clé API stockée localement (iziregi-config.json) -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
	

  <ItemGroup>
    <Folder Include="obj\" />
  </ItemGroup>

  <!-- ✅ Écran de chargement natif WPF désactivé (06.07.2026) : combiné au bug de
       bascule en plein écran de MainWindow (voir commentaire dans MainWindow.xaml.cs),
       il donnait l'impression désagréable de deux fenêtres qui s'ouvrent et se
       referment très rapidement au lancement. L'app s'ouvre maintenant directement
       en plein écran, sans écran de chargement intermédiaire. Image conservée dans
       Assets\Splash.png si besoin de la réutiliser un jour. -->
  <!--
  <ItemGroup>
    <SplashScreen Include="Assets\Splash.png" />
  </ItemGroup>
  -->

</Project>
