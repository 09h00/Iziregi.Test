<!-- File: TaskDescriptionWindow.xaml -->
<!-- ✅ Ajouté le 16.07.2026 (demande de Joe) : éditeur agrandi du champ "Descriptif" du
     tableau des Tâches (page Planning), pour les cas où le texte à saisir est long ou
     détaillé. Le texte est le MÊME champ que celui affiché dans la grille (pas de
     nouveau stockage) — seul "Enregistrer" renvoie le texte modifié à l'appelant
     (voir TaskDescriptionWindow.xaml.cs, ResultText / DialogResult). Permet aussi de
     générer un PDF simple (texte + petit en-tête) du descriptif en cours d'édition. -->
<Window x:Class="Iziregi.Test.TaskDescriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Descriptif de la tâche"
        Height="560"
        Width="700"
        MinHeight="380"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="#F6F7FB">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ✅ IMPORTANT : Template custom, sinon le thème Windows peut ignorer Background au survol -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- ✅ 29.07.2026 (demande de Joe) : bordure plus épaisse au survol. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1D4ED8"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E40AF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ Descriptif enrichi (25.07.2026, demande de Joe) : mêmes styles de boutons
             (arrondis + bordure noire) que la barre d'outils des "zones de texte" du Planning
             (PlanningPage.xaml), dupliqués ici volontairement (convention déjà établie dans ce
             projet : chaque page/fenêtre garde ses propres styles locaux plutôt qu'une
             centralisation à large portée). -->
        <Style x:Key="TextZoneToolButtonStyle" TargetType="Button">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- ✅ 29.07.2026 (demande de Joe) : bordure plus épaisse au survol. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextZoneToolToggleStyle" TargetType="ToggleButton">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête : contexte de la tâche (lecture seule, l'édition des colonnes reste dans la grille) -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14"
                Margin="0,0,0,12"
                Effect="{StaticResource CardShadowEffect}">
            <StackPanel>
                <TextBlock x:Name="TaskRefTextBlock" FontSize="15" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,10"/>
                <!-- ✅ Ordre identique à celui de la grille des Tâches (Bâtiment, Étage,
                     Catégorie, Entreprise, Urg., Effectué), libellés dynamiques (page Listes),
                     et un champ n'apparaît ici QUE si sa colonne est actuellement visible dans
                     la grille (voir TaskExpandDescriptionButton_Click, PlanningPage.xaml.cs). -->
                <!-- ✅ Marge à droite sur le StackPanel lui-même (pas seulement sur la valeur) :
                     sinon, quand le libellé est plus large que la valeur (ex. "Catégorie" / "—"),
                     la largeur du StackPanel est dictée par le libellé SANS marge et les panneaux
                     se touchent (bug signalé par Joe le 16.07.2026, capture d'écran à l'appui). -->
                <WrapPanel Orientation="Horizontal">
                    <StackPanel x:Name="BuildingPanel" Margin="0,0,20,0">
                        <TextBlock x:Name="BuildingLabelTextBlock" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="BuildingTextBlock" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                    <StackPanel x:Name="FloorPanel" Margin="0,0,20,0">
                        <TextBlock x:Name="FloorLabelTextBlock" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="FloorTextBlock" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                    <StackPanel x:Name="CategoryPanel" Margin="0,0,20,0">
                        <TextBlock x:Name="CategoryLabelTextBlock" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="CategoryTextBlock" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                    <StackPanel x:Name="CompanyPanel" Margin="0,0,20,0">
                        <TextBlock x:Name="CompanyLabelTextBlock" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="CompanyTextBlock" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                    <StackPanel x:Name="UrgentPanel" Margin="0,0,20,0">
                        <TextBlock x:Name="UrgentLabelTextBlock" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="UrgentTextBlock" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                    <StackPanel x:Name="DonePanel" Margin="0,0,20,0">
                        <TextBlock Text="Effectué" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="DoneTextBlock" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                    <StackPanel x:Name="ReservePanel" Margin="0,0,20,0">
                        <TextBlock Text="Concerne" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="ReserveTextBlock" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Barre d'outils : mise en forme + insertion d'image (25.07.2026, demande de Joe) -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8"
                Margin="0,0,0,10"
                Effect="{StaticResource CardShadowEffect}">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="BoldToggle" Width="36" Height="28" Margin="0,0,8,0"
                              Style="{StaticResource TextZoneToolToggleStyle}"
                              Background="White" Foreground="#111827"
                              Click="BoldToggle_Click"
                              ToolTip="Gras">
                    <TextBlock Text="G" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ToggleButton>

                <ToggleButton x:Name="ItalicToggle" Width="36" Height="28" Margin="0,0,8,0"
                              Style="{StaticResource TextZoneToolToggleStyle}"
                              Background="White" Foreground="#111827"
                              Click="ItalicToggle_Click"
                              ToolTip="Italique">
                    <TextBlock Text="I" FontSize="13" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ToggleButton>

                <ToggleButton x:Name="UnderlineToggle" Width="36" Height="28" Margin="0,0,16,0"
                              Style="{StaticResource TextZoneToolToggleStyle}"
                              Background="White" Foreground="#111827"
                              Click="UnderlineToggle_Click"
                              ToolTip="Souligné">
                    <TextBlock Text="S" FontSize="13" TextDecorations="Underline" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ToggleButton>

                <!-- ✅ Couleur de police / surlignage (28.07.2026, demande de Joe) : même
                     principe que dans les zones de texte du Planning. -->
                <Button x:Name="FontColorButton" Width="56" Height="28" Margin="0,0,8,0"
                        Style="{StaticResource TextZoneToolButtonStyle}"
                        Background="White"
                        Click="FontColorButton_Click"
                        ToolTip="Couleur du texte (police)">
                    <StackPanel>
                        <Border BorderThickness="2"
                                CornerRadius="4"
                                Padding="0"
                                HorizontalAlignment="Center"
                                BorderBrush="{Binding ElementName=FontColorSwatch, Path=Background}">
                            <TextBlock Text="A"
                                       Foreground="#111827"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="2,-1,2,0"/>
                        </Border>
                        <TextBlock Text="Texte" Foreground="#6B7280" FontSize="9" HorizontalAlignment="Center" Margin="0,-1,0,0"/>
                        <Border x:Name="FontColorSwatch" Height="3" Background="#EF4444" CornerRadius="2" Margin="0,1,0,0"/>
                    </StackPanel>
                </Button>

                <Button x:Name="FillColorButton" Width="56" Height="28" Margin="0,0,16,0"
                        Style="{StaticResource TextZoneToolButtonStyle}"
                        Background="White"
                        Click="FillColorButton_Click"
                        ToolTip="Couleur de surlignage (fond)">
                    <StackPanel>
                        <Border BorderThickness="2"
                                CornerRadius="4"
                                Padding="0"
                                HorizontalAlignment="Center"
                                BorderBrush="{Binding ElementName=FillColorSwatch, Path=Background}">
                            <TextBlock Text="▧"
                                       Foreground="#111827"
                                       FontSize="14"
                                       FontWeight="Normal"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="4,-1,4,0"/>
                        </Border>
                        <TextBlock Text="Surlign." Foreground="#6B7280" FontSize="9" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                        <Border x:Name="FillColorSwatch" Height="3" Background="#FDE047" CornerRadius="2" Margin="0,1,0,0"/>
                    </StackPanel>
                </Button>

                <Button Content="🖼 Insérer image" Height="28"
                        Style="{StaticResource TextZoneToolButtonStyle}"
                        Padding="10,0"
                        Background="White" Foreground="#111827"
                        Click="InsertImageButton_Click"
                        ToolTip="Insérer une image (PNG, JPG...). Ctrl + molette sur l'image pour la redimensionner."/>

                <!-- ✅ Astuce affichée uniquement s'il y a une image insérée (26.07.2026,
                     demande de Joe : l'utilisateur ne devine pas Ctrl+molette tout seul). -->
                <Border x:Name="ResizeImageHintBorder"
                        Background="#FEF3C7"
                        BorderBrush="#FCD34D"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,4"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock FontSize="11">
                        <Run Text="💡" FontFamily="Segoe UI Emoji"/>
                        <Run Text=" Ctrl + molette sur l'image pour la redimensionner" Foreground="#92400E"/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>

        <!-- Zone de texte agrandie -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12"
                Padding="2"
                Effect="{StaticResource CardShadowEffect}">
            <RichTextBox x:Name="DescriptifRichTextBox"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="12"
                     FontSize="13"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     TextChanged="DescriptifRichTextBox_TextChanged"
                     SelectionChanged="DescriptifRichTextBox_SelectionChanged"
                     PreviewMouseWheel="DescriptifRichTextBox_PreviewMouseWheel">
                <!-- ✅ Sans ça, chaque retour à la ligne crée un nouveau Paragraph avec la
                     marge par défaut du thème (~10px), donnant un écart bien plus grand
                     qu'avec l'ancien TextBox simple (26.07.2026, signalé par Joe). -->
                <RichTextBox.Resources>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>
        </Border>

        <!-- Boutons -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="GeneratePdfButton"
                    Content="Générer PDF"
                    Style="{StaticResource PdfButtonStyle}"
                    DockPanel.Dock="Left"
                    Click="GeneratePdfButton_Click"/>

            <Button x:Name="CancelButton"
                    Content="Annuler"
                    Style="{StaticResource SecondaryButtonStyle}"
                    DockPanel.Dock="Right"
                    Click="CancelButton_Click"/>

            <Button x:Name="SaveButton"
                    Content="Enregistrer"
                    Style="{StaticResource PrimaryButtonStyle}"
                    DockPanel.Dock="Right"
                    Margin="0,0,8,0"
                    Click="SaveButton_Click"/>
        </DockPanel>
    </Grid>
</Window>
