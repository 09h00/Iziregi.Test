<!-- File: Pages/ArchivesPage.xaml -->
<UserControl x:Class="Iziregi.Test.Pages.ArchivesPage"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 d:DesignHeight="820"
			 d:DesignWidth="1280"
			 Background="#F6F7FB">

	<UserControl.Resources>

		<Style x:Key="SmallButtonStyle" TargetType="Button">
			<Setter Property="Height" Value="28"/>
			<Setter Property="Padding" Value="8,0"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="Foreground" Value="#111827"/>
			<Setter Property="BorderBrush" Value="#D1D5DB"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style x:Key="DangerSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
			<Setter Property="Foreground" Value="#B91C1C"/>
			<Setter Property="BorderBrush" Value="#FCA5A5"/>
		</Style>

		<!-- ✅ Même vert que "Archiver" dans Dashboard (24.07.2026, demande de Joe : couleurs
		     cohérentes entre les pages pour les boutons Corbeille/Rétablir). -->
		<Style x:Key="RestoreSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
			<Setter Property="Foreground" Value="#15803D"/>
			<Setter Property="BorderBrush" Value="#15803D"/>
		</Style>

		<!-- ✅ "Corbeille sélection"/"Restaurer sélection" en rouge/vert arrondi (24.07.2026,
		     demande de Joe) : ControlTemplate explicite avec CornerRadius, comme PdfButtonStyle
		     dans App.xaml — le chrome Windows par défaut d'un Button ignore parfois le style selon
		     le thème, d'où ce template minimal pour garantir l'arrondi. -->
		<Style x:Key="TrashSelectionButtonStyle" TargetType="Button" BasedOn="{StaticResource DangerSmallButtonStyle}">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="8"
								SnapsToDevicePixels="True">
							<ContentPresenter Margin="{TemplateBinding Padding}"
											  HorizontalAlignment="Center"
											  VerticalAlignment="Center"/>
						</Border>
						<!-- ✅ Grisé si désactivé (24.07.2026, demande de Joe) : un ControlTemplate
						     custom ignore l'état IsEnabled=False par défaut, il faut un Trigger explicite. -->
						<ControlTemplate.Triggers>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
								<Setter TargetName="Bd" Property="BorderBrush" Value="#D1D5DB"/>
								<Setter Property="Foreground" Value="#9CA3AF"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="RestoreSelectionButtonStyle" TargetType="Button" BasedOn="{StaticResource RestoreSmallButtonStyle}">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="8"
								SnapsToDevicePixels="True">
							<ContentPresenter Margin="{TemplateBinding Padding}"
											  HorizontalAlignment="Center"
											  VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
								<Setter TargetName="Bd" Property="BorderBrush" Value="#D1D5DB"/>
								<Setter Property="Foreground" Value="#9CA3AF"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- ✅ Bouton filtre façon Excel dans les en-têtes de colonne (24.07.2026, demande de Joe). -->
		<Style x:Key="FilterHeaderButtonStyle" TargetType="Button">
			<Setter Property="Width" Value="16"/>
			<Setter Property="Height" Value="16"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#6B7280"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="FontSize" Value="9"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" CornerRadius="3">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#E5E7EB"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="FilterHeaderButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource FilterHeaderButtonStyle}">
			<Setter Property="Foreground" Value="#1D4ED8"/>
			<Setter Property="FontWeight" Value="Bold"/>
		</Style>

		<!-- ✅ Bordure bleue autour de l'en-tête tant qu'un tri/filtre est actif sur cette colonne
		     (24.07.2026, demande de Joe). -->
		<Style x:Key="FilterHeaderHighlightBorderStyle" TargetType="Border">
			<Setter Property="BorderThickness" Value="2"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Padding" Value="4,2"/>
		</Style>

		<Style x:Key="InputStyle" TargetType="TextBox">
			<Setter Property="Height" Value="26"/>
			<Setter Property="Padding" Value="6,2"/>
			<Setter Property="BorderBrush" Value="#D1D5DB"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="FontSize" Value="12"/>
		</Style>

		<!-- Texte centré -->
		<Style x:Key="GridTextCellStyle" TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="TextAlignment" Value="Center"/>
			<Setter Property="TextWrapping" Value="NoWrap"/>
			<Setter Property="TextTrimming" Value="None"/>
		</Style>

		<!-- CheckBox centrée -->
		<Style x:Key="GridCheckBoxCellStyle" TargetType="CheckBox">
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="Padding" Value="0"/>
		</Style>

		<!-- DataGrid -->
		<Style x:Key="GridStyle" TargetType="DataGrid">
			<Setter Property="AutoGenerateColumns" Value="False"/>
			<Setter Property="CanUserAddRows" Value="False"/>
			<Setter Property="CanUserDeleteRows" Value="False"/>

			<Setter Property="GridLinesVisibility" Value="All"/>
			<Setter Property="VerticalGridLinesBrush" Value="#E5E7EB"/>
			<Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>

			<Setter Property="HeadersVisibility" Value="Column"/>
			<Setter Property="RowHeight" Value="36"/>
			<Setter Property="ColumnHeaderHeight" Value="44"/>

			<!-- Bordure extérieure -->
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="#D1D5DB"/>

			<Setter Property="Background" Value="White"/>
			<Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>

			<Setter Property="SelectionMode" Value="Single"/>
			<Setter Property="SelectionUnit" Value="FullRow"/>

			<Setter Property="FontSize" Value="12"/>
			<Setter Property="IsReadOnly" Value="False"/>

			<!-- Sélection : bordure bleue -->
			<Setter Property="RowStyle">
				<Setter.Value>
					<Style TargetType="DataGridRow">
						<Setter Property="Background" Value="Transparent"/>
						<Setter Property="BorderBrush" Value="Transparent"/>
						<Setter Property="BorderThickness" Value="0"/>
						<Setter Property="SnapsToDevicePixels" Value="True"/>

						<Style.Triggers>
							<Trigger Property="IsSelected" Value="True">
								<Setter Property="BorderBrush" Value="#2563EB"/>
								<Setter Property="BorderThickness" Value="2"/>
								<Setter Property="Background" Value="Transparent"/>
							</Trigger>

							<Trigger Property="IsKeyboardFocusWithin" Value="True">
								<Setter Property="BorderBrush" Value="#2563EB"/>
								<Setter Property="BorderThickness" Value="2"/>
								<Setter Property="Background" Value="Transparent"/>
							</Trigger>
						</Style.Triggers>
					</Style>
				</Setter.Value>
			</Setter>

			<!-- Cellules : pas de remplissage bleu -->
			<Setter Property="CellStyle">
				<Setter.Value>
					<Style TargetType="DataGridCell">
						<Setter Property="VerticalContentAlignment" Value="Stretch"/>
						<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
						<Setter Property="Padding" Value="6,0"/>
						<Setter Property="BorderBrush" Value="#E5E7EB"/>
						<Setter Property="BorderThickness" Value="0,0,1,1"/>
						<Setter Property="Background" Value="Transparent"/>
						<Style.Triggers>
							<Trigger Property="IsSelected" Value="True">
								<Setter Property="Background" Value="Transparent"/>
							</Trigger>
						</Style.Triggers>
					</Style>
				</Setter.Value>
			</Setter>

			<!-- En-têtes : gras + noir -->
			<Setter Property="ColumnHeaderStyle">
				<Setter.Value>
					<Style TargetType="DataGridColumnHeader">
						<Setter Property="VerticalContentAlignment" Value="Center"/>
						<Setter Property="HorizontalContentAlignment" Value="Center"/>
						<Setter Property="Padding" Value="6,0"/>
						<Setter Property="BorderBrush" Value="#D1D5DB"/>
						<Setter Property="BorderThickness" Value="0,0,1,1"/>
						<Setter Property="Foreground" Value="#111827"/>
						<Setter Property="FontWeight" Value="Bold"/>
					</Style>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Texte statut (base) -->
		<Style x:Key="StatusCellTextBaseStyle" TargetType="TextBlock" BasedOn="{StaticResource GridTextCellStyle}">
			<Setter Property="Foreground" Value="#9CA3AF"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Padding" Value="4,0"/>
		</Style>

		<!-- Zone Statut : pas de séparations verticales -->
		<Style x:Key="StatusHeaderNoVerticalSeparators" TargetType="DataGridColumnHeader">
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="Padding" Value="6,0"/>
			<Setter Property="BorderBrush" Value="#D1D5DB"/>
			<Setter Property="BorderThickness" Value="0,0,0,1"/>
		</Style>

		<Style x:Key="StatusCellNoVerticalSeparators" TargetType="DataGridCell">
			<Setter Property="VerticalContentAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="BorderBrush" Value="#E5E7EB"/>
			<Setter Property="BorderThickness" Value="0,0,0,1"/>
			<Setter Property="Background" Value="Transparent"/>
			<Style.Triggers>
				<Trigger Property="IsSelected" Value="True">
					<Setter Property="Background" Value="Transparent"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="StatusHeaderWithRightSeparator"
			   TargetType="DataGridColumnHeader"
			   BasedOn="{StaticResource StatusHeaderNoVerticalSeparators}">
			<Setter Property="BorderBrush" Value="#D1D5DB"/>
			<Setter Property="BorderThickness" Value="0,0,1,1"/>
		</Style>

		<Style x:Key="StatusCellWithRightSeparator"
			   TargetType="DataGridCell"
			   BasedOn="{StaticResource StatusCellNoVerticalSeparators}">
			<Setter Property="BorderThickness" Value="0,0,1,1"/>
			<Setter Property="Background" Value="Transparent"/>
			<Style.Triggers>
				<Trigger Property="IsSelected" Value="True">
					<Setter Property="Background" Value="Transparent"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<!-- Header "Statut" -->
		<Style x:Key="StatusHeaderTopText" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="#111827"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>

		<!-- DatePicker compact -->
		<Style x:Key="GridDatePickerStyle" TargetType="DatePicker">
			<Setter Property="SelectedDateFormat" Value="Short"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Width" Value="117"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>

		<!-- Fond vert si date renseignée -->
		<Style x:Key="DateCellBorderStyle_Distributed" TargetType="Border">
			<Setter Property="Background" Value="#C7F9C7"/>
			<Setter Property="CornerRadius" Value="2"/>
			<Setter Property="Padding" Value="0"/>
			<Style.Triggers>
				<DataTrigger Binding="{Binding WorkOrder.DistributedAt}" Value="{x:Null}">
					<Setter Property="Background" Value="Transparent"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="DateCellBorderStyle_Performed" TargetType="Border">
			<Setter Property="Background" Value="#C7F9C7"/>
			<Setter Property="CornerRadius" Value="2"/>
			<Setter Property="Padding" Value="0"/>
			<Style.Triggers>
				<DataTrigger Binding="{Binding WorkOrder.PerformedAt}" Value="{x:Null}">
					<Setter Property="Background" Value="Transparent"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<!-- DatePickerTextBox : supprime le watermark -->
		<Style x:Key="NoWatermarkDatePickerTextBoxStyle" TargetType="{x:Type DatePickerTextBox}">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type DatePickerTextBox}">
						<Border Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								Padding="{TemplateBinding Padding}">
							<TextBox Background="Transparent"
									 BorderThickness="0"
									 IsReadOnly="True"
									 Foreground="#111827"
									 TextAlignment="Center"
									 VerticalContentAlignment="Center"
									 Text="{Binding Path=SelectedDate,
									 RelativeSource={RelativeSource AncestorType={x:Type DatePicker}},
									 StringFormat=dd.MM.yyyy,
									 TargetNullValue=''}"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

	</UserControl.Resources>

	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- ✅ Popup de filtre façon Excel, partagé par toutes les colonnes filtrables (24.07.2026,
		     demande de Joe) : rempli dynamiquement en code-behind selon la colonne dont le bouton
		     a été cliqué (voir ColumnFilterButton_Click). -->
		<Popup x:Name="ColumnFilterPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
			<Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="8" MinWidth="220" MaxHeight="380" Effect="{StaticResource CardShadowEffect}">
				<StackPanel>

					<!-- ✅ Colonnes texte/statut (24.07.2026, demande de Joe) : tri alphabétique à
					     cocher + liste de valeurs à cocher. Le tri est masqué pour la colonne Statut
					     (n'a pas de sens de trier alphabétiquement des étapes de pipeline). -->
					<StackPanel x:Name="TextFilterPanel">
						<CheckBox x:Name="AlphaSortCheckBox"
						          Content="Trier par ordre alphabétique (A→Z)"
						          Margin="0,0,0,8"/>

						<Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Margin="0,0,0,6"/>

						<CheckBox x:Name="FilterSelectAllCheckBox"
						          Content="(Tout sélectionner)"
						          IsChecked="True"
						          FontWeight="Bold"
						          Click="FilterSelectAllCheckBox_Click"
						          Margin="0,0,0,6"/>

						<ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
							<ItemsControl x:Name="FilterOptionsItemsControl">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<CheckBox Content="{Binding DisplayText}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,2"/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</StackPanel>

					<!-- ✅ Colonnes date (24.07.2026, demande de Joe) : tri croissant/décroissant à
					     cocher (mutuellement exclusifs) + sélection d'une plage de dates (début/fin). -->
					<StackPanel x:Name="DateFilterPanel" Visibility="Collapsed">
						<!-- ✅ Compteurs (28.07.2026, demande de Joe) : équivalent pour les colonnes
						     date des comptages par valeur des autres colonnes (une date étant
						     quasi toujours unique, on compte "renseigné" vs "non renseigné", avec
						     un libellé propre à chaque colonne). -->
						<TextBlock x:Name="DateFilterCountsTextBlock"
						           Foreground="#374151"
						           FontSize="12"
						           TextWrapping="Wrap"
						           Margin="0,0,0,8"/>

						<CheckBox x:Name="DateAscCheckBox" Content="Trier par ordre croissant" Click="DateAscCheckBox_Click" Margin="0,0,0,4"/>
						<CheckBox x:Name="DateDescCheckBox" Content="Trier par ordre décroissant" Click="DateDescCheckBox_Click" Margin="0,0,0,8"/>

						<Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Margin="0,0,0,8"/>

						<TextBlock Text="Du" Foreground="#6B7280" Margin="0,0,0,2"/>
						<DatePicker x:Name="DateFromPicker" Width="190" HorizontalAlignment="Left" Margin="0,0,0,8"/>

						<TextBlock Text="Au" Foreground="#6B7280" Margin="0,0,0,2"/>
						<DatePicker x:Name="DateToPicker" Width="190" HorizontalAlignment="Left"/>

						<!-- ✅ Réinitialise juste la plage Du/Au de cette colonne (24.07.2026, demande
						     de Joe), sans toucher au tri croissant/décroissant coché au-dessus. -->
						<Button Content="Réinitialiser les dates sélectionnées"
						        Style="{StaticResource SmallButtonStyle}"
						        Click="ResetDateRangeButton_Click"
						        HorizontalAlignment="Left"
						        Margin="0,8,0,0"/>
					</StackPanel>

					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
						<Button Content="Annuler" Style="{StaticResource SmallButtonStyle}" Click="ColumnFilterCancel_Click" Margin="0,0,6,0"/>
						<Button Content="OK" Style="{StaticResource SmallButtonStyle}" Click="ColumnFilterApply_Click"/>
					</StackPanel>
				</StackPanel>
			</Border>
		</Popup>

		<!-- BARRE -->
		<Border Grid.Row="0"
				Background="White"
				BorderBrush="#E5E7EB"
				BorderThickness="1"
				CornerRadius="12"
				Padding="8"
				Margin="0,0,0,8"
				Effect="{StaticResource CardShadowEffect}">

			<Grid>
	<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
		<TextBlock Text="Archives des bons"
		           FontSize="18"
		           FontWeight="SemiBold"
		           Foreground="#111827"
		           Margin="0,0,10,0"/>

		<Button x:Name="RestoreSelectionButton"
		        Content="Restaurer sélection"
		        Style="{StaticResource RestoreSelectionButtonStyle}"
		        Click="RestoreSelected_Click"
		        IsEnabled="False"
		        Margin="0,0,6,0"/>

		<Button x:Name="TrashSelectionButton"
		        Content="Corbeille sélection"
		        Style="{StaticResource TrashSelectionButtonStyle}"
		        Click="TrashSelected_Click"
		        IsEnabled="False"
		        Margin="0,0,6,0"/>

		<Button Content="Rafraîchir"
		        Style="{StaticResource SmallButtonStyle}"
		        Click="Refresh_Click"
		        Margin="0,0,6,0"/>

		<!-- ✅ Filtres façon Excel sur les en-têtes de colonnes (24.07.2026, demande de Joe) :
		     remplace l'ancien filtre Entreprise/période unique. -->
		<Button Content="Effacer filtres"
		        Style="{StaticResource SmallButtonStyle}"
		        Click="ClearFilters_Click"/>
	</StackPanel>
</Grid>
		</Border>

		<!-- TABLEAU -->
		<Border Grid.Row="1"
				Background="White"
				BorderBrush="#E5E7EB"
				BorderThickness="1"
				CornerRadius="12"
				Padding="10"
				Effect="{StaticResource CardShadowEffect}">

			<DataGrid x:Name="ArchivedGrid"
					  Grid.Row="1"
					  Style="{StaticResource GridStyle}"
					  ColumnWidth="SizeToCells"
					  MouseDoubleClick="ArchivedGrid_MouseDoubleClick">

				<DataGrid.Columns>

					<!-- Sélection -->
					<DataGridTemplateColumn Width="31" IsReadOnly="True">
						<DataGridTemplateColumn.HeaderTemplate>
							<DataTemplate>
								<CheckBox x:Name="SelectAllCheckBox"
										  Style="{StaticResource GridCheckBoxCellStyle}"
										  Click="SelectAllCheckBox_Click"/>
							</DataTemplate>
						</DataGridTemplateColumn.HeaderTemplate>

						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<CheckBox Style="{StaticResource GridCheckBoxCellStyle}"
										  IsChecked="{Binding IsSelected, Mode=TwoWay}"
										  Click="RowSelectCheckBox_Click"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- N° -->
					<DataGridTextColumn Header="N°"
										Binding="{Binding WorkOrder.BdrDisplay}"
										Width="48"
										ElementStyle="{StaticResource GridTextCellStyle}"
										IsReadOnly="True"/>

					<!-- Concerne -->
					<DataGridTextColumn Width="SizeToCells"
										MinWidth="80"
										Binding="{Binding WorkOrder.Reserve}"
										ElementStyle="{StaticResource GridTextCellStyle}"
										IsReadOnly="True"
										CanUserSort="False">
						<DataGridTextColumn.Header>
							<Border x:Name="ConcerneHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
								<StackPanel Orientation="Vertical" HorizontalAlignment="Center">
									<TextBlock Text="Concerne" HorizontalAlignment="Center"/>
									<Button x:Name="ConcerneFilterButton" Content="▾" Tag="Concerne"
											Style="{StaticResource FilterHeaderButtonStyle}"
											Click="ColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
								</StackPanel>
							</Border>
						</DataGridTextColumn.Header>
					</DataGridTextColumn>

					<!-- Demandé par -->
					<DataGridTextColumn Width="SizeToCells"
										MinWidth="90"
										Binding="{Binding WorkOrder.RequestedBy}"
										ElementStyle="{StaticResource GridTextCellStyle}"
										IsReadOnly="True"
										CanUserSort="False">
						<DataGridTextColumn.Header>
							<Border x:Name="RequestedByHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
								<StackPanel Orientation="Vertical" HorizontalAlignment="Center">
									<TextBlock Text="Demandé par" HorizontalAlignment="Center"/>
									<Button x:Name="RequestedByFilterButton" Content="▾" Tag="RequestedBy"
											Style="{StaticResource FilterHeaderButtonStyle}"
											Click="ColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
								</StackPanel>
							</Border>
						</DataGridTextColumn.Header>
					</DataGridTextColumn>

					<!-- Entreprise (avec couleur) -->
					<DataGridTemplateColumn Width="SizeToCells" MinWidth="76" IsReadOnly="True">
						<DataGridTemplateColumn.Header>
							<Border x:Name="CompanyHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
								<StackPanel Orientation="Vertical" HorizontalAlignment="Center">
									<TextBlock Text="Entreprise" HorizontalAlignment="Center"/>
									<Button x:Name="CompanyFilterButton" Content="▾" Tag="Company"
											Style="{StaticResource FilterHeaderButtonStyle}"
											Click="ColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
								</StackPanel>
							</Border>
						</DataGridTemplateColumn.Header>
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Border Background="{Binding CompanyBrush}" CornerRadius="2" Padding="6,0">
									<TextBlock Text="{Binding WorkOrder.PerformedBy}"
											   Foreground="{Binding CompanyTextBrush}"
											   FontWeight="Bold"
											   VerticalAlignment="Center"
											   TextAlignment="Center"
											   TextWrapping="NoWrap"/>
								</Border>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- Date -->
					<DataGridTextColumn Binding="{Binding WorkOrder.RequestDate, StringFormat=dd.MM.yyyy}"
										Width="SizeToCells"
										MinWidth="70"
										ElementStyle="{StaticResource GridTextCellStyle}"
										IsReadOnly="True"
										CanUserSort="False">
						<DataGridTextColumn.Header>
							<Border x:Name="CreatedDateHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
								<StackPanel Orientation="Vertical" HorizontalAlignment="Center">
									<TextBlock Text="Créé le" HorizontalAlignment="Center"/>
									<Button x:Name="CreatedDateFilterButton" Content="▾" Tag="CreatedDate"
											Style="{StaticResource FilterHeaderButtonStyle}"
											Click="ColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
								</StackPanel>
							</Border>
						</DataGridTextColumn.Header>
					</DataGridTextColumn>

					<!-- ========================= -->
					<!-- STATUT (5 colonnes) -->
					<!-- ========================= -->

					<!-- 1) Créé -->
					<DataGridTemplateColumn Width="SizeToCells"
											HeaderStyle="{StaticResource StatusHeaderNoVerticalSeparators}"
											CellStyle="{StaticResource StatusCellNoVerticalSeparators}"
											IsReadOnly="True">
						<DataGridTemplateColumn.Header>
							<Grid/>
						</DataGridTemplateColumn.Header>
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Border CornerRadius="2">
									<Border.Style>
										<Style TargetType="Border">
											<Setter Property="Background" Value="Transparent"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding WorkOrder.IsInCreation}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
												<DataTrigger Binding="{Binding WorkOrder.IsSentToCompany}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
												<DataTrigger Binding="{Binding WorkOrder.IsQuoteReceived}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
												<DataTrigger Binding="{Binding WorkOrder.IsSentToSigner}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
												<DataTrigger Binding="{Binding WorkOrder.IsValidated}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Border.Style>

									<TextBlock>
										<TextBlock.Style>
											<Style TargetType="TextBlock" BasedOn="{StaticResource StatusCellTextBaseStyle}">
												<Setter Property="Text" Value="Créé"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding WorkOrder.IsInCreation}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding WorkOrder.IsSentToCompany}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding WorkOrder.IsQuoteReceived}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding WorkOrder.IsSentToSigner}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding WorkOrder.IsValidated}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
								</Border>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- 2) Demande devis envoyée -->
					<DataGridTemplateColumn Width="SizeToCells"
											HeaderStyle="{StaticResource StatusHeaderNoVerticalSeparators}"
											CellStyle="{StaticResource StatusCellNoVerticalSeparators}"
											IsReadOnly="True">
						<DataGridTemplateColumn.Header>
							<Grid/>
						</DataGridTemplateColumn.Header>
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Border CornerRadius="2">
									<Border.Style>
										<Style TargetType="Border">
											<Setter Property="Background" Value="Transparent"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding WorkOrder.IsSentToCompany}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
												<DataTrigger Binding="{Binding WorkOrder.IsQuoteReceived}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
												<DataTrigger Binding="{Binding WorkOrder.IsSentToSigner}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
												<DataTrigger Binding="{Binding WorkOrder.IsValidated}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Border.Style>

									<TextBlock>
										<TextBlock.Style>
											<Style TargetType="TextBlock" BasedOn="{StaticResource StatusCellTextBaseStyle}">
												<Setter Property="Text" Value="Demande devis envoyée"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding WorkOrder.IsSentToCompany}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding WorkOrder.IsQuoteReceived}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding WorkOrder.IsSentToSigner}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding WorkOrder.IsValidated}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
								</Border>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- 3) Devis reçu -->
					<DataGridTemplateColumn Width="SizeToCells"
											MinWidth="70"
											HeaderStyle="{StaticResource StatusHeaderNoVerticalSeparators}"
											CellStyle="{StaticResource StatusCellNoVerticalSeparators}"
											IsReadOnly="True">
						<DataGridTemplateColumn.Header>
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="*"/>
									<RowDefinition Height="*"/>
								</Grid.RowDefinitions>

								<Border x:Name="StatusHeaderBorder" Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource FilterHeaderHighlightBorderStyle}" HorizontalAlignment="Center" VerticalAlignment="Center">
									<StackPanel Orientation="Vertical" HorizontalAlignment="Center">
										<TextBlock Text="Statut" Style="{StaticResource StatusHeaderTopText}" HorizontalAlignment="Center"/>
										<Button x:Name="StatusFilterButton" Content="▾" Tag="Status"
												Style="{StaticResource FilterHeaderButtonStyle}"
												Click="ColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
									</StackPanel>
								</Border>
							</Grid>
						</DataGridTemplateColumn.Header>
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Border CornerRadius="2">
									<Border.Style>
										<Style TargetType="Border">
											<Setter Property="Background" Value="Transparent"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding WorkOrder.IsQuoteReceived}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
												<DataTrigger Binding="{Binding WorkOrder.IsSentToSigner}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
												<DataTrigger Binding="{Binding WorkOrder.IsValidated}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Border.Style>

									<TextBlock>
										<TextBlock.Style>
											<Style TargetType="TextBlock" BasedOn="{StaticResource StatusCellTextBaseStyle}">
												<Setter Property="Text" Value="Devis reçu"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding WorkOrder.IsQuoteReceived}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding WorkOrder.IsSentToSigner}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding WorkOrder.IsValidated}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
								</Border>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- 4) Demande validation envoyée -->
					<DataGridTemplateColumn Width="SizeToCells"
											HeaderStyle="{StaticResource StatusHeaderNoVerticalSeparators}"
											CellStyle="{StaticResource StatusCellNoVerticalSeparators}"
											IsReadOnly="True">
						<DataGridTemplateColumn.Header>
							<Grid/>
						</DataGridTemplateColumn.Header>
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Border CornerRadius="2">
									<Border.Style>
										<Style TargetType="Border">
											<Setter Property="Background" Value="Transparent"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding WorkOrder.IsSentToSigner}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
												<DataTrigger Binding="{Binding WorkOrder.IsValidated}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Border.Style>

									<TextBlock>
										<TextBlock.Style>
											<Style TargetType="TextBlock" BasedOn="{StaticResource StatusCellTextBaseStyle}">
												<Setter Property="Text" Value="Demande validation envoyée"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding WorkOrder.IsSentToSigner}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding WorkOrder.IsValidated}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
								</Border>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- 5) Validé -->
					<DataGridTemplateColumn Width="SizeToCells"
											HeaderStyle="{StaticResource StatusHeaderWithRightSeparator}"
											CellStyle="{StaticResource StatusCellWithRightSeparator}"
											IsReadOnly="True">
						<DataGridTemplateColumn.Header>
							<Grid/>
						</DataGridTemplateColumn.Header>

						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Border CornerRadius="2">
									<Border.Style>
										<Style TargetType="Border">
											<Setter Property="Background" Value="Transparent"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding WorkOrder.ValidationDecision}" Value="Validé">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>

												<DataTrigger Binding="{Binding WorkOrder.ValidationDecision}" Value="Annulé">
													<Setter Property="Background" Value="#FFEDD5"/>
												</DataTrigger>

												<DataTrigger Binding="{Binding WorkOrder.ValidationDecision}" Value="Refusé">
													<Setter Property="Background" Value="#FEE2E2"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Border.Style>

									<TextBlock>
										<TextBlock.Style>
											<Style TargetType="TextBlock" BasedOn="{StaticResource StatusCellTextBaseStyle}">
												<Setter Property="Text" Value="{Binding WorkOrder.ValidationDecision}"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding WorkOrder.ValidationDecision}" Value="Validé">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding WorkOrder.ValidationDecision}" Value="Annulé">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding WorkOrder.ValidationDecision}" Value="Refusé">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
								</Border>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- Distribué le -->
					<DataGridTemplateColumn Width="95" IsReadOnly="False">
						<DataGridTemplateColumn.Header>
							<Border x:Name="DistributedDateHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
								<StackPanel Orientation="Vertical" HorizontalAlignment="Center">
									<TextBlock Text="Distribué le" HorizontalAlignment="Center"/>
									<Button x:Name="DistributedDateFilterButton" Content="▾" Tag="DistributedDate"
											Style="{StaticResource FilterHeaderButtonStyle}"
											Click="ColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
								</StackPanel>
							</Border>
						</DataGridTemplateColumn.Header>
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Border Style="{StaticResource DateCellBorderStyle_Distributed}">
									<DatePicker Style="{StaticResource GridDatePickerStyle}"
												SelectedDate="{Binding WorkOrder.DistributedAt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												SelectedDateChanged="DistributedDate_SelectedDateChanged">
										<DatePicker.Resources>
											<Style TargetType="{x:Type DatePickerTextBox}"
												   BasedOn="{StaticResource NoWatermarkDatePickerTextBoxStyle}"/>
										</DatePicker.Resources>
									</DatePicker>
								</Border>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- Effectué le -->
					<DataGridTemplateColumn Width="95" IsReadOnly="False">
						<DataGridTemplateColumn.Header>
							<Border x:Name="PerformedDateHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
								<StackPanel Orientation="Vertical" HorizontalAlignment="Center">
									<TextBlock Text="Effectué le" HorizontalAlignment="Center"/>
									<Button x:Name="PerformedDateFilterButton" Content="▾" Tag="PerformedDate"
											Style="{StaticResource FilterHeaderButtonStyle}"
											Click="ColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
								</StackPanel>
							</Border>
						</DataGridTemplateColumn.Header>
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Border Style="{StaticResource DateCellBorderStyle_Performed}">
									<DatePicker Style="{StaticResource GridDatePickerStyle}"
												SelectedDate="{Binding WorkOrder.PerformedAt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												SelectedDateChanged="PerformedDate_SelectedDateChanged">
										<DatePicker.Resources>
											<Style TargetType="{x:Type DatePickerTextBox}"
												   BasedOn="{StaticResource NoWatermarkDatePickerTextBoxStyle}"/>
										</DatePicker.Resources>
									</DatePicker>
								</Border>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- Actions (largeur réduite de 35% puis 15% de plus, 24.07.2026, demande de Joe) -->
					<DataGridTemplateColumn Header="Actions" Width="83" IsReadOnly="True">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<StackPanel Orientation="Horizontal">
									<Button Content="↩"
											ToolTip="Restaurer"
											Style="{StaticResource RestoreSmallButtonStyle}"
											Click="RestoreRow_Click"
											Margin="0,0,4,0"/>

									<Button ToolTip="Corbeille"
											Style="{StaticResource DangerSmallButtonStyle}"
											Click="TrashRow_Click">
										<Path Data="{StaticResource IconTrashGeometry}"
											  Width="12" Height="12" Stretch="Uniform"
											  Fill="Transparent" StrokeThickness="1.3" StrokeLineJoin="Round"
											  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
									</Button>
								</StackPanel>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

				</DataGrid.Columns>
			</DataGrid>
		</Border>

	</Grid>
</UserControl>