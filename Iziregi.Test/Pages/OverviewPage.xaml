<!-- File: Pages/OverviewPage.xaml -->
<UserControl x:Class="Iziregi.Test.Pages.OverviewPage"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 d:DesignHeight="820"
			 d:DesignWidth="1280"
			 Background="#F6F7FB">

	<!-- ✅ 31.07.2026 (demande de Joe) : "l'ancien Tableau de bord n'était en fait qu'un
		 tableau des bons, pas un vrai résumé général", cette page devient le nouveau
		 point d'entrée "Tableau de bord" (widgets : heure/date, dossier actif, statistiques
		 bons + tâches), l'ancienne page (liste des bons) est renommée "Bons d'intervention"
		 dans le menu, sans changement de contenu.

		 ✅ 31.07.2026, 2e passe (demande de Joe) : "beaucoup de choses sur cette page, tout
		 doit passer sans scroll, les widgets ne prennent que la place nécessaire, style
		 élégant", la maquette Excel fournie n'était qu'une référence de STRUCTURE (quelles
		 étapes, quels compteurs), pas de style. Remplacé la grille façon tableur (case par
		 case, bordures partout) par une barre proportionnelle compacte + puces de légende,
		 nettement plus dense verticalement. -->

	<UserControl.Resources>

		<Style x:Key="CardStyle" TargetType="Border">
			<Setter Property="Background" Value="White"/>
			<Setter Property="BorderBrush" Value="#E2E8F0"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Padding" Value="16,14"/>
			<Setter Property="Effect" Value="{StaticResource CardShadowEffect}"/>
		</Style>

		<!-- ✅ Bold (demande de Joe : "tous les titres widget en bold"). -->
		<Style x:Key="CardTitleStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="#0F172A"/>
		</Style>

		<!-- ✅ 31.07.2026, 3e passe (demande de Joe) : "garde la même structure que ma pic",
			 retour à l'escalier de progression (une puce par étape franchie, la dernière
			 colorée selon le résultat), mais en version élégante (pas de grille façon
			 tableur/bordures noires) : puces arrondies, étapes déjà franchies en gris discret,
			 seule l'étape courante est mise en couleur. -->
		<Style x:Key="ChipStyle" TargetType="Border">
			<Setter Property="CornerRadius" Value="5"/>
			<Setter Property="Padding" Value="7,3"/>
			<Setter Property="Margin" Value="0,0,6,4"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style x:Key="ChipTextStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="Medium"/>
		</Style>
		<Style x:Key="StageRowCountStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="#0F172A"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Right"/>
			<Setter Property="Margin" Value="0,0,0,4"/>
		</Style>

		<!-- ✅ Séparateur discret entre les lignes de l'escalier (31.07.2026, demande de Joe :
			 "bien distinguer quel chiffre est à qui") : pointillé plutôt qu'une ligne pleine,
			 moins "tableur" qu'une bordure classique. Épaissi + assombri (2e passe, demande de
			 Joe : "peu visibles"). -->
		<Style x:Key="RowDividerStyle" TargetType="Rectangle">
			<Setter Property="Height" Value="1.6"/>
			<Setter Property="Fill" Value="Transparent"/>
			<Setter Property="Stroke" Value="#94A3B8"/>
			<Setter Property="StrokeThickness" Value="1.6"/>
			<Setter Property="StrokeDashArray" Value="2,2"/>
			<Setter Property="VerticalAlignment" Value="Bottom"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
		</Style>

		<!-- Puce de légende (pastille couleur + libellé + valeur) -->
		<Style x:Key="LegendLabelStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Foreground" Value="#64748B"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style x:Key="LegendValueStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="#0F172A"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="4,0,0,0"/>
		</Style>
		<Style x:Key="LegendDotStyle" TargetType="Border">
			<Setter Property="Width" Value="9"/>
			<Setter Property="Height" Value="9"/>
			<Setter Property="CornerRadius" Value="3"/>
			<Setter Property="Margin" Value="0,0,5,0"/>
		</Style>

		<!-- Lien "hyperactif" façon pilule (31.07.2026, demande de Joe) : Corbeille ouvre sa
			 page dédiée, curseur main + surlignage discret au survol. Vert clair (demande de
			 Joe : les éléments gris deviennent vert clair), sauf "Archivés" qui garde
			 volontairement son gris d'origine (défini inline, pas via ce style). -->
		<Style x:Key="LinkPillStyle" TargetType="Border">
			<Setter Property="CornerRadius" Value="20"/>
			<Setter Property="Padding" Value="10,4"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Background" Value="#ECFDF5"/>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#DCFCE7"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<!-- ✅ Bouton "supprimer" d'une note du Bloc-notes (demande de Joe) : discret (pas de
			 chrome Windows), rouge au survol seulement. Construit en code-behind
			 (OverviewPage.xaml.cs, BuildNoteRow) donc appliqué via FindResource, pas de
			 x:Name/binding ici. -->
		<Style x:Key="NoteDeleteButtonStyle" TargetType="Button">
			<Setter Property="Width" Value="22"/>
			<Setter Property="Height" Value="22"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="#94A3B8"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="VerticalAlignment" Value="Top"/>
			<Setter Property="Margin" Value="6,0,0,0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/>
								<Setter Property="Foreground" Value="#B91C1C"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<!-- ✅ Widgets extensibles (11e passe, demande de Joe) : ScrollViewer pour que la droite et
		 le bas des cartes restent accessibles (défilement) si le contenu dépasse la fenêtre,
		 au lieu d'être simplement rogné. -->
	<!-- ✅ Fix (demande de Joe : chiffres du widget BI mal alignés) : HorizontalScrollBarVisibility
		 "Auto" donnait une largeur infinie en mesure au contenu, ce qui casse le mécanisme
		 SharedSizeGroup (les colonnes ne se synchronisent plus entre les lignes de l'escalier).
		 Passé à "Disabled", le défilement vertical suffit, les widgets sont compacts/alignés
		 à gauche et n'ont pas besoin de défilement horizontal. -->
	<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
	<Grid Margin="18,16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0"
				   Text="Tableau de bord"
				   FontSize="18"
				   FontWeight="SemiBold"
				   Foreground="#0F172A"
				   Margin="0,0,0,14"/>

		<!-- ✅ 27e passe (demande de Joe) : Date en Row0 (colonne gauche uniquement), Dossier
			 actif + Tâches en Row1 (colonne gauche), BI en Row1 colonne droite, le haut de BI
			 s'aligne ainsi précisément sur le haut de "Dossier actif" (pas sur Date), via la
			 grille elle-même plutôt qu'une marge devinée au pixel. -->
		<Grid Grid.Row="1" VerticalAlignment="Top">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="14"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<!-- ✅ Fix (demande de Joe : layout cassé, "Tâches" pas vraiment en haut) : grille à
				 une seule ligne (le découpage Row0/Row1 datait du widget date supprimé, plus de
				 raison de le garder), Tâches et la colonne droite démarrent maintenant
				 exactement à la même hauteur, sans dépendre d'une distribution de RowSpan. -->
		<StackPanel Grid.Column="0" VerticalAlignment="Top">
			<!-- ✅ Widget Heure/Date/Semaine (demande de Joe, re-ajouté au-dessus de "Tâches").
				 ✅ Bordure orange clair (demande de Joe, remplace le noir), ombre jaune clair,
				 même intensité que les autres widgets (DropShadowEffect Direction/ShadowDepth/
				 BlurRadius/Opacity identiques, seule la couleur change). -->
			<Border Style="{StaticResource CardStyle}"
			        BorderBrush="#FDBA74"
			        Padding="14,10" Margin="0,0,0,10" HorizontalAlignment="Left">
				<Border.Effect>
					<DropShadowEffect Color="#FDE047" Direction="270" ShadowDepth="6" BlurRadius="30" Opacity="0.42"/>
				</Border.Effect>
				<StackPanel Orientation="Horizontal">
					<TextBlock x:Name="ClockTextBlock" Text="--:--:--" FontSize="20" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
					<Border Width="1" Background="#94A3B8" Margin="10,2" />
					<TextBlock x:Name="DateTextBlock" Text="-" FontSize="14" Foreground="#0F172A" VerticalAlignment="Center"/>
					<Border Width="1" Background="#94A3B8" Margin="10,2" />
					<TextBlock x:Name="WeekTextBlock" Text="-" FontSize="14" Foreground="#0F172A" VerticalAlignment="Center"/>
				</StackPanel>
			</Border>

			<!-- Carte "Tâches" : titre "Tâches" seul. "Actives" en haut (comme "Actifs" côté
				 Bons, avec son propre total = tâches non archivées non effectuées), puis les
				 niveaux d'urgence (visibles uniquement si la colonne "Urg." est affichée dans la
				 grille Planning, voir Db.GetTasksVisibleColumns), puis "Effectuées", puis "Total"
				 (Actives + Effectuées) tout en bas, comme "Total" côté Bons. -->
			<!-- ✅ Descendu de 2cm (76px, demande de Joe) via Margin (pousse réellement le
				 widget, pas de RenderTransform : dernier élément de sa colonne, aucun risque de
				 chevauchement). -->
			<Border Style="{StaticResource CardStyle}"
			        BorderBrush="#2563EB"
			        Margin="0,76,0,0">
				<Border.Effect>
					<DropShadowEffect Color="#2563EB" Direction="270" ShadowDepth="6" BlurRadius="30" Opacity="0.42"/>
				</Border.Effect>
				<StackPanel>
					<TextBlock Style="{StaticResource CardTitleStyle}" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="TasksCard_Click">
						<Run Text="Tâches"/>
						<Run Text=" →" Foreground="Black" FontWeight="Normal"/>
					</TextBlock>

					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto" MinWidth="28"/>
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource RowDividerStyle}" VerticalAlignment="Top" Margin="0,-4,0,0"/>

						<TextBlock Grid.Row="0" Grid.Column="0" Text="Actives" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,3"/>
						<TextBlock Grid.Row="0" Grid.Column="1" x:Name="TasksActiveRun" Text="0" FontSize="15" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" Margin="0,0,0,3"/>
						<Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource RowDividerStyle}"/>

						<Border x:Name="TasksUrgency1Chip" Grid.Row="1" Grid.Column="0" Background="#FECACA" BorderBrush="Transparent" BorderThickness="2" CornerRadius="5" Padding="10,3" HorizontalAlignment="Left" Margin="0,3,0,2">
							<TextBlock x:Name="TasksUrgency1Label" Text="Niveau d'urgence 1" FontSize="12" Foreground="Black"/>
						</Border>
						<!-- ✅ Décalé de 2cm (76px) vers la gauche (demande de Joe) : les niveaux
							 d'urgence sont un sous-détail d'"Actives", pas additionnés dans le Total,
							 ce décalage purement visuel (RenderTransform, sans effet sur la mise en
							 page/largeur des colonnes) marque cette différence. -->
						<TextBlock x:Name="TasksUrgency1Run" Grid.Row="1" Grid.Column="1" Text="0" Style="{StaticResource StageRowCountStyle}" Margin="0,3,0,2">
							<TextBlock.RenderTransform>
								<TranslateTransform X="-76"/>
							</TextBlock.RenderTransform>
						</TextBlock>
						<Rectangle x:Name="TasksUrgency1Divider" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource RowDividerStyle}"/>

						<Border x:Name="TasksUrgency2Chip" Grid.Row="2" Grid.Column="0" Background="#FED7AA" CornerRadius="5" Padding="10,3" HorizontalAlignment="Left" Margin="0,3,0,2">
							<TextBlock Text="Niveau d'urgence 2" FontSize="12" Foreground="Black"/>
						</Border>
						<TextBlock x:Name="TasksUrgency2Run" Grid.Row="2" Grid.Column="1" Text="0" Style="{StaticResource StageRowCountStyle}" Margin="0,3,0,2">
							<TextBlock.RenderTransform>
								<TranslateTransform X="-76"/>
							</TextBlock.RenderTransform>
						</TextBlock>
						<Rectangle x:Name="TasksUrgency2Divider" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource RowDividerStyle}"/>

						<Border x:Name="TasksUrgency3Chip" Grid.Row="3" Grid.Column="0" Background="#FEF08A" CornerRadius="5" Padding="10,3" HorizontalAlignment="Left" Margin="0,3,0,2">
							<TextBlock Text="Niveau d'urgence 3" FontSize="12" Foreground="Black"/>
						</Border>
						<TextBlock x:Name="TasksUrgency3Run" Grid.Row="3" Grid.Column="1" Text="0" Style="{StaticResource StageRowCountStyle}" Margin="0,3,0,2">
							<TextBlock.RenderTransform>
								<TranslateTransform X="-76"/>
							</TextBlock.RenderTransform>
						</TextBlock>
						<Rectangle x:Name="TasksUrgency3Divider" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource RowDividerStyle}"/>

						<!-- ✅ Surlignage vert clair + police noire (demande de Joe), comme la
							 colonne "Effectué" de la grille des tâches (PlanningPage.xaml,
							 TaskDoneColumn, DoneCellBorder Background="#C7F9C7" quand Done=true). -->
						<Border Grid.Row="4" Grid.Column="0" Background="#C7F9C7" CornerRadius="5" Padding="10,3" HorizontalAlignment="Left" Margin="0,3,0,2">
							<TextBlock Text="Effectuées" FontSize="12" Foreground="Black"/>
						</Border>
						<TextBlock Grid.Row="4" Grid.Column="1" x:Name="TasksDoneRun" Text="0" Style="{StaticResource StageRowCountStyle}" Margin="0,3,0,2"/>
						<Rectangle Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource RowDividerStyle}"/>

						<!-- ✅ "Tâches Archivées" (demande de Joe, disposée comme "Archivés" dans le
							 widget BI) : lien cliquable gris, n'entre pas dans le Total (comme
							 Archivés/Corbeille côté BI). -->
						<Border Grid.Row="5" Grid.Column="0" Background="#F1F5F9" CornerRadius="5" Padding="10,3" HorizontalAlignment="Left" Cursor="Hand" MouseLeftButtonDown="TasksArchivedRow_Click" Margin="0,3,0,2">
							<TextBlock Foreground="#334155" FontSize="12">
								<Run Text="Archivées"/>
								<Run Text=" &#8594;" FontWeight="Normal"/>
							</TextBlock>
						</Border>
						<TextBlock x:Name="TasksArchivedRun" Grid.Row="5" Grid.Column="1" Text="0" Style="{StaticResource StageRowCountStyle}" Margin="0,3,0,2"/>
						<Rectangle Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource RowDividerStyle}"/>

						<!-- ✅ "Corbeille" (demande de Joe, disposée comme "Corbeille" dans le widget BI) :
							 lien cliquable rouge, n'entre pas dans le calcul d'Actives (les tâches
							 mises à la corbeille sont exclues plus haut), mais s'ajoute au Total. -->
						<Border Grid.Row="6" Grid.Column="0" Background="#F1F5F9" CornerRadius="5" Padding="10,3" HorizontalAlignment="Left" Cursor="Hand" MouseLeftButtonDown="TasksTrashedRow_Click" Margin="0,3,0,2">
							<TextBlock Foreground="#B91C1C" FontSize="12">
								<Run Text="Corbeille"/>
								<Run Text=" &#8594;" FontWeight="Normal"/>
							</TextBlock>
						</Border>
						<TextBlock x:Name="TasksTrashedRun" Grid.Row="6" Grid.Column="1" Text="0" Style="{StaticResource StageRowCountStyle}" Margin="0,3,0,2"/>
						<Rectangle Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource RowDividerStyle}"/>

						<TextBlock Grid.Row="7" Grid.Column="0" Text="Total" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,3,0,0"/>
						<TextBlock Grid.Row="7" Grid.Column="1" x:Name="TasksTotalRun" Text="0" FontSize="16" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" Margin="0,3,0,0"/>
					</Grid>
				</StackPanel>
			</Border>
		</StackPanel>

			<!-- Carte "Bons d'intervention" : escalier de progression élégant (31.07.2026,
				 demande de Joe : même structure que sa maquette Excel, une puce par étape
				 franchie, dernière puce colorée selon le résultat, mais sans grille/bordures
				 façon tableur).

				 ✅ 31.07.2026, 4e passe (demande de Joe) : colonnes de puces à largeur FIXE
				 (au lieu d'un StackPanel par ligne), nécessaire pour qu'"Archivés"/
				 "Corbeille"/"Total" puissent s'aligner sur la même colonne que "Validé", et
				 pour que tous les totaux tombent à un endroit constant, proche (10mm/38px) de
				 cette colonne plutôt que loin à droite. Palette repassée en vert (étapes
				 franchies = vert très clair, étape courante en cours = vert foncé, comme
				 "Validé". Refusé/Annulé gardent leur rouge/ambre, ce sont des résultats
				 distincts. Police Arial + bordure de la carte en vert.

				 ✅ 22e passe (demande de Joe) : passée en colonne 2 (droite), la carte "Tâches"
				 prend la colonne 0 (gauche) ci-dessus.

				 ✅ 27e passe (demande de Joe) : HorizontalAlignment="Left" (widget trop large,
				 resserré à la largeur de son contenu au lieu de s'étirer sur toute la colonne
				 "*"). Grid.Row="0" + Grid.RowSpan="2" (28e passe, demande de Joe : "remonter
				 widget BI en haut à droite") : le haut de BI s'aligne maintenant sur le haut de
				 "Date" (tout en haut), pas sur "Dossier actif".

				 ✅ 29e passe (demande de Joe) : BI + widget "Total TTC, Intervenants" empilés
				 dans une StackPanel commune (colonne droite), pour que le widget TTC se place
				 juste sous BI. -->
			<!-- ✅ Fix (demande de Joe : "Dossier actif" en haut à droite de la PAGE, sous la
				 pastille du dossier) : Grid à 2 colonnes (Auto=BI/TTC, *=reste), "Dossier actif"
				 dans la colonne "*" aligné à droite pour atteindre le vrai bord droit de la
				 page, peu importe la largeur de BI. -->
			<!-- ✅ Fix (demande de Joe : "widget TTC à droite du widget BI et aligné
				 horizontalement sur le bas de BI") : 3 colonnes désormais (Auto=BI, Auto=TTC,
				 *=Dossier actif), TTC en VerticalAlignment="Bottom" pour que son bas coïncide
				 avec le bas de BI (même hauteur de ligne de grille). -->
			<Grid Grid.Column="2">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<!-- ✅ Fix (demande de Joe : "remettre Statistiques au milieu de BI") : BI et
					 Statistiques regroupés dans ce sous-Grid dédié (2 colonnes), lui-même
					 VerticalAlignment="Top" dans la grille du dessus, sans ça, sa ligne de
					 grille était partagée avec la colonne "Dossier actif + Bloc-notes" (Grid.
					 Column="1" ci-dessous), et grandissait avec elle (ex. hauteur fixe du
					 Bloc-notes), ce qui centrait Statistiques sur cette ligne plus haute au lieu
					 du BI réel. En VerticalAlignment="Top", ce sous-Grid ne prend que sa propre
					 hauteur naturelle (celle de BI, qui reste le plus grand des deux ici), donc
					 Statistiques (VerticalAlignment="Center" à l'intérieur) se centre bien sur
					 BI, peu importe la hauteur du Bloc-notes à côté. -->
				<Grid Grid.Column="0" VerticalAlignment="Top">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
			<StackPanel Grid.Column="0" VerticalAlignment="Top">
			<!-- ✅ Décalé de 1mm/4px vers la gauche (demande de Joe) via RenderTransform. -->
			<Border Style="{StaticResource CardStyle}"
			        BorderBrush="#15803D"
			        TextElement.FontFamily="Arial"
			        Grid.IsSharedSizeScope="True"
			        HorizontalAlignment="Left">
				<!-- ✅ Ombre encore plus prononcée (3e passe, demande de Joe) que le
				     CardShadowEffect partagé (App.xaml), surchargée ici seulement, pas touché
				     pour les autres cartes de l'app. -->
				<Border.Effect>
					<DropShadowEffect Color="#15803D" Direction="270" ShadowDepth="6" BlurRadius="30" Opacity="0.42"/>
				</Border.Effect>
				<Border.RenderTransform>
					<TranslateTransform X="-4"/>
				</Border.RenderTransform>
				<StackPanel>
					<!-- ✅ Lien cliquable limité au titre (15e passe, demande de Joe), plus toute
						 la carte. Flèche "→" pour signaler le lien (27e passe, demande de Joe). -->
					<TextBlock Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonDown="BonsStatusTable_Click">
						<Run Text="États des statuts de BI"/>
						<Run Text=" →" Foreground="Black" FontWeight="Normal"/>
					</TextBlock>

					<!-- ✅ Colonnes en Auto (2e passe, demande de Joe : "serrer les éléments à la
					     largeur de leur écritures") + SharedSizeGroup pour que ce Grid ET celui
					     d'Archivés/Corbeille/Total (plus bas) partagent EXACTEMENT les mêmes
					     largeurs de colonnes malgré ce sont 2 Grid distincts. -->
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol0"/>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol1"/>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol2"/>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol3"/>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol4"/>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol5"/>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol6"/>
							<ColumnDefinition Width="19"/>
							<ColumnDefinition Width="Auto" MinWidth="28" SharedSizeGroup="StageCol8"/>
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<!-- Ligne pointillée au-dessus d'Actifs, remontée de 2mm/8px (3e passe,
							 demande de Joe). -->
						<Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}" VerticalAlignment="Top" Margin="0,-8,0,0"/>

						<!-- Actifs (police agrandie, 8e passe, demande de Joe) -->
						<TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7" Text="Actifs" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
						<TextBlock Grid.Row="0" Grid.Column="8" x:Name="WorkOrdersActiveRun" Text="0" FontSize="15" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" Margin="0,0,0,8"/>
						<!-- ✅ Remontée de 1mm/4px (15e passe, demande de Joe) -->
						<Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}" Margin="0,0,0,4"/>

						<!-- ✅ Fix (demande de Joe : "on enlève les cases vertes claires, et on garde
							 les autres [...] disposés verticalement") : escalier retiré, les puces
							 des étapes déjà franchies (vert clair) sont supprimées, il ne reste que
							 la puce de l'étape courante de chaque ligne (colonne 0), une ligne par
							 étape, chacune avec son total. -->

						<!-- Créé -->
						<Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ChipStyle}" Background="#C7F9C7" HorizontalAlignment="Stretch"><TextBlock Text="Créé" Style="{StaticResource ChipTextStyle}" Foreground="Black"/></Border>
						<TextBlock Grid.Row="1" Grid.Column="8" x:Name="StageCreatedOnlyRun" Text="0" Style="{StaticResource StageRowCountStyle}"/>
						<Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}"/>

						<!-- Demande devis envoyée -->
						<Border Grid.Row="2" Grid.Column="0" Style="{StaticResource ChipStyle}" Background="#C7F9C7" HorizontalAlignment="Stretch"><TextBlock Text="Demande devis envoyée" Style="{StaticResource ChipTextStyle}" Foreground="Black"/></Border>
						<TextBlock Grid.Row="2" Grid.Column="8" x:Name="StageSentToCompanyRun" Text="0" Style="{StaticResource StageRowCountStyle}"/>
						<Rectangle Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}"/>

						<!-- Devis reçu -->
						<Border Grid.Row="3" Grid.Column="0" Style="{StaticResource ChipStyle}" Background="#C7F9C7" HorizontalAlignment="Stretch"><TextBlock Text="Devis reçu" Style="{StaticResource ChipTextStyle}" Foreground="Black"/></Border>
						<TextBlock Grid.Row="3" Grid.Column="8" x:Name="StageQuoteReceivedRun" Text="0" Style="{StaticResource StageRowCountStyle}"/>
						<Rectangle Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}"/>

						<!-- Demande validation envoyée -->
						<Border Grid.Row="4" Grid.Column="0" Style="{StaticResource ChipStyle}" Background="#C7F9C7" HorizontalAlignment="Stretch"><TextBlock Text="Demande validation envoyée" Style="{StaticResource ChipTextStyle}" Foreground="Black"/></Border>
						<TextBlock Grid.Row="4" Grid.Column="8" x:Name="StageSentToSignerRun" Text="0" Style="{StaticResource StageRowCountStyle}"/>
						<Rectangle Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}"/>

						<!-- Validé -->
						<Border Grid.Row="5" Grid.Column="0" Style="{StaticResource ChipStyle}" Background="#C7F9C7" Margin="0,0,6,4" HorizontalAlignment="Stretch"><TextBlock Text="Validé" Style="{StaticResource ChipTextStyle}" Foreground="Black"/></Border>
						<TextBlock Grid.Row="5" Grid.Column="8" x:Name="StageValidatedRun" Text="0" Style="{StaticResource StageRowCountStyle}"/>
						<Rectangle Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}"/>

						<!-- Distribué -->
						<Border Grid.Row="6" Grid.Column="0" Style="{StaticResource ChipStyle}" Background="#C7F9C7" Margin="0,0,6,4" HorizontalAlignment="Stretch"><TextBlock Text="Distribué" Style="{StaticResource ChipTextStyle}" Foreground="Black"/></Border>
						<TextBlock Grid.Row="6" Grid.Column="8" x:Name="StageDistributedRun" Text="0" Style="{StaticResource StageRowCountStyle}"/>
						<Rectangle Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}"/>

						<!-- Effectué -->
						<Border Grid.Row="7" Grid.Column="0" Style="{StaticResource ChipStyle}" Background="#C7F9C7" Margin="0,0,6,4" HorizontalAlignment="Stretch"><TextBlock Text="Effectué" Style="{StaticResource ChipTextStyle}" Foreground="Black"/></Border>
						<TextBlock Grid.Row="7" Grid.Column="8" x:Name="StagePerformedRun" Text="0" Style="{StaticResource StageRowCountStyle}"/>
						<Rectangle Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}"/>

						<!-- Refusé -->
						<Border Grid.Row="8" Grid.Column="0" Style="{StaticResource ChipStyle}" Background="#FEE2E2" Margin="0,0,6,4" HorizontalAlignment="Stretch"><TextBlock Text="Refusé" Style="{StaticResource ChipTextStyle}" Foreground="#B91C1C"/></Border>
						<TextBlock Grid.Row="8" Grid.Column="8" x:Name="StageRefusedRun" Text="0" Style="{StaticResource StageRowCountStyle}"/>
						<Rectangle Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}"/>

						<!-- Annulé -->
						<Border Grid.Row="9" Grid.Column="0" Style="{StaticResource ChipStyle}" Background="#FEF3C7" Margin="0,0,6,0" HorizontalAlignment="Stretch"><TextBlock Text="Annulé" Style="{StaticResource ChipTextStyle}" Foreground="#92400E"/></Border>
						<TextBlock Grid.Row="9" Grid.Column="8" x:Name="StageCancelledRun" Text="0" Style="{StaticResource StageRowCountStyle}"/>
						<!-- Ligne pointillée en dessous d'Annulé (2e passe, demande de Joe) -->
						<Rectangle Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}"/>

						<!-- Lien Devis expiré -->
						<Border Grid.Row="10" Grid.Column="0" Style="{StaticResource ChipStyle}" Background="#FED7AA" ToolTip="Lien entreprise expiré (&gt; 9 jours) — Regénérer dans la fiche" HorizontalAlignment="Stretch"><TextBlock Text="Lien Devis expiré" Style="{StaticResource ChipTextStyle}" Foreground="#2563EB"/></Border>
						<TextBlock Grid.Row="10" Grid.Column="8" x:Name="ExpiredCompanyLinkRun" Text="0" Style="{StaticResource StageRowCountStyle}"/>
						<Rectangle Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}"/>

						<!-- Lien Validation expiré -->
						<Border Grid.Row="11" Grid.Column="0" Style="{StaticResource ChipStyle}" Background="#FED7AA" ToolTip="Lien signataire expiré (&gt; 9 jours) — Regénérer dans la fiche" HorizontalAlignment="Stretch"><TextBlock Text="Lien Validation expiré" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<TextBlock Grid.Row="11" Grid.Column="8" x:Name="ExpiredSignerLinkRun" Text="0" Style="{StaticResource StageRowCountStyle}"/>
						<!-- ✅ Séparation pointillée sous "Lien Validation expiré" (14e passe,
							 demande de Joe). -->
						<Rectangle Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}"/>
					</Grid>

					<!-- ✅ Espace resserré entre l'escalier et "Archivés" (14e passe, demande de
						 Joe). -->
					<Border BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Margin="0,4,0,4"/>

					<!-- Archivés / Corbeille (liens) + Total : libellés alignés sur la colonne
						 "Validé" ci-dessus (31.07.2026, demande de Joe), totaux dans la même
						 colonne à droite, à 10mm (colonne "gap" de 38px) du libellé. -->
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol0"/>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol1"/>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol2"/>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol3"/>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol4"/>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol5"/>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol6"/>
							<ColumnDefinition Width="19"/>
							<ColumnDefinition Width="Auto" MinWidth="28" SharedSizeGroup="StageCol8"/>
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<!-- ✅ "Archivés" garde son gris d'origine (demande explicite de Joe : "sauf
							 Archivés"). Rectangle arrondi ChipStyle (6e passe, demande de Joe :
							 "comme les autres"). ✅ Fix (demande de Joe : "Archivés et Corbeille
							 peuvent être sur la même colonne que les autres, mais à droite de la
							 colonne") : colonne 4 (dédiée à l'ancien escalier) -> colonne 0 (même
							 colonne que toutes les puces désormais), alignement à droite dans
							 cette même colonne. -->
						<Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ChipStyle}" Background="#F1F5F9" Cursor="Hand" HorizontalAlignment="Right" MouseLeftButtonDown="ArchivedRow_Click" Margin="0,0,0,6">
							<TextBlock Style="{StaticResource ChipTextStyle}" Foreground="#334155">
								<Run Text="Archivés"/>
								<Run Text=" &#8594;" FontWeight="Normal"/>
							</TextBlock>
						</Border>
						<TextBlock Grid.Row="0" Grid.Column="8" x:Name="WorkOrdersArchivedRun" Text="0" Style="{StaticResource StageRowCountStyle}" Margin="0,0,0,6"/>

						<!-- ✅ Corbeille en gris (4e passe, demande de Joe), même fond qu'Archivés,
							 même traitement rectangle arrondi + alignement droit (6e passe). -->
						<Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ChipStyle}" Background="#F1F5F9" Cursor="Hand" HorizontalAlignment="Right" MouseLeftButtonDown="TrashRow_Click" Margin="0,0,0,6">
							<TextBlock Style="{StaticResource ChipTextStyle}" Foreground="#B91C1C">
								<Run Text="Corbeille"/>
								<Run Text=" &#8594;" FontWeight="Normal"/>
							</TextBlock>
						</Border>
						<TextBlock Grid.Row="1" Grid.Column="8" x:Name="WorkOrdersTrashedRun" Text="0" Style="{StaticResource StageRowCountStyle}" Margin="0,0,0,6"/>
						<!-- Ligne pointillée entre Corbeille et Total (2e passe, demande de Joe) -->
						<Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}"/>

						<!-- ✅ "Total" et son chiffre descendus de 2mm/8px (4e passe, demande de Joe). -->
						<TextBlock Grid.Row="2" Grid.Column="0" Text="Total" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,8,6,0"/>
						<TextBlock Grid.Row="2" Grid.Column="8" x:Name="WorkOrdersTotalRun" Text="0" FontSize="16" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" Margin="0,8,0,0"/>
					</Grid>
				</StackPanel>
			</Border>
		</StackPanel>

		<!-- Widget "Total TTC, Intervenants", Total TTC du 1er tableau de la page Comptabilité
			 ("Totaux par intervenants", ligne TOTAL), calculé avec les mêmes bons éligibles
			 (Validé) et la même formule de prix (AccountingPage.ComputeTtc/IsAccountingEligible,
			 rendues internal static pour être réutilisées ici sans dupliquer la logique de
			 calcul). Bordure/ombre vertes comme BI. -->
		<!-- ✅ Centré verticalement sur BI (demande de Joe, remplace l'alignement "Bottom"
			 précédent) : VerticalAlignment="Center", même hauteur de ligne de grille que BI,
			 mais centré au lieu de calé en bas.
			 ✅ Remonté de 5mm/19px puis encore 3mm/11px (demande de Joe), total 8mm/30px, puis
			 redescendu de 1mm/4px (net 26px) et décalé de 3mm/11px vers la gauche (demande de
			 Joe), via RenderTransform (comme ailleurs dans cette page) : un margin seul ne
			 suffirait pas à décaler du plein montant avec VerticalAlignment="Center" (le
			 centrage n'en absorbe que la moitié). -->
		<Border Grid.Column="1" Style="{StaticResource CardStyle}" BorderBrush="#15803D" VerticalAlignment="Center" Margin="14,0,0,0">
			<Border.RenderTransform>
				<TranslateTransform X="-11" Y="-26"/>
			</Border.RenderTransform>
			<Border.Effect>
				<DropShadowEffect Color="#15803D" Direction="270" ShadowDepth="6" BlurRadius="30" Opacity="0.42"/>
			</Border.Effect>
			<StackPanel>
				<TextBlock Style="{StaticResource CardTitleStyle}" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="AccountingCard_Click">
					<Run Text="Montant actuel des bons validés"/>
					<Run Text=" &#8594;" Foreground="Black" FontWeight="Normal"/>
				</TextBlock>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto" MinWidth="28"/>
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="0" Text="Total TTC, intervenants" FontSize="14" FontWeight="Normal" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,14,0"/>
					<TextBlock Grid.Column="1" x:Name="AccountingTotalTtcTextBlock" Text="0.00" FontSize="16" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>
				</Grid>
			</StackPanel>
		</Border>
		</Grid>

		<!-- ✅ Fix (demande de Joe : "en haut à droite de la page, sous la pastille") : colonne
			 "*" du Grid ci-dessus, alignée à droite -> bord droit de la page quelle que soit
			 la largeur de BI.
			 ✅ Bloc-notes juste sous "Dossier actif" (demande de Joe, retour en arrière sur le
			 "tout en bas de page" précédent qui le poussait via une ligne "*"), 2 lignes Auto
			 seulement désormais, empilées directement l'une sous l'autre. -->
		<Grid Grid.Column="1" HorizontalAlignment="Right">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- ✅ "Dossier actif" : titre fixe (comme "Bons d'intervention"/"Tâches"), nom du
				 dossier en valeur juste en dessous. Bordure/ombre teintées de la couleur de
				 la pastille du dossier (Project.ColorHex), définies en code-behind. Adresse
				 et Ville croisées avec Réf./Contact (demande de Joe). Titre cliquable (ouvre
				 la Banque de dossiers), flèche "→" pour signaler le lien. -->
			<Border Grid.Row="0" x:Name="ProjectCardBorder" Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,10">
				<Border.Effect>
					<DropShadowEffect x:Name="ProjectCardShadow" Color="#2563EB" Direction="270" ShadowDepth="6" BlurRadius="30" Opacity="0.42"/>
				</Border.Effect>
				<StackPanel>
					<TextBlock Style="{StaticResource CardTitleStyle}" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="ProjectCard_Click">
						<Run Text="Dossier actif"/>
						<Run Text=" →" Foreground="Black" FontWeight="Normal"/>
					</TextBlock>
					<TextBlock x:Name="ProjectNameTextBlock"
							   Text="Aucun dossier sélectionné"
							   FontSize="15"
							   FontWeight="Bold"
							   Foreground="#0F172A"
							   Margin="0,0,0,10"
							   TextWrapping="NoWrap"
							   TextTrimming="CharacterEllipsis"/>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="28"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
							<TextBlock Text="ADRESSE" FontSize="9" FontWeight="SemiBold" Foreground="#94A3B8"/>
							<TextBlock x:Name="ProjectAddressTextBlock" Text="-" FontSize="13" Foreground="#0F172A" Margin="0,1,0,0"/>
						</StackPanel>

						<StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
							<TextBlock Text="VILLE" FontSize="9" FontWeight="SemiBold" Foreground="#94A3B8"/>
							<TextBlock x:Name="ProjectCityTextBlock" Text="-" FontSize="13" Foreground="#0F172A" Margin="0,1,0,0"/>
						</StackPanel>

						<StackPanel Grid.Row="1" Grid.Column="0">
							<TextBlock Text="RÉF." FontSize="9" FontWeight="SemiBold" Foreground="#94A3B8"/>
							<TextBlock x:Name="ProjectManagerNameTextBlock" Text="-" FontSize="13" Foreground="#0F172A" Margin="0,1,0,0"/>
						</StackPanel>

						<StackPanel Grid.Row="1" Grid.Column="2">
							<TextBlock Text="CONTACT" FontSize="9" FontWeight="SemiBold" Foreground="#94A3B8"/>
							<TextBlock x:Name="ProjectManagerContactTextBlock" Text="-" FontSize="13" Foreground="#0F172A" Margin="0,1,0,0"/>
						</StackPanel>
					</Grid>
				</StackPanel>
			</Border>

			<!-- ✅ Bloc-notes (demande de Joe) : style "mosaïque" (2e essai, après la version en
				 liste empilée), plusieurs post-its indépendants disposés en grille (WrapPanel),
				 chacun avec sa propre zone de texte (enregistrement auto à la perte de focus) et
				 une croix de suppression dans le coin. Table SQL DashboardNotes (Db.cs), une
				 ligne par note. Construit dynamiquement en code-behind (RebuildNotesList/
				 BuildNoteTile) plutôt qu'en binding, cohérent avec le reste de cette page (pas de
				 MVVM ici). MaxHeight + ScrollViewer interne : la carte ne grandit pas
				 indéfiniment si beaucoup de notes sont ajoutées. -->
			<!-- ✅ Remonté de 1cm (demande de Joe, depuis 76px -> 38px) via Margin. -->
			<!-- ✅ Agrandi de 1cm (38px) vers le bas, puis de 4mm (15px) vers le haut (demande de
				 Joe) : hauteur 260 -> 298 -> 313 ; marge haute réduite d'autant (38 -> 23) pour
				 que le haut remonte sans déplacer le bas.
				 ✅ Redevenu MaxHeight (demande de Joe : "avant il se déployait avec plusieurs
				 notes, remettre comme avant"). Le Height fixe d'une passe précédente réglait le
				 déplacement de Statistiques, mais au prix de figer aussi la hauteur du widget.
				 Inutile maintenant que BI+Statistiques sont isolés dans leur propre sous-Grid
				 (VerticalAlignment="Top", voir plus haut) : cette carte peut de nouveau grandir/
				 rétrécir librement avec le nombre de notes (jusqu'au plafond de 313) sans jamais
				 affecter Statistiques. -->
			<Border Grid.Row="1" Style="{StaticResource CardStyle}" MaxHeight="313" BorderBrush="#8B5CF6" Margin="0,23,0,0">
				<Border.Effect>
					<DropShadowEffect Color="#8B5CF6" Direction="270" ShadowDepth="6" BlurRadius="30" Opacity="0.42"/>
				</Border.Effect>
				<DockPanel LastChildFill="True">
					<Grid DockPanel.Dock="Top" Margin="0,0,0,8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
							<TextBlock Style="{StaticResource CardTitleStyle}" Text="Bloc-notes"/>
							<TextBlock x:Name="NotesCountTextBlock" Text="(0)" FontSize="13" Foreground="#64748B" Margin="6,0,0,0" VerticalAlignment="Center"/>
						</StackPanel>
						<Button Grid.Column="1" x:Name="AddNoteButton" Content="+" Style="{StaticResource PrimaryButtonStyle}" Width="30" Height="26" FontSize="14" Padding="0" Click="AddNoteButton_Click"/>
					</Grid>
					<ScrollViewer VerticalScrollBarVisibility="Auto">
						<WrapPanel x:Name="NotesListPanel"/>
					</ScrollViewer>
				</DockPanel>
			</Border>
		</Grid>
		</Grid>

		</Grid>
	</Grid>
	</ScrollViewer>
</UserControl>
