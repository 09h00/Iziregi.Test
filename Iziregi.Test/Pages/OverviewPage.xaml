<!-- File: Pages/OverviewPage.xaml -->
<UserControl x:Class="Iziregi.Test.Pages.OverviewPage"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 d:DesignHeight="820"
			 d:DesignWidth="1280"
			 Background="#F6F7FB">

	<!-- ✅ 31.07.2026 (demande de Joe) : "l'ancien Tableau de bord n'était en fait qu'un
		 tableau des bons, pas un vrai résumé général", cette page devient le nouveau
		 point d'entrée "Tableau de bord" (widgets : heure/date, dossier actif, statistiques
		 bons + tâches), l'ancienne page (liste des bons) est renommée "Bons d'intervention"
		 dans le menu, sans changement de contenu.

		 ✅ 31.07.2026, 2e passe (demande de Joe) : "beaucoup de choses sur cette page, tout
		 doit passer sans scroll, les widgets ne prennent que la place nécessaire, style
		 élégant", la maquette Excel fournie n'était qu'une référence de STRUCTURE (quelles
		 étapes, quels compteurs), pas de style. Remplacé la grille façon tableur (case par
		 case, bordures partout) par une barre proportionnelle compacte + puces de légende,
		 nettement plus dense verticalement. -->

	<UserControl.Resources>

		<Style x:Key="CardStyle" TargetType="Border">
			<Setter Property="Background" Value="White"/>
			<Setter Property="BorderBrush" Value="#E2E8F0"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Padding" Value="16,14"/>
			<Setter Property="Effect" Value="{StaticResource CardShadowEffect}"/>
		</Style>

		<Style x:Key="CardTitleStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="#0F172A"/>
		</Style>

		<!-- ✅ 31.07.2026, 3e passe (demande de Joe) : "garde la même structure que ma pic",
			 retour à l'escalier de progression (une puce par étape franchie, la dernière
			 colorée selon le résultat), mais en version élégante (pas de grille façon
			 tableur/bordures noires) : puces arrondies, étapes déjà franchies en gris discret,
			 seule l'étape courante est mise en couleur. -->
		<Style x:Key="ChipStyle" TargetType="Border">
			<Setter Property="CornerRadius" Value="5"/>
			<Setter Property="Padding" Value="7,3"/>
			<Setter Property="Margin" Value="0,0,6,4"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style x:Key="ChipTextStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="Medium"/>
		</Style>
		<Style x:Key="StageRowCountStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="#0F172A"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Right"/>
			<Setter Property="Margin" Value="0,0,0,4"/>
		</Style>

		<!-- ✅ Séparateur discret entre les lignes de l'escalier (31.07.2026, demande de Joe :
			 "bien distinguer quel chiffre est à qui") : pointillé plutôt qu'une ligne pleine,
			 moins "tableur" qu'une bordure classique. Épaissi + assombri (2e passe, demande de
			 Joe : "peu visibles"). -->
		<Style x:Key="RowDividerStyle" TargetType="Rectangle">
			<Setter Property="Height" Value="1.6"/>
			<Setter Property="Fill" Value="Transparent"/>
			<Setter Property="Stroke" Value="#94A3B8"/>
			<Setter Property="StrokeThickness" Value="1.6"/>
			<Setter Property="StrokeDashArray" Value="2,2"/>
			<Setter Property="VerticalAlignment" Value="Bottom"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
		</Style>

		<!-- Puce de légende (pastille couleur + libellé + valeur) -->
		<Style x:Key="LegendLabelStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Foreground" Value="#64748B"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style x:Key="LegendValueStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="#0F172A"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="4,0,0,0"/>
		</Style>
		<Style x:Key="LegendDotStyle" TargetType="Border">
			<Setter Property="Width" Value="9"/>
			<Setter Property="Height" Value="9"/>
			<Setter Property="CornerRadius" Value="3"/>
			<Setter Property="Margin" Value="0,0,5,0"/>
		</Style>

		<!-- Lien "hyperactif" façon pilule (31.07.2026, demande de Joe) : Corbeille ouvre sa
			 page dédiée, curseur main + surlignage discret au survol. Vert clair (demande de
			 Joe : les éléments gris deviennent vert clair), sauf "Archivés" qui garde
			 volontairement son gris d'origine (défini inline, pas via ce style). -->
		<Style x:Key="LinkPillStyle" TargetType="Border">
			<Setter Property="CornerRadius" Value="20"/>
			<Setter Property="Padding" Value="10,4"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Background" Value="#ECFDF5"/>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#DCFCE7"/>
				</Trigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>

	<!-- ✅ Widgets extensibles (11e passe, demande de Joe) : ScrollViewer pour que la droite et
		 le bas des cartes restent accessibles (défilement) si le contenu dépasse la fenêtre,
		 au lieu d'être simplement rogné. -->
	<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
	<Grid Margin="18,16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0"
				   Text="Tableau de bord"
				   FontSize="18"
				   FontWeight="SemiBold"
				   Foreground="#0F172A"
				   Margin="0,0,0,14"/>

		<!-- Ligne 1 : Heure/Date (à gauche, compact) + Dossier actif (5e passe, demande de Joe :
			 "le nom du dossier pourra varier en longueur"), le nom n'est plus tronqué à une
			 largeur fixe, la carte s'étire maintenant dans l'espace restant de la ligne, via
			 une colonne "*" plutôt qu'un StackPanel horizontal. -->
		<Grid Grid.Row="1" Margin="0,0,0,14">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="10"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14,10">
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<TextBlock x:Name="ClockTextBlock"
							   Text="00:00"
							   FontSize="20"
							   FontWeight="Bold"
							   Foreground="#0F172A"
							   VerticalAlignment="Center"/>
					<Border Width="1" Background="#E2E8F0" Margin="10,2" />
					<TextBlock x:Name="DateTextBlock"
							   Text=""
							   FontSize="14"
							   Foreground="#0F172A"
							   VerticalAlignment="Center"/>
				</StackPanel>
			</Border>

			<Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14,10">
				<StackPanel VerticalAlignment="Center">
					<TextBlock Text="DOSSIER ACTIF" FontSize="9" FontWeight="SemiBold" Foreground="#94A3B8"/>
					<TextBlock x:Name="ProjectNameTextBlock"
							   Text="Aucun dossier sélectionné"
							   FontSize="15"
							   FontWeight="Bold"
							   Foreground="#0F172A"
							   Margin="0,1,0,0"
							   TextWrapping="NoWrap"
							   TextTrimming="CharacterEllipsis"/>
				</StackPanel>
			</Border>
		</Grid>

		<!-- Ligne 2 : Bons d'intervention (gauche) + Tâches (droite), côte à côte pour rester
			 compact verticalement. -->
		<Grid Grid.Row="2" VerticalAlignment="Top">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="14"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- Carte "Bons d'intervention" : escalier de progression élégant (31.07.2026,
				 demande de Joe : même structure que sa maquette Excel, une puce par étape
				 franchie, dernière puce colorée selon le résultat, mais sans grille/bordures
				 façon tableur).

				 ✅ 31.07.2026, 4e passe (demande de Joe) : colonnes de puces à largeur FIXE
				 (au lieu d'un StackPanel par ligne), nécessaire pour qu'"Archivés"/
				 "Corbeille"/"Total" puissent s'aligner sur la même colonne que "Validé", et
				 pour que tous les totaux tombent à un endroit constant, proche (10mm/38px) de
				 cette colonne plutôt que loin à droite. Palette repassée en vert (étapes
				 franchies = vert très clair, étape courante en cours = vert foncé, comme
				 "Validé". Refusé/Annulé gardent leur rouge/ambre, ce sont des résultats
				 distincts. Police Arial + bordure de la carte en vert. -->
			<Border Grid.Column="0"
			        Style="{StaticResource CardStyle}"
			        BorderBrush="#15803D"
			        TextElement.FontFamily="Arial"
			        Grid.IsSharedSizeScope="True">
				<!-- ✅ Ombre encore plus prononcée (3e passe, demande de Joe) que le
				     CardShadowEffect partagé (App.xaml), surchargée ici seulement, pas touché
				     pour les autres cartes de l'app. -->
				<Border.Effect>
					<DropShadowEffect Color="#15803D" Direction="270" ShadowDepth="6" BlurRadius="30" Opacity="0.42"/>
				</Border.Effect>
				<StackPanel>
					<!-- ✅ Lien cliquable limité au titre (15e passe, demande de Joe), plus toute
						 la carte. -->
					<TextBlock Text="Bons d'intervention" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonDown="BonsStatusTable_Click"/>

					<!-- ✅ Colonnes en Auto (2e passe, demande de Joe : "serrer les éléments à la
					     largeur de leur écritures") + SharedSizeGroup pour que ce Grid ET celui
					     d'Archivés/Corbeille/Total (plus bas) partagent EXACTEMENT les mêmes
					     largeurs de colonnes malgré ce sont 2 Grid distincts. -->
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol0"/>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol1"/>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol2"/>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol3"/>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol4"/>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol5"/>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol6"/>
							<ColumnDefinition Width="19"/>
							<ColumnDefinition Width="Auto" MinWidth="28" SharedSizeGroup="StageCol8"/>
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<!-- Ligne pointillée au-dessus d'Actifs, remontée de 2mm/8px (3e passe,
							 demande de Joe). -->
						<Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}" VerticalAlignment="Top" Margin="0,-8,0,0"/>

						<!-- Actifs (police agrandie, 8e passe, demande de Joe) -->
						<TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7" Text="Actifs" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
						<TextBlock Grid.Row="0" Grid.Column="8" x:Name="WorkOrdersActiveRun" Text="0" FontSize="15" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" Margin="0,0,0,8"/>
						<!-- ✅ Remontée de 1mm/4px (15e passe, demande de Joe) -->
						<Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}" Margin="0,0,0,4"/>

						<!-- Créé -->
						<Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ChipStyle}" Background="#15803D"><TextBlock Text="Créé" Style="{StaticResource ChipTextStyle}" Foreground="White"/></Border>
						<TextBlock Grid.Row="1" Grid.Column="8" x:Name="StageCreatedOnlyRun" Text="0" Style="{StaticResource StageRowCountStyle}"/>
						<Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}"/>

						<!-- Créé (passé) > Devis envoyé -->
						<Border Grid.Row="2" Grid.Column="0" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Créé" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="2" Grid.Column="1" Style="{StaticResource ChipStyle}" Background="#15803D"><TextBlock Text="Demande devis envoyée" Style="{StaticResource ChipTextStyle}" Foreground="White"/></Border>
						<TextBlock Grid.Row="2" Grid.Column="8" x:Name="StageSentToCompanyRun" Text="0" Style="{StaticResource StageRowCountStyle}"/>
						<Rectangle Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}"/>

						<!-- ... > Devis reçu -->
						<Border Grid.Row="3" Grid.Column="0" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Créé" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="3" Grid.Column="1" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Demande devis envoyée" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="3" Grid.Column="2" Style="{StaticResource ChipStyle}" Background="#15803D"><TextBlock Text="Devis reçu" Style="{StaticResource ChipTextStyle}" Foreground="White"/></Border>
						<TextBlock Grid.Row="3" Grid.Column="8" x:Name="StageQuoteReceivedRun" Text="0" Style="{StaticResource StageRowCountStyle}"/>
						<Rectangle Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}"/>

						<!-- ... > Validation envoyée -->
						<Border Grid.Row="4" Grid.Column="0" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Créé" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="4" Grid.Column="1" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Demande devis envoyée" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="4" Grid.Column="2" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Devis reçu" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="4" Grid.Column="3" Style="{StaticResource ChipStyle}" Background="#15803D"><TextBlock Text="Demande validation envoyée" Style="{StaticResource ChipTextStyle}" Foreground="White"/></Border>
						<TextBlock Grid.Row="4" Grid.Column="8" x:Name="StageSentToSignerRun" Text="0" Style="{StaticResource StageRowCountStyle}"/>
						<Rectangle Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}"/>

						<!-- ... > Validé -->
						<Border Grid.Row="5" Grid.Column="0" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Créé" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="5" Grid.Column="1" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Demande devis envoyée" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="5" Grid.Column="2" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Devis reçu" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="5" Grid.Column="3" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Demande validation envoyée" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="5" Grid.Column="4" Style="{StaticResource ChipStyle}" Background="#15803D" Margin="0,0,0,4"><TextBlock Text="Validé" Style="{StaticResource ChipTextStyle}" Foreground="White"/></Border>
						<TextBlock Grid.Row="5" Grid.Column="8" x:Name="StageValidatedRun" Text="0" Style="{StaticResource StageRowCountStyle}"/>
						<Rectangle Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}"/>

						<!-- ✅ ... > Distribué (7e passe, demande de Joe) : nouvelle étape entre
							 "Validé" et "Refusé", même style que les autres (WorkOrder.DistributedAt
							 non nul, déjà utilisé par la page "Bons d'intervention" comme "Distribué
							 le"). -->
						<Border Grid.Row="6" Grid.Column="0" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Créé" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="6" Grid.Column="1" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Demande devis envoyée" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="6" Grid.Column="2" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Devis reçu" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="6" Grid.Column="3" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Demande validation envoyée" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="6" Grid.Column="4" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Validé" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="6" Grid.Column="5" Style="{StaticResource ChipStyle}" Background="#15803D" Margin="0,0,0,4"><TextBlock Text="Distribué" Style="{StaticResource ChipTextStyle}" Foreground="White"/></Border>
						<TextBlock Grid.Row="6" Grid.Column="8" x:Name="StageDistributedRun" Text="0" Style="{StaticResource StageRowCountStyle}"/>
						<Rectangle Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}"/>

						<!-- ✅ ... > Effectué (8e passe, demande de Joe) : même principe que
							 "Distribué", basé sur WorkOrder.PerformedAt ("Effectué le", déjà utilisé
							 par la page "Bons d'intervention"). -->
						<Border Grid.Row="7" Grid.Column="0" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Créé" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="7" Grid.Column="1" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Demande devis envoyée" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="7" Grid.Column="2" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Devis reçu" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="7" Grid.Column="3" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Demande validation envoyée" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="7" Grid.Column="4" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Validé" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="7" Grid.Column="5" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Distribué" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="7" Grid.Column="6" Style="{StaticResource ChipStyle}" Background="#15803D" Margin="0,0,0,4"><TextBlock Text="Effectué" Style="{StaticResource ChipTextStyle}" Foreground="White"/></Border>
						<TextBlock Grid.Row="7" Grid.Column="8" x:Name="StagePerformedRun" Text="0" Style="{StaticResource StageRowCountStyle}"/>
						<Rectangle Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}"/>

						<!-- ... > Refusé -->
						<Border Grid.Row="8" Grid.Column="0" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Créé" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="8" Grid.Column="1" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Demande devis envoyée" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="8" Grid.Column="2" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Devis reçu" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="8" Grid.Column="3" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Demande validation envoyée" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="8" Grid.Column="4" Style="{StaticResource ChipStyle}" Background="#FEE2E2" Margin="0,0,0,4"><TextBlock Text="Refusé" Style="{StaticResource ChipTextStyle}" Foreground="#B91C1C"/></Border>
						<TextBlock Grid.Row="8" Grid.Column="8" x:Name="StageRefusedRun" Text="0" Style="{StaticResource StageRowCountStyle}"/>
						<Rectangle Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}"/>

						<!-- ... > Annulé -->
						<Border Grid.Row="9" Grid.Column="0" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Créé" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="9" Grid.Column="1" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Demande devis envoyée" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="9" Grid.Column="2" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Devis reçu" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="9" Grid.Column="3" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Demande validation envoyée" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="9" Grid.Column="4" Style="{StaticResource ChipStyle}" Background="#FEF3C7" Margin="0"><TextBlock Text="Annulé" Style="{StaticResource ChipTextStyle}" Foreground="#92400E"/></Border>
						<TextBlock Grid.Row="9" Grid.Column="8" x:Name="StageCancelledRun" Text="0" Style="{StaticResource StageRowCountStyle}"/>
						<!-- Ligne pointillée en dessous d'Annulé (2e passe, demande de Joe) -->
						<Rectangle Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}"/>

						<!-- ✅ 2 lignes sous "Annulé" (12e passe, demande de Joe : cohérence logique),
							 bons dont le lien (devis ou validation) a dépassé le délai, même seuil
							 que la page "Bons d'intervention" (WorkOrder.IsCompanyLinkExpired /
							 IsSignerLinkExpired, > 9 jours). Un lien devis expiré signifie que le
							 devis n'a JAMAIS été reçu (IsCompanyLinkExpired implique !IsQuoteReceived),
							 le bon s'arrête donc après "Devis envoyé", pas plus loin. Idem pour le
							 lien validation, qui implique !IsValidated, le bon s'arrête après
							 "Validation envoyée". -->
						<Border Grid.Row="10" Grid.Column="0" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Créé" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="10" Grid.Column="1" Style="{StaticResource ChipStyle}" Background="#FED7AA" ToolTip="Lien entreprise expiré (&gt; 9 jours) — Regénérer dans la fiche"><TextBlock Text="Lien Devis expiré" Style="{StaticResource ChipTextStyle}" Foreground="#2563EB"/></Border>
						<TextBlock Grid.Row="10" Grid.Column="8" x:Name="ExpiredCompanyLinkRun" Text="0" Style="{StaticResource StageRowCountStyle}"/>
						<Rectangle Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}"/>

						<Border Grid.Row="11" Grid.Column="0" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Créé" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="11" Grid.Column="1" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Demande devis envoyée" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="11" Grid.Column="2" Style="{StaticResource ChipStyle}" Background="#ECFDF5"><TextBlock Text="Devis reçu" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<Border Grid.Row="11" Grid.Column="3" Style="{StaticResource ChipStyle}" Background="#FED7AA" ToolTip="Lien signataire expiré (&gt; 9 jours) — Regénérer dans la fiche"><TextBlock Text="Lien Validation expiré" Style="{StaticResource ChipTextStyle}" Foreground="#16A34A"/></Border>
						<TextBlock Grid.Row="11" Grid.Column="8" x:Name="ExpiredSignerLinkRun" Text="0" Style="{StaticResource StageRowCountStyle}"/>
						<!-- ✅ Séparation pointillée sous "Lien Validation expiré" (14e passe,
							 demande de Joe). -->
						<Rectangle Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}"/>
					</Grid>

					<!-- ✅ Espace resserré entre l'escalier et "Archivés" (14e passe, demande de
						 Joe). -->
					<Border BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Margin="0,4,0,4"/>

					<!-- Archivés / Corbeille (liens) + Total : libellés alignés sur la colonne
						 "Validé" ci-dessus (31.07.2026, demande de Joe), totaux dans la même
						 colonne à droite, à 10mm (colonne "gap" de 38px) du libellé. -->
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol0"/>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol1"/>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol2"/>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol3"/>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol4"/>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol5"/>
							<ColumnDefinition Width="Auto" SharedSizeGroup="StageCol6"/>
							<ColumnDefinition Width="19"/>
							<ColumnDefinition Width="Auto" MinWidth="28" SharedSizeGroup="StageCol8"/>
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<!-- ✅ "Archivés" garde son gris d'origine (demande explicite de Joe : "sauf
							 Archivés"). Rectangle arrondi ChipStyle (6e passe, demande de Joe :
							 "comme les autres"), bord droit aligné sur celui d'"Annulé" (colonne 4
							 seule, sans déborder sur la colonne "gap", alignement à droite). -->
						<Border Grid.Row="0" Grid.Column="4" Style="{StaticResource ChipStyle}" Background="#F1F5F9" Cursor="Hand" HorizontalAlignment="Right" MouseLeftButtonDown="ArchivedRow_Click" Margin="0,0,0,6">
							<TextBlock Text="Archivés" Style="{StaticResource ChipTextStyle}" Foreground="#334155"/>
						</Border>
						<TextBlock Grid.Row="0" Grid.Column="8" x:Name="WorkOrdersArchivedRun" Text="0" Style="{StaticResource StageRowCountStyle}" Margin="0,0,0,6"/>

						<!-- ✅ Corbeille en gris (4e passe, demande de Joe), même fond qu'Archivés,
							 même traitement rectangle arrondi + alignement droit (6e passe). -->
						<Border Grid.Row="1" Grid.Column="4" Style="{StaticResource ChipStyle}" Background="#F1F5F9" Cursor="Hand" HorizontalAlignment="Right" MouseLeftButtonDown="TrashRow_Click" Margin="0,0,0,6">
							<TextBlock Text="Corbeille" Style="{StaticResource ChipTextStyle}" Foreground="#B91C1C"/>
						</Border>
						<TextBlock Grid.Row="1" Grid.Column="8" x:Name="WorkOrdersTrashedRun" Text="0" Style="{StaticResource StageRowCountStyle}" Margin="0,0,0,6"/>
						<!-- Ligne pointillée entre Corbeille et Total (2e passe, demande de Joe) -->
						<Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="9" Style="{StaticResource RowDividerStyle}"/>

						<!-- ✅ "Total" et son chiffre descendus de 2mm/8px (4e passe, demande de Joe). -->
						<TextBlock Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="4" Text="Total" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,8,6,0"/>
						<TextBlock Grid.Row="2" Grid.Column="8" x:Name="WorkOrdersTotalRun" Text="0" FontSize="16" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" Margin="0,8,0,0"/>
					</Grid>
				</StackPanel>
			</Border>

			<!-- Carte "Tâches" (20e passe, demande de Joe) : rectangles arrondis (CornerRadius 5,
				 comme ChipStyle) au lieu des pastilles ovales, "Total Tâches actives" en bas
				 (comme "Total" côté Bons), bordure + ombre bleues, largeur resserrée au minimum
				 du contenu (HorizontalAlignment="Left", ne s'étire plus). -->
			<Border Grid.Column="2"
			        Style="{StaticResource CardStyle}"
			        BorderBrush="#2563EB"
			        HorizontalAlignment="Left">
				<Border.Effect>
					<DropShadowEffect Color="#2563EB" Direction="270" ShadowDepth="6" BlurRadius="30" Opacity="0.42"/>
				</Border.Effect>
				<StackPanel>
					<TextBlock Text="Tâches (Planning)" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10"/>

					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto" MinWidth="28"/>
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource RowDividerStyle}" VerticalAlignment="Top" Margin="0,-8,0,0"/>

						<!-- Niveau d'urgence 1 -->
						<Border Grid.Row="0" Grid.Column="0" Background="#FEE2E2" CornerRadius="5" Padding="10,4" HorizontalAlignment="Left">
							<TextBlock Text="Niveau d'urgence 1" FontSize="12" Foreground="#B91C1C"/>
						</Border>
						<TextBlock Grid.Row="0" Grid.Column="1" x:Name="TasksUrgency1Run" Text="0" Style="{StaticResource StageRowCountStyle}"/>
						<Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource RowDividerStyle}"/>

						<!-- Niveau d'urgence 2 -->
						<Border Grid.Row="1" Grid.Column="0" Background="#FEF3C7" CornerRadius="5" Padding="10,4" HorizontalAlignment="Left" Margin="0,8,0,4">
							<TextBlock Text="Niveau d'urgence 2" FontSize="12" Foreground="#92400E"/>
						</Border>
						<TextBlock Grid.Row="1" Grid.Column="1" x:Name="TasksUrgency2Run" Text="0" Style="{StaticResource StageRowCountStyle}" Margin="0,8,0,4"/>
						<Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource RowDividerStyle}"/>

						<!-- Niveau d'urgence 3 -->
						<Border Grid.Row="2" Grid.Column="0" Background="#DBEAFE" CornerRadius="5" Padding="10,4" HorizontalAlignment="Left" Margin="0,8,0,4">
							<TextBlock Text="Niveau d'urgence 3" FontSize="12" Foreground="#2563EB"/>
						</Border>
						<TextBlock Grid.Row="2" Grid.Column="1" x:Name="TasksUrgency3Run" Text="0" Style="{StaticResource StageRowCountStyle}" Margin="0,8,0,4"/>
						<Rectangle Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource RowDividerStyle}"/>

						<!-- Effectué -->
						<Border Grid.Row="3" Grid.Column="0" Background="#15803D" CornerRadius="5" Padding="10,4" HorizontalAlignment="Left" Margin="0,8,0,4">
							<TextBlock Text="Effectué" FontSize="12" Foreground="White"/>
						</Border>
						<TextBlock Grid.Row="3" Grid.Column="1" x:Name="TasksDoneRun" Text="0" Style="{StaticResource StageRowCountStyle}" Margin="0,8,0,4"/>
						<Rectangle Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource RowDividerStyle}"/>

						<!-- Total Tâches actives -->
						<TextBlock Grid.Row="4" Grid.Column="0" Text="Total Tâches actives" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,8,0,0"/>
						<TextBlock Grid.Row="4" Grid.Column="1" x:Name="TasksActiveRun" Text="0" FontSize="16" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" Margin="0,8,0,0"/>
					</Grid>
				</StackPanel>
			</Border>
		</Grid>
	</Grid>
	</ScrollViewer>
</UserControl>
