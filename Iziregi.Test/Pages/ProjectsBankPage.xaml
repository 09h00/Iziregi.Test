<!-- File: Pages/ProjectsBankPage.xaml -->
<!-- ✅ Converti depuis ProjectsWindow (18.08.2026, demande de Joe) : cette page s'ouvrait
     auparavant dans une fenêtre séparée ("Banque de dossiers"), jugée obsolète, embarquée
     maintenant directement dans l'onglet "Banque de dossiers" de Paramètres, même principe que
     la conversion ArchitectIdentityWindow -> ArchitectIdentityPage. -->
<UserControl x:Class="Iziregi.Test.ProjectsBankPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Iziregi.Test"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1100"
             Background="{StaticResource PageBackgroundBrush}">

    <UserControl.Resources>
        <local:HexToBrushConverter x:Key="HexToBrushConverter"/>
        <local:BoolToActiveStatusConverter x:Key="BoolToActiveStatusConverter"/>
        <local:BoolToStatusBrushConverter x:Key="BoolToStatusBrushConverter"/>
        <local:BoolToStatusForegroundConverter x:Key="BoolToStatusForegroundConverter"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadowEffect}"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ✅ IMPORTANT : Template custom, sinon le thème Windows peut ignorer Background au survol -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- ✅ 29.07.2026 (demande de Joe) : bordure plus épaisse au survol. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1D4ED8"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E40AF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E40AF"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#93C5FD"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- ✅ 29.07.2026 (demande de Joe) : bordure plus épaisse au survol. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
        </Style>

        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="RootScrollViewer" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="RootScrollViewer_PreviewMouseWheel">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Banque de dossiers"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#111827"/>
                    <TextBlock Text="Créer et gérer les informations des dossiers utilisés dans les bons d'intervention."
                               FontSize="13"
                               Foreground="#6B7280"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Contenu principal -->
        <Grid Grid.Row="1" MinHeight="560">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="0.85*" MinWidth="580"/>
            </Grid.ColumnDefinitions>

            <!-- Liste projets -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Liste des dossiers"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               Margin="0,0,0,10"/>

                    <DataGrid x:Name="ProjectsGrid"
                              Grid.Row="1"
                              Style="{StaticResource GridStyle}"
                              SelectionChanged="ProjectsGrid_SelectionChanged"
                              HorizontalAlignment="Stretch"
                              Width="NaN">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="●" Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="20" Height="20"
                                                CornerRadius="10"
                                                BorderBrush="#D1D5DB"
                                                BorderThickness="1"
                                                HorizontalAlignment="Center"
                                                Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id, StringFormat=D{0}}" Width="55"/>
                            <DataGridTextColumn Header="" Binding="{Binding LockIcon}" Width="28"/>
                            <DataGridTextColumn Header="Nom du dossier" Binding="{Binding Name}" Width="1.2*"/>
                            <DataGridTextColumn Header="Adresse" Binding="{Binding Address}" Width="1.6*"/>
                            <DataGridTemplateColumn Header="État" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding IsActive, Converter={StaticResource BoolToStatusBrushConverter}}"
                                                CornerRadius="10"
                                                Padding="8,2"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToActiveStatusConverter}}"
                                                       Foreground="{Binding IsActive, Converter={StaticResource BoolToStatusForegroundConverter}}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- ✅ "Modifier" (18.08.2026, demande de Joe) : remplace le bouton
                                 "Modifier" de la section Actions. Demande le mot de passe du dossier
                                 si nécessaire (voir ModifyProjectRow_Click), même que pour l'activer. -->
                            <DataGridTemplateColumn Header="" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Modifier"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Height="24"
                                                Padding="8,0"
                                                FontSize="11"
                                                Click="ModifyProjectRow_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Formulaire -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
                <StackPanel>

                    <!-- Champs -->
                    <StackPanel>
                        <!-- ✅ Bouton "Fermer" retiré d'ici (18.08.2026, demande de Joe) : page
                             embarquée dans Paramètres, plus de fenêtre à fermer. -->
                        <DockPanel Margin="0,0,0,12" LastChildFill="True">
                            <TextBlock Text="Dossier"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left"
                                       Margin="0,0,14,0"/>

                            <Button Content="+ Nouveau dossier"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="NewProject_Click"
                                    DockPanel.Dock="Left"
                                    VerticalAlignment="Center"
                                    Margin="0,0,14,0"/>

                            <TextBlock x:Name="StatusTextBlock"
                                       Text=""
                                       Foreground="#6B7280"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </DockPanel>

                        <!-- Ligne 1 : Nom du dossier -->
                        <TextBlock Text="Nom du dossier" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="ProjectNameTextBox"
                                 Style="{StaticResource InputStyle}"
                                 Margin="0,0,0,12"/>

                        <!-- Ligne 2 : Adresse -->
                        <TextBlock Text="Adresse" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="ProjectAddressLineTextBox"
                                 Style="{StaticResource InputStyle}"
                                 Margin="0,0,0,10"/>

                        <!-- Ligne 3 : Code postal et Ville -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.35*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="0.65*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Code postal" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="ProjectZipTextBox"
                                         Style="{StaticResource InputStyle}"
                                         MaxLength="4"
                                         PreviewTextInput="Zip_PreviewTextInput"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ville" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="ProjectCityTextBox"
                                         Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Ligne 4 : Géré par -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.5*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="0.5*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Réf." Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="ProjectManagerNameTextBox"
                                         Style="{StaticResource InputStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <!-- ✅ Espaceur (sans texte) pour garder ProjectManagerContactTextBox
                                     aligné avec ProjectManagerNameTextBox à gauche (qui a un label "Réf."). -->
                                <TextBlock Text="" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="ProjectManagerContactTextBox"
                                         Style="{StaticResource InputStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Ligne 5 : Couleur de la pastille -->
                        <TextBlock Text="Couleur de la pastille" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="ProjectColorHexTextBox"
                                     Grid.Column="0"
                                     Style="{StaticResource InputStyle}"
                                     Text="#111827"/>

                            <Button x:Name="PickProjectColorButton"
                                    Grid.Column="2"
                                    Content="Choisir..."
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="PickProjectColor_Click"/>

                            <Border x:Name="ProjectColorPreviewBorder"
                                    Grid.Column="4"
                                    Width="38"
                                    Height="32"
                                    CornerRadius="6"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    Background="#111827"/>
                        </Grid>

                        <!-- ✅ Mot de passe du dossier (18.08.2026, demande de Joe) : verrouille
                             l'accès au dossier, sauf mot de passe "Directeur" (voir Paramètres).
                             Laisser vide à l'enregistrement = ne change rien au mot de passe
                             existant. -->
                        <TextBlock Text="Mot de passe du dossier" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <PasswordBox x:Name="ProjectPasswordBox"
                                         Grid.Column="0"
                                         Height="32"
                                         Padding="8,4"
                                         BorderBrush="#D1D5DB"
                                         BorderThickness="1"
                                         Background="White"
                                         VerticalContentAlignment="Center"/>

                            <Button Grid.Column="2"
                                    Content="Retirer"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="RemoveProjectPassword_Click"/>
                        </Grid>
                        <TextBlock x:Name="ProjectPasswordStatusTextBlock"
                                   Text=""
                                   FontSize="11"
                                   Foreground="#9CA3AF"
                                   Margin="0,0,0,2"/>
                    </StackPanel>

                    <!-- ACTIONS -->
                    <Border Background="#F9FAFB"
                            BorderBrush="#6B7280"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="10"
                            Margin="0,2,0,0">
                        <StackPanel>
                            <TextBlock Text="Actions"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       Margin="0,0,0,10"/>

                            <WrapPanel HorizontalAlignment="Center">
                                <Button Content="Désactiver"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Click="DisableProject_Click"
                                        Margin="0,0,8,8"/>

                                <Button Content="Réactiver"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="EnableProject_Click"
                                        BorderBrush="#16A34A"
                                        Foreground="#16A34A"
                                        Margin="0,0,8,8"/>

                                <Button Content="Supprimer"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Click="DeleteProject_Click"
                                        Background="#DC2626"
                                        Foreground="White"
                                        BorderBrush="#DC2626"
                                        Margin="0,0,8,8"/>

                                <!-- ✅ "Modifier" retiré d'ici (18.08.2026, demande de Joe) : remplacé par
                                     la colonne "Modifier" de la grille (voir ProjectsGrid). -->
                                <Button Content="Enregistrer"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="SaveProject_Click"
                                        Margin="0,0,8,8"/>

                                <!-- ✅ "Fermer" (18.08.2026, demande de Joe) : ramène sur "Démarrage"
                                     avec le sous-menu Paramètres réaffiché (voir CloseRequested),
                                     seul le bouton "Fermer" du haut du formulaire était obsolète. -->
                                <Button Content="Fermer"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="Close_Click"
                                        BorderThickness="2"
                                        Margin="0,0,8,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
