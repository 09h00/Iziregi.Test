<!-- File: Pages/AccountingPage.xaml -->
<UserControl x:Class="Iziregi.Test.Pages.AccountingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>

        <!-- ✅ Coins arrondis + bordure noire (31.07.2026, demande de Joe). Un premier essai
             (même jour) avait semblé casser la fiabilité de la sélection ("données qui
             clignotaient") ; après coup, le vrai coupable identifié était un changement de
             largeur de colonne (Auto) ailleurs sur la page, pas ce template. Il manquait
             cependant Popup.StaysOpen="False" (toujours présent dans le template natif d'un
             ComboBox, oubli du premier essai), ajouté ici. -->
        <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#6B7280"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <!-- ✅ StaysOpen="False", absent du 1er essai, toujours présent dans le
                                 template natif WPF : sans lui, le popup ne se ferme pas tout seul au
                                 clic ailleurs/sur un item, ce qui peut désynchroniser IsDropDownOpen
                                 de l'état réel du popup. -->
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="White"
                                        BorderBrush="Black"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="300"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ Bordure bleue arrondie + police bleue (23.07.2026, demande de Joe). -->
        <Style x:Key="CategoryChartToggleButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1D4ED8"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <!-- ✅ 29.07.2026 (demande de Joe) : bordure plus épaisse au survol. -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ 29.07.2026 (demande de Joe) : bouton "Rafraîchir" sans couleur de fond, texte
             noir, coins arrondis. -->
        <Style x:Key="RefreshButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <!-- =========================
             EN-TÊTE + BOUTONS (VISIBLE SUR LA PAGE, FIXE EN HAUT)
             ========================= -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">

            <!-- ✅ "Rafraîchir"/"Masquer graphique catégories"/"Générer PDF" poussés à droite de
                 la page (demande de Joe) : Grid 2 colonnes (Auto + *), groupe de gauche (titre +
                 2 boutons Export CSV) en colonne 0, groupe de droite dans une StackPanel alignée
                 à droite de la colonne 1. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Comptabilité"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <Button Content="Exporter CSV (détail)"
                            Width="190"
                            Margin="16,0,0,0"
                            Background="#D1D5DB"
                            Style="{StaticResource RefreshButtonStyle}"
                            Click="ExportDetailsCsv_Click"/>

                    <Button Content="Exporter CSV (totaux intervenants)"
                            Width="260"
                            Margin="8,0,0,0"
                            Background="#D1D5DB"
                            Style="{StaticResource RefreshButtonStyle}"
                            Click="ExportCompaniesCsv_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Rafraîchir"
                            Width="120"
                            Style="{StaticResource RefreshButtonStyle}"
                            Click="Refresh_Click"/>

                    <!-- ✅ Afficher/Masquer le graphique des catégories (23.07.2026, demande de Joe). -->
                    <Button x:Name="ToggleCategoryChartButton"
                            Content="Masquer graphique catégories"
                            Width="210"
                            Margin="8,0,0,0"
                            Foreground="Black"
                            BorderBrush="Black"
                            Style="{StaticResource CategoryChartToggleButtonStyle}"
                            Click="ToggleCategoryChartButton_Click"/>

                    <Button Content="Générer PDF"
                            Width="150"
                            Margin="8,0,0,0"
                            Style="{StaticResource PdfButtonStyle}"
                            Click="ExportPdf_Click"/>
                </StackPanel>
            </Grid>

        </StackPanel>

        <!-- =========================
             ✅ Le reste de la page (filtres + tableaux) est maintenant dans un
             ScrollViewer : auparavant tout était empilé dans un StackPanel
             Dock="Top" sans aucun défilement, donc tout ce qui dépassait la
             hauteur de la fenêtre était simplement coupé (notamment le tableau
             "Détail" qui peut contenir beaucoup de lignes). Le rendu PDF
             (RenderElementToPng sur AccountingPrintArea) n'est pas affecté par
             ce ScrollViewer car il remesure/arrange l'élément en taille infinie
             avant de le capturer.
             ========================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <!-- =========================
                 ZONE IMPRIMABLE (PDF) : FILTRES + CONTENU
                 ✅ Le titre est seulement dans l'en-tête (plus de doublon)
                 ========================= -->
            <Border x:Name="AccountingPrintArea"
                    BorderThickness="0"
                    Background="Transparent"
                    Margin="0,10,0,0">

                <StackPanel>

                    <!-- ✅ IMPORTANT : PAS DE 2e titre ici -->

                    <!-- Filtres -->
                    <Border x:Name="FiltersCardBorder"
                            BorderBrush="#DDDDDD"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Background="#FAFAFA"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="20"/>

                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="20"/>

                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Du" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <DatePicker x:Name="FromDatePicker" Grid.Column="1"/>

                            <TextBlock Grid.Column="3" Text="Au" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <DatePicker x:Name="ToDatePicker" Grid.Column="4"/>

                            <TextBlock Grid.Column="6" Text="Intervenants" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CompanyFilterComboBox"
                                      Grid.Column="7"
                                      Style="{StaticResource RoundedComboBoxStyle}"
                                      IsEditable="False"
                                      SelectionChanged="Filters_Changed"/>
                        </Grid>
                    </Border>

                    <!-- Body -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <!-- ✅ 31.07.2026 (demande de Joe) : largeur FIXE en pixels (pas "Auto")
                                     pour la colonne gauche, juste assez pour les tableaux (5 colonnes
                                     fixes, ~480px + marges), sans espace vide après TTC. "Auto" avait été
                                     tenté puis annulé (risque de boucle de mesure avec les grilles en
                                     dessous) ; une valeur fixe ne recalcule jamais, donc pas ce risque. -->
                                <ColumnDefinition Width="520"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Colonne gauche : Totaux + Détail -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Totaux -->
                                <Border x:Name="TotalsCardBorder"
                                        Grid.Row="0"
                                        BorderBrush="Black"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12"
                                        Background="White"
                                        Effect="{StaticResource CardShadowEffect}">
                                    <DockPanel>

                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="Totaux par intervenants"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Tri :"
                                                           Margin="0,0,6,0"
                                                           VerticalAlignment="Center"/>
                                                <ComboBox x:Name="ChartSortComboBox"
                                                          Width="190"
                                                          Style="{StaticResource RoundedComboBoxStyle}"
                                                          SelectionChanged="ChartSort_Changed">
                                                    <ComboBoxItem Content="TTC décroissant" IsSelected="True"/>
                                                    <ComboBoxItem Content="TTC croissant"/>
                                                    <ComboBoxItem Content="Alphabétique"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <DataGrid x:Name="ByCompanyGrid"
                                                  Style="{StaticResource IziregiGrid}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  ColumnWidth="Auto"
                                                  CanUserResizeColumns="True"
                                                  HeadersVisibility="Column"
                                                  SelectionChanged="ByCompanyGrid_SelectionChanged"
                                                  GridLinesVisibility="All"
                                                  VerticalGridLinesBrush="#E5E7EB"
                                                  HorizontalGridLinesBrush="#E5E7EB"
                                                  BorderBrush="#D1D5DB"
                                                  BorderThickness="1"
                                                  RowHeight="18"
                                                  ColumnHeaderHeight="18"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto"
                                                  FrozenColumnCount="2">

                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>

                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="Background" Value="#FAFAFA"/>
                                                            <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                                            <Setter Property="BorderThickness" Value="0,1,0,1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>

                                            <DataGrid.Columns>

                                                <DataGridTemplateColumn Header="Intervenants" Width="145">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border x:Name="CompanyCell"
                                                                    Background="{Binding CompanyBrush}"
                                                                    Padding="6,0"
                                                                    CornerRadius="2">
                                                                <TextBlock x:Name="CompanyText"
                                                                           Text="{Binding Company}"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{Binding CompanyTextBrush}"
                                                                           FontWeight="SemiBold"
                                                                           TextWrapping="Wrap"/>
                                                            </Border>

                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                                    <Setter TargetName="CompanyCell" Property="Background" Value="Transparent"/>
                                                                    <Setter TargetName="CompanyText" Property="Foreground" Value="Black"/>
                                                                    <Setter TargetName="CompanyText" Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTextColumn Header="Nb" Binding="{Binding Count}" Width="65">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextAlignment" Value="Center"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Header="HT" Binding="{Binding TotalHt, StringFormat={}{0:0.00}}" Width="80">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextAlignment" Value="Right"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Header="TVA" Binding="{Binding TotalTva, StringFormat={}{0:0.00}}" Width="80">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextAlignment" Value="Right"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Header="TTC" Binding="{Binding TotalTtc, StringFormat={}{0:0.00}}" Width="110" MinWidth="110">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextAlignment" Value="Right"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="Padding" Value="0,0,2,0"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                            </DataGrid.Columns>
                                        </DataGrid>

                                    </DockPanel>
                                </Border>

                                <!-- Détail -->
                                <Border x:Name="DetailsCardBorder"
                                        Grid.Row="2"
                                        BorderBrush="Black"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12"
                                        Background="White"
                                        Effect="{StaticResource CardShadowEffect}">
                                    <DockPanel>

                                        <Border x:Name="DetailsTitleBorder"
                                                DockPanel.Dock="Top"
                                                Background="Transparent"
                                                CornerRadius="4"
                                                Padding="8,4"
                                                Margin="0,0,0,10">
                                            <TextBlock x:Name="DetailsTitleTextBlock"
                                                       Text="Détail — sélectionnez un intervenant"
                                                       FontWeight="Bold"/>
                                        </Border>

                                        <DataGrid x:Name="DetailsGrid"
                                                  Style="{StaticResource IziregiGrid}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  ColumnWidth="Auto"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="All"
                                                  VerticalGridLinesBrush="#E5E7EB"
                                                  HorizontalGridLinesBrush="#E5E7EB"
                                                  BorderBrush="#D1D5DB"
                                                  BorderThickness="1"
                                                  RowHeight="18"
                                                  ColumnHeaderHeight="18"
                                                  SelectionChanged="DetailsGrid_SelectionChanged"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto"
                                                  FrozenColumnCount="2">

                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>

                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="Background" Value="#FAFAFA"/>
                                                            <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                                            <Setter Property="BorderThickness" Value="0,2,0,2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>

                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="BDR" Binding="{Binding Bdr}" Width="145"/>
                                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="65"/>

                                                <DataGridTextColumn Header="HT" Binding="{Binding Ht, StringFormat={}{0:0.00}}" Width="80">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextAlignment" Value="Right"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Header="TVA" Binding="{Binding Tva, StringFormat={}{0:0.00}}" Width="80">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextAlignment" Value="Right"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Header="TTC" Binding="{Binding Ttc, StringFormat={}{0:0.00}}" Width="110" MinWidth="110">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextAlignment" Value="Right"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="Padding" Value="0,0,2,0"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>

                                        </DataGrid>
                                    </DockPanel>
                                </Border>

                            </Grid>

                            <!-- Graphiques : entreprise + catégorie, empilés, même largeur/hauteur
                                 (demande de Joe, 17.07.2026 : "même grandeur", "placé sous l'autre"). -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                            <Border x:Name="ChartCardBorder"
                                    Grid.Row="0"
                                    BorderBrush="Black"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Background="White"
                                    Effect="{StaticResource CardShadowEffect}">
                                <DockPanel>

                                    <TextBlock x:Name="ChartTitleTextBlock"
                                               DockPanel.Dock="Top"
                                               Text="Graphique-TTC par intervenants"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6"/>

                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Total"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock x:Name="ChartTotalTtcTextBlock"
                                                   Grid.Column="1"
                                                   Text="0.00"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <Border DockPanel.Dock="Top"
                                            BorderBrush="#D1D5DB"
                                            BorderThickness="0,0,0,1"
                                            Margin="0,4,0,20"/>

                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ChartItems">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="4"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="70"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Company}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   VerticalAlignment="Center"/>

                                                        <Border Grid.Column="2"
                                                                Height="16"
                                                                CornerRadius="3"
                                                                Background="#FFFFFF">
                                                            <Border Width="{Binding BarWidth}"
                                                                    Height="16"
                                                                    CornerRadius="2"
                                                                    Background="{Binding BarBrush}"
                                                                    BorderBrush="#D1D5DB"
                                                                    BorderThickness="1"
                                                                    HorizontalAlignment="Left"/>
                                                        </Border>

                                                        <TextBlock Grid.Column="3"
                                                                   Width="70"
                                                                   Margin="6,0,0,4"
                                                                   TextAlignment="Right"
                                                                   Text="{Binding TotalTtc, StringFormat={}{0:0.00}}"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                </DockPanel>
                            </Border>

                            <!-- ✅ Tâches par catégorie (demande de Joe, 17.07.2026) : indépendant des
                                 filtres date/entreprise ci-dessus (ceux-ci portent sur les bons de
                                 régie ; la catégorie est un champ du tableau des Tâches de la page
                                 Planning, sans notion de date) — reflète le projet courant dans son
                                 intégralité. -->
                            <Border x:Name="CategoryChartBorder"
                                    Grid.Row="2"
                                    BorderBrush="Black"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Background="White"
                                    Effect="{StaticResource CardShadowEffect}">
                                <DockPanel>

                                    <TextBlock DockPanel.Dock="Top"
                                               Text="Tâches par catégorie"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6"/>

                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Total tâches"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock x:Name="CategoryChartTotalTextBlock"
                                                   Grid.Column="1"
                                                   Text="0"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <Border DockPanel.Dock="Top"
                                            BorderBrush="#D1D5DB"
                                            BorderThickness="0,0,0,1"
                                            Margin="0,4,0,20"/>

                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="CategoryChartItems">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="4"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="70"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Category}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   VerticalAlignment="Center"/>

                                                        <Border Grid.Column="2"
                                                                Height="16"
                                                                CornerRadius="3"
                                                                Background="#FFFFFF">
                                                            <Border Width="{Binding BarWidth}"
                                                                    Height="16"
                                                                    CornerRadius="2"
                                                                    Background="{Binding BarBrush}"
                                                                    BorderBrush="#D1D5DB"
                                                                    BorderThickness="1"
                                                                    HorizontalAlignment="Left"/>
                                                        </Border>

                                                        <TextBlock Grid.Column="3"
                                                                   Width="70"
                                                                   Margin="6,0,0,4"
                                                                   TextAlignment="Right"
                                                                   Text="{Binding Count}"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                </DockPanel>
                            </Border>

                            </Grid>

                        </Grid>
                    </Grid>

                </StackPanel>
            </Border>

        </ScrollViewer>

    </DockPanel>
</UserControl>