<!-- File: Pages/SettingsPage.xaml -->
<UserControl x:Class="Iziregi.Test.Pages.SettingsPage"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 d:DesignHeight="720"
			 d:DesignWidth="1100"
			 Background="#F6F7FB">

	<!-- ✅ 01.08.2026 (demande de Joe) : "Paramètres" devient un point d'entrée unique avec un
		 sous-menu (Identité société / Banque de dossiers / Connexion / Démarrage / Vos données /
		 Éthique et confidentialité), au lieu d'un bouton "Identité Société" séparé dans la barre
		 de nav et d'une fenêtre modale (ConfigSetupWindow) pour le reste. ConfigSetupWindow n'est
		 PAS supprimée : elle reste utilisée telle quelle pour la configuration initiale
		 obligatoire au 1er lancement (voir MainWindow.xaml.cs, ligne ~156), cette page reprend
		 seulement le même contenu pour un accès courant, une fois l'app déjà configurée. -->

	<UserControl.Resources>
		<Style x:Key="CardStyle" TargetType="Border">
			<Setter Property="Background" Value="White"/>
			<Setter Property="BorderBrush" Value="#E2E8F0"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Padding" Value="20"/>
			<Setter Property="Effect" Value="{StaticResource CardShadowEffect}"/>
		</Style>

		<!-- ✅ Même police que le titre "Identité Société" (demande de Joe, 03.08.2026),
			 pour que tous les titres de section de Paramètres soient cohérents entre eux. -->
		<Style x:Key="SectionTitleStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="20"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="#0F172A"/>
			<Setter Property="Margin" Value="0,0,0,10"/>
		</Style>

		<!-- ✅ Texte de contenu agrandi (demande de Joe : "c'est le texte dans les fenêtres que
			 je veux agrandir", pas les titres). -->
		<Style x:Key="DescStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="Foreground" Value="#64748B"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="Margin" Value="0,0,0,14"/>
		</Style>

		<Style x:Key="LabelStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="Foreground" Value="#6B7280"/>
			<Setter Property="Margin" Value="0,0,0,4"/>
		</Style>

		<!-- ✅ ComboBox "Démarrage" en rectangle arrondi (demande de Joe), même technique que
			 RoundedComboBoxStyle (AccountingPage) : Popup.StaysOpen="False" indispensable. -->
		<Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
			<Setter Property="Height" Value="38"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="Padding" Value="10,0"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="BorderBrush" Value="#D1D5DB"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ComboBox">
						<Grid>
							<ToggleButton x:Name="ToggleButton"
							              Focusable="False"
							              ClickMode="Press"
							              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
							              Background="{TemplateBinding Background}"
							              BorderBrush="{TemplateBinding BorderBrush}"
							              BorderThickness="{TemplateBinding BorderThickness}">
								<ToggleButton.Template>
									<ControlTemplate TargetType="ToggleButton">
										<Border Background="{TemplateBinding Background}"
										        BorderBrush="{TemplateBinding BorderBrush}"
										        BorderThickness="{TemplateBinding BorderThickness}"
										        CornerRadius="8"
										        SnapsToDevicePixels="True">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="24"/>
												</Grid.ColumnDefinitions>
												<Path Grid.Column="1"
												      Data="M 0 0 L 4 4 L 8 0 Z"
												      Fill="#6B7280"
												      HorizontalAlignment="Center"
												      VerticalAlignment="Center"/>
											</Grid>
										</Border>
									</ControlTemplate>
								</ToggleButton.Template>
							</ToggleButton>

							<ContentPresenter x:Name="ContentSite"
							                  IsHitTestVisible="False"
							                  Content="{TemplateBinding SelectionBoxItem}"
							                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
							                  Margin="{TemplateBinding Padding}"
							                  VerticalAlignment="Center"
							                  HorizontalAlignment="Left"/>

							<Popup x:Name="Popup"
							       Placement="Bottom"
							       IsOpen="{TemplateBinding IsDropDownOpen}"
							       StaysOpen="False"
							       AllowsTransparency="True"
							       Focusable="False"
							       PopupAnimation="Slide">
								<Border Background="White"
								        BorderBrush="#D1D5DB"
								        BorderThickness="1"
								        CornerRadius="8"
								        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
								        MaxHeight="300"
								        SnapsToDevicePixels="True">
									<ScrollViewer SnapsToDevicePixels="True">
										<ItemsPresenter/>
									</ScrollViewer>
								</Border>
							</Popup>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="InputStyle" TargetType="TextBox">
			<Setter Property="Height" Value="32"/>
			<Setter Property="Padding" Value="8,4"/>
			<Setter Property="BorderBrush" Value="#D1D5DB"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0,0,0,12"/>
		</Style>

		<!-- ✅ Bouton principal (coins arrondis + bordure qui s'épaissit au survol), même
			 convention que le reste de l'app (ArchitectIdentityPage, Comptabilité). -->
		<Style x:Key="PrimaryButtonStyle" TargetType="Button">
			<Setter Property="Height" Value="38"/>
			<Setter Property="Padding" Value="14,0"/>
			<Setter Property="Background" Value="#2563EB"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderBrush" Value="#2563EB"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd"
						        Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}"
						        BorderThickness="{TemplateBinding BorderThickness}"
						        CornerRadius="8">
							<ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
			<Setter Property="Background" Value="White"/>
			<Setter Property="Foreground" Value="#0F172A"/>
			<Setter Property="BorderBrush" Value="#D1D5DB"/>
		</Style>

		<!-- Sous-menu vertical (colonne de gauche) -->
		<Style x:Key="SubNavButtonStyle" TargetType="Button">
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Padding" Value="12,9"/>
			<Setter Property="Margin" Value="0,0,0,4"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#334155"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
							<ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- ✅ Fix (demande de Joe : "le champ devient blanc si je garde la souris dessus") : ce
			 style héritait du Template de SubNavButtonStyle, dont le déclencheur IsMouseOver
			 peint TOUJOURS le fond en gris clair (#EEF2F7), quel que soit le Background défini
			 ici, sur le bouton actif (fond bleu, texte blanc), ça rendait le texte quasi
			 invisible au survol. Template propre avec une couleur de survol adaptée. -->
		<Style x:Key="SubNavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource SubNavButtonStyle}">
			<Setter Property="Background" Value="#2563EB"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
							<ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="#1E40AF"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<!-- ✅ ScrollViewer (demande de Joe : "on ne voit pas les boutons pour enregistrer le
		 logo") : la page "Identité société" embarquée n'a pas été conçue pour partager la
		 hauteur avec le titre "Paramètres" au-dessus, son bas (dont les boutons du logo)
		 pouvait être rogné hors de la fenêtre sans moyen d'y accéder. Même correctif que
		 OverviewPage. -->
	<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
	<Grid Margin="18,16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0"
		           Text="Paramètres"
		           FontSize="18"
		           FontWeight="SemiBold"
		           Foreground="#0F172A"
		           Margin="0,0,0,14"/>

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="200"/>
				<ColumnDefinition Width="20"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- Sous-menu (01.08.2026, demande de Joe : ordre 1.Identité société 2.Banque de
				 dossiers 3.Démarrage 4.Vos données 5.Connexion 6.Éthique et confidentialité
				 7.CGU). -->
			<StackPanel Grid.Column="0">
				<Button x:Name="NavIdentityButton" Content="Identité société" Tag="Identity" Click="SubNav_Click" Style="{StaticResource SubNavButtonActiveStyle}"/>
				<Button x:Name="NavProjectsButton" Content="Banque de dossiers" Tag="Projects" Click="SubNav_Click" Style="{StaticResource SubNavButtonStyle}"/>
				<Button x:Name="NavStartupButton" Content="Démarrage" Tag="Startup" Click="SubNav_Click" Style="{StaticResource SubNavButtonStyle}"/>
				<Button x:Name="NavDataButton" Content="Vos données" Tag="Data" Click="SubNav_Click" Style="{StaticResource SubNavButtonStyle}"/>
				<Button x:Name="NavConnectionButton" Content="Connexion" Tag="Connection" Click="SubNav_Click" Style="{StaticResource SubNavButtonStyle}"/>
				<Button x:Name="NavEthicsButton" Content="Éthique et confidentialité" Tag="Ethics" Click="SubNav_Click" Style="{StaticResource SubNavButtonStyle}"/>
				<Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="4,8,4,8"/>
				<!-- ✅ Lien externe (ouvre le navigateur), même principe qu'Aide/Contact ailleurs
					 dans l'app, ne change pas la section affichée. -->
				<Button x:Name="NavCguLinkButton" Content="CGU" Tag="Cgu" Click="SubNav_Click" Style="{StaticResource SubNavButtonStyle}"/>
			</StackPanel>

			<!-- Contenu -->
			<Grid Grid.Column="2">
				<ContentControl x:Name="IdentityHost" Visibility="Visible" VerticalAlignment="Top"/>

				<Border x:Name="ProjectsPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed" VerticalAlignment="Top">
					<StackPanel>
						<TextBlock Text="Banque de dossiers" Style="{StaticResource SectionTitleStyle}"/>
						<TextBlock Text="Gère la liste de tes dossiers (création, suppression, tags projet)." Style="{StaticResource DescStyle}"/>
						<Button Content="Ouvrir la banque de dossiers…" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Click="OpenProjectsBank_Click"/>
					</StackPanel>
				</Border>

				<Border x:Name="ConnectionPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed" VerticalAlignment="Top">
					<StackPanel MaxWidth="420" HorizontalAlignment="Left">
						<TextBlock Text="Connexion au serveur Iziregi" Style="{StaticResource SectionTitleStyle}"/>

						<TextBlock Text="URL du serveur" Style="{StaticResource LabelStyle}"/>
						<TextBox x:Name="ServerUrlTextBox" Style="{StaticResource InputStyle}"/>

						<TextBlock Text="Clé d'accès" Style="{StaticResource LabelStyle}"/>
						<TextBox x:Name="ServerKeyTextBox" Style="{StaticResource InputStyle}"/>

						<TextBlock Text="La clé d'accès vous est fournie par votre administrateur Iziregi." Style="{StaticResource DescStyle}"/>

						<StackPanel Orientation="Horizontal">
							<Button Content="Tester" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="TestConnection_Click"/>
							<Button Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}" Click="SaveConnection_Click"/>
						</StackPanel>

						<TextBlock x:Name="ConnectionStatusText" Margin="0,10,0,0" FontSize="15" TextWrapping="Wrap" Visibility="Collapsed"/>
					</StackPanel>
				</Border>

				<Border x:Name="StartupPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed" VerticalAlignment="Top">
					<StackPanel MaxWidth="420" HorizontalAlignment="Left">
						<TextBlock Text="Page d'ouverture au démarrage" Style="{StaticResource SectionTitleStyle}"/>
						<TextBlock x:Name="StartupDescText" Style="{StaticResource DescStyle}"/>
						<TextBlock Text="Ouvrir automatiquement :" Style="{StaticResource LabelStyle}"/>
						<ComboBox x:Name="StartupPageComboBox" Width="280" Style="{StaticResource RoundedComboBoxStyle}" HorizontalAlignment="Left" SelectionChanged="StartupPageComboBox_SelectionChanged"/>
					</StackPanel>
				</Border>

				<Border x:Name="DataPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed" VerticalAlignment="Top">
					<StackPanel MaxWidth="420" HorizontalAlignment="Left">
						<TextBlock Text="Vos données" Style="{StaticResource SectionTitleStyle}"/>
						<TextBlock Text="Exportez l'intégralité de vos données (projets, bons, listes, comptabilité) dans des fichiers CSV, lisibles avec Excel ou tout tableur, même sans Iziregi." Style="{StaticResource DescStyle}"/>
						<Button Content="Exporter toutes mes données…" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Click="ExportAllData_Click"/>
					</StackPanel>
				</Border>

				<Border x:Name="EthicsPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed" VerticalAlignment="Top">
					<StackPanel MaxWidth="520" HorizontalAlignment="Left">
						<TextBlock Text="Vos données, en toute confiance" Style="{StaticResource SectionTitleStyle}"/>
						<TextBlock Style="{StaticResource DescStyle}" FontSize="15" TextWrapping="Wrap" Foreground="#0F172A">
							Iziregi est hébergé exclusivement en Suisse, chez Infomaniak — hébergeur suisse indépendant (fondé à Genève en 1994), certifié ISO 27001 (sécurité de l'information) et labellisé Swiss Hosting / Swiss Made Software. Vos données ne quittent jamais le territoire suisse.
						</TextBlock>

						<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
							<TextBlock Text="✓" FontSize="13" FontWeight="Bold" Foreground="#10B981" Margin="0,0,8,0" VerticalAlignment="Top"/>
							<TextBlock Text="Hébergement 100% souverain, sur des serveurs suisses gérés par un hébergeur suisse certifié" FontSize="15" TextWrapping="Wrap" MaxWidth="460"/>
						</StackPanel>
						<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
							<TextBlock Text="✓" FontSize="13" FontWeight="Bold" Foreground="#10B981" Margin="0,0,8,0" VerticalAlignment="Top"/>
							<TextBlock Text="Aucune donnée n'est partagée, revendue ou exploitée à des fins commerciales ou publicitaires" FontSize="15" TextWrapping="Wrap" MaxWidth="460"/>
						</StackPanel>
						<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
							<TextBlock Text="✓" FontSize="13" FontWeight="Bold" Foreground="#10B981" Margin="0,0,8,0" VerticalAlignment="Top"/>
							<TextBlock Text="Vous pouvez à tout moment exporter l'intégralité de vos données dans un format ouvert (Excel, tableur), sans dépendre d'Iziregi pour les consulter" FontSize="15" TextWrapping="Wrap" MaxWidth="460"/>
						</StackPanel>
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="✓" FontSize="13" FontWeight="Bold" Foreground="#10B981" Margin="0,0,8,0" VerticalAlignment="Top"/>
							<TextBlock Text="Conforme à la législation suisse sur la protection des données (nLPD)" FontSize="15" TextWrapping="Wrap" MaxWidth="460"/>
						</StackPanel>
					</StackPanel>
				</Border>
			</Grid>
		</Grid>
	</Grid>
	</ScrollViewer>
</UserControl>
