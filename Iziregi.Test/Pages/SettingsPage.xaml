<!-- File: Pages/SettingsPage.xaml -->
<UserControl x:Class="Iziregi.Test.Pages.SettingsPage"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 d:DesignHeight="720"
			 d:DesignWidth="1100"
			 Background="{StaticResource PageBackgroundBrush}">

	<!-- ✅ 01.08.2026 (demande de Joe) : "Paramètres" devient un point d'entrée unique avec un
		 sous-menu (Identité société / Banque de dossiers / Connexion / Démarrage / Vos données /
		 Éthique et confidentialité), au lieu d'un bouton "Identité Société" séparé dans la barre
		 de nav et d'une fenêtre modale (ConfigSetupWindow) pour le reste. ConfigSetupWindow n'est
		 PAS supprimée : elle reste utilisée telle quelle pour la configuration initiale
		 obligatoire au 1er lancement (voir MainWindow.xaml.cs, ligne ~156), cette page reprend
		 seulement le même contenu pour un accès courant, une fois l'app déjà configurée. -->

	<UserControl.Resources>
		<Style x:Key="CardStyle" TargetType="Border">
			<Setter Property="Background" Value="White"/>
			<Setter Property="BorderBrush" Value="#E2E8F0"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="14"/>
			<Setter Property="Padding" Value="20"/>
			<Setter Property="Effect" Value="{StaticResource CardShadowEffect}"/>
		</Style>

		<!-- ✅ Même police que le titre "Identité Société" (demande de Joe, 03.08.2026),
			 pour que tous les titres de section de Paramètres soient cohérents entre eux. -->
		<Style x:Key="SectionTitleStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="20"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="#0F172A"/>
			<Setter Property="Margin" Value="0,0,0,10"/>
		</Style>

		<!-- ✅ Texte de contenu agrandi (demande de Joe : "c'est le texte dans les fenêtres que
			 je veux agrandir", pas les titres). -->
		<Style x:Key="DescStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="Foreground" Value="#64748B"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="Margin" Value="0,0,0,14"/>
		</Style>

		<Style x:Key="LabelStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="Foreground" Value="#6B7280"/>
			<Setter Property="Margin" Value="0,0,0,4"/>
		</Style>

		<!-- ✅ ComboBox "Démarrage" en rectangle arrondi (demande de Joe), même technique que
			 RoundedComboBoxStyle (AccountingPage) : Popup.StaysOpen="False" indispensable. -->
		<Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
			<Setter Property="Height" Value="38"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="Padding" Value="10,0"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="BorderBrush" Value="#D1D5DB"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ComboBox">
						<Grid>
							<ToggleButton x:Name="ToggleButton"
							              Focusable="False"
							              ClickMode="Press"
							              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
							              Background="{TemplateBinding Background}"
							              BorderBrush="{TemplateBinding BorderBrush}"
							              BorderThickness="{TemplateBinding BorderThickness}">
								<ToggleButton.Template>
									<ControlTemplate TargetType="ToggleButton">
										<Border Background="{TemplateBinding Background}"
										        BorderBrush="{TemplateBinding BorderBrush}"
										        BorderThickness="{TemplateBinding BorderThickness}"
										        CornerRadius="6"
										        SnapsToDevicePixels="True">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="24"/>
												</Grid.ColumnDefinitions>
												<Path Grid.Column="1"
												      Data="M 0 0 L 4 4 L 8 0 Z"
												      Fill="#6B7280"
												      HorizontalAlignment="Center"
												      VerticalAlignment="Center"/>
											</Grid>
										</Border>
									</ControlTemplate>
								</ToggleButton.Template>
							</ToggleButton>

							<ContentPresenter x:Name="ContentSite"
							                  IsHitTestVisible="False"
							                  Content="{TemplateBinding SelectionBoxItem}"
							                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
							                  Margin="{TemplateBinding Padding}"
							                  VerticalAlignment="Center"
							                  HorizontalAlignment="Left"/>

							<Popup x:Name="Popup"
							       Placement="Bottom"
							       IsOpen="{TemplateBinding IsDropDownOpen}"
							       StaysOpen="False"
							       AllowsTransparency="True"
							       Focusable="False"
							       PopupAnimation="Slide">
								<Border Background="White"
								        BorderBrush="#D1D5DB"
								        BorderThickness="1"
								        CornerRadius="6"
								        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
								        MaxHeight="300"
								        SnapsToDevicePixels="True">
									<ScrollViewer SnapsToDevicePixels="True">
										<ItemsPresenter/>
									</ScrollViewer>
								</Border>
							</Popup>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="InputStyle" TargetType="TextBox">
			<Setter Property="Height" Value="32"/>
			<Setter Property="Padding" Value="8,4"/>
			<Setter Property="BorderBrush" Value="#D1D5DB"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0,0,0,12"/>
		</Style>

		<!-- ✅ Bouton principal (coins arrondis + bordure qui s'épaissit au survol), même
			 convention que le reste de l'app (ArchitectIdentityPage, Comptabilité). -->
		<Style x:Key="PrimaryButtonStyle" TargetType="Button">
			<Setter Property="Height" Value="30"/>
			<Setter Property="Padding" Value="14,0"/>
			<Setter Property="Background" Value="#2563EB"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderBrush" Value="#2563EB"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd"
						        Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}"
						        BorderThickness="{TemplateBinding BorderThickness}"
						        CornerRadius="6">
							<ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
			<Setter Property="Background" Value="White"/>
			<Setter Property="Foreground" Value="#0F172A"/>
			<Setter Property="BorderBrush" Value="#D1D5DB"/>
		</Style>

		<!-- Sous-menu vertical (colonne de gauche) -->
		<Style x:Key="SubNavButtonStyle" TargetType="Button">
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Padding" Value="12,9"/>
			<Setter Property="Margin" Value="0,0,0,4"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#334155"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
							<ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- ✅ Fix (demande de Joe : "le champ devient blanc si je garde la souris dessus") : ce
			 style héritait du Template de SubNavButtonStyle, dont le déclencheur IsMouseOver
			 peint TOUJOURS le fond en gris clair (#EEF2F7), quel que soit le Background défini
			 ici, sur le bouton actif (fond bleu, texte blanc), ça rendait le texte quasi
			 invisible au survol. Template propre avec une couleur de survol adaptée. -->
		<Style x:Key="SubNavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource SubNavButtonStyle}">
			<Setter Property="Background" Value="#2563EB"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
							<ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="#1E40AF"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<!-- ✅ ScrollViewer (demande de Joe : "on ne voit pas les boutons pour enregistrer le
		 logo") : la page "Identité société" embarquée n'a pas été conçue pour partager la
		 hauteur avec le titre "Paramètres" au-dessus, son bas (dont les boutons du logo)
		 pouvait être rogné hors de la fenêtre sans moyen d'y accéder. Même correctif que
		 OverviewPage. -->
	<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
	<Grid Margin="18,16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- ✅ Masqué sur "Banque de dossiers" (18.08.2026, demande de Joe) : la page a déjà son
			 propre titre ("Banque de dossiers"), celui-ci est redondant une fois le sous-menu
			 caché et la page en pleine largeur, voir SettingsPage.ShowSection. -->
		<TextBlock x:Name="PageTitleTextBlock"
		           Grid.Row="0"
		           Text="Paramètres"
		           FontSize="18"
		           FontWeight="SemiBold"
		           Foreground="#0F172A"
		           Margin="0,0,0,14"/>

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<!-- ✅ x:Name (18.08.2026, demande de Joe) : sous-menu masqué (largeur à 0) sur
					 l'onglet "Banque de dossiers", qui a besoin de toute la largeur pour sa liste
					 de dossiers, voir ShowSection. -->
				<ColumnDefinition x:Name="SubNavColumn" Width="200"/>
				<ColumnDefinition x:Name="SubNavSpacerColumn" Width="20"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- ✅ Sous-menu restructuré (18.08.2026, demande de Joe) : "Identité société"/"Vos
				 données"/"Connexion" fusionnées dans une page "Admin" unique, protégée par un
				 mot de passe Admin distinct du mot de passe Directeur (celui-ci reste délégable
				 aux employés sans donner accès à Admin, voir ShowSection/EnterAdminSection).
				 "Banque de dossiers"/"Démarrage"/"Éthique" restent accessibles à tous. Ordre
				 (18.08.2026, demande de Joe) : Démarrage, Banque de dossiers, Admin, Éthique, CGU. -->
			<StackPanel Grid.Column="0">
				<Button x:Name="NavStartupButton" Content="Démarrage" Tag="Startup" Click="SubNav_Click" Style="{StaticResource SubNavButtonStyle}"/>
				<Button x:Name="NavProjectsButton" Content="Banque de dossiers" Tag="Projects" Click="SubNav_Click" Style="{StaticResource SubNavButtonActiveStyle}"/>
				<Button x:Name="NavAdminButton" Content="Admin" Tag="Admin" Click="SubNav_Click" Style="{StaticResource SubNavButtonStyle}"/>
				<Button x:Name="NavEthicsButton" Content="Éthique et confidentialité" Tag="Ethics" Click="SubNav_Click" Style="{StaticResource SubNavButtonStyle}"/>
				<Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="4,8,4,8"/>
				<!-- ✅ Lien externe (ouvre le navigateur), même principe qu'Aide/Contact ailleurs
					 dans l'app, ne change pas la section affichée. -->
				<Button x:Name="NavCguLinkButton" Content="CGU" Tag="Cgu" Click="SubNav_Click" Style="{StaticResource SubNavButtonStyle}"/>
			</StackPanel>

			<!-- Contenu -->
			<Grid Grid.Column="2">
				<!-- ✅ Page "Admin" (18.08.2026, demande de Joe) : regroupe Identité société / Mot
					 de passe Directeur / Mot de passe Admin / Vos données / Connexion, protégée
					 par le mot de passe Admin (voir EnterAdminSection). -->
				<StackPanel x:Name="AdminPanel" Visibility="Collapsed" VerticalAlignment="Top">
					<ContentControl x:Name="IdentityHost" VerticalAlignment="Top"/>

					<Border Style="{StaticResource CardStyle}" Margin="0,18,0,0" VerticalAlignment="Top">
						<StackPanel MaxWidth="420" HorizontalAlignment="Left">
							<!-- ✅ Mot de passe "Directeur" (18.08.2026, demande de Joe) : déverrouille
								 n'importe quel dossier protégé par mot de passe, en plus du mot de
								 passe propre à chaque dossier (voir ProjectsWindow). Délégable (ex: à
								 un remplaçant pendant les vacances du directeur) SANS donner accès à
								 cette page Admin, voir mot de passe Admin plus bas, volontairement
								 distinct. -->
							<TextBlock Text="Mot de passe Directeur (accès aux dossiers)" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,4"/>
							<TextBlock Text="Déverrouille n'importe quel dossier verrouillé, quel que soit son propre mot de passe. Peut être transmis à un remplaçant sans lui donner accès à cette page Admin. Laisser vide à l'enregistrement = ne rien changer." Style="{StaticResource DescStyle}"/>

							<TextBlock Text="Nouveau mot de passe" Style="{StaticResource LabelStyle}"/>
							<PasswordBox x:Name="DirectorPasswordBox" Height="32" Padding="8,4" BorderBrush="#D1D5DB" BorderThickness="1" Background="White" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

							<StackPanel Orientation="Horizontal">
								<Button Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="SaveDirectorPassword_Click"/>
								<Button Content="Retirer" Style="{StaticResource SecondaryButtonStyle}" Click="RemoveDirectorPassword_Click"/>
							</StackPanel>

							<TextBlock x:Name="DirectorPasswordStatusTextBlock" Text="" FontSize="11" Foreground="#9CA3AF" Margin="0,8,0,0"/>

							<!-- ✅ Reset par email (18.08.2026, demande de Joe) : envoie un code à usage
								 unique à l'email de contact du bureau (enregistré côté admin serveur),
								 permet de redéfinir le mot de passe Directeur sans intervention manuelle. -->
							<Button Content="Mot de passe Directeur oublié ?"
							        Style="{StaticResource SecondaryButtonStyle}"
							        HorizontalAlignment="Left"
							        Margin="0,10,0,0"
							        Click="ForgotDirectorPassword_Click"/>

							<Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,18,0,16"/>

							<!-- ✅ Mot de passe "Admin" (18.08.2026, demande de Joe) : protège l'accès à
								 CETTE page (Identité société/Mot de passe Directeur/Vos données/
								 Connexion), réservé au directeur/acheteur de l'app, volontairement
								 distinct du mot de passe Directeur ci-dessus, jamais délégué. -->
							<TextBlock Text="Mot de passe Admin (accès à cette page)" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,4"/>
							<TextBlock Text="Protège l'accès à cette page Admin. Réservé au directeur -- ne pas transmettre, contrairement au mot de passe Directeur ci-dessus. Laisser vide à l'enregistrement = ne rien changer." Style="{StaticResource DescStyle}"/>

							<TextBlock Text="Nouveau mot de passe" Style="{StaticResource LabelStyle}"/>
							<PasswordBox x:Name="AdminPasswordBox" Height="32" Padding="8,4" BorderBrush="#D1D5DB" BorderThickness="1" Background="White" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

							<StackPanel Orientation="Horizontal">
								<Button Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="SaveAdminPassword_Click"/>
								<Button Content="Retirer" Style="{StaticResource SecondaryButtonStyle}" Click="RemoveAdminPassword_Click"/>
							</StackPanel>

							<TextBlock x:Name="AdminPasswordStatusTextBlock" Text="" FontSize="11" Foreground="#9CA3AF" Margin="0,8,0,0"/>

							<Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,18,0,16"/>

							<TextBlock Text="Vos données" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,4"/>
							<TextBlock Text="Exportez l'intégralité de vos données (projets, bons, listes, comptabilité) dans des fichiers CSV, lisibles avec Excel ou tout tableur, même sans Iziregi." Style="{StaticResource DescStyle}"/>
							<Button Content="Exporter toutes mes données…" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Click="ExportAllData_Click"/>

							<Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,18,0,16"/>

							<TextBlock Text="Connexion au serveur Iziregi" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,4"/>

							<TextBlock Text="URL du serveur" Style="{StaticResource LabelStyle}"/>
							<TextBox x:Name="ServerUrlTextBox" Style="{StaticResource InputStyle}"/>

							<TextBlock Text="Clé d'accès" Style="{StaticResource LabelStyle}"/>
							<TextBox x:Name="ServerKeyTextBox" Style="{StaticResource InputStyle}"/>

							<TextBlock Text="La clé d'accès vous est fournie par votre administrateur Iziregi." Style="{StaticResource DescStyle}"/>

							<StackPanel Orientation="Horizontal">
								<Button Content="Tester" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="TestConnection_Click"/>
								<Button Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}" Click="SaveConnection_Click"/>
							</StackPanel>

							<TextBlock x:Name="ConnectionStatusText" Margin="0,10,0,0" FontSize="15" TextWrapping="Wrap" Visibility="Collapsed"/>
						</StackPanel>
					</Border>
				</StackPanel>

				<!-- ✅ Page embarquée directement (18.08.2026, demande de Joe) : la fenêtre séparée
					 "Banque de dossiers" (ProjectsWindow) est obsolète, remplacée par
					 ProjectsBankPage affichée ici, même principe que "Admin"/IdentityHost. -->
				<ContentControl x:Name="ProjectsHost" Visibility="Collapsed" VerticalAlignment="Top"/>

				<Border x:Name="StartupPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed" VerticalAlignment="Top">
					<StackPanel MaxWidth="420" HorizontalAlignment="Left">
						<TextBlock Text="Page d'ouverture au démarrage" Style="{StaticResource SectionTitleStyle}"/>
						<TextBlock x:Name="StartupDescText" Style="{StaticResource DescStyle}"/>
						<TextBlock Text="Ouvrir automatiquement :" Style="{StaticResource LabelStyle}"/>
						<ComboBox x:Name="StartupPageComboBox" Width="280" Style="{StaticResource RoundedComboBoxStyle}" HorizontalAlignment="Left" SelectionChanged="StartupPageComboBox_SelectionChanged"/>
					</StackPanel>
				</Border>

				<Border x:Name="EthicsPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed" VerticalAlignment="Top">
					<StackPanel MaxWidth="520" HorizontalAlignment="Left">
						<TextBlock Text="Vos données, en toute confiance" Style="{StaticResource SectionTitleStyle}"/>
						<TextBlock Style="{StaticResource DescStyle}" FontSize="15" TextWrapping="Wrap" Foreground="#0F172A">
							Iziregi est hébergé exclusivement en Suisse, chez Infomaniak — hébergeur suisse indépendant (fondé à Genève en 1994), certifié ISO 27001 (sécurité de l'information) et labellisé Swiss Hosting / Swiss Made Software. Vos données ne quittent jamais le territoire suisse.
						</TextBlock>

						<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
							<TextBlock Text="✓" FontSize="13" FontWeight="Bold" Foreground="#10B981" Margin="0,0,8,0" VerticalAlignment="Top"/>
							<TextBlock Text="Hébergement 100% souverain, sur des serveurs suisses gérés par un hébergeur suisse certifié" FontSize="15" TextWrapping="Wrap" MaxWidth="460"/>
						</StackPanel>
						<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
							<TextBlock Text="✓" FontSize="13" FontWeight="Bold" Foreground="#10B981" Margin="0,0,8,0" VerticalAlignment="Top"/>
							<TextBlock Text="Aucune donnée n'est partagée, revendue ou exploitée à des fins commerciales ou publicitaires" FontSize="15" TextWrapping="Wrap" MaxWidth="460"/>
						</StackPanel>
						<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
							<TextBlock Text="✓" FontSize="13" FontWeight="Bold" Foreground="#10B981" Margin="0,0,8,0" VerticalAlignment="Top"/>
							<TextBlock Text="Vous pouvez à tout moment exporter l'intégralité de vos données dans un format ouvert (Excel, tableur), sans dépendre d'Iziregi pour les consulter" FontSize="15" TextWrapping="Wrap" MaxWidth="460"/>
						</StackPanel>
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="✓" FontSize="13" FontWeight="Bold" Foreground="#10B981" Margin="0,0,8,0" VerticalAlignment="Top"/>
							<TextBlock Text="Conforme à la législation suisse sur la protection des données (nLPD)" FontSize="15" TextWrapping="Wrap" MaxWidth="460"/>
						</StackPanel>
					</StackPanel>
				</Border>
			</Grid>
		</Grid>
	</Grid>
	</ScrollViewer>
</UserControl>
