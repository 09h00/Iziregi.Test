<!-- File: Pages/TrashPage.xaml -->
<UserControl x:Class="Iziregi.Test.Pages.TrashPage"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 d:DesignHeight="820"
			 d:DesignWidth="1280"
			 Background="#F6F7FB">

	<UserControl.Resources>

		<Style x:Key="SmallButtonStyle" TargetType="Button">
			<Setter Property="Height" Value="28"/>
			<Setter Property="Padding" Value="8,0"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="Foreground" Value="#111827"/>
			<Setter Property="BorderBrush" Value="#D1D5DB"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="6">
							<ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
							</Trigger>
							<!-- ✅ Fix (04.08.2026, demande de Joe : "tu n'as pas grisé les boutons") :
							     un ControlTemplate custom ignore l'état IsEnabled=False par défaut, il
							     faut un Trigger explicite, mêmes valeurs que ArchivesPage.xaml. -->
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
								<Setter TargetName="Bd" Property="BorderBrush" Value="#D1D5DB"/>
								<Setter Property="Foreground" Value="#9CA3AF"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="DangerSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
			<Setter Property="Foreground" Value="#B91C1C"/>
			<Setter Property="BorderBrush" Value="#FCA5A5"/>
		</Style>

		<!-- ✅ Même vert que "Archiver" dans Dashboard (24.07.2026, demande de Joe : couleurs
		     cohérentes entre les pages pour les boutons Corbeille/Rétablir). -->
		<Style x:Key="RestoreSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
			<Setter Property="Foreground" Value="#15803D"/>
			<Setter Property="BorderBrush" Value="#15803D"/>
		</Style>

		<Style x:Key="InputStyle" TargetType="TextBox">
			<Setter Property="Height" Value="26"/>
			<Setter Property="Padding" Value="6,2"/>
			<Setter Property="BorderBrush" Value="#D1D5DB"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="FontSize" Value="12"/>
		</Style>

		<!-- Texte centré -->
		<Style x:Key="GridTextCellStyle" TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="TextAlignment" Value="Center"/>
			<Setter Property="TextWrapping" Value="NoWrap"/>
			<Setter Property="TextTrimming" Value="None"/>
		</Style>

		<!-- CheckBox centrée -->
		<Style x:Key="GridCheckBoxCellStyle" TargetType="CheckBox">
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="Padding" Value="0"/>
		</Style>

		<!-- DataGrid -->
		<Style x:Key="GridStyle" TargetType="DataGrid">
			<Setter Property="AutoGenerateColumns" Value="False"/>
			<Setter Property="CanUserAddRows" Value="False"/>
			<Setter Property="CanUserDeleteRows" Value="False"/>

			<Setter Property="GridLinesVisibility" Value="All"/>
			<Setter Property="VerticalGridLinesBrush" Value="#E5E7EB"/>
			<Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>

			<Setter Property="HeadersVisibility" Value="Column"/>
			<Setter Property="RowHeight" Value="36"/>
			<Setter Property="ColumnHeaderHeight" Value="44"/>

			<!-- Bordure extérieure -->
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="#D1D5DB"/>

			<Setter Property="Background" Value="White"/>
			<Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>

			<Setter Property="SelectionMode" Value="Single"/>
			<Setter Property="SelectionUnit" Value="FullRow"/>

			<Setter Property="FontSize" Value="12"/>
			<Setter Property="IsReadOnly" Value="False"/>

			<!-- Sélection : bordure bleue -->
			<Setter Property="RowStyle">
				<Setter.Value>
					<Style TargetType="DataGridRow">
						<Setter Property="Background" Value="Transparent"/>
						<Setter Property="BorderBrush" Value="Transparent"/>
						<Setter Property="BorderThickness" Value="0"/>
						<Setter Property="SnapsToDevicePixels" Value="True"/>

						<Style.Triggers>
							<Trigger Property="IsSelected" Value="True">
								<Setter Property="BorderBrush" Value="#2563EB"/>
								<Setter Property="BorderThickness" Value="2"/>
								<Setter Property="Background" Value="Transparent"/>
							</Trigger>

							<Trigger Property="IsKeyboardFocusWithin" Value="True">
								<Setter Property="BorderBrush" Value="#2563EB"/>
								<Setter Property="BorderThickness" Value="2"/>
								<Setter Property="Background" Value="Transparent"/>
							</Trigger>
						</Style.Triggers>
					</Style>
				</Setter.Value>
			</Setter>

			<!-- Cellules : pas de remplissage bleu -->
			<Setter Property="CellStyle">
				<Setter.Value>
					<Style TargetType="DataGridCell">
						<Setter Property="VerticalContentAlignment" Value="Stretch"/>
						<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
						<Setter Property="Padding" Value="6,0"/>
						<Setter Property="BorderBrush" Value="#E5E7EB"/>
						<Setter Property="BorderThickness" Value="0,0,1,1"/>
						<Setter Property="Background" Value="Transparent"/>
						<Style.Triggers>
							<Trigger Property="IsSelected" Value="True">
								<Setter Property="Background" Value="Transparent"/>
							</Trigger>
						</Style.Triggers>
					</Style>
				</Setter.Value>
			</Setter>

			<!-- En-têtes : gras + noir -->
			<Setter Property="ColumnHeaderStyle">
				<Setter.Value>
					<Style TargetType="DataGridColumnHeader">
						<Setter Property="VerticalContentAlignment" Value="Center"/>
						<Setter Property="HorizontalContentAlignment" Value="Center"/>
						<Setter Property="Padding" Value="6,0"/>
						<Setter Property="BorderBrush" Value="#D1D5DB"/>
						<Setter Property="BorderThickness" Value="0,0,1,1"/>
						<Setter Property="Foreground" Value="#111827"/>
						<Setter Property="FontWeight" Value="Bold"/>
					</Style>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Texte statut (base) -->
		<Style x:Key="StatusCellTextBaseStyle" TargetType="TextBlock" BasedOn="{StaticResource GridTextCellStyle}">
			<Setter Property="Foreground" Value="#9CA3AF"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Padding" Value="4,0"/>
		</Style>

		<!-- Zone Statut : pas de séparations verticales -->
		<Style x:Key="StatusHeaderNoVerticalSeparators" TargetType="DataGridColumnHeader">
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="Padding" Value="6,0"/>
			<Setter Property="BorderBrush" Value="#D1D5DB"/>
			<Setter Property="BorderThickness" Value="0,0,0,1"/>
		</Style>

		<Style x:Key="StatusCellNoVerticalSeparators" TargetType="DataGridCell">
			<Setter Property="VerticalContentAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="BorderBrush" Value="#E5E7EB"/>
			<Setter Property="BorderThickness" Value="0,0,0,1"/>
			<Setter Property="Background" Value="Transparent"/>
			<Style.Triggers>
				<Trigger Property="IsSelected" Value="True">
					<Setter Property="Background" Value="Transparent"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="StatusHeaderWithRightSeparator"
			   TargetType="DataGridColumnHeader"
			   BasedOn="{StaticResource StatusHeaderNoVerticalSeparators}">
			<Setter Property="BorderBrush" Value="#D1D5DB"/>
			<Setter Property="BorderThickness" Value="0,0,1,1"/>
		</Style>

		<Style x:Key="StatusCellWithRightSeparator"
			   TargetType="DataGridCell"
			   BasedOn="{StaticResource StatusCellNoVerticalSeparators}">
			<Setter Property="BorderThickness" Value="0,0,1,1"/>
			<Setter Property="Background" Value="Transparent"/>
			<Style.Triggers>
				<Trigger Property="IsSelected" Value="True">
					<Setter Property="Background" Value="Transparent"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<!-- Header "Statut" -->
		<Style x:Key="StatusHeaderTopText" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="#111827"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>

	</UserControl.Resources>

	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- BARRE -->
		<Border Grid.Row="0"
				Background="White"
				BorderBrush="#E5E7EB"
				BorderThickness="1"
				CornerRadius="12"
				Padding="8"
				Margin="0,0,0,8"
				Effect="{StaticResource CardShadowEffect}">

			<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
	<!-- ✅ Renommé "Corbeille des bons" (demande de Joe, 04.08.2026), même principe que
	     "Archives des bons d'intervention". -->
	<TextBlock Text="Corbeille des bons"
	           FontSize="18"
	           FontWeight="SemiBold"
	           Foreground="#111827"
	           Margin="0,0,10,0"/>

	<Button x:Name="RestoreSelectionButton"
	        Content="Restaurer sélection"
	        Style="{StaticResource RestoreSmallButtonStyle}"
	        Click="RestoreSelected_Click"
	        IsEnabled="False"
	        Height="34"
	        Margin="0,0,6,0"/>

	<Button x:Name="DeleteSelectionButton"
	        Content="Supprimer définitivement"
	        Style="{StaticResource DangerSmallButtonStyle}"
	        Click="DeleteSelected_Click"
	        IsEnabled="False"
	        Height="34"
	        Margin="0,0,6,0"/>

	<Button Content="Rafraîchir"
	        Style="{StaticResource SmallButtonStyle}"
	        BorderBrush="Black"
	        Height="34"
	        Margin="0,0,6,0"
	        Click="Refresh_Click"/>

	<!-- ✅ Retour (04.08.2026, demande de Joe) : Corbeille n'a plus de bouton dédié
	     dans le menu global (voir MainWindow.xaml), accès désormais via "Bons
	     d'intervention", ce bouton ramène à la page d'origine. Déplacé à côté de
	     "Rafraîchir" (demande de Joe, 04.08.2026). -->
	<Button Content="Page des bons"
	        Style="{StaticResource SmallButtonStyle}"
	        BorderBrush="Black"
	        Height="34"
	        Margin="0,0,6,0"
	        Click="BackToParent_Click"/>

	<!-- ✅ Accès direct à l'autre sous-page (demande de Joe, 04.08.2026) : depuis Corbeille, va
	     directement à Archives sans repasser par "Bons d'intervention". Fond gris clair, même
	     couleur que "Page archives" sur Bons d'intervention/Planification. -->
	<Button Content="Page archives"
	        Style="{StaticResource SmallButtonStyle}"
	        Background="#F3F4F6"
	        BorderBrush="Black"
	        Height="34"
	        Click="GoToArchives_Click"/>
</StackPanel>
		</Border>

		<!-- TABLEAU -->
		<Border Grid.Row="1"
				Background="White"
				BorderBrush="#E5E7EB"
				BorderThickness="1"
				CornerRadius="12"
				Padding="10"
				Effect="{StaticResource CardShadowEffect}">

			<DataGrid x:Name="TrashedGrid"
					  Grid.Row="1"
					  Style="{StaticResource GridStyle}"
					  ColumnWidth="Auto"
					  MouseDoubleClick="TrashedGrid_MouseDoubleClick"
					  SelectionChanged="TrashedGrid_SelectionChanged">

				<DataGrid.Columns>

					<!-- Sélection -->
					<DataGridTemplateColumn Width="31" IsReadOnly="True">
						<DataGridTemplateColumn.HeaderTemplate>
							<DataTemplate>
								<CheckBox x:Name="SelectAllCheckBox"
										  Style="{StaticResource GridCheckBoxCellStyle}"
										  Click="SelectAllCheckBox_Click"/>
							</DataTemplate>
						</DataGridTemplateColumn.HeaderTemplate>

						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<CheckBox Style="{StaticResource GridCheckBoxCellStyle}"
										  IsChecked="{Binding IsSelected, Mode=TwoWay}"
										  Click="RowSelectCheckBox_Click"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- N° -->
					<DataGridTextColumn Header="N°"
										Binding="{Binding WorkOrder.BdrDisplay}"
										Width="48"
										ElementStyle="{StaticResource GridTextCellStyle}"
										IsReadOnly="True"/>

					<!-- Concerne -->
					<DataGridTextColumn Width="Auto"
										MinWidth="90"
										Binding="{Binding WorkOrder.Reserve}"
										ElementStyle="{StaticResource GridTextCellStyle}"
										IsReadOnly="True">
						<DataGridTextColumn.Header>
							<TextBlock Text="Concerne"/>
						</DataGridTextColumn.Header>
					</DataGridTextColumn>

					<!-- Demandé par -->
					<DataGridTextColumn Width="Auto"
										MinWidth="90"
										Binding="{Binding WorkOrder.RequestedBy}"
										ElementStyle="{StaticResource GridTextCellStyle}"
										IsReadOnly="True">
						<DataGridTextColumn.Header>
							<TextBlock Text="Demandé par"/>
						</DataGridTextColumn.Header>
					</DataGridTextColumn>

					<!-- Entreprise (avec couleur) -->
					<DataGridTemplateColumn Width="Auto" MinWidth="76" IsReadOnly="True">
						<DataGridTemplateColumn.Header>
							<TextBlock Text="Entreprise"/>
						</DataGridTemplateColumn.Header>
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Border Background="{Binding CompanyBrush}" CornerRadius="2" Padding="6,0">
									<TextBlock Text="{Binding WorkOrder.PerformedBy}"
											   Foreground="{Binding CompanyTextBrush}"
											   FontWeight="Bold"
											   VerticalAlignment="Center"
											   TextAlignment="Center"
											   TextWrapping="NoWrap"/>
								</Border>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- Date -->
					<DataGridTextColumn Header="Créé le"
										Binding="{Binding WorkOrder.RequestDate, StringFormat=dd.MM.yyyy}"
										Width="Auto"
										MinWidth="70"
										ElementStyle="{StaticResource GridTextCellStyle}"
										IsReadOnly="True"/>

					<!-- ========================= -->
					<!-- STATUT (5 colonnes) -->
					<!-- ========================= -->

					<!-- 1) Créé -->
					<DataGridTemplateColumn Width="Auto"
											HeaderStyle="{StaticResource StatusHeaderNoVerticalSeparators}"
											CellStyle="{StaticResource StatusCellNoVerticalSeparators}"
											IsReadOnly="True">
						<DataGridTemplateColumn.Header>
							<Grid/>
						</DataGridTemplateColumn.Header>
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Border CornerRadius="2">
									<Border.Style>
										<Style TargetType="Border">
											<Setter Property="Background" Value="Transparent"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding WorkOrder.IsInCreation}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
												<DataTrigger Binding="{Binding WorkOrder.IsSentToCompany}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
												<DataTrigger Binding="{Binding WorkOrder.IsQuoteReceived}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
												<DataTrigger Binding="{Binding WorkOrder.IsSentToSigner}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
												<DataTrigger Binding="{Binding WorkOrder.IsValidated}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Border.Style>

									<TextBlock>
										<TextBlock.Style>
											<Style TargetType="TextBlock" BasedOn="{StaticResource StatusCellTextBaseStyle}">
												<Setter Property="Text" Value="Créé"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding WorkOrder.IsInCreation}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding WorkOrder.IsSentToCompany}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding WorkOrder.IsQuoteReceived}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding WorkOrder.IsSentToSigner}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding WorkOrder.IsValidated}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
								</Border>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- 2) Demande devis envoyée -->
					<DataGridTemplateColumn Width="Auto"
											HeaderStyle="{StaticResource StatusHeaderNoVerticalSeparators}"
											CellStyle="{StaticResource StatusCellNoVerticalSeparators}"
											IsReadOnly="True">
						<DataGridTemplateColumn.Header>
							<Grid/>
						</DataGridTemplateColumn.Header>
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Border CornerRadius="2">
									<Border.Style>
										<Style TargetType="Border">
											<Setter Property="Background" Value="Transparent"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding WorkOrder.IsSentToCompany}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
												<DataTrigger Binding="{Binding WorkOrder.IsQuoteReceived}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
												<DataTrigger Binding="{Binding WorkOrder.IsSentToSigner}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
												<DataTrigger Binding="{Binding WorkOrder.IsValidated}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Border.Style>

									<TextBlock>
										<TextBlock.Style>
											<Style TargetType="TextBlock" BasedOn="{StaticResource StatusCellTextBaseStyle}">
												<Setter Property="Text" Value="Demande devis envoyée"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding WorkOrder.IsSentToCompany}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding WorkOrder.IsQuoteReceived}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding WorkOrder.IsSentToSigner}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding WorkOrder.IsValidated}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
								</Border>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- 3) Devis reçu -->
					<DataGridTemplateColumn Width="Auto"
											HeaderStyle="{StaticResource StatusHeaderNoVerticalSeparators}"
											CellStyle="{StaticResource StatusCellNoVerticalSeparators}"
											IsReadOnly="True">
						<DataGridTemplateColumn.Header>
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="*"/>
									<RowDefinition Height="*"/>
								</Grid.RowDefinitions>

								<TextBlock Text="Statut"
										   Grid.Row="0"
										   Grid.RowSpan="2"
										   Style="{StaticResource StatusHeaderTopText}"
										   VerticalAlignment="Center"/>
							</Grid>
						</DataGridTemplateColumn.Header>
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Border CornerRadius="2">
									<Border.Style>
										<Style TargetType="Border">
											<Setter Property="Background" Value="Transparent"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding WorkOrder.IsQuoteReceived}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
												<DataTrigger Binding="{Binding WorkOrder.IsSentToSigner}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
												<DataTrigger Binding="{Binding WorkOrder.IsValidated}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Border.Style>

									<TextBlock>
										<TextBlock.Style>
											<Style TargetType="TextBlock" BasedOn="{StaticResource StatusCellTextBaseStyle}">
												<Setter Property="Text" Value="Devis reçu"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding WorkOrder.IsQuoteReceived}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding WorkOrder.IsSentToSigner}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding WorkOrder.IsValidated}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
								</Border>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- 4) Demande validation envoyée -->
					<DataGridTemplateColumn Width="Auto"
											HeaderStyle="{StaticResource StatusHeaderNoVerticalSeparators}"
											CellStyle="{StaticResource StatusCellNoVerticalSeparators}"
											IsReadOnly="True">
						<DataGridTemplateColumn.Header>
							<Grid/>
						</DataGridTemplateColumn.Header>
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Border CornerRadius="2">
									<Border.Style>
										<Style TargetType="Border">
											<Setter Property="Background" Value="Transparent"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding WorkOrder.IsSentToSigner}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
												<DataTrigger Binding="{Binding WorkOrder.IsValidated}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Border.Style>

									<TextBlock>
										<TextBlock.Style>
											<Style TargetType="TextBlock" BasedOn="{StaticResource StatusCellTextBaseStyle}">
												<Setter Property="Text" Value="Demande validation envoyée"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding WorkOrder.IsSentToSigner}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding WorkOrder.IsValidated}" Value="True">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
								</Border>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- 5) Validé -->
					<DataGridTemplateColumn Width="Auto"
											HeaderStyle="{StaticResource StatusHeaderWithRightSeparator}"
											CellStyle="{StaticResource StatusCellWithRightSeparator}"
											IsReadOnly="True">
						<DataGridTemplateColumn.Header>
							<Grid/>
						</DataGridTemplateColumn.Header>

						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Border CornerRadius="2">
									<Border.Style>
										<Style TargetType="Border">
											<Setter Property="Background" Value="Transparent"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding WorkOrder.ValidationDecision}" Value="Validé">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>

												<DataTrigger Binding="{Binding WorkOrder.ValidationDecision}" Value="Annulé">
													<Setter Property="Background" Value="#FFEDD5"/>
												</DataTrigger>

												<DataTrigger Binding="{Binding WorkOrder.ValidationDecision}" Value="Refusé">
													<Setter Property="Background" Value="#FEE2E2"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Border.Style>

									<TextBlock>
										<TextBlock.Style>
											<Style TargetType="TextBlock" BasedOn="{StaticResource StatusCellTextBaseStyle}">
												<Setter Property="Text" Value="{Binding WorkOrder.ValidationDecision}"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding WorkOrder.ValidationDecision}" Value="Validé">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding WorkOrder.ValidationDecision}" Value="Annulé">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding WorkOrder.ValidationDecision}" Value="Refusé">
														<Setter Property="Foreground" Value="#111827"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
								</Border>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- ✅ Colonnes manquantes (demande de Joe, 04.08.2026), même principe que
					     "Créé le" ci-dessus (lecture seule), pas les DatePicker éditables de
					     WorkOrdersGrid (Dashboard), une entrée à la Corbeille reste figée. -->
					<!-- Distribué le -->
					<DataGridTextColumn Header="Distribué le"
										Binding="{Binding WorkOrder.DistributedAt, StringFormat=dd.MM.yyyy}"
										Width="Auto"
										MinWidth="70"
										ElementStyle="{StaticResource GridTextCellStyle}"
										IsReadOnly="True"/>

					<!-- Effectué le -->
					<DataGridTextColumn Header="Effectué le"
										Binding="{Binding WorkOrder.PerformedAt, StringFormat=dd.MM.yyyy}"
										Width="Auto"
										MinWidth="70"
										ElementStyle="{StaticResource GridTextCellStyle}"
										IsReadOnly="True"/>

					<!-- Actions -->
					<DataGridTemplateColumn Header="Actions" Width="150" IsReadOnly="True">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<StackPanel Orientation="Horizontal">
									<Button Content="↩"
											ToolTip="Restaurer"
											Style="{StaticResource RestoreSmallButtonStyle}"
											Click="RestoreRow_Click"
											Margin="0,0,4,0"/>

									<Button Content="✖"
											ToolTip="Supprimer définitivement"
											Style="{StaticResource DangerSmallButtonStyle}"
											Click="DeleteRow_Click"/>
								</StackPanel>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

				</DataGrid.Columns>
			</DataGrid>
		</Border>

	</Grid>
</UserControl>