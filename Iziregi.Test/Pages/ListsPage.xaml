<!-- File: Pages/ListsPage.xaml -->
<UserControl x:Class="Iziregi.Test.Pages.ListsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="6"
							SnapsToDevicePixels="True">
                            <ContentPresenter
								Margin="{TemplateBinding Padding}"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F9FAFB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
			Text="Listes"
			FontSize="18"
			FontWeight="SemiBold"
			Foreground="#111827"/>

        <GroupBox Grid.Row="2"
			Header="Noms des 6 champs de la section “Demande”">
            <GroupBox.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontWeight="SemiBold"/>
                </DataTemplate>
            </GroupBox.HeaderTemplate>

            <Border BorderBrush="#E2E2E2"
				BorderThickness="1"
				CornerRadius="6"
				Padding="8"
				Background="#FAFAFA">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="450"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="LabelReserveTextBox" Grid.Row="0" Grid.Column="0" Height="22" HorizontalAlignment="Stretch"/>
                    <TextBox x:Name="LabelRequestedByTextBox" Grid.Row="0" Grid.Column="2" Height="22" HorizontalAlignment="Stretch"/>
                    <TextBox x:Name="LabelPerformedByTextBox" Grid.Row="0" Grid.Column="4" Height="22" HorizontalAlignment="Stretch"/>

                    <Button Grid.Row="0"
						Grid.Column="6"
						Content="Enregistrer"
						Style="{StaticResource PrimaryButtonStyle}"
						Height="26"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Center"
						Click="SaveLabels_Click"/>

                    <TextBox x:Name="LabelPlaceTextBox" Grid.Row="2" Grid.Column="0" Height="22" HorizontalAlignment="Stretch"/>
                    <TextBox x:Name="LabelEtageTextBox" Grid.Row="2" Grid.Column="2" Height="22" HorizontalAlignment="Stretch"/>
                    <TextBox x:Name="LabelDeadlineTextBox" Grid.Row="2" Grid.Column="4" Height="22" HorizontalAlignment="Stretch"/>
                    <TextBox x:Name="LabelPlanningTextZoneTextBox" Grid.Row="2" Grid.Column="6" Height="22" HorizontalAlignment="Stretch"/>
                </Grid>
            </Border>
        </GroupBox>

        <Separator Grid.Row="3"
			Height="1"
			Background="#111827"
			Margin="0,8,0,8"/>

        <Border Grid.Row="4"
			BorderBrush="#E2E2E2"
			BorderThickness="1"
			CornerRadius="6"
			Padding="8"
			Background="#FFFFFF">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Listes déroulantes"
						FontWeight="SemiBold"
						VerticalAlignment="Center"
						Margin="0,0,12,0"/>

                    <Button x:Name="CommonAddButton" Content="Ajouter" Width="90" Margin="0,0,8,0" Click="CommonAdd_Click"/>
                    <Button x:Name="CommonRenameButton" Content="Renommer" Width="90" Margin="0,0,8,0" Click="CommonRename_Click"/>
                    <Button x:Name="CommonDeleteButton" Content="Supprimer" Width="90" Margin="0,0,8,0" Click="CommonDelete_Click"/>
                    <Button x:Name="CommonSetDefaultButton" Content="Définir par défaut" Width="140" Margin="0,0,8,0" Click="CommonSetDefault_Click"/>
                    <Button x:Name="CommonCopyButton" Content="Copier" Width="90" Margin="0,0,8,0" Click="CommonCopy_Click"/>
                    <Button x:Name="CommonPasteButton" Content="Coller" Width="90" Click="CommonPaste_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="Liste active : " VerticalAlignment="Center" Foreground="#6B7280"/>
                    <TextBlock x:Name="ActiveListLabel" Text="—" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Concerne -->
            <GroupBox x:Name="ReservesGroupBox" Grid.Column="0" Header="Concerne">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding}"/>
                            <TextBlock Text=" (20 caractères max.)" Foreground="#9CA3AF"/>
                        </StackPanel>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>

                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Sélection par défaut" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DefaultReserveComboBox" DockPanel.Dock="Top" IsEditable="True" Margin="0,0,0,10"/>

                    <Border x:Name="ReservesListBorder"
						Background="Transparent"
						BorderThickness="2"
						CornerRadius="6"
						BorderBrush="#E5E7EB"
						PreviewMouseLeftButtonDown="ReservesListBorder_PreviewMouseLeftButtonDown">
                        <ListBox x:Name="ReservesListBox"
							GotFocus="ReservesListBox_GotFocus"
							SelectionChanged="AnyListBox_SelectionChanged"/>
                    </Border>
                </DockPanel>
            </GroupBox>

            <!-- Demandé par -->
            <GroupBox x:Name="RequestersGroupBox" Header="Demandé par" Grid.Column="2">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Sélection par défaut" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DefaultRequesterComboBox" DockPanel.Dock="Top" IsEditable="True" Margin="0,0,0,10"/>

                    <Border x:Name="RequestersListBorder"
						Background="Transparent"
						BorderThickness="2"
						CornerRadius="6"
						BorderBrush="#E5E7EB"
						PreviewMouseLeftButtonDown="RequestersListBorder_PreviewMouseLeftButtonDown">
                        <ListBox x:Name="RequestersListBox"
							GotFocus="RequestersListBox_GotFocus"
							SelectionChanged="AnyListBox_SelectionChanged"/>
                    </Border>
                </DockPanel>
            </GroupBox>

            <!-- Bâtiment -->
            <GroupBox x:Name="PlacesGroupBox" Header="Bâtiment" Grid.Column="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Sélection par défaut" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DefaultPlaceComboBox" DockPanel.Dock="Top" IsEditable="True" Margin="0,0,0,10"/>
                    <TextBox x:Name="NewPlaceTextBox" Visibility="Collapsed"/>

                    <Border x:Name="PlacesListBorder"
						Background="Transparent"
						BorderThickness="2"
						CornerRadius="6"
						BorderBrush="#E5E7EB"
						PreviewMouseLeftButtonDown="PlacesListBorder_PreviewMouseLeftButtonDown">
                        <ListBox x:Name="PlacesListBox"
							GotFocus="PlacesListBox_GotFocus"
							SelectionChanged="AnyListBox_SelectionChanged"/>
                    </Border>
                </DockPanel>
            </GroupBox>

            <!-- Étage -->
            <GroupBox x:Name="EtagesGroupBox" Header="Étage" Grid.Column="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Sélection par défaut" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DefaultEtageComboBox" DockPanel.Dock="Top" IsEditable="True" Margin="0,0,0,10"/>
                    <TextBox x:Name="NewEtageTextBox" Visibility="Collapsed"/>

                    <Border x:Name="EtagesListBorder"
						Background="Transparent"
						BorderThickness="2"
						CornerRadius="6"
						BorderBrush="#E5E7EB"
						PreviewMouseLeftButtonDown="EtagesListBorder_PreviewMouseLeftButtonDown">
                        <ListBox x:Name="EtagesListBox"
							GotFocus="EtagesListBox_GotFocus"
							SelectionChanged="AnyListBox_SelectionChanged"/>
                    </Border>
                </DockPanel>
            </GroupBox>

            <!-- Entreprise -->
            <GroupBox x:Name="CompaniesGroupBox" Header="Entreprise" Grid.Column="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Sélection par défaut" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DefaultCompanyComboBox" DockPanel.Dock="Top" IsEditable="True" Margin="0,0,0,10"/>

                    <!-- Boutons couleur (placés entre défaut et liste) -->
                    <Border DockPanel.Dock="Top"
						BorderBrush="#E2E2E2"
						BorderThickness="1"
						CornerRadius="6"
						Padding="8"
						Background="#FFFFFF"
						Margin="0,0,0,10">
                        <StackPanel>
                            <TextBox x:Name="NewCompanyTextBox" Visibility="Collapsed"/>
                            <WrapPanel VerticalAlignment="Center">
                                <Border x:Name="SelectedCompanyColorPreview" Width="24" Height="24" Background="Transparent" BorderBrush="#666" BorderThickness="1" CornerRadius="3" Margin="0,0,8,0"/>
                                <Button Content="Couleur..." Height="24" Width="80" Margin="0,0,8,0" Click="PickCompanyColor_Click"/>
                                <Button Content="✕" Height="24" Width="24" ToolTip="Effacer" Click="ClearCompanyColor_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Liste (inchangée) -->
                    <Border x:Name="CompaniesListBorder"
						Background="Transparent"
						BorderThickness="2"
						CornerRadius="6"
						BorderBrush="#E5E7EB"
						PreviewMouseLeftButtonDown="CompaniesListBorder_PreviewMouseLeftButtonDown">
                        <ListBox x:Name="CompaniesListBox"
							GotFocus="CompaniesListBox_GotFocus"
							SelectionChanged="CompaniesListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="10" Height="10" CornerRadius="5" BorderThickness="1" BorderBrush="#666" Background="{Binding ColorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </GroupBox>

            <!-- Zone de texte planning -->
            <GroupBox x:Name="PlanningTextZonesGroupBox" Header="Zone de texte planning" Grid.Column="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Sélection par défaut" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DefaultPlanningTextZoneComboBox" DockPanel.Dock="Top" IsEditable="True" Margin="0,0,0,10"/>

                    <Border x:Name="PlanningTextZonesListBorder"
						Background="Transparent"
						BorderThickness="2"
						CornerRadius="6"
						BorderBrush="#E5E7EB"
						PreviewMouseLeftButtonDown="PlanningTextZonesListBorder_PreviewMouseLeftButtonDown">
                        <ListBox x:Name="PlanningTextZonesListBox"
							GotFocus="PlanningTextZonesListBox_GotFocus"
							SelectionChanged="AnyListBox_SelectionChanged"/>
                    </Border>
                </DockPanel>
            </GroupBox>

        </Grid>
    </Grid>
</UserControl>