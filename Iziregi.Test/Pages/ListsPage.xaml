<!-- File: Pages/ListsPage.xaml -->
<UserControl x:Class="Iziregi.Test.Pages.ListsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="6"
							SnapsToDevicePixels="True">
                            <ContentPresenter
								Margin="{TemplateBinding Padding}"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F9FAFB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ✅ Nom de champ/liste éditable directement au-dessus de chaque liste (remplace
             l'ancien titre statique du GroupBox + l'ancienne section "Noms des 6 champs"). -->
        <Style x:Key="ListLabelTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <!-- ✅ Template entièrement personnalisé : le template TextBox par défaut de
                 Windows a son propre déclencheur de focus qui redessine la bordure en bleu
                 système PAR-DESSUS la propriété BorderBrush du Style — d'où l'absence de
                 changement malgré les couleurs testées précédemment. Ici, la bordure (Bd)
                 est explicitement pilotée par nous, sans callback caché du thème. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4169E1"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ ComboBox "Sélection par défaut" : sans style, elles gardaient le bleu de focus
             par défaut de Windows (différent du bleu de l'app) — même bleu/épaisseur que les
             champs de libellé et les listes actives, pour un focus visuellement cohérent. -->
        <Style x:Key="DefaultValueComboBoxStyle" TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
			Text="Listes"
			FontSize="18"
			FontWeight="SemiBold"
			Foreground="#111827"
			Margin="0,-11,0,-3"/>

        <Border Grid.Row="2"
			BorderBrush="#E5E7EB"
			BorderThickness="1"
			CornerRadius="10"
			Padding="8"
			Background="#FFFFFF"
			Effect="{StaticResource CardShadowEffect}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Listes déroulantes"
						FontWeight="SemiBold"
						VerticalAlignment="Center"
						Margin="0,0,12,0"/>

                    <Button x:Name="CommonAddButton" Content="Ajouter" Width="90" Margin="0,0,8,0" Click="CommonAdd_Click" Style="{StaticResource SmallButtonStyle}" Foreground="#2563EB" BorderBrush="#2563EB"/>
                    <Button x:Name="CommonRenameButton" Content="Renommer" Width="90" Margin="0,0,8,0" Click="CommonRename_Click" Style="{StaticResource SmallButtonStyle}"/>
                    <Button x:Name="CommonDeleteButton" Content="Supprimer" Width="90" Margin="0,0,8,0" Click="CommonDelete_Click" Style="{StaticResource SmallButtonStyle}" Foreground="#DC2626" BorderBrush="#DC2626"/>
                    <Button x:Name="CommonSetDefaultButton" Content="Définir par défaut" Width="140" Margin="0,0,8,0" Click="CommonSetDefault_Click" Style="{StaticResource SmallButtonStyle}"/>
                    <Button x:Name="CommonCopyButton" Content="Copier" Width="90" Margin="0,0,8,0" Click="CommonCopy_Click" Style="{StaticResource SmallButtonStyle}"/>
                    <Button x:Name="CommonPasteButton" Content="Coller" Width="90" Click="CommonPaste_Click" Style="{StaticResource SmallButtonStyle}"/>
                </StackPanel>

                <Button Content="Enregistrer"
                        DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="200"
                        Height="26"
                        Click="SaveLabels_Click"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Liste active : " VerticalAlignment="Center" Foreground="#6B7280"/>
                    <TextBlock x:Name="ActiveListLabel" Text="—" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#2563EB"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
        <Grid Height="478">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Concerne -->
            <GroupBox x:Name="ReservesGroupBox" Grid.Column="0">
                <DockPanel>
                    <TextBox x:Name="LabelReserveTextBox" DockPanel.Dock="Top" Style="{StaticResource ListLabelTextBoxStyle}" TextChanged="AnyLabelTextBox_TextChanged" GotFocus="AnyLabelTextBox_GotFocus"/>
                    <TextBlock DockPanel.Dock="Top" Text="(20 caractères max. sur le bon)" Foreground="#9CA3AF" FontSize="10" Margin="0,-6,0,8"/>
                    <TextBlock DockPanel.Dock="Top" Text="Sélection par défaut" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DefaultReserveComboBox" DockPanel.Dock="Top" IsEditable="True" Margin="0,0,0,10" Style="{StaticResource DefaultValueComboBoxStyle}"/>

                    <Border x:Name="ReservesListBorder"
						Background="Transparent"
						BorderThickness="2"
						CornerRadius="6"
						BorderBrush="#E5E7EB"
						PreviewMouseLeftButtonDown="ReservesListBorder_PreviewMouseLeftButtonDown">
                        <ListBox x:Name="ReservesListBox"
							GotFocus="ReservesListBox_GotFocus"
							SelectionChanged="AnyListBox_SelectionChanged"/>
                    </Border>
                </DockPanel>
            </GroupBox>

            <!-- Demandé par -->
            <GroupBox x:Name="RequestersGroupBox" Grid.Column="2">
                <DockPanel>
                    <TextBox x:Name="LabelRequestedByTextBox" DockPanel.Dock="Top" Style="{StaticResource ListLabelTextBoxStyle}" TextChanged="AnyLabelTextBox_TextChanged" GotFocus="AnyLabelTextBox_GotFocus"/>
                    <TextBlock DockPanel.Dock="Top" Text="Sélection par défaut" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DefaultRequesterComboBox" DockPanel.Dock="Top" IsEditable="True" Margin="0,0,0,10" Style="{StaticResource DefaultValueComboBoxStyle}"/>

                    <Border x:Name="RequestersListBorder"
						Background="Transparent"
						BorderThickness="2"
						CornerRadius="6"
						BorderBrush="#E5E7EB"
						PreviewMouseLeftButtonDown="RequestersListBorder_PreviewMouseLeftButtonDown">
                        <ListBox x:Name="RequestersListBox"
							GotFocus="RequestersListBox_GotFocus"
							SelectionChanged="AnyListBox_SelectionChanged"/>
                    </Border>
                </DockPanel>
            </GroupBox>

            <!-- Bâtiment -->
            <GroupBox x:Name="PlacesGroupBox" Grid.Column="4">
                <DockPanel>
                    <TextBox x:Name="LabelPlaceTextBox" DockPanel.Dock="Top" Style="{StaticResource ListLabelTextBoxStyle}" TextChanged="AnyLabelTextBox_TextChanged" GotFocus="AnyLabelTextBox_GotFocus"/>
                    <TextBlock DockPanel.Dock="Top" Text="Sélection par défaut" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DefaultPlaceComboBox" DockPanel.Dock="Top" IsEditable="True" Margin="0,0,0,10" Style="{StaticResource DefaultValueComboBoxStyle}"/>
                    <TextBox x:Name="NewPlaceTextBox" Visibility="Collapsed"/>

                    <Border x:Name="PlacesListBorder"
						Background="Transparent"
						BorderThickness="2"
						CornerRadius="6"
						BorderBrush="#E5E7EB"
						PreviewMouseLeftButtonDown="PlacesListBorder_PreviewMouseLeftButtonDown">
                        <ListBox x:Name="PlacesListBox"
							GotFocus="PlacesListBox_GotFocus"
							SelectionChanged="AnyListBox_SelectionChanged"/>
                    </Border>
                </DockPanel>
            </GroupBox>

            <!-- Étage -->
            <GroupBox x:Name="EtagesGroupBox" Grid.Column="6">
                <DockPanel>
                    <TextBox x:Name="LabelEtageTextBox" DockPanel.Dock="Top" Style="{StaticResource ListLabelTextBoxStyle}" TextChanged="AnyLabelTextBox_TextChanged" GotFocus="AnyLabelTextBox_GotFocus"/>
                    <TextBlock DockPanel.Dock="Top" Text="Sélection par défaut" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DefaultEtageComboBox" DockPanel.Dock="Top" IsEditable="True" Margin="0,0,0,10" Style="{StaticResource DefaultValueComboBoxStyle}"/>
                    <TextBox x:Name="NewEtageTextBox" Visibility="Collapsed"/>

                    <Border x:Name="EtagesListBorder"
						Background="Transparent"
						BorderThickness="2"
						CornerRadius="6"
						BorderBrush="#E5E7EB"
						PreviewMouseLeftButtonDown="EtagesListBorder_PreviewMouseLeftButtonDown">
                        <ListBox x:Name="EtagesListBox"
							GotFocus="EtagesListBox_GotFocus"
							SelectionChanged="AnyListBox_SelectionChanged"/>
                    </Border>
                </DockPanel>
            </GroupBox>

            <!-- Entreprise -->
            <GroupBox x:Name="CompaniesGroupBox" Grid.Column="8">
                <DockPanel>
                    <TextBox x:Name="LabelPerformedByTextBox" DockPanel.Dock="Top" Style="{StaticResource ListLabelTextBoxStyle}" TextChanged="AnyLabelTextBox_TextChanged" GotFocus="AnyLabelTextBox_GotFocus"/>
                    <TextBlock DockPanel.Dock="Top" Text="Sélection par défaut" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DefaultCompanyComboBox" DockPanel.Dock="Top" IsEditable="True" Margin="0,0,0,10" Style="{StaticResource DefaultValueComboBoxStyle}"/>

                    <!-- Boutons couleur (placés entre défaut et liste) -->
                    <Border DockPanel.Dock="Top"
						BorderBrush="#E2E2E2"
						BorderThickness="1"
						CornerRadius="6"
						Padding="8"
						Background="#FFFFFF"
						Margin="0,0,0,10">
                        <StackPanel>
                            <TextBox x:Name="NewCompanyTextBox" Visibility="Collapsed"/>
                            <DockPanel VerticalAlignment="Center" LastChildFill="False">
                                <Button x:Name="PickCompanyColorButton" Content="Couleur" Height="24" Width="64" Margin="0,0,8,0" Click="PickCompanyColor_Click" Style="{StaticResource SmallButtonStyle}" DockPanel.Dock="Left"/>
                                <CheckBox x:Name="CompanyGradientCheckBox" Content="Mix" VerticalAlignment="Center" Margin="0,0,8,0" Checked="CompanyGradientCheckBox_Changed" Unchecked="CompanyGradientCheckBox_Changed" DockPanel.Dock="Left"/>
                                <Button Content="✕" Height="24" Width="32" ToolTip="Effacer" Click="ClearCompanyColor_Click" Style="{StaticResource SmallButtonStyle}" DockPanel.Dock="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Liste (inchangée) -->
                    <Border x:Name="CompaniesListBorder"
						Background="Transparent"
						BorderThickness="2"
						CornerRadius="6"
						BorderBrush="#E5E7EB"
						PreviewMouseLeftButtonDown="CompaniesListBorder_PreviewMouseLeftButtonDown">
                        <ListBox x:Name="CompaniesListBox"
							GotFocus="CompaniesListBox_GotFocus"
							SelectionChanged="CompaniesListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="10" Height="10" CornerRadius="5" BorderThickness="1" BorderBrush="#666" Background="{Binding ColorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </GroupBox>

            <!-- Délai (pas de liste associée : juste le nom du champ) -->
            <GroupBox x:Name="DeadlineGroupBox" Grid.Column="10">
                <DockPanel>
                    <TextBox x:Name="LabelDeadlineTextBox" DockPanel.Dock="Top" Style="{StaticResource ListLabelTextBoxStyle}" TextChanged="AnyLabelTextBox_TextChanged" GotFocus="AnyLabelTextBox_GotFocus"/>
                    <TextBlock DockPanel.Dock="Top" Text="Champ date (pas de liste associée)" Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap"/>
                </DockPanel>
            </GroupBox>

        </Grid>

        <Border Height="8"/>

        <!-- ✅ Listes liées au Planning (déplacées ensemble : Zone de texte, Cat., Urg.) —
             mêmes ColumnDefinitions que la grille du haut pour que chaque liste ait
             exactement la même largeur (seules les colonnes 0/2/4 sont utilisées). -->
        <Grid Height="478">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Zone de texte planning -->
            <GroupBox x:Name="PlanningTextZonesGroupBox" Grid.Column="0">
                <DockPanel>
                    <TextBox x:Name="LabelPlanningTextZoneTextBox" DockPanel.Dock="Top" Style="{StaticResource ListLabelTextBoxStyle}" TextChanged="AnyLabelTextBox_TextChanged" GotFocus="AnyLabelTextBox_GotFocus"/>
                    <TextBlock DockPanel.Dock="Top" Text="Sélection par défaut" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DefaultPlanningTextZoneComboBox" DockPanel.Dock="Top" IsEditable="True" Margin="0,0,0,10" Style="{StaticResource DefaultValueComboBoxStyle}"/>

                    <Border x:Name="PlanningTextZonesListBorder"
						Background="Transparent"
						BorderThickness="2"
						CornerRadius="6"
						BorderBrush="#E5E7EB"
						PreviewMouseLeftButtonDown="PlanningTextZonesListBorder_PreviewMouseLeftButtonDown">
                        <ListBox x:Name="PlanningTextZonesListBox"
							GotFocus="PlanningTextZonesListBox_GotFocus"
							SelectionChanged="AnyListBox_SelectionChanged"/>
                    </Border>
                </DockPanel>
            </GroupBox>

            <!-- Cat. (tâches Planning) -->
            <GroupBox x:Name="TaskCategoriesGroupBox" Grid.Column="2">
                <DockPanel>
                    <TextBox x:Name="LabelTaskCategoryTextBox" DockPanel.Dock="Top" Style="{StaticResource ListLabelTextBoxStyle}" TextChanged="AnyLabelTextBox_TextChanged" GotFocus="AnyLabelTextBox_GotFocus"/>
                    <TextBlock DockPanel.Dock="Top" Text="Sélection par défaut" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DefaultTaskCategoryComboBox" DockPanel.Dock="Top" IsEditable="True" Margin="0,0,0,10" Style="{StaticResource DefaultValueComboBoxStyle}"/>

                    <!-- ✅ Boutons couleur (17.07.2026, demande de Joe) : indépendant des couleurs
                         d'entreprises, même bloc en miroir. -->
                    <Border DockPanel.Dock="Top"
						BorderBrush="#E2E2E2"
						BorderThickness="1"
						CornerRadius="6"
						Padding="8"
						Background="#FFFFFF"
						Margin="0,0,0,10">
                        <DockPanel VerticalAlignment="Center" LastChildFill="False">
                            <Button x:Name="PickTaskCategoryColorButton" Content="Couleur" Height="24" Width="64" Margin="0,0,8,0" Click="PickTaskCategoryColor_Click" Style="{StaticResource SmallButtonStyle}" DockPanel.Dock="Left"/>
                            <CheckBox x:Name="TaskCategoryGradientCheckBox" Content="Mix" VerticalAlignment="Center" Margin="0,0,8,0" Checked="TaskCategoryGradientCheckBox_Changed" Unchecked="TaskCategoryGradientCheckBox_Changed" DockPanel.Dock="Left"/>
                            <Button Content="✕" Height="24" Width="32" ToolTip="Effacer" Click="ClearTaskCategoryColor_Click" Style="{StaticResource SmallButtonStyle}" DockPanel.Dock="Right"/>
                        </DockPanel>
                    </Border>

                    <Border x:Name="TaskCategoriesListBorder"
						Background="Transparent"
						BorderThickness="2"
						CornerRadius="6"
						BorderBrush="#E5E7EB"
						PreviewMouseLeftButtonDown="TaskCategoriesListBorder_PreviewMouseLeftButtonDown">
                        <ListBox x:Name="TaskCategoriesListBox"
							GotFocus="TaskCategoriesListBox_GotFocus"
							SelectionChanged="TaskCategoriesListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="10" Height="10" CornerRadius="5" BorderThickness="1" BorderBrush="#666" Background="{Binding ColorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </GroupBox>

            <!-- Urg. (tâches Planning) -->
            <GroupBox x:Name="TaskUrgenciesGroupBox" Grid.Column="4">
                <DockPanel>
                    <TextBox x:Name="LabelTaskUrgencyTextBox" DockPanel.Dock="Top" Style="{StaticResource ListLabelTextBoxStyle}" TextChanged="AnyLabelTextBox_TextChanged" GotFocus="AnyLabelTextBox_GotFocus"/>
                    <TextBlock DockPanel.Dock="Top" Text="Sélection par défaut" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DefaultTaskUrgencyComboBox" DockPanel.Dock="Top" IsEditable="True" Margin="0,0,0,10" Style="{StaticResource DefaultValueComboBoxStyle}"/>

                    <Border x:Name="TaskUrgenciesListBorder"
						Background="Transparent"
						BorderThickness="2"
						CornerRadius="6"
						BorderBrush="#E5E7EB"
						PreviewMouseLeftButtonDown="TaskUrgenciesListBorder_PreviewMouseLeftButtonDown">
                        <ListBox x:Name="TaskUrgenciesListBox"
							GotFocus="TaskUrgenciesListBox_GotFocus"
							SelectionChanged="AnyListBox_SelectionChanged"/>
                    </Border>
                </DockPanel>
            </GroupBox>

        </Grid>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>