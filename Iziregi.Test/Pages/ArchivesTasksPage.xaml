<!-- File: Pages/ArchivesTasksPage.xaml -->
<UserControl x:Class="Iziregi.Test.Pages.ArchivesTasksPage"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 d:DesignHeight="820"
			 d:DesignWidth="1280"
			 Background="#F6F7FB">

	<!-- ✅ 30.07.2026 (demande de Joe) : "Archives tâches", fonctionne comme les Archives des
		 bons (lecture seule, restaurer / supprimer définitivement), même entête de grille que
		 la grille des tâches (page Planning). Styles copiés/adaptés de TrashPage.xaml (page la
		 plus proche du besoin ici : pas de filtres façon Excel, juste sélection + actions),
		 par choix volontaire de ne pas centraliser les styles entre pages (voir CLAUDE.md). -->
	<UserControl.Resources>

		<Style x:Key="SmallButtonStyle" TargetType="Button">
			<Setter Property="Height" Value="28"/>
			<Setter Property="Padding" Value="8,0"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="Foreground" Value="#111827"/>
			<Setter Property="BorderBrush" Value="#D1D5DB"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="6">
							<ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
							</Trigger>
							<!-- ✅ Fix (04.08.2026, demande de Joe : "tu n'as pas grisé les boutons") :
							     un ControlTemplate custom ignore l'état IsEnabled=False par défaut, il
							     faut un Trigger explicite, mêmes valeurs que ArchivesPage.xaml. -->
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
								<Setter TargetName="Bd" Property="BorderBrush" Value="#D1D5DB"/>
								<Setter Property="Foreground" Value="#9CA3AF"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="DangerSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
			<Setter Property="Foreground" Value="#B91C1C"/>
			<Setter Property="BorderBrush" Value="#FCA5A5"/>
		</Style>

		<Style x:Key="RestoreSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
			<Setter Property="Foreground" Value="#15803D"/>
			<Setter Property="BorderBrush" Value="#15803D"/>
		</Style>

		<!-- ✅ TextBox (pas TextBlock) en lecture seule : bloque la saisie mais laisse la
			 sélection de texte + Ctrl+C fonctionner normalement. -->
		<Style x:Key="GridReadOnlyTextStyle" TargetType="TextBox">
			<Setter Property="IsReadOnly" Value="True"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="TextWrapping" Value="NoWrap"/>
			<Setter Property="IsUndoEnabled" Value="False"/>
			<Setter Property="Focusable" Value="True"/>
		</Style>

		<!-- CheckBox centrée -->
		<Style x:Key="GridCheckBoxCellStyle" TargetType="CheckBox">
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="Padding" Value="0"/>
		</Style>

		<!-- ✅ Filtres façon Excel dans les en-têtes de colonne (demande de Joe : "comme dans
			 Archives des bons d'intervention"), styles copiés tels quels d'ArchivesPage.xaml. -->
		<Style x:Key="FilterHeaderButtonStyle" TargetType="Button">
			<Setter Property="Width" Value="16"/>
			<Setter Property="Height" Value="16"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#6B7280"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="FontSize" Value="9"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" CornerRadius="3">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#E5E7EB"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="FilterHeaderButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource FilterHeaderButtonStyle}">
			<Setter Property="Foreground" Value="#1D4ED8"/>
			<Setter Property="FontWeight" Value="Bold"/>
		</Style>

		<Style x:Key="FilterHeaderHighlightBorderStyle" TargetType="Border">
			<Setter Property="BorderThickness" Value="2"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Padding" Value="4,2"/>
		</Style>

		<!-- ✅ Boutons OK/Annuler du popup de filtre, copiés tels quels de PlanningPage.xaml
			 (demande de Joe : "comme dans grille des tâches") : remplace SmallButtonStyle
			 (gris) utilisé lors du 1er essai. -->
		<Style x:Key="SmallBlueButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="#2563EB"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderBrush" Value="#1D4ED8"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="10,0"/>
			<Setter Property="Height" Value="22"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Right"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="6"
								SnapsToDevicePixels="True">
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center"
											  Margin="{TemplateBinding Padding}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
								<Setter TargetName="Bd" Property="BorderBrush" Value="#1E40AF"/>
								<Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="#1E40AF"/>
								<Setter TargetName="Bd" Property="BorderBrush" Value="#1E3A8A"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="Bd" Property="Background" Value="#93C5FD"/>
								<Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD"/>
								<Setter Property="Foreground" Value="#F9FAFB"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="OutlineBlueButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallBlueButtonStyle}">
			<Setter Property="Background" Value="White"/>
			<Setter Property="Foreground" Value="#2563EB"/>
			<Setter Property="BorderBrush" Value="#2563EB"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="6"
								SnapsToDevicePixels="True">
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center"
											  Margin="{TemplateBinding Padding}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
								<Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="Bd" Property="BorderBrush" Value="#BFDBFE"/>
								<Setter Property="Foreground" Value="#BFDBFE"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- DataGrid -->
		<Style x:Key="GridStyle" TargetType="DataGrid">
			<Setter Property="AutoGenerateColumns" Value="False"/>
			<Setter Property="CanUserAddRows" Value="False"/>
			<Setter Property="CanUserDeleteRows" Value="False"/>

			<Setter Property="GridLinesVisibility" Value="All"/>
			<Setter Property="VerticalGridLinesBrush" Value="#E5E7EB"/>
			<Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>

			<Setter Property="HeadersVisibility" Value="Column"/>
			<Setter Property="RowHeight" Value="36"/>
			<Setter Property="ColumnHeaderHeight" Value="34"/>

			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="#D1D5DB"/>

			<Setter Property="Background" Value="White"/>
			<Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>

			<Setter Property="SelectionMode" Value="Single"/>
			<Setter Property="SelectionUnit" Value="FullRow"/>

			<Setter Property="FontSize" Value="13"/>
			<Setter Property="IsReadOnly" Value="True"/>

			<Setter Property="RowStyle">
				<Setter.Value>
					<Style TargetType="DataGridRow">
						<Setter Property="Background" Value="Transparent"/>
						<Setter Property="BorderBrush" Value="Transparent"/>
						<Setter Property="BorderThickness" Value="0"/>
						<Setter Property="SnapsToDevicePixels" Value="True"/>

						<Style.Triggers>
							<Trigger Property="IsSelected" Value="True">
								<Setter Property="BorderBrush" Value="#2563EB"/>
								<Setter Property="BorderThickness" Value="2"/>
								<Setter Property="Background" Value="Transparent"/>
							</Trigger>
						</Style.Triggers>
					</Style>
				</Setter.Value>
			</Setter>

			<Setter Property="CellStyle">
				<Setter.Value>
					<Style TargetType="DataGridCell">
						<Setter Property="VerticalContentAlignment" Value="Stretch"/>
						<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
						<Setter Property="Padding" Value="6,0"/>
						<Setter Property="BorderBrush" Value="#E5E7EB"/>
						<Setter Property="BorderThickness" Value="0,0,1,1"/>
						<Setter Property="Background" Value="Transparent"/>
						<Style.Triggers>
							<Trigger Property="IsSelected" Value="True">
								<Setter Property="Background" Value="Transparent"/>
							</Trigger>
						</Style.Triggers>
					</Style>
				</Setter.Value>
			</Setter>

			<Setter Property="ColumnHeaderStyle">
				<Setter.Value>
					<Style TargetType="DataGridColumnHeader">
						<Setter Property="VerticalContentAlignment" Value="Center"/>
						<Setter Property="HorizontalContentAlignment" Value="Center"/>
						<Setter Property="Padding" Value="6,0"/>
						<Setter Property="BorderBrush" Value="#D1D5DB"/>
						<Setter Property="BorderThickness" Value="0,0,1,1"/>
						<Setter Property="Foreground" Value="#111827"/>
						<Setter Property="FontWeight" Value="Bold"/>
					</Style>
				</Setter.Value>
			</Setter>
		</Style>

	</UserControl.Resources>

	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- ✅ Popup de filtre façon Excel, partagé par toutes les colonnes filtrables (demande
			 de Joe : "comme dans Archives des bons d'intervention"), copié/simplifié
			 d'ArchivesPage.xaml (pas de colonnes date ici, donc pas de DateFilterPanel). -->
		<Popup x:Name="ColumnFilterPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
			<Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="8" MinWidth="220" MaxHeight="380" Effect="{StaticResource CardShadowEffect}">
				<StackPanel>
					<CheckBox x:Name="AlphaSortCheckBox"
					          Content="Trier par ordre alphabétique (A→Z)"
					          Margin="0,0,0,8"/>

					<Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Margin="0,0,0,6"/>

					<CheckBox x:Name="FilterSelectAllCheckBox"
					          Content="(Tout sélectionner)"
					          IsChecked="True"
					          FontWeight="Bold"
					          Click="FilterSelectAllCheckBox_Click"
					          Margin="0,0,0,6"/>

					<ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
						<ItemsControl x:Name="FilterOptionsItemsControl">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<CheckBox Content="{Binding DisplayText}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,2"/>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>

					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
						<Button Content="Annuler" Style="{StaticResource OutlineBlueButtonStyle}" Click="ColumnFilterCancel_Click" Margin="0,0,6,0"/>
						<Button Content="OK" Style="{StaticResource SmallBlueButtonStyle}" Click="ColumnFilterApply_Click"/>
					</StackPanel>
				</StackPanel>
			</Border>
		</Popup>

		<!-- BARRE -->
		<Border Grid.Row="0"
				Background="White"
				BorderBrush="#E5E7EB"
				BorderThickness="1"
				CornerRadius="12"
				Padding="8"
				Margin="0,0,0,8"
				Effect="{StaticResource CardShadowEffect}">

			<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
				<TextBlock Text="Archives tâches"
						   FontSize="18"
						   FontWeight="SemiBold"
						   Foreground="#111827"
						   Margin="0,0,10,0"/>

				<Button x:Name="RestoreSelectionButton"
						Content="Restaurer sélection"
						Style="{StaticResource RestoreSmallButtonStyle}"
						Click="RestoreSelected_Click"
						IsEnabled="False"
						Height="34"
						Margin="0,0,6,0"/>

				<!-- ✅ Renommé (demande de Joe, 04.08.2026) : "Supprimer définitivement" devient
				     "Déplacer dans la corbeille" (voir DeleteSelected_Click, IsTrashed/
				     TrashedAt), même principe que "Corbeille sélection" côté Bons. -->
				<Button x:Name="DeleteSelectionButton"
						Content="Déplacer dans la corbeille"
						Style="{StaticResource DangerSmallButtonStyle}"
						Click="DeleteSelected_Click"
						IsEnabled="False"
						Height="34"
						Margin="0,0,6,0"/>

				<Button Content="Rafraîchir"
						Style="{StaticResource SmallButtonStyle}"
						Height="34"
						Margin="0,0,6,0"
						Click="Refresh_Click"/>

				<!-- ✅ Retour (04.08.2026, demande de Joe) : Archives tâches n'a plus de bouton
				     dédié dans le menu global (voir MainWindow.xaml), accès désormais via
				     "Planification", ce bouton ramène à la page d'origine. Déplacé à côté de
				     "Rafraîchir" (demande de Joe, 04.08.2026). -->
				<Button Content="Page planification"
				        Style="{StaticResource SmallButtonStyle}"
				        BorderBrush="Black"
				        Height="34"
				        Margin="0,0,6,0"
				        Click="BackToParent_Click"/>

				<!-- ✅ Accès direct à l'autre sous-page (demande de Joe, 04.08.2026) : depuis
				     Archives tâches, va directement à Corbeille tâches sans repasser par
				     "Planification". Fond rouge clair, même couleur que "Page corbeille". -->
				<Button Content="Page corbeille"
				        Style="{StaticResource SmallButtonStyle}"
				        Background="#FEE2E2"
				        Foreground="#B91C1C"
				        BorderBrush="#B91C1C"
				        Height="34"
				        Click="GoToTrash_Click"/>
			</StackPanel>
		</Border>

		<!-- TABLEAU -->
		<Border Grid.Row="1"
				Background="White"
				BorderBrush="#E5E7EB"
				BorderThickness="1"
				CornerRadius="12"
				Padding="10"
				Effect="{StaticResource CardShadowEffect}">

			<!-- ✅ Fix (même piège que PlanningPage.xaml, "je ne vois aucun filtre") :
				 ColumnHeaderHeight surchargé à 44 (au lieu des 34 de GridStyle). Les en-têtes
				 filtrables ont 2 lignes (libellé + bouton ▾), 34px ne laissait aucune place
				 visible pour la 2e ligne, le bouton était rogné/invisible. -->
			<DataGrid x:Name="ArchivedTasksGrid"
					  Style="{StaticResource GridStyle}"
					  ColumnWidth="Auto"
					  ColumnHeaderHeight="44"
					  SelectionChanged="ArchivedTasksGrid_SelectionChanged">

				<DataGrid.Columns>

					<!-- Sélection -->
					<DataGridTemplateColumn Width="31" IsReadOnly="True">
						<DataGridTemplateColumn.HeaderTemplate>
							<DataTemplate>
								<CheckBox x:Name="SelectAllCheckBox"
										  Style="{StaticResource GridCheckBoxCellStyle}"
										  Click="SelectAllCheckBox_Click"/>
							</DataTemplate>
						</DataGridTemplateColumn.HeaderTemplate>

						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<CheckBox Style="{StaticResource GridCheckBoxCellStyle}"
										  IsChecked="{Binding IsSelected, Mode=TwoWay}"
										  Click="RowSelectCheckBox_Click"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- N° -->
					<DataGridTemplateColumn Header="N°" Width="60" IsReadOnly="True">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<TextBox Style="{StaticResource GridReadOnlyTextStyle}"
										 Text="{Binding Task.Ref, Mode=OneWay}"
										 TextAlignment="Center"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- Bâtiment (libellé dynamique) -->
					<DataGridTemplateColumn Width="Auto" MinWidth="90" IsReadOnly="True">
						<DataGridTemplateColumn.Header>
							<Border x:Name="BuildingHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
								<StackPanel Orientation="Vertical" HorizontalAlignment="Center">
									<TextBlock x:Name="BuildingHeaderText" Text="Bâtiment" HorizontalAlignment="Center"/>
									<Button x:Name="BuildingFilterButton" Content="▾" Tag="Building"
											Style="{StaticResource FilterHeaderButtonStyle}"
											Click="ColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
								</StackPanel>
							</Border>
						</DataGridTemplateColumn.Header>
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<TextBox Style="{StaticResource GridReadOnlyTextStyle}"
										 Text="{Binding Task.Building, Mode=OneWay}"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- Étage (libellé dynamique) -->
					<DataGridTemplateColumn Width="Auto" MinWidth="80" IsReadOnly="True">
						<DataGridTemplateColumn.Header>
							<Border x:Name="FloorHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
								<StackPanel Orientation="Vertical" HorizontalAlignment="Center">
									<TextBlock x:Name="FloorHeaderText" Text="Étage" HorizontalAlignment="Center"/>
									<Button x:Name="FloorFilterButton" Content="▾" Tag="Floor"
											Style="{StaticResource FilterHeaderButtonStyle}"
											Click="ColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
								</StackPanel>
							</Border>
						</DataGridTemplateColumn.Header>
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<TextBox Style="{StaticResource GridReadOnlyTextStyle}"
										 Text="{Binding Task.Floor, Mode=OneWay}"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- Descriptif -->
					<DataGridTemplateColumn Header="Descriptif" Width="*" MinWidth="140" IsReadOnly="True">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<TextBox Style="{StaticResource GridReadOnlyTextStyle}"
										 Text="{Binding Task.Todo, Mode=OneWay}"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- Catégorie (libellé dynamique) -->
					<DataGridTemplateColumn Width="Auto" MinWidth="90" IsReadOnly="True">
						<DataGridTemplateColumn.Header>
							<Border x:Name="CategoryHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
								<StackPanel Orientation="Vertical" HorizontalAlignment="Center">
									<TextBlock x:Name="CategoryHeaderText" Text="Cat." HorizontalAlignment="Center"/>
									<Button x:Name="CategoryFilterButton" Content="▾" Tag="Category"
											Style="{StaticResource FilterHeaderButtonStyle}"
											Click="ColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
								</StackPanel>
							</Border>
						</DataGridTemplateColumn.Header>
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<TextBox Style="{StaticResource GridReadOnlyTextStyle}"
										 Text="{Binding Task.Category, Mode=OneWay}"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- Entreprise (libellé dynamique, avec couleur) -->
					<DataGridTemplateColumn Width="Auto" MinWidth="110" IsReadOnly="True">
						<DataGridTemplateColumn.Header>
							<Border x:Name="CompanyHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
								<StackPanel Orientation="Vertical" HorizontalAlignment="Center">
									<TextBlock x:Name="CompanyHeaderText" Text="Entreprise" HorizontalAlignment="Center"/>
									<Button x:Name="CompanyFilterButton" Content="▾" Tag="Company"
											Style="{StaticResource FilterHeaderButtonStyle}"
											Click="ColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
								</StackPanel>
							</Border>
						</DataGridTemplateColumn.Header>
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Border Background="{Binding CompanyBrush}" CornerRadius="2" Padding="6,0">
									<TextBox Style="{StaticResource GridReadOnlyTextStyle}"
											 Text="{Binding Task.Company, Mode=OneWay}"
											 Foreground="{Binding CompanyTextBrush}"
											 FontWeight="Bold"
											 TextAlignment="Center"
											 Background="Transparent"/>
								</Border>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- Urg. (libellé dynamique) -->
					<DataGridTemplateColumn Width="Auto" MinWidth="52" IsReadOnly="True">
						<DataGridTemplateColumn.Header>
							<Border x:Name="UrgencyHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
								<StackPanel Orientation="Vertical" HorizontalAlignment="Center">
									<TextBlock x:Name="UrgencyHeaderText" Text="Urg." HorizontalAlignment="Center"/>
									<Button x:Name="UrgencyFilterButton" Content="▾" Tag="Urgency"
											Style="{StaticResource FilterHeaderButtonStyle}"
											Click="ColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
								</StackPanel>
							</Border>
						</DataGridTemplateColumn.Header>
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<TextBox Style="{StaticResource GridReadOnlyTextStyle}"
										 Text="{Binding Task.Urgent, Mode=OneWay}"
										 TextAlignment="Center"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- Effectué -->
					<DataGridTemplateColumn Width="80" IsReadOnly="True">
						<DataGridTemplateColumn.Header>
							<Border x:Name="DoneHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
								<StackPanel Orientation="Vertical" HorizontalAlignment="Center">
									<TextBlock Text="Effectué" HorizontalAlignment="Center"/>
									<Button x:Name="DoneFilterButton" Content="▾" Tag="Done"
											Style="{StaticResource FilterHeaderButtonStyle}"
											Click="ColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
								</StackPanel>
							</Border>
						</DataGridTemplateColumn.Header>
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Border CornerRadius="4" Padding="0">
									<Border.Style>
										<Style TargetType="Border">
											<Setter Property="Background" Value="Transparent"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding Task.Done}" Value="True">
													<Setter Property="Background" Value="#C7F9C7"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Border.Style>
									<CheckBox Style="{StaticResource GridCheckBoxCellStyle}"
											  IsChecked="{Binding Task.Done, Mode=OneWay}"
											  IsHitTestVisible="False"/>
								</Border>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- Actions -->
					<DataGridTemplateColumn Header="Actions" Width="150" IsReadOnly="True">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<StackPanel Orientation="Horizontal">
									<Button Content="↩"
											ToolTip="Restaurer"
											Style="{StaticResource RestoreSmallButtonStyle}"
											Click="RestoreRow_Click"
											Margin="0,0,4,0"/>

									<Button ToolTip="Corbeille"
											Style="{StaticResource DangerSmallButtonStyle}"
											Click="TrashRow_Click">
										<Path Data="{StaticResource IconTrashGeometry}"
											  Width="12" Height="12" Stretch="Uniform"
											  Fill="Transparent" StrokeThickness="1.3" StrokeLineJoin="Round"
											  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
									</Button>
								</StackPanel>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

				</DataGrid.Columns>
			</DataGrid>
		</Border>

	</Grid>
</UserControl>
