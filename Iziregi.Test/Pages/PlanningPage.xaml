<!-- File: Pages/PlanningPage.xaml -->
<UserControl x:Class="Iziregi.Test.Pages.PlanningPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Iziregi.Test.Pages"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1100">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Converters couleur entreprise -->
        <local:CompanyNameToBrushConverter x:Key="CompanyBgConverter"/>
        <local:CompanyNameToTextBrushConverter x:Key="CompanyFgConverter"/>

        <!-- ✅ Cell color only if not empty -->
        <local:CellTextAndCompanyToBrushConverter x:Key="CellCompanyColorIfNotEmptyConverter"/>
        <!-- ✅ Cell foreground (contrast) only if not empty -->
        <local:CellTextAndCompanyToTextBrushConverter x:Key="CellCompanyTextColorIfNotEmptyConverter"/>

        <!-- ✅ NEW: TextBox sticker posé (drag au clic, édition au double-clic) -->
        <Style x:Key="PlacedStickerTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MaxLength" Value="2"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="IsReadOnly" Value="False"/>
                    <Setter Property="Cursor" Value="IBeam"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SmallBlueButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
						        Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}"
						        BorderThickness="{TemplateBinding BorderThickness}"
						        CornerRadius="6"
						        SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
							                  VerticalAlignment="Center"
							                  Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E40AF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E3A8A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#93C5FD"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD"/>
                                <Setter Property="Foreground" Value="#F9FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallBlackButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallBlueButtonStyle}">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#111827"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
						        Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}"
						        BorderThickness="{TemplateBinding BorderThickness}"
						        CornerRadius="6"
						        SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
							                  VerticalAlignment="Center"
							                  Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#374151"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#374151"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4B5563"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#9CA3AF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#9CA3AF"/>
                                <Setter Property="Foreground" Value="#F9FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlanningDatePickerStyle" TargetType="DatePicker">
            <Setter Property="SelectedDateFormat" Value="Short"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PlanningGridStyle" TargetType="DataGrid">
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="24"/>
            <Setter Property="ColumnHeaderHeight" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="CellOrRowHeader"/>

            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>

            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="BorderThickness" Value="0,2,0,2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>

            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="6,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#111827"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>

            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="#111827"/>
                        <Setter Property="BorderBrush" Value="Black"/>
                        <Setter Property="BorderThickness" Value="0,0,1,2"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="6,0"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="CompanyComboStyle" TargetType="ComboBox" BasedOn="{StaticResource GridComboStyle}">
            <Setter Property="IsEditable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
							              Focusable="False"
							              ClickMode="Press"
							              HorizontalContentAlignment="Stretch"
							              VerticalContentAlignment="Center"
							              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
							              Background="Transparent"
							              BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
									                  Margin="4,0,0,0"
									                  VerticalAlignment="Center"
									                  HorizontalAlignment="Stretch"
									                  Content="{TemplateBinding SelectionBoxItem}">
                                        <ContentPresenter.ContentTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
												           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ComboBox}, Path=Foreground}"/>
                                            </DataTemplate>
                                        </ContentPresenter.ContentTemplate>
                                    </ContentPresenter>

                                    <Path Grid.Column="1"
									      Data="M 0 0 L 4 4 L 8 0 Z"
									      Fill="#6B7280"
									      HorizontalAlignment="Center"
									      VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>

                            <Popup x:Name="Popup"
							       Placement="Bottom"
							       IsOpen="{TemplateBinding IsDropDownOpen}"
							       AllowsTransparency="True"
							       Focusable="False"
							       PopupAnimation="Fade">
                                <Border Background="White"
								        BorderBrush="#D1D5DB"
								        BorderThickness="1"
								        CornerRadius="6"
								        SnapsToDevicePixels="True">
                                    <ScrollViewer Margin="2"
									              SnapsToDevicePixels="True"
									              VerticalScrollBarVisibility="Auto"
									              HorizontalScrollBarVisibility="Disabled"
									              Background="White">
                                        <ItemsPresenter>
                                            <ItemsPresenter.Resources>
                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="Foreground" Value="#111827"/>
                                                    <Setter Property="Padding" Value="6,4"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter Property="Background" Value="#F3F4F6"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#E5E7EB"/>
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground" Value="#9CA3AF"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsPresenter.Resources>
                                        </ItemsPresenter>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextZoneRichTextBoxStyle" TargetType="RichTextBox">
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="72"/>
        </Style>

        <Style x:Key="CompanyColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
						        Background="{TemplateBinding Background}"
						        BorderBrush="Black"
						        BorderThickness="1"
						        CornerRadius="999"
						        SnapsToDevicePixels="True"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="Black"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="Black"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ✅ Titre "Planning" supprimé -->

            <TextBlock Grid.Column="2"
			           x:Name="WeekTextBlock"
			           Text="Semaine …"
			           Foreground="#111827"
			           FontWeight="SemiBold"
			           VerticalAlignment="Center"/>

            <TextBlock Grid.Column="4"
			           Text="Début semaine :"
			           Foreground="#374151"
			           VerticalAlignment="Center"/>

            <ComboBox x:Name="StartWeekdayCombo"
			          Grid.Column="6"
			          Width="110"
			          Height="24"
			          VerticalContentAlignment="Center"
			          Margin="0,0,0,0"
			          DisplayMemberPath="Label"
			          SelectedValuePath="Value"
			          SelectionChanged="StartWeekdayCombo_SelectionChanged"/>

            <TextBlock Grid.Column="8"
			           Text="Date de départ :"
			           Foreground="#374151"
			           VerticalAlignment="Center"/>

            <DatePicker x:Name="StartDatePicker"
			            Grid.Column="10"
			            Style="{StaticResource PlanningDatePickerStyle}"
			            SelectedDateChanged="StartDatePicker_SelectedDateChanged"/>

            <TextBlock Grid.Column="12"
			           Text="Date de fin :"
			           Foreground="#374151"
			           VerticalAlignment="Center"/>

            <DatePicker x:Name="EndDatePicker"
			            Grid.Column="13"
			            Style="{StaticResource PlanningDatePickerStyle}"
			            SelectedDateChanged="EndDatePicker_SelectedDateChanged"/>
        </Grid>

        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1) Tâches -->
                <Border x:Name="TaskSectionBorder"
                        Grid.Row="0"
				        BorderBrush="Black"
				        BorderThickness="1"
				        CornerRadius="10"
				        Padding="10"
				        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel x:Name="TaskHeaderToolbar"
                                   Grid.Row="0"
                                   Margin="0,0,0,8"
                                   LastChildFill="False">
                            <TextBlock Text="Tâches"
							           FontSize="14"
							           FontWeight="SemiBold"
							           Foreground="#111827"
							           DockPanel.Dock="Left"/>

                            <Button x:Name="RemoveTaskRowButton"
							        Content="Supprimer"
							        Style="{StaticResource SmallBlackButtonStyle}"
							        DockPanel.Dock="Right"
							        Margin="8,0,0,0"
							        Click="RemoveTaskRowButton_Click"/>

                            <Button x:Name="AddTaskRowButton"
							        Content="Ajouter"
							        Style="{StaticResource SmallBlueButtonStyle}"
							        DockPanel.Dock="Right"
							        Click="AddTaskRowButton_Click"/>
                        </DockPanel>

                        <DataGrid x:Name="TasksDataGrid"
						          Grid.Row="1"
						          Style="{StaticResource PlanningGridStyle}"
						          AutoGenerateColumns="False"
						          CanUserAddRows="False"
						          RowHeaderWidth="0"
						          Background="White"
						          BorderBrush="Black"
						          BorderThickness="1"
						          IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn x:Name="TaskRefColumn" Header="N° Réf." Width="60" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="0" Padding="0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource CompanyBgConverter}">
                                                                    <Binding Path="Company"/>
                                                                    <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Company}" Value="">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Company}" Value="{x:Null}">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <TextBlock Text="{Binding Ref}"
												           HorizontalAlignment="Center"
												           VerticalAlignment="Center"
												           FontWeight="SemiBold">
                                                    <TextBlock.Foreground>
                                                        <MultiBinding Converter="{StaticResource CompanyFgConverter}">
                                                            <Binding Path="Company"/>
                                                            <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="TaskCompanyColumn" Header="Entreprise" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource CompanyBgConverter}">
                                                                    <Binding Path="Company"/>
                                                                    <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Company}" Value="">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Company}" Value="{x:Null}">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <ComboBox Style="{StaticResource CompanyComboStyle}"
												          ItemsSource="{Binding DataContext.Companies, RelativeSource={RelativeSource AncestorType=UserControl}}"
												          SelectedItem="{Binding Company, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <ComboBox.Foreground>
                                                        <MultiBinding Converter="{StaticResource CompanyFgConverter}">
                                                            <Binding Path="Company"/>
                                                            <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </ComboBox.Foreground>
                                                </ComboBox>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="TaskBuildingColumn" Header="Bâtiment" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource GridComboStyle}"
											          ItemsSource="{Binding DataContext.Buildings, RelativeSource={RelativeSource AncestorType=UserControl}}"
											          SelectedItem="{Binding Building, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="TaskFloorColumn" Header="Étage" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource GridComboStyle}"
											          ItemsSource="{Binding DataContext.Floors, RelativeSource={RelativeSource AncestorType=UserControl}}"
											          SelectedItem="{Binding Floor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn x:Name="TaskTodoColumn" Header="Descriptif" Width="*" Binding="{Binding Todo}"/>

                                <DataGridTemplateColumn x:Name="TaskCategoryColumn" Header="Cat." Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource GridComboStyle}"
											          ItemsSource="{Binding DataContext.PlanningTextZones, RelativeSource={RelativeSource AncestorType=UserControl}}"
											          SelectedItem="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="TaskReserveColumn" Header="Concerne" Width="110" Visibility="Collapsed">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource GridComboStyle}"
											          ItemsSource="{Binding DataContext.Reserves, RelativeSource={RelativeSource AncestorType=UserControl}}"
											          SelectedItem="{Binding Reserve, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="TaskDoneColumn" Header="Effectué" Width="72">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="DoneCellBorder" Background="Transparent" CornerRadius="4" Padding="0">
                                                <CheckBox x:Name="TaskDoneCheckBox"
												          HorizontalAlignment="Center"
												          VerticalAlignment="Center"
												          IsChecked="{Binding Done, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Done}" Value="True">
                                                    <Setter TargetName="DoneCellBorder" Property="Background" Value="#C7F9C7"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- 2) Planning hebdo -->
                <Border x:Name="WeeklySectionBorder"
                        Grid.Row="1"
				        BorderBrush="Black"
				        BorderThickness="1"
				        CornerRadius="10"
				        Padding="10"
				        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel x:Name="WeeklyHeaderToolbar"
                                   Grid.Row="0"
                                   Margin="0,0,0,8"
                                   LastChildFill="False">
                            <TextBlock Text="Planning hebdomadaire"
							           FontSize="14"
							           FontWeight="SemiBold"
							           Foreground="#111827"
							           DockPanel.Dock="Left"/>

                            <Button x:Name="ToggleSaturdayButton"
							        Content="Afficher samedi"
							        Style="{StaticResource SmallBlueButtonStyle}"
							        DockPanel.Dock="Right"
							        Margin="8,0,0,0"
							        Click="ToggleSaturdayButton_Click"/>

                            <Button x:Name="RemovePlanningRowButton"
							        Content="Supprimer"
							        Style="{StaticResource SmallBlackButtonStyle}"
							        DockPanel.Dock="Right"
							        Margin="8,0,0,0"
							        Click="RemovePlanningRowButton_Click"/>

                            <Button x:Name="AddPlanningRowButton"
							        Content="Ajouter"
							        Style="{StaticResource SmallBlueButtonStyle}"
							        DockPanel.Dock="Right"
							        Click="AddPlanningRowButton_Click"/>
                        </DockPanel>

