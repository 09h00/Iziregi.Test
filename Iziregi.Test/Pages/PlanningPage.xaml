<!-- File: Pages/PlanningPage.xaml -->
<UserControl x:Class="Iziregi.Test.Pages.PlanningPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Iziregi.Test.Pages"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1100">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Converters couleur entreprise -->
        <local:CompanyNameToBrushConverter x:Key="CompanyBgConverter"/>
        <local:CompanyNameToTextBrushConverter x:Key="CompanyFgConverter"/>
        <local:UrgencyToBrushConverter x:Key="UrgencyBgConverter"/>
        <local:UrgencyToForegroundConverter x:Key="UrgencyFgConverter"/>
        <local:TodoFirstLineConverter x:Key="TodoFirstLineConverter"/>
        <local:TodoShowPencilConverter x:Key="TodoShowPencilConverter"/>
        <local:TodoShowVoirPlusConverter x:Key="TodoShowVoirPlusConverter"/>

        <!-- ✅ Cell color only if not empty -->
        <local:CellTextAndCompanyToBrushConverter x:Key="CellCompanyColorIfNotEmptyConverter"/>
        <!-- ✅ Cell foreground (contrast) only if not empty -->
        <local:CellTextAndCompanyToTextBrushConverter x:Key="CellCompanyTextColorIfNotEmptyConverter"/>

        <!-- ✅ NEW: TextBox sticker posé (drag au clic, édition au double-clic) -->
        <Style x:Key="PlacedStickerTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <!-- ✅ 4 chiffres (numérotation de tâche annuelle) au lieu de 2 -->
            <Setter Property="MaxLength" Value="4"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="IsReadOnly" Value="False"/>
                    <Setter Property="Cursor" Value="IBeam"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ✅ Boutons arrondis + bordure noire, section "zones de texte" (25.07.2026,
             demande de Joe). Preserve le Content existant (texte simple ou StackPanel
             personnalisé comme FontColorButton/FillColorButton).
             ✅ Reste noir (demande de Joe, 04.08.2026) : seuls les boutons à FOND noir plein
             (SmallBlackButtonStyle) passent en rouge, pas ceux qui n'ont qu'une bordure/police
             noire comme ceux qui utilisent ce style-ci. -->
        <Style x:Key="TextZoneToolButtonStyle" TargetType="Button">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- ✅ 29.07.2026 (demande de Joe) : bordure plus épaisse au survol. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextZoneToolToggleStyle" TargetType="ToggleButton">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallBlueButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
						        Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}"
						        BorderThickness="{TemplateBinding BorderThickness}"
						        CornerRadius="6"
						        SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
							                  VerticalAlignment="Center"
							                  Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- ✅ 29.07.2026 (demande de Joe) : bordure plus épaisse au survol. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E40AF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E40AF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E3A8A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#93C5FD"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD"/>
                                <Setter Property="Foreground" Value="#F9FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ Fond blanc + police/bordure rouges (demande de Joe, remplace le fond noir plein) :
             même principe que OutlineBlueButtonStyle/ArchiveOutlineButtonStyle (survol = juste
             bordure plus épaisse, pas de changement de fond, sauf pression = léger fond teinté).
             Clé inchangée (SmallBlackButtonStyle) pour ne pas devoir retoucher tous ses usages
             dans cette page ni AutoAddToggleButton.Style (PlanningPage.xaml.cs). -->
        <Style x:Key="SmallBlackButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallBlueButtonStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
						        Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}"
						        BorderThickness="{TemplateBinding BorderThickness}"
						        CornerRadius="6"
						        SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
							                  VerticalAlignment="Center"
							                  Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Bd" Property="Background" Value="#FEF2F2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FECACA"/>
                                <Setter Property="Foreground" Value="#FECACA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ Flèches de navigation semaine (◀/▶, demande de Joe, 04.08.2026) : fond blanc,
             police/bordure noires, distinct de SmallBlackButtonStyle (passé au rouge juste
             avant), ces deux boutons-là doivent rester noirs. Même principe de survol que les
             autres styles "outline" (bordure plus épaisse, léger fond gris à l'appui). -->
        <Style x:Key="WeekNavButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallBlueButtonStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
						        Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}"
						        BorderThickness="{TemplateBinding BorderThickness}"
						        CornerRadius="6"
						        SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
							                  VerticalAlignment="Center"
							                  Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D1D5DB"/>
                                <Setter Property="Foreground" Value="#D1D5DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ Bouton "Colonnes" : blanc/bleu — au survol, juste une bordure plus épaisse
             (pas de fond noir comme SmallBlackButtonStyle). -->
        <Style x:Key="OutlineBlueButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallBlueButtonStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
						        Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}"
						        BorderThickness="{TemplateBinding BorderThickness}"
						        CornerRadius="6"
						        SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
							                  VerticalAlignment="Center"
							                  Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#BFDBFE"/>
                                <Setter Property="Foreground" Value="#BFDBFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ Bouton "Archiver sélection" (30.07.2026, demande de Joe) : même vert que
             "Archiver" dans Dashboard (ArchiveSmallButtonStyle, #15803D). -->
        <!-- ✅ Gris neutre (demande de Joe, 04.08.2026) : convention plus courante pour
             "Archiver" (action réversible, non destructive), remplace le vert précédent qui
             évoque plutôt une action positive/validation. -->
        <Style x:Key="ArchiveOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallBlueButtonStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
						        Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}"
						        BorderThickness="{TemplateBinding BorderThickness}"
						        CornerRadius="6"
						        SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
							                  VerticalAlignment="Center"
							                  Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D1D5DB"/>
                                <Setter Property="Foreground" Value="#D1D5DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlanningDatePickerStyle" TargetType="DatePicker">
            <!-- ✅ Retour au format court "13.07.2026" (19.07.2026) : le format long
                 ("lundi, 13 juillet 2026") essayé juste avant prenait trop de place dans
                 l'en-tête "Planning hebdomadaire" (le bouton "Ajouter" sortait de l'écran),
                 Joe a préféré revenir au format court plutôt que complexifier davantage. -->
            <Setter Property="SelectedDateFormat" Value="Short"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PlanningGridStyle" TargetType="DataGrid">
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <!-- ✅ Taille normale à l'écran (18.07.2026, retour à l'original : Joe ne veut pas
                 que l'agrandissement demandé pour le PDF change l'affichage à l'écran). La
                 police est agrandie UNIQUEMENT pendant la capture PDF, temporairement, voir
                 PlanningPage.xaml.cs, PreparePdfCaptureUi / ExportPdfButton_Click. -->
            <Setter Property="RowHeight" Value="24"/>
            <Setter Property="ColumnHeaderHeight" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="CellOrRowHeader"/>

            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>

            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="BorderThickness" Value="0,2,0,2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>

            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="6,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#111827"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>

            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="#111827"/>
                        <Setter Property="BorderBrush" Value="#D1D5DB"/>
                        <Setter Property="BorderThickness" Value="0,0,1,2"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="6,0"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="CompanyComboStyle" TargetType="ComboBox" BasedOn="{StaticResource GridComboStyle}">
            <Setter Property="IsEditable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
							              Focusable="False"
							              ClickMode="Press"
							              HorizontalContentAlignment="Stretch"
							              VerticalContentAlignment="Center"
							              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
							              Background="Transparent"
							              BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
									                  Margin="4,0,0,0"
									                  VerticalAlignment="Center"
									                  HorizontalAlignment="Center"
									                  Content="{TemplateBinding SelectionBoxItem}">
                                        <ContentPresenter.ContentTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
												           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ComboBox}, Path=Foreground}"/>
                                            </DataTemplate>
                                        </ContentPresenter.ContentTemplate>
                                    </ContentPresenter>

                                    <Path Grid.Column="1"
									      Data="M 0 0 L 4 4 L 8 0 Z"
									      Fill="#6B7280"
									      HorizontalAlignment="Center"
									      VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>

                            <Popup x:Name="Popup"
							       Placement="Bottom"
							       IsOpen="{TemplateBinding IsDropDownOpen}"
							       AllowsTransparency="True"
							       Focusable="False"
							       PopupAnimation="Fade">
                                <Border Background="White"
								        BorderBrush="#D1D5DB"
								        BorderThickness="1"
								        CornerRadius="6"
								        SnapsToDevicePixels="True">
                                    <ScrollViewer Margin="2"
									              SnapsToDevicePixels="True"
									              VerticalScrollBarVisibility="Auto"
									              HorizontalScrollBarVisibility="Disabled"
									              Background="White">
                                        <ItemsPresenter>
                                            <ItemsPresenter.Resources>
                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="Foreground" Value="#111827"/>
                                                    <Setter Property="Padding" Value="6,4"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter Property="Background" Value="#F3F4F6"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#E5E7EB"/>
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground" Value="#9CA3AF"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsPresenter.Resources>
                                        </ItemsPresenter>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ Combo "Urg." dédié : GridComboStyle (utilisé par Bâtiment/Étage/Cat.) ne
             surcharge PAS le Template du ComboBox — le chrome par défaut du thème Windows
             reste opaque (fond blanc) même avec Background="Transparent" sur le ComboBox,
             ce qui cachait la couleur du Border placé derrière lui. Repris du template
             entièrement transparent de CompanyComboStyle (non éditable — valeurs 1/2/3
             choisies dans la liste, pas de saisie libre nécessaire). -->
        <Style x:Key="UrgencyComboStyle" TargetType="ComboBox" BasedOn="{StaticResource GridComboStyle}">
            <Setter Property="IsEditable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
						              Focusable="False"
						              ClickMode="Press"
						              HorizontalContentAlignment="Stretch"
						              VerticalContentAlignment="Center"
						              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
						              Background="Transparent"
						              BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
									                  Margin="4,0,0,0"
									                  VerticalAlignment="Center"
									                  HorizontalAlignment="Center"
									                  Content="{TemplateBinding SelectionBoxItem}">
                                        <ContentPresenter.ContentTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
												           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ComboBox}, Path=Foreground}"/>
                                            </DataTemplate>
                                        </ContentPresenter.ContentTemplate>
                                    </ContentPresenter>

                                    <Path Grid.Column="1"
									      Data="M 0 0 L 4 4 L 8 0 Z"
									      Fill="#6B7280"
									      HorizontalAlignment="Center"
									      VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>

                            <Popup x:Name="Popup"
						       Placement="Bottom"
						       IsOpen="{TemplateBinding IsDropDownOpen}"
						       AllowsTransparency="True"
						       Focusable="False"
						       PopupAnimation="Fade">
                                <Border Background="White"
								        BorderBrush="#D1D5DB"
								        BorderThickness="1"
								        CornerRadius="6"
								        SnapsToDevicePixels="True">
                                    <ScrollViewer Margin="2"
									              SnapsToDevicePixels="True"
									              VerticalScrollBarVisibility="Auto"
									              HorizontalScrollBarVisibility="Disabled"
									              Background="White">
                                        <ItemsPresenter>
                                            <ItemsPresenter.Resources>
                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="Foreground" Value="#111827"/>
                                                    <Setter Property="Padding" Value="6,4"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter Property="Background" Value="#F3F4F6"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#E5E7EB"/>
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground" Value="#9CA3AF"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsPresenter.Resources>
                                        </ItemsPresenter>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextZoneRichTextBoxStyle" TargetType="RichTextBox">
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="72"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ✅ Filtres façon Excel sur l'en-tête de la grille des Tâches (demande de Joe), même
             mécanisme que sur les Bons actifs (DashboardPage/ArchivesPage), styles dupliqués ici
             (convention déjà établie dans ce projet : pas de centralisation à large portée). -->
        <Style x:Key="FilterHeaderButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterHeaderButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource FilterHeaderButtonStyle}">
            <Setter Property="Foreground" Value="#1D4ED8"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="FilterHeaderHighlightBorderStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="White" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ✅ Titre de page (28.07.2026, demande de Joe : même police que les autres pages,
             ex. "Comptabilité"). -->
        <TextBlock Grid.Row="0"
                   Text="Planification"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#111827"
                   Margin="0,0,0,12"/>

        <!-- ✅ Sélection de semaine + dates déplacées ici (19.07.2026, 2e demande de Joe) :
             cette Row="1" est HORS du ScrollViewer (voir MainScrollViewer, Row="2") -> zone
             figée, toujours visible au scroll, même ligne que "Générer PDF". -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="PrevWeekButton"
                        Content="◀"
                        Click="PrevWeekButton_Click"
                        Width="22" Height="24"
                        Margin="0,0,6,0"
                        Padding="0"
                        Style="{StaticResource WeekNavButtonStyle}"/>
                <TextBlock x:Name="WeekTextBlock"
                           Text="Semaine …"
                           Foreground="#111827"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <Button x:Name="NextWeekButton"
                        Content="▶"
                        Click="NextWeekButton_Click"
                        Width="22" Height="24"
                        Margin="0,0,4,0"
                        Padding="0"
                        Style="{StaticResource WeekNavButtonStyle}"/>

                <TextBlock Text="Début :"
                           Foreground="#374151"
                           VerticalAlignment="Center"
                           Margin="14,0,4,0"/>
                <DatePicker x:Name="StartDatePicker"
                            Width="100"
                            Height="24"
                            Style="{StaticResource PlanningDatePickerStyle}"
                            SelectedDateChanged="StartDatePicker_SelectedDateChanged"/>

                <TextBlock Text="Fin :"
                           Foreground="#374151"
                           VerticalAlignment="Center"
                           Margin="30,0,4,0"/>
                <DatePicker x:Name="EndDatePicker"
                            Width="100"
                            Height="24"
                            Style="{StaticResource PlanningDatePickerStyle}"
                            SelectedDateChanged="EndDatePicker_SelectedDateChanged"/>

                <!-- ✅ Archives/Corbeille (04.08.2026, demande de Joe : "mettre les boutons à
                     côté des dates") : déplacées ici depuis la colonne de droite (à côté de
                     "Générer PDF"), deviennent le sous-menu d'accès pour la variante Tâches
                     (ShowArchivesTasks/ShowTrashedTasks, MainWindow.xaml.cs). -->
                <!-- ✅ Décalé de 10mm/38px vers la droite (demande de Joe) : marge gauche
                     14 -> 52 (le bouton "Voir Corbeille" suit, sans marge propre, dans le même
                     StackPanel). Renommé "Voir Archives" (demande de Joe). -->
                <Button x:Name="PlanningArchivesButton"
                        Content="Voir Archives"
                        Style="{StaticResource WeekNavButtonStyle}"
                        Background="#F3F4F6"
                        Height="30"
                        Padding="10,0"
                        Margin="52,0,6,0"
                        Click="PlanningArchivesButton_Click"/>
                <!-- ✅ Fond rouge clair, police/bordure rouges (demande de Joe, 04.08.2026).
                     Renommé "Voir Corbeille" (demande de Joe). -->
                <Button x:Name="PlanningTrashButton"
                        Content="Voir Corbeille"
                        Style="{StaticResource WeekNavButtonStyle}"
                        Background="#FEE2E2"
                        Foreground="#B91C1C"
                        BorderBrush="#B91C1C"
                        Height="30"
                        Padding="10,0"
                        Click="PlanningTrashButton_Click"/>
            </StackPanel>

            <!-- ✅ Marge droite de 8 pour aligner le bord droit avec la pastille "Dossier" de
                 MainWindow : le conteneur de page (Border Padding="12") est inset de 4px de
                 plus que le bandeau de nav (Padding="8,6"), et la pastille a elle-même une
                 marge droite de 12 dans son StackPanel — 12+8-12 = 8 de marge ici pour
                 compenser exactement l'écart. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                <Button x:Name="ExportPdfButton"
                        Content="Générer PDF"
                        Style="{StaticResource PdfButtonStyle}"
                        VerticalAlignment="Center"
                        Height="30"
                        Width="150"
                        FontSize="15"
                        Click="ExportPdfButton_Click"/>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1) Tâches -->
                <Border x:Name="TaskSectionBorder"
                        Grid.Row="0"
				        BorderBrush="#6B7280"
				        BorderThickness="1"
				        CornerRadius="12"
				        Padding="10"
		        Effect="{StaticResource CardShadowEffect}"
				        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ✅ Popup de filtre façon Excel (demande de Joe), même mécanisme que
                             DashboardPage/ArchivesPage (bouton "▾" dans l'en-tête d'une colonne
                             ouvre ce popup unique, positionné dynamiquement sur ce bouton via
                             PlacementTarget en code-behind). Seulement le panneau "Texte" (pas de
                             panneau "Date" ici : aucune des colonnes filtrées de cette grille
                             n'est une date). -->
                        <Popup x:Name="TaskColumnFilterPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
                            <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="8" MinWidth="220" MaxHeight="380" Effect="{StaticResource CardShadowEffect}">
                                <StackPanel>
                                    <CheckBox x:Name="TaskAlphaSortCheckBox"
                                              Content="Trier par ordre alphabétique (A→Z)"
                                              Margin="0,0,0,8"/>

                                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Margin="0,0,0,6"/>

                                    <CheckBox x:Name="TaskFilterSelectAllCheckBox"
                                              Content="(Tout sélectionner)"
                                              IsChecked="True"
                                              FontWeight="Bold"
                                              Click="TaskFilterSelectAllCheckBox_Click"
                                              Margin="0,0,0,6"/>

                                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="TaskFilterOptionsItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding DisplayText}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Content="Annuler" Style="{StaticResource OutlineBlueButtonStyle}" Click="TaskColumnFilterCancel_Click" Margin="0,0,6,0"/>
                                        <Button Content="OK" Style="{StaticResource SmallBlueButtonStyle}" Click="TaskColumnFilterApply_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- ✅ 31.07.2026 (demande de Joe) : tous les boutons "Ajouter" (gauche) de
                             chaque section de la page Planning doivent s'aligner verticalement,
                             Planning hebdo servant de référence fixe (178 = largeur colonne case à
                             cocher [28] + colonne Entreprise [MinWidth 150]), plus aligné sur la
                             colonne Bâtiment (98) de cette grille-ci depuis le 30.07.2026. -->
                        <Grid x:Name="TaskHeaderToolbar"
                              Grid.Row="0"
                              Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="178"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Tâches"
							           FontSize="14"
							           FontWeight="SemiBold"
							           Foreground="#111827"
							           VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="AddTaskRowButton"
								        Content="Ajouter"
								        Style="{StaticResource SmallBlueButtonStyle}"
								        Height="34"
								        Click="AddTaskRowButton_Click"/>

                                <!-- ✅ 30.07.2026 (demande de Joe) : archive la/les tâche(s)
                                     sélectionnée(s) (comme "Supprimer", même sélection) au lieu de
                                     les effacer, consultable/restaurable depuis "Archives tâches".
                                     ✅ Repositionné juste après "Ajouter" (demande de Joe, 04.08.2026).
                                     ✅ Grisé tant qu'aucune ligne n'est sélectionnée (demande de Joe,
                                     04.08.2026), voir RefreshTaskSelectionButtonsState. -->
                                <Button x:Name="ArchiveTaskRowButton"
								        Content="Archiver sélection"
								        Style="{StaticResource ArchiveOutlineButtonStyle}"
								        Height="34"
								        Margin="8,0,0,0"
								        IsEnabled="False"
								        Click="ArchiveTaskRowButton_Click"/>

                                <!-- ✅ Renommé (demande de Joe, 04.08.2026) : ce bouton ne supprime pas
                                     définitivement, il met à la corbeille (voir
                                     RemoveTaskRowButton_Click, IsTrashed/TrashedAt), même principe
                                     que "Déplacer dans la corbeille" sur Bons d'intervention.
                                     ✅ Grisé tant qu'aucune ligne n'est sélectionnée (demande de Joe,
                                     04.08.2026), voir RefreshTaskSelectionButtonsState. -->
                                <Button x:Name="RemoveTaskRowButton"
								        Content="Déplacer dans la corbeille"
								        Style="{StaticResource SmallBlackButtonStyle}"
								        IsEnabled="False"
								        Height="34"
								        Margin="8,0,0,0"
								        Click="RemoveTaskRowButton_Click"/>
                            </StackPanel>

                            <!-- ✅ Choix des colonnes à listes déroulantes affichées/masquées
                                 (mémorisé entre les sessions via Db.GetTasksVisibleColumns/
                                 SetTasksVisibleColumns). -->
                            <Button x:Name="TaskColumnsButton"
                                    Grid.Column="3"
							        Content="Colonnes ▾"
							        Style="{StaticResource OutlineBlueButtonStyle}"
							        Height="34"
							        Click="TaskColumnsButton_Click"/>
                        </Grid>

                        <Popup x:Name="TaskColumnsPopup"
                               PlacementTarget="{Binding ElementName=TaskColumnsButton}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Background="White"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Effect="{StaticResource CardShadowEffect}">
                                <StackPanel>
                                    <TextBlock Text="Colonnes visibles" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="ColShowCompanyCheckBox" Content="Entreprise" Margin="0,2" Click="TaskColumnVisibility_Changed"/>
                                    <CheckBox x:Name="ColShowBuildingCheckBox" Content="Bâtiment" Margin="0,2" Click="TaskColumnVisibility_Changed"/>
                                    <CheckBox x:Name="ColShowFloorCheckBox" Content="Étage" Margin="0,2" Click="TaskColumnVisibility_Changed"/>
                                    <CheckBox x:Name="ColShowCategoryCheckBox" Content="Catégorie" Margin="0,2" Click="TaskColumnVisibility_Changed"/>
                                    <CheckBox x:Name="ColShowUrgencyCheckBox" Content="Urg." Margin="0,2" Click="TaskColumnVisibility_Changed"/>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- ✅ Fix (demande de Joe : "je ne vois aucun filtre") : ColumnHeaderHeight
                             surchargé à 44 (au lieu des 28 de PlanningGridStyle, partagé avec
                             Planning hebdo ci-dessous, non touché). Les en-têtes filtrables ont
                             maintenant 2 lignes (libellé + bouton ▾), 28px ne laissait aucune
                             place visible pour la 2e ligne, le bouton était rogné/invisible. -->
                        <DataGrid x:Name="TasksDataGrid"
						          Grid.Row="1"
						          Style="{StaticResource PlanningGridStyle}"
						          ColumnHeaderHeight="44"
						          AutoGenerateColumns="False"
						          CanUserAddRows="False"
						          RowHeaderWidth="0"
						          SelectionUnit="FullRow"
						          Background="White"
						          BorderBrush="#D1D5DB"
						          BorderThickness="1"
						          IsReadOnly="False"
						          CellEditEnding="TasksDataGrid_CellEditEnding"
						          SelectionChanged="TasksDataGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn x:Name="TaskSelectColumn" Header="" Width="28" CanUserResize="False">
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <!-- ✅ 30.07.2026 (demande de Joe) : case à cocher qui sélectionne
                                                 toutes les cases de la colonne. -->
                                            <CheckBox x:Name="TaskSelectAllCheckBox"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Click="TaskSelectAllCheckBox_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center"
											          VerticalAlignment="Center"
											          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="TaskRefColumn" Header="N°" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="0" Padding="0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource CompanyBgConverter}">
                                                                    <Binding Path="Company"/>
                                                                    <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Company}" Value="">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Company}" Value="{x:Null}">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <TextBlock Text="{Binding Ref}"
												           HorizontalAlignment="Center"
												           VerticalAlignment="Center"
												           FontWeight="SemiBold">
                                                    <TextBlock.Foreground>
                                                        <MultiBinding Converter="{StaticResource CompanyFgConverter}">
                                                            <Binding Path="Company"/>
                                                            <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Ref, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Center"
                                                     HorizontalContentAlignment="Center"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     FontWeight="SemiBold"
                                                     Padding="2,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- ✅ Plus de MaxWidth (30.07.2026, demande de Joe) : un mot long ne doit
                                     plus être coupé, ni dans les lignes ni dans l'entête, la colonne
                                     s'élargit maintenant librement pour l'accueillir (au lieu de tronquer,
                                     voir ancien commentaire du 16.07.2026 remplacé ici). -->
                                <DataGridTemplateColumn x:Name="TaskBuildingColumn" MinWidth="90" Width="Auto">
                                    <!-- ✅ Filtre Excel (demande de Joe) : Header (instance unique,
                                         permanente) au lieu de HeaderTemplate, nécessaire pour
                                         nommer le Border/Button et les retrouver depuis
                                         UpdateTaskFilterButtonIndicators (un HeaderTemplate est
                                         instancié par le système de présentation, ses éléments
                                         nommés ne deviennent pas des champs de la classe). Le
                                         binding dynamique du libellé (RelativeSource
                                         AncestorType=UserControl) fonctionne pareil ici. -->
                                    <DataGridTemplateColumn.Header>
                                        <Border x:Name="BuildingHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DataContext.BuildingLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center"/>
                                                <Button x:Name="BuildingFilterButton" Content="▾" Tag="Building" Style="{StaticResource FilterHeaderButtonStyle}" Click="TaskColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource GridComboStyle}"
											          ItemsSource="{Binding DataContext.Buildings, RelativeSource={RelativeSource AncestorType=UserControl}}"
											          SelectedItem="{Binding Building, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="TaskFloorColumn" MinWidth="80" Width="Auto">
                                    <DataGridTemplateColumn.Header>
                                        <Border x:Name="FloorHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DataContext.FloorLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center"/>
                                                <Button x:Name="FloorFilterButton" Content="▾" Tag="Floor" Style="{StaticResource FilterHeaderButtonStyle}" Click="TaskColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource GridComboStyle}"
											          ItemsSource="{Binding DataContext.Floors, RelativeSource={RelativeSource AncestorType=UserControl}}"
											          SelectedItem="{Binding Floor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ✅ N'affiche que la 1ère ligne en mode lecture (le texte complet peut
                                     être multi-lignes via l'éditeur agrandi) — édition rapide inline
                                     toujours possible (reste sur une seule ligne, comme avant). -->
                                <DataGridTemplateColumn x:Name="TaskTodoColumn" Header="Descriptif" MinWidth="120" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Todo, Converter={StaticResource TodoFirstLineConverter}}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Todo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     MaxLength="80"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     VerticalContentAlignment="Center"
                                                     LostFocus="TaskTodoTextBox_LostFocus"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- ✅ Éditeur agrandi du Descriptif (16.07.2026, demande de Joe) : ouvre
                                     TaskDescriptionWindow en modal pour saisir/consulter un texte long,
                                     avec bouton "Générer PDF" — le champ reste le même, juste plus
                                     confortable pour écrire beaucoup de texte. Crayon si 1 seule ligne ;
                                     texte "Voir +" (sans fond coloré) si plus d'une ligne. Icône/texte
                                     agrandis (demande de Joe, 16.07.2026, 2e passe). -->
                                <DataGridTemplateColumn x:Name="TaskExpandDescriptionColumn" Header="" Width="56" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Padding="4,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="Agrandir / éditer le descriptif"
                                                    Click="TaskExpandDescriptionButton_Click">
                                                <Grid>
                                                    <Path Data="{StaticResource IconEditGeometry}"
                                                          Stretch="Uniform"
                                                          Width="15"
                                                          Height="15"
                                                          Fill="#6B7280"
                                                          Visibility="{Binding Todo, Converter={StaticResource TodoShowPencilConverter}}"/>
                                                    <TextBlock Text="Voir +"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="#2563EB"
                                                               Visibility="{Binding Todo, Converter={StaticResource TodoShowVoirPlusConverter}}"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="TaskCategoryColumn" MinWidth="90" Width="Auto">
                                    <DataGridTemplateColumn.Header>
                                        <Border x:Name="CategoryHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DataContext.TaskCategoryLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center"/>
                                                <Button x:Name="CategoryFilterButton" Content="▾" Tag="Category" Style="{StaticResource FilterHeaderButtonStyle}" Click="TaskColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource GridComboStyle}"
											          ItemsSource="{Binding DataContext.TaskCategoriesWithBlank, RelativeSource={RelativeSource AncestorType=UserControl}}"
											          SelectedItem="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ✅ Déplacée entre Catégorie et Urg. (demande de Joe du 16.07.2026). -->
                                <DataGridTemplateColumn x:Name="TaskCompanyColumn" MinWidth="130" Width="Auto">
                                    <DataGridTemplateColumn.Header>
                                        <Border x:Name="CompanyHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DataContext.CompanyLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center"/>
                                                <Button x:Name="CompanyFilterButton" Content="▾" Tag="Company" Style="{StaticResource FilterHeaderButtonStyle}" Click="TaskColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource CompanyBgConverter}">
                                                                    <Binding Path="Company"/>
                                                                    <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Company}" Value="">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Company}" Value="{x:Null}">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <ComboBox Style="{StaticResource CompanyComboStyle}"
												          VerticalAlignment="Center"
												          Height="20"
												          ItemsSource="{Binding DataContext.Companies, RelativeSource={RelativeSource AncestorType=UserControl}}"
												          SelectedItem="{Binding Company, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <ComboBox.Foreground>
                                                        <MultiBinding Converter="{StaticResource CompanyFgConverter}">
                                                            <Binding Path="Company"/>
                                                            <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </ComboBox.Foreground>
                                                </ComboBox>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

