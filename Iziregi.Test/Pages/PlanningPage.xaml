                                            <Border Padding="0">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource CellCompanyColorIfNotEmptyConverter}">
                                                        <Binding Path="D5"/>
                                                        <Binding Path="Company"/>
                                                        <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Border.Background>

                                                <TextBox Text="{Binding D5, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												         FontWeight="SemiBold"
												         BorderThickness="0"
												         Background="Transparent"
												         Padding="6,0"
												         VerticalContentAlignment="Center">
                                                    <TextBox.Foreground>
                                                        <MultiBinding Converter="{StaticResource CellCompanyTextColorIfNotEmptyConverter}">
                                                            <Binding Path="D5"/>
                                                            <Binding Path="Company"/>
                                                            <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </TextBox.Foreground>
                                                </TextBox>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ✅ Samedi DOIT être après le vendredi -->
                                <DataGridTemplateColumn x:Name="SaturdayColumn" Header="Samedi" Width="*" Visibility="Collapsed">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="0">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource CellCompanyColorIfNotEmptyConverter}">
                                                        <Binding Path="Sat"/>
                                                        <Binding Path="Company"/>
                                                        <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Border.Background>

                                                <TextBox Text="{Binding Sat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												         FontWeight="SemiBold"
												         BorderThickness="0"
												         Background="Transparent"
												         Padding="6,0"
												         VerticalContentAlignment="Center">
                                                    <TextBox.Foreground>
                                                        <MultiBinding Converter="{StaticResource CellCompanyTextColorIfNotEmptyConverter}">
                                                            <Binding Path="Sat"/>
                                                            <Binding Path="Company"/>
                                                            <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </TextBox.Foreground>
                                                </TextBox>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Jour 6" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="0">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource CellCompanyColorIfNotEmptyConverter}">
                                                        <Binding Path="D6"/>
                                                        <Binding Path="Company"/>
                                                        <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Border.Background>

                                                <TextBox Text="{Binding D6, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												         FontWeight="SemiBold"
												         BorderThickness="0"
												         Background="Transparent"
												         Padding="6,0"
												         VerticalContentAlignment="Center">
                                                    <TextBox.Foreground>
                                                        <MultiBinding Converter="{StaticResource CellCompanyTextColorIfNotEmptyConverter}">
                                                            <Binding Path="D6"/>
                                                            <Binding Path="Company"/>
                                                            <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
