                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource CellCompanyColorIfNotEmptyConverter}">
                                                        <Binding Path="D3"/>
                                                        <Binding Path="Company"/>
                                                        <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Border.Background>

                                                <TextBox Text="{Binding D3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												         FontWeight="SemiBold"
												         BorderThickness="0"
												         Background="Transparent"
												         Padding="6,0"
												         VerticalContentAlignment="Center">
                                                    <TextBox.Foreground>
                                                        <MultiBinding Converter="{StaticResource CellCompanyTextColorIfNotEmptyConverter}">
                                                            <Binding Path="D3"/>
                                                            <Binding Path="Company"/>
                                                            <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </TextBox.Foreground>
                                                </TextBox>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Jour 4" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="0">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource CellCompanyColorIfNotEmptyConverter}">
                                                        <Binding Path="D4"/>
                                                        <Binding Path="Company"/>
                                                        <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Border.Background>

                                                <TextBox Text="{Binding D4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												         FontWeight="SemiBold"
												         BorderThickness="0"
												         Background="Transparent"
												         Padding="6,0"
												         VerticalContentAlignment="Center">
                                                    <TextBox.Foreground>
                                                        <MultiBinding Converter="{StaticResource CellCompanyTextColorIfNotEmptyConverter}">
                                                            <Binding Path="D4"/>
                                                            <Binding Path="Company"/>
                                                            <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </TextBox.Foreground>
                                                </TextBox>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Jour 5" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
