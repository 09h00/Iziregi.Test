                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- 3) Image -->
                <Border x:Name="PlanSectionBorder"
                        Grid.Row="2"
				        BorderBrush="Black"
				        BorderThickness="1"
				        CornerRadius="10"
				        Padding="10"
				        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="92"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel x:Name="PlanHeaderToolbar"
                                   Grid.Row="0"
                                   Grid.ColumnSpan="3"
                                   Margin="0,0,0,8"
                                   LastChildFill="False">
                            <TextBlock Text="Image"
							           FontSize="14"
							           FontWeight="SemiBold"
							           Foreground="#111827"
							           DockPanel.Dock="Left"/>

                            <Button x:Name="ResetStickersButton"
                                    Content="Reset stickers"
							        Style="{StaticResource SmallBlackButtonStyle}"
							        DockPanel.Dock="Right"
							        Margin="8,0,0,0"
							        Click="ResetPlacedStickers_Click"/>

                            <Button x:Name="PlanRemoveButton"
                                    Content="Retirer image"
							        Style="{StaticResource SmallBlackButtonStyle}"
							        DockPanel.Dock="Right"
							        Margin="8,0,0,0"
							        Click="PlanRemove_Click"/>

                            <Button x:Name="PlanAddButton"
                                    Content="Ajouter image"
							        Style="{StaticResource SmallBlueButtonStyle}"
							        DockPanel.Dock="Right"
							        Click="PlanAdd_Click"/>
                        </DockPanel>

                        <Border Grid.Row="1" Grid.Column="0"
                                MinHeight="380"
                                ClipToBounds="True"
						        BorderBrush="Black"
						        BorderThickness="1"
						        CornerRadius="8"
						        Background="#FAFAFA"
						        Padding="8">
                            <Grid>
                                <Canvas x:Name="PlanCanvas"
								        Background="Transparent"
								        AllowDrop="True"
								        PreviewMouseLeftButtonDown="PlanCanvas_PreviewMouseLeftButtonDown"
								        PreviewMouseMove="PlanCanvas_PreviewMouseMove"
								        PreviewMouseLeftButtonUp="PlanCanvas_PreviewMouseLeftButtonUp">
                                    <!-- (contenu inchangé) -->
                                    <ItemsControl ItemsSource="{Binding PlacedPlanImages}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="{Binding Width}"
												        Height="{Binding Height}"
												        BorderBrush="Black"
												        BorderThickness="1"
												        Background="Transparent"
												        PreviewMouseLeftButtonDown="PlacedPlanImage_PreviewMouseLeftButtonDown"
												        PreviewMouseMove="PlacedPlanImage_PreviewMouseMove"
												        PreviewMouseLeftButtonUp="PlacedPlanImage_PreviewMouseLeftButtonUp"
												        PreviewMouseRightButtonDown="PlacedPlanImage_RightClick"
												        ToolTip="Glisser : déplacer • Coin : redimensionner • Clic droit : supprimer">
                                                    <Grid>
                                                        <Image Source="{Binding ImageSource}" Stretch="Fill"/>
                                                        <Thumb Width="14"
														       Height="14"
														       HorizontalAlignment="Right"
														       VerticalAlignment="Bottom"
														       Cursor="SizeNWSE"
														       DragDelta="PlacedPlanImageResizeThumb_DragDelta">
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border Background="Black" CornerRadius="2"/>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding PlacedStickers}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="{Binding Size}"
												        Height="{Binding Size}"
												        CornerRadius="999"
												        Background="{Binding ColorHex}"
												        BorderBrush="Black"
												        BorderThickness="1"
												        PreviewMouseLeftButtonDown="PlacedSticker_PreviewMouseLeftButtonDown"
												        PreviewMouseMove="PlacedSticker_PreviewMouseMove"
												        PreviewMouseLeftButtonUp="PlacedSticker_PreviewMouseLeftButtonUp"
												        PreviewMouseRightButtonDown="PlacedSticker_RightClick"
												        ToolTip="Clic : drag • Double-clic : éditer • Clic droit : retirer le sticker">
                                                    <TextBox Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													         FontWeight="Bold"
													         FontSize="12"
													         Foreground="{Binding TextColorHex}"
                                                             Style="{StaticResource PlacedStickerTextBoxStyle}"
                                                             PreviewMouseLeftButtonDown="PlacedStickerTextBox_PreviewMouseLeftButtonDown"
                                                             PreviewKeyDown="PlacedStickerTextBox_PreviewKeyDown"
                                                             LostFocus="PlacedSticker_EndEditOnLostFocus"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Grid>
                        </Border>

                        <Border x:Name="StickerBankPanel"
                                Grid.Row="1"
                                Grid.Column="2"
						        BorderBrush="Black"
						        BorderThickness="1"
						        CornerRadius="8"
						        Background="White"
						        Padding="6">
                            <!-- (contenu inchangé) -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
								           Text="Stickers"
								           FontWeight="SemiBold"
								           Foreground="#111827"
								           Margin="0,0,0,6"
								           HorizontalAlignment="Center"/>

                                <WrapPanel Grid.Row="1"
								           Margin="0,0,0,6"
								           HorizontalAlignment="Center">
                                    <ItemsControl ItemsSource="{Binding CompanyColorMap}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource CompanyColorSwatchButtonStyle}"
												        Background="{Binding Value}"
												        ToolTip="{Binding Key}"
												        Click="CompanyColorSwatch_Click"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>

                                <Border Grid.Row="2" Height="1" Background="Black" Margin="0,0,0,6"/>

                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Stickers}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" HorizontalAlignment="Center"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="2"
												        Height="26"
												        Width="26"
												        Background="{Binding ColorHex}"
												        BorderBrush="Black"
												        BorderThickness="1"
												        HorizontalAlignment="Center"
												        PreviewMouseRightButtonDown="Sticker_RightClick"
												        PreviewMouseLeftButtonDown="StickerBank_PreviewMouseLeftButtonDown"
												        PreviewMouseMove="StickerBank_PreviewMouseMove"
												        PreviewMouseLeftButtonUp="StickerBank_PreviewMouseLeftButtonUp">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
															        BorderBrush="{TemplateBinding BorderBrush}"
															        BorderThickness="{TemplateBinding BorderThickness}"
															        CornerRadius="999"
															        Width="{TemplateBinding Width}"
															        Height="{TemplateBinding Height}">
                                                                <ContentPresenter HorizontalAlignment="Center"
																                  VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>

                                                    <TextBox Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													         FontWeight="Bold"
													         FontSize="12"
													         Foreground="{Binding TextColorHex}"
													         Background="Transparent"
													         BorderThickness="0"
													         MaxLength="2"
													         Width="16"
													         HorizontalContentAlignment="Center"
													         VerticalContentAlignment="Center"
													         HorizontalAlignment="Center"
													         VerticalAlignment="Center"
                                                             PreviewMouseLeftButtonDown="StickerBankTextBox_PreviewMouseLeftButtonDown"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- 4) Zones de texte -->
                <Border Grid.Row="3"
				        BorderBrush="Black"
				        BorderThickness="1"
				        CornerRadius="10"
				        Padding="10"
				        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel x:Name="TextZoneHeaderToolbar"
                                   Grid.Row="0"
                                   Margin="0,0,0,10"
                                   LastChildFill="False">
                            <TextBlock Text="Zones de texte"
							           FontSize="14"
							           FontWeight="SemiBold"
							           Foreground="#111827"
							           DockPanel.Dock="Left"
							           VerticalAlignment="Center"/>

                            <Button x:Name="ExportPdfButton"
							        Content="Exporter PDF"
							        Style="{StaticResource SmallBlueButtonStyle}"
							        DockPanel.Dock="Right"
							        Margin="0,0,8,0"
							        Click="ExportPdfButton_Click"/>

                            <Button Content="Retirer zone de texte"
							        Style="{StaticResource SmallBlackButtonStyle}"
							        DockPanel.Dock="Right"
							        Margin="8,0,0,0"
							        Click="TextZoneRemove_Click"/>

                            <Button Content="Ajouter zone de texte"
							        Style="{StaticResource SmallBlueButtonStyle}"
							        DockPanel.Dock="Right"
							        Click="TextZoneAdd_Click"/>
                        </DockPanel>

                        <Border x:Name="TextZoneFontToolbar"
                                Grid.Row="1"
						        Background="White"
						        BorderBrush="Black"
						        BorderThickness="1"
						        CornerRadius="10"
						        Padding="8"
						        Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Police :" Foreground="#111827" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="FontFamilyCombo" Width="150" Height="26" Margin="8,0,16,0"
								          SelectionChanged="FontFamilyCombo_SelectionChanged"/>

                                <TextBlock Grid.Column="2" Text="Taille :" Foreground="#111827" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="3" x:Name="FontSizeCombo" Width="64" Height="26" Margin="8,0,16,0"
								          SelectionChanged="FontSizeCombo_SelectionChanged"/>

                                <ToggleButton Grid.Column="4" x:Name="BoldToggle" Width="40" Height="28" Margin="0,0,8,0"
								              Background="White" Foreground="#111827" BorderBrush="Black"
								              Click="BoldToggle_Click"
								              ToolTip="Gras (police)">
                                    <TextBlock Text="G" FontSize="17" FontWeight="Bold"
									           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ToggleButton>

                                <ToggleButton Grid.Column="5" x:Name="ItalicToggle" Width="40" Height="28" Margin="0,0,8,0"
								              Background="White" Foreground="#111827" BorderBrush="Black"
								              Click="ItalicToggle_Click"
								              ToolTip="Italique (police)">
                                    <TextBlock Text="I" FontSize="14" FontStyle="Italic" FontWeight="Normal"
									           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ToggleButton>

                                <ToggleButton Grid.Column="6" x:Name="UnderlineToggle" Width="40" Height="28" Margin="0,0,16,0"
								              Background="White" Foreground="#111827" BorderBrush="Black"
								              Click="UnderlineToggle_Click"
								              ToolTip="Souligné (police)">
                                    <TextBlock Text="S" FontSize="14" FontWeight="Normal" TextDecorations="Underline"
									           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ToggleButton>

                                <Button Grid.Column="7" x:Name="FontColorButton" Width="56" Height="28" Margin="0,0,8,0"
								        HorizontalAlignment="Left"
								        Background="White" BorderBrush="Black" BorderThickness="1"
								        Click="FontColorButton_Click"
								        ToolTip="Couleur du texte (police)">
                                    <StackPanel>
                                        <Border BorderThickness="2"
										        CornerRadius="4"
										        Padding="0"
										        HorizontalAlignment="Center"
										        BorderBrush="{Binding ElementName=FontColorSwatch, Path=Background}">
                                            <TextBlock Text="A"
											           Foreground="#111827"
											           FontSize="16"
											           FontWeight="SemiBold"
											           HorizontalAlignment="Center"
											           VerticalAlignment="Center"
											           Margin="2,-1,2,0"/>
                                        </Border>
                                        <TextBlock Text="Texte" Foreground="#6B7280" FontSize="9" HorizontalAlignment="Center" Margin="0,-1,0,0"/>
                                        <Border x:Name="FontColorSwatch" Height="3" Background="#EF4444" CornerRadius="2" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="8" x:Name="FillColorButton" Width="56" Height="28"
								        HorizontalAlignment="Left"
								        Background="White" BorderBrush="Black" BorderThickness="1"
								        Click="FillColorButton_Click"
								        ToolTip="Couleur de remplissage (fond)">
                                    <StackPanel>
                                        <Border BorderThickness="2"
										        CornerRadius="4"
										        Padding="0"
										        HorizontalAlignment="Center"
										        BorderBrush="{Binding ElementName=FillColorSwatch, Path=Background}">
                                            <TextBlock Text="▧"
											           Foreground="#111827"
											           FontSize="14"
											           FontWeight="Normal"
											           HorizontalAlignment="Center"
											           VerticalAlignment="Center"
											           Margin="4,-1,4,0"/>
                                        </Border>
                                        <TextBlock Text="Rempl." Foreground="#6B7280" FontSize="9" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                                        <Border x:Name="FillColorSwatch" Height="3" Background="#FDE047" CornerRadius="2" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="TextZonesLeftCol" Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition x:Name="TextZonesRightCol" Width="*"/>
                            </Grid.ColumnDefinitions>

                            <GridSplitter Grid.Column="1"
							              Width="6"
							              HorizontalAlignment="Stretch"
							              VerticalAlignment="Stretch"
							              Background="#E5E7EB"
							              ResizeBehavior="PreviousAndNext"
							              ResizeDirection="Columns"
							              ShowsPreview="True"/>

                            <StackPanel Grid.Column="0">
                                <Border CornerRadius="8" Padding="0" Margin="0,0,0,10"
								        Visibility="{Binding TextZones[0].Visible, Converter={StaticResource BoolToVis}}"
								        PreviewMouseDown="TextZone_Focus0">
                                    <Grid DataContext="{Binding TextZones[0]}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ComboBox Grid.Row="0" Height="26"
										          ItemsSource="{Binding DataContext.PlanningTextZones, RelativeSource={RelativeSource AncestorType=UserControl}}"
										          SelectedItem="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										          IsEditable="False"
										          Margin="0,0,0,8"
										          GotFocus="TextZone_Focus0"/>

                                        <RichTextBox x:Name="Rtb0" Grid.Row="1"
										            Style="{StaticResource TextZoneRichTextBoxStyle}"
										            GotFocus="Rtb_GotFocus"
										            TextChanged="Rtb_TextChanged"/>
                                    </Grid>
                                </Border>

                                <Border CornerRadius="8" Padding="0"
								        Visibility="{Binding TextZones[3].Visible, Converter={StaticResource BoolToVis}}"
								        PreviewMouseDown="TextZone_Focus3">
                                    <Grid DataContext="{Binding TextZones[3]}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ComboBox Grid.Row="0" Height="26"
										          ItemsSource="{Binding DataContext.PlanningTextZones, RelativeSource={RelativeSource AncestorType=UserControl}}"
										          SelectedItem="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										          IsEditable="False"
										          Margin="0,0,0,8"
										          GotFocus="TextZone_Focus3"/>

                                        <RichTextBox x:Name="Rtb3" Grid.Row="1"
										            Style="{StaticResource TextZoneRichTextBoxStyle}"
										            GotFocus="Rtb_GotFocus"
										            TextChanged="Rtb_TextChanged"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border CornerRadius="8" Padding="0" Margin="0,0,0,10"
								        Visibility="{Binding TextZones[1].Visible, Converter={StaticResource BoolToVis}}"
								        PreviewMouseDown="TextZone_Focus1">
                                    <Grid DataContext="{Binding TextZones[1]}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ComboBox Grid.Row="0" Height="26"
										          ItemsSource="{Binding DataContext.PlanningTextZones, RelativeSource={RelativeSource AncestorType=UserControl}}"
										          SelectedItem="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										          IsEditable="False"
										          Margin="0,0,0,8"
										          GotFocus="TextZone_Focus1"/>

                                        <RichTextBox x:Name="Rtb1" Grid.Row="1"
										            Style="{StaticResource TextZoneRichTextBoxStyle}"
										            GotFocus="Rtb_GotFocus"
										            TextChanged="Rtb_TextChanged"/>
                                    </Grid>
                                </Border>

                                <Border CornerRadius="8" Padding="0"
								        Visibility="{Binding TextZones[2].Visible, Converter={StaticResource BoolToVis}}"
								        PreviewMouseDown="TextZone_Focus2">
                                    <Grid DataContext="{Binding TextZones[2]}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ComboBox Grid.Row="0" Height="26"
										          ItemsSource="{Binding DataContext.PlanningTextZones, RelativeSource={RelativeSource AncestorType=UserControl}}"
										          SelectedItem="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										          IsEditable="False"
										          Margin="0,0,0,8"
										          GotFocus="TextZone_Focus2"/>

                                        <RichTextBox x:Name="Rtb2" Grid.Row="1"
										            Style="{StaticResource TextZoneRichTextBoxStyle}"
										            GotFocus="Rtb_GotFocus"
										            TextChanged="Rtb_TextChanged"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>