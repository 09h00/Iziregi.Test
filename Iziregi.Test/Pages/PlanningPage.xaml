				        BorderThickness="1"
				        CornerRadius="12"
				        Padding="10"
		        Effect="{StaticResource CardShadowEffect}"
				        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ✅ 30.07.2026 (demande de Joe) : Grid (plutôt que DockPanel) pour que
                             "Ajouter" démarre à une position FIXE (178 = largeur colonne case à
                             cocher [28] + colonne Entreprise [MinWidth 150, valeur habituelle en
                             pratique]) et s'aligne verticalement avec le bord gauche de la colonne
                             "Lundi" de PlanningDataGrid ci-dessous, indépendamment de la largeur
                             du titre. Approximatif si un nom d'entreprise pousse la colonne
                             au-delà de 150 (colonne en Auto). -->
                        <Grid x:Name="WeeklyHeaderToolbar"
                              Grid.Row="0"
                              Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="178"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Planification hebdomadaire"
							           FontSize="14"
							           FontWeight="SemiBold"
							           Foreground="#111827"
							           VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="AddPlanningRowButton"
								        Content="Ajouter"
								        Style="{StaticResource SmallBlueButtonStyle}"
								        Height="34"
								        Click="AddPlanningRowButton_Click"/>

                                <Button x:Name="RemovePlanningRowButton"
								        Content="Supprimer"
								        Style="{StaticResource SmallBlackButtonStyle}"
								        Height="34"
								        Margin="8,0,0,0"
								        Click="RemovePlanningRowButton_Click"/>
                            </StackPanel>

                            <!-- ✅ Navigation de semaine + dates déplacées dans la zone figée en haut
                                 de page (19.07.2026, 2e demande de Joe), même ligne que "Générer PDF"
                                 -> toujours visibles au scroll. Voir Grid Grid.Row="0" (hors du
                                 ScrollViewer). -->

                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <!-- ✅ 30.07.2026 (demande de Joe) : commutateur Automatique/Manuel
                                     pour l'ajout des intervenants au planning depuis la liste des
                                     tâches, figé par semaine (voir AutoAddToggleButton_Click). -->
                                <Button x:Name="AutoAddToggleButton"
								        Content="Intervenant automatique"
								        Style="{StaticResource SmallBlueButtonStyle}"
								        Height="34"
								        ToolTip="Ajout automatique des intervenants au planning (choisis dans les tâches). Cliquer pour passer en manuel pour cette semaine."
								        Click="AutoAddToggleButton_Click"/>

                                <!-- ✅ Toutes les options de structure de la semaine regroupées sous
                                     un seul bouton (19.07.2026, demande de Joe : auparavant deux
                                     boutons séparés "Samedi/Dimanche ▾" et "Jours : 6 ▾"). Choix
                                     Samedi/Dimanche mémorisés PAR SEMAINE (voir LoadWeekState) ;
                                     structure 5/6 jours en mémoire pour la session (voir
                                     _weekDayCount). Placé tout à droite (30.07.2026, demande de
                                     Joe). -->
                                <Button x:Name="WeekStructureButton"
								        Content="Structurer la semaine ▾"
								        Style="{StaticResource OutlineBlueButtonStyle}"
								        Height="34"
								        Margin="8,0,0,0"
								        Click="WeekStructureButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <Popup x:Name="WeekStructurePopup"
                               PlacementTarget="{Binding ElementName=WeekStructureButton}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Background="White"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Effect="{StaticResource CardShadowEffect}">
                                <StackPanel>
                                    <TextBlock Text="Structure de la semaine" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                    <!-- ✅ 5 jours en premier (19.07.2026, demande de Joe). -->
                                    <RadioButton x:Name="WeekDayCount5RadioButton"
                                                 GroupName="WeekDayCount"
                                                 Content="5 jours ouvrés (+ weekend)"
                                                 Margin="0,2"
                                                 Click="WeekDayCount_Changed"/>
                                    <RadioButton x:Name="WeekDayCount6RadioButton"
                                                 GroupName="WeekDayCount"
                                                 Content="6 jours ouvrés (+ weekend)"
                                                 Margin="0,2"
                                                 Click="WeekDayCount_Changed"/>

                                    <!-- ✅ Déplacé depuis le haut de page (19.07.2026, demande de
                                         Joe) : même ComboBox, même gestionnaire
                                         (StartWeekdayCombo_SelectionChanged), juste regroupé ici.
                                         "Structure" avant "Début" (19.07.2026, 2e demande de Joe). -->
                                    <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,8,0,8"/>
                                    <TextBlock Text="Début de semaine" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="StartWeekdayCombo"
                                              Width="130"
                                              Height="24"
                                              HorizontalAlignment="Left"
                                              VerticalContentAlignment="Center"
                                              Margin="0,0,0,0"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectionChanged="StartWeekdayCombo_SelectionChanged"/>

                                    <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,8,0,8"/>
                                    <TextBlock Text="Colonnes visibles par semaine individuelle" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="WeekendShowSaturdayCheckBox" Content="Samedi" Margin="0,2" Click="WeekendColumnVisibility_Changed"/>
                                    <CheckBox x:Name="WeekendShowSundayCheckBox" Content="Dimanche" Margin="0,2" Click="WeekendColumnVisibility_Changed"/>

                                    <!-- ✅ Défauts Samedi/Dimanche indépendants (18.07.2026, demande de
                                         Joe) : cocher applique immédiatement à toutes les semaines déjà
                                         sauvegardées ET devient le défaut pour les nouvelles, voir
                                         Db.GetDefaultShowSaturday/GetDefaultShowSunday. Un utilisateur
                                         qui travaille tous les samedis mais jamais les dimanches ne coche
                                         que la première. -->
                                    <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,8,0,8"/>
                                    <TextBlock Text="Colonnes visibles toutes les semaines" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="WeekendSaturdayDefaultCheckBox"
                                              Content="Samedi par défaut"
                                              Margin="0,2"
                                              Click="WeekendSaturdayDefault_Changed"/>
                                    <CheckBox x:Name="WeekendSundayDefaultCheckBox"
                                              Content="Dimanche par défaut"
                                              Margin="0,2"
                                              Click="WeekendSundayDefault_Changed"/>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <DataGrid x:Name="PlanningDataGrid"
