                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource CellCompanyColorIfNotEmptyConverter}">
                                                        <Binding Path="D3"/>
                                                        <Binding Path="Company"/>
                                                        <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
