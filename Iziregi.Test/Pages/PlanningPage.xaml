                                     masquée en permanence, comme avant l'ajout de ce sélecteur. -->
                                <DataGridTemplateColumn x:Name="TaskReserveColumn" Header="Concerne" Width="110" Visibility="Collapsed">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource GridComboStyle}"
											          ItemsSource="{Binding DataContext.Reserves, RelativeSource={RelativeSource AncestorType=UserControl}}"
											          SelectedItem="{Binding Reserve, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="TaskUrgentColumn" MinWidth="52" Width="Auto">
                                    <!-- ✅ Width Auto (au lieu de 52 fixe) : la colonne doit pouvoir
                                         s'élargir pour accueillir le bouton de filtre "▾" sous le
                                         libellé, MinWidth conservé comme largeur plancher. -->
                                    <DataGridTemplateColumn.Header>
                                        <Border x:Name="UrgentHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DataContext.TaskUrgencyLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center"/>
                                                <Button x:Name="UrgentFilterButton" Content="▾" Tag="Urgent" Style="{StaticResource FilterHeaderButtonStyle}" Click="TaskColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- ✅ Couleur selon la valeur (1=rouge, 2=orange, 3=jaune clair) via
                                                 converter (UrgencyBgConverter) plutôt que DataTrigger : binding
                                                 direct sur Background, sans dépendre du timing de sélection d'un
                                                 ComboBox éditable (IsEditable="True" sur GridComboStyle). -->
                                            <Border Background="{Binding Urgent, Converter={StaticResource UrgencyBgConverter}}" CornerRadius="4" Padding="0">
                                                <ComboBox Style="{StaticResource UrgencyComboStyle}"
												          ItemsSource="{Binding DataContext.TaskUrgenciesWithBlank, RelativeSource={RelativeSource AncestorType=UserControl}}"
												          SelectedItem="{Binding Urgent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												          Foreground="{Binding Urgent, Converter={StaticResource UrgencyFgConverter}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ✅ Largeur augmentée (16.07.2026, demande de Joe) : 61px coupait la
                                     dernière lettre de "Effectué" depuis l'agrandissement de la police
                                     des grilles (13→15). -->
                                <DataGridTemplateColumn x:Name="TaskDoneColumn" Width="90">
                                    <DataGridTemplateColumn.Header>
                                        <Border x:Name="DoneHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                                <TextBlock Text="Effectuée" HorizontalAlignment="Center"/>
                                                <Button x:Name="DoneFilterButton" Content="▾" Tag="Done" Style="{StaticResource FilterHeaderButtonStyle}" Click="TaskColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="DoneCellBorder" Background="Transparent" CornerRadius="4" Padding="0">
                                                <CheckBox x:Name="TaskDoneCheckBox"
												          HorizontalAlignment="Center"
												          VerticalAlignment="Center"
												          IsChecked="{Binding Done, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												          Click="TaskDoneCheckBox_Click"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Done}" Value="True">
                                                    <Setter TargetName="DoneCellBorder" Property="Background" Value="#C7F9C7"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- 2) Planning hebdo -->
                <Border x:Name="WeeklySectionBorder"
