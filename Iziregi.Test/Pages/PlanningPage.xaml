<!-- File: Pages/PlanningPage.xaml -->
<UserControl x:Class="Iziregi.Test.Pages.PlanningPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Iziregi.Test.Pages"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1100">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ✅ Champ de titre des zones de texte, legerement arrondi (demande de Joe,
             14.08.2026) : template repris de RoundedComboBoxStyle (AccountingPage.xaml),
             deja fiable (Popup.StaysOpen="False" inclus). -->
        <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#6B7280"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="White"
                                        BorderBrush="#D1D5DB"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="300"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Converters couleur entreprise -->
        <local:CompanyNameToBrushConverter x:Key="CompanyBgConverter"/>
        <local:CompanyNameToTextBrushConverter x:Key="CompanyFgConverter"/>
        <local:UrgencyToBrushConverter x:Key="UrgencyBgConverter"/>
        <local:UrgencyToForegroundConverter x:Key="UrgencyFgConverter"/>
        <local:TodoFirstLineConverter x:Key="TodoFirstLineConverter"/>
        <local:TodoShowPencilConverter x:Key="TodoShowPencilConverter"/>
        <local:TodoShowVoirPlusConverter x:Key="TodoShowVoirPlusConverter"/>

        <!-- ✅ Cell color only if not empty -->
        <local:CellTextAndCompanyToBrushConverter x:Key="CellCompanyColorIfNotEmptyConverter"/>
        <!-- ✅ Cell foreground (contrast) only if not empty -->
        <local:CellTextAndCompanyToTextBrushConverter x:Key="CellCompanyTextColorIfNotEmptyConverter"/>

        <!-- ✅ NEW: TextBox sticker posé (drag au clic, édition au double-clic) -->
        <Style x:Key="PlacedStickerTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <!-- ✅ 4 chiffres (numérotation de tâche annuelle) au lieu de 2 -->
            <Setter Property="MaxLength" Value="4"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="IsReadOnly" Value="False"/>
                    <Setter Property="Cursor" Value="IBeam"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ✅ Boutons arrondis + bordure noire, section "zones de texte" (25.07.2026,
             demande de Joe). Preserve le Content existant (texte simple ou StackPanel
             personnalisé comme FontColorButton/FillColorButton).
             ✅ Reste noir (demande de Joe, 04.08.2026) : seuls les boutons à FOND noir plein
             (SmallBlackButtonStyle) passent en rouge, pas ceux qui n'ont qu'une bordure/police
             noire comme ceux qui utilisent ce style-ci. -->
        <Style x:Key="TextZoneToolButtonStyle" TargetType="Button">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- ✅ 29.07.2026 (demande de Joe) : bordure plus épaisse au survol. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextZoneToolToggleStyle" TargetType="ToggleButton">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallBlueButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
						        Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}"
						        BorderThickness="{TemplateBinding BorderThickness}"
						        CornerRadius="6"
						        SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
							                  VerticalAlignment="Center"
							                  Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- ✅ 29.07.2026 (demande de Joe) : bordure plus épaisse au survol. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E40AF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E40AF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E3A8A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#93C5FD"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD"/>
                                <Setter Property="Foreground" Value="#F9FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ Fond blanc + police/bordure rouges (demande de Joe, remplace le fond noir plein) :
             même principe que OutlineBlueButtonStyle/ArchiveOutlineButtonStyle (survol = juste
             bordure plus épaisse, pas de changement de fond, sauf pression = léger fond teinté).
             Clé inchangée (SmallBlackButtonStyle) pour ne pas devoir retoucher tous ses usages
             dans cette page ni AutoAddToggleButton.Style (PlanningPage.xaml.cs). -->
        <Style x:Key="SmallBlackButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallBlueButtonStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
						        Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}"
						        BorderThickness="{TemplateBinding BorderThickness}"
						        CornerRadius="6"
						        SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
							                  VerticalAlignment="Center"
							                  Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Bd" Property="Background" Value="#FEF2F2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FECACA"/>
                                <Setter Property="Foreground" Value="#FECACA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ Flèches de navigation semaine (◀/▶, demande de Joe, 04.08.2026) : fond blanc,
             police/bordure noires, distinct de SmallBlackButtonStyle (passé au rouge juste
             avant), ces deux boutons-là doivent rester noirs. Même principe de survol que les
             autres styles "outline" (bordure plus épaisse, léger fond gris à l'appui). -->
        <Style x:Key="WeekNavButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallBlueButtonStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
						        Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}"
						        BorderThickness="{TemplateBinding BorderThickness}"
						        CornerRadius="6"
						        SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
							                  VerticalAlignment="Center"
							                  Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D1D5DB"/>
                                <Setter Property="Foreground" Value="#D1D5DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ Bouton "Colonnes" : blanc/bleu — au survol, juste une bordure plus épaisse
             (pas de fond noir comme SmallBlackButtonStyle). -->
        <Style x:Key="OutlineBlueButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallBlueButtonStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
						        Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}"
						        BorderThickness="{TemplateBinding BorderThickness}"
						        CornerRadius="6"
						        SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
							                  VerticalAlignment="Center"
							                  Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#BFDBFE"/>
                                <Setter Property="Foreground" Value="#BFDBFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ Bouton "Archiver sélection" (30.07.2026, demande de Joe) : même vert que
             "Archiver" dans Dashboard (ArchiveSmallButtonStyle, #15803D). -->
        <!-- ✅ Gris neutre (demande de Joe, 04.08.2026) : convention plus courante pour
             "Archiver" (action réversible, non destructive), remplace le vert précédent qui
             évoque plutôt une action positive/validation. -->
        <Style x:Key="ArchiveOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallBlueButtonStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
						        Background="{TemplateBinding Background}"
						        BorderBrush="{TemplateBinding BorderBrush}"
						        BorderThickness="{TemplateBinding BorderThickness}"
						        CornerRadius="6"
						        SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
							                  VerticalAlignment="Center"
							                  Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D1D5DB"/>
                                <Setter Property="Foreground" Value="#D1D5DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlanningDatePickerStyle" TargetType="DatePicker">
            <!-- ✅ Retour au format court "13.07.2026" (19.07.2026) : le format long
                 ("lundi, 13 juillet 2026") essayé juste avant prenait trop de place dans
                 l'en-tête "Planning hebdomadaire" (le bouton "Ajouter" sortait de l'écran),
                 Joe a préféré revenir au format court plutôt que complexifier davantage. -->
            <Setter Property="SelectedDateFormat" Value="Short"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PlanningGridStyle" TargetType="DataGrid">
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <!-- ✅ Taille normale à l'écran (18.07.2026, retour à l'original : Joe ne veut pas
                 que l'agrandissement demandé pour le PDF change l'affichage à l'écran). La
                 police est agrandie UNIQUEMENT pendant la capture PDF, temporairement, voir
                 PlanningPage.xaml.cs, PreparePdfCaptureUi / ExportPdfButton_Click. -->
            <Setter Property="RowHeight" Value="24"/>
            <Setter Property="ColumnHeaderHeight" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="CellOrRowHeader"/>

            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>

            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="BorderThickness" Value="0,2,0,2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>

            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="6,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#111827"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>

            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="#111827"/>
                        <Setter Property="BorderBrush" Value="#D1D5DB"/>
                        <Setter Property="BorderThickness" Value="0,0,1,2"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="6,0"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="CompanyComboStyle" TargetType="ComboBox" BasedOn="{StaticResource GridComboStyle}">
            <Setter Property="IsEditable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
							              Focusable="False"
							              ClickMode="Press"
							              HorizontalContentAlignment="Stretch"
							              VerticalContentAlignment="Center"
							              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
							              Background="Transparent"
							              BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
									                  Margin="4,0,0,0"
									                  VerticalAlignment="Center"
									                  HorizontalAlignment="Center"
									                  Content="{TemplateBinding SelectionBoxItem}">
                                        <ContentPresenter.ContentTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
												           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ComboBox}, Path=Foreground}"/>
                                            </DataTemplate>
                                        </ContentPresenter.ContentTemplate>
                                    </ContentPresenter>

                                    <Path Grid.Column="1"
									      Data="M 0 0 L 4 4 L 8 0 Z"
									      Fill="#6B7280"
									      HorizontalAlignment="Center"
									      VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>

                            <Popup x:Name="Popup"
							       Placement="Bottom"
							       IsOpen="{TemplateBinding IsDropDownOpen}"
							       AllowsTransparency="True"
							       Focusable="False"
							       PopupAnimation="Fade">
                                <Border Background="White"
								        BorderBrush="#D1D5DB"
								        BorderThickness="1"
								        CornerRadius="6"
								        SnapsToDevicePixels="True">
                                    <ScrollViewer Margin="2"
									              SnapsToDevicePixels="True"
									              VerticalScrollBarVisibility="Auto"
									              HorizontalScrollBarVisibility="Disabled"
									              Background="White">
                                        <ItemsPresenter>
                                            <ItemsPresenter.Resources>
                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="Foreground" Value="#111827"/>
                                                    <Setter Property="Padding" Value="6,4"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter Property="Background" Value="#F3F4F6"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#E5E7EB"/>
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground" Value="#9CA3AF"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsPresenter.Resources>
                                        </ItemsPresenter>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ Combo "Urg." dédié : GridComboStyle (utilisé par Bâtiment/Étage/Cat.) ne
             surcharge PAS le Template du ComboBox — le chrome par défaut du thème Windows
             reste opaque (fond blanc) même avec Background="Transparent" sur le ComboBox,
             ce qui cachait la couleur du Border placé derrière lui. Repris du template
             entièrement transparent de CompanyComboStyle (non éditable — valeurs 1/2/3
             choisies dans la liste, pas de saisie libre nécessaire). -->
        <Style x:Key="UrgencyComboStyle" TargetType="ComboBox" BasedOn="{StaticResource GridComboStyle}">
            <Setter Property="IsEditable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
						              Focusable="False"
						              ClickMode="Press"
						              HorizontalContentAlignment="Stretch"
						              VerticalContentAlignment="Center"
						              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
						              Background="Transparent"
						              BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
									                  Margin="4,0,0,0"
									                  VerticalAlignment="Center"
									                  HorizontalAlignment="Center"
									                  Content="{TemplateBinding SelectionBoxItem}">
                                        <ContentPresenter.ContentTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
												           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ComboBox}, Path=Foreground}"/>
                                            </DataTemplate>
                                        </ContentPresenter.ContentTemplate>
                                    </ContentPresenter>

                                    <Path Grid.Column="1"
									      Data="M 0 0 L 4 4 L 8 0 Z"
									      Fill="#6B7280"
									      HorizontalAlignment="Center"
									      VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>

                            <Popup x:Name="Popup"
						       Placement="Bottom"
						       IsOpen="{TemplateBinding IsDropDownOpen}"
						       AllowsTransparency="True"
						       Focusable="False"
						       PopupAnimation="Fade">
                                <Border Background="White"
								        BorderBrush="#D1D5DB"
								        BorderThickness="1"
								        CornerRadius="6"
								        SnapsToDevicePixels="True">
                                    <ScrollViewer Margin="2"
									              SnapsToDevicePixels="True"
									              VerticalScrollBarVisibility="Auto"
									              HorizontalScrollBarVisibility="Disabled"
									              Background="White">
                                        <ItemsPresenter>
                                            <ItemsPresenter.Resources>
                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="Foreground" Value="#111827"/>
                                                    <Setter Property="Padding" Value="6,4"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter Property="Background" Value="#F3F4F6"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#E5E7EB"/>
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground" Value="#9CA3AF"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsPresenter.Resources>
                                        </ItemsPresenter>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextZoneRichTextBoxStyle" TargetType="RichTextBox">
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="72"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ✅ Filtres façon Excel sur l'en-tête de la grille des Tâches (demande de Joe), même
             mécanisme que sur les Bons actifs (DashboardPage/ArchivesPage), styles dupliqués ici
             (convention déjà établie dans ce projet : pas de centralisation à large portée). -->
        <Style x:Key="FilterHeaderButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterHeaderButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource FilterHeaderButtonStyle}">
            <Setter Property="Foreground" Value="#1D4ED8"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="FilterHeaderHighlightBorderStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- ✅ NOUVEAU (18.08.2026, demande de Joe) : ligne pour PvPanel, entre la barre
                 Début/Fin et le bloc figé des Tâches (TasksHeaderFixedBlock, décalé de Row="2"
                 à Row="3" ci-dessous, ainsi que TasksHeaderCollapsedSeparator et
                 MainScrollViewer). -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ✅ Titre de page (28.07.2026, demande de Joe : même police que les autres pages,
             ex. "Comptabilité"). -->
        <TextBlock Grid.Row="0"
                   Text="Planification"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#111827"
                   Margin="0,0,0,12"/>

        <!-- ✅ Sélection de semaine + dates déplacées ici (19.07.2026, 2e demande de Joe) :
             cette Row="1" est HORS du ScrollViewer (voir MainScrollViewer, Row="2") -> zone
             figée, toujours visible au scroll, même ligne que "Générer PDF". -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="PrevWeekButton"
                        Content="◀"
                        Click="PrevWeekButton_Click"
                        Width="22" Height="24"
                        Margin="0,0,6,0"
                        Padding="0"
                        Style="{StaticResource WeekNavButtonStyle}"/>
                <TextBlock x:Name="WeekTextBlock"
                           Text="Semaine …"
                           Foreground="#111827"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <Button x:Name="NextWeekButton"
                        Content="▶"
                        Click="NextWeekButton_Click"
                        Width="22" Height="24"
                        Margin="0,0,4,0"
                        Padding="0"
                        Style="{StaticResource WeekNavButtonStyle}"/>

                <TextBlock Text="Début :"
                           Foreground="#374151"
                           VerticalAlignment="Center"
                           Margin="14,0,4,0"/>
                <DatePicker x:Name="StartDatePicker"
                            Width="100"
                            Height="24"
                            Style="{StaticResource PlanningDatePickerStyle}"
                            SelectedDateChanged="StartDatePicker_SelectedDateChanged"/>

                <TextBlock Text="Fin :"
                           Foreground="#374151"
                           VerticalAlignment="Center"
                           Margin="30,0,4,0"/>
                <TextBlock x:Name="EndDateTextBlock"
                           Foreground="#111827"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>

                <!-- ✅ NOUVEAU (18.08.2026, demande de Joe) : bascule l'affichage du bloc
                     "Participants (Mode PV)" juste au-dessus de la grille des Tâches (voir
                     PvPanel, Grid.Row="2"), pour la liste des participants d'une séance. -->
                <Button x:Name="TogglePvModeButton"
                        Content="Mode PV"
                        Style="{StaticResource WeekNavButtonStyle}"
                        Height="30"
                        Padding="10,0"
                        Margin="20,0,0,0"
                        Click="TogglePvModeButton_Click"/>

            </StackPanel>

            <!-- ✅ Marge droite de 8 pour aligner le bord droit avec la pastille "Dossier" de
                 MainWindow : le conteneur de page (Border Padding="12") est inset de 4px de
                 plus que le bandeau de nav (Padding="8,6"), et la pastille a elle-même une
                 marge droite de 12 dans son StackPanel — 12+8-12 = 8 de marge ici pour
                 compenser exactement l'écart. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                <!-- ✅ Raccourcis de navigation (demande de Joe) : liste des tâches pouvant devenir
                     très longue, ces 4 boutons évitent de devoir scroller manuellement jusqu'à
                     une section. Placés dans cette barre du haut (déjà figée, hors du
                     ScrollViewer) plutôt qu'un rail flottant séparé, à la demande de Joe. -->
                <Button x:Name="ScrollToTopHeaderButton"
                        Content="Haut de page"
                        Style="{StaticResource WeekNavButtonStyle}"
                        Height="30"
                        Padding="10,0"
                        Margin="0,0,4,0"
                        Click="ScrollToTopButton_Click"/>
                <Button Content="Planning"
                        Style="{StaticResource WeekNavButtonStyle}"
                        Height="30"
                        Padding="10,0"
                        Margin="0,0,4,0"
                        Click="ScrollToWeeklyButton_Click"/>
                <Button Content="Image"
                        Style="{StaticResource WeekNavButtonStyle}"
                        Height="30"
                        Padding="10,0"
                        Margin="0,0,4,0"
                        Click="ScrollToImageButton_Click"/>
                <Button Content="Bas de page"
                        Style="{StaticResource WeekNavButtonStyle}"
                        Height="30"
                        Padding="10,0"
                        Margin="0,0,14,0"
                        Click="ScrollToBottomButton_Click"/>

                <Button x:Name="ExportPdfButton"
                        Content="Générer PDF"
                        Style="{StaticResource PdfButtonStyle}"
                        VerticalAlignment="Center"
                        Height="30"
                        Width="150"
                        FontSize="15"
                        Click="ExportPdfButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- ✅ Bloc "Ajouter"/"Supprimer" + en-tête de colonnes des Tâches, placés en dur ici
             (demande de Joe) : zone figée au même titre que la barre "Début/Fin" au-dessus
             (Grid.Row="2", hors du ScrollViewer), plus besoin de bascule dynamique ni de calcul
             de seuil, juste un placement statique. Le scroll de la page (MainScrollViewer,
             Row="3") démarre donc directement à la 1ère ligne de tâches. L'en-tête de colonnes
             ci-dessous est "détaché" de TasksDataGrid (qui a HeadersVisibility="None" plus bas)
             : mêmes libellés/boutons de filtre (réutilisent TaskColumnFilterButton_Click), mais
             largeurs liées en live à TasksDataGrid.Columns[x].ActualWidth via x:Reference, pour
             rester alignées même si une colonne se redimensionne ou est masquée/affichée
             (ActualWidth=0 quand masquée -> la cellule disparaît aussi, sans code supplémentaire). -->
        <!-- ✅ x:Name ajouté (10.08.2026, demande de Joe) : ce bloc figé se masque désormais
             quand la grille Tâches est entièrement scrollée hors de vue, pour ne plus se
             superposer à la section Planning hebdo qui remonte dessous (MainScrollViewer_ScrollChanged). -->
        <!-- ✅ Padding bas réduit 10->4 (demande de Joe, 10.08.2026) : compense le Margin haut
             de 2mm ajouté sur la ligne de titres plus bas, qui laissait trop de vide sous les
             flèches ▾ et donnait l'impression que titres/flèches restaient trop hauts dans la carte. -->
        <!-- ✅ NOUVEAU (18.08.2026, demande de Joe) : "Mode PV" (bouton près des dates) fait
             apparaître ce bloc, juste au-dessus de la grille des Tâches. Liste de
             participants (Nom/Entreprise), étalée en 2 colonnes côte à côte pour économiser
             de la hauteur (voir RebuildPvParticipantsUI). Le champ "Nom" de chaque ligne est
             une ComboBox éditable listant les contacts du Carnet d'adresses : sélectionner un
             contact importe Nom/Entreprise en une fois. Pas de colonne "Prénom" séparée
             (demande de Joe, 18.08.2026 : le carnet d'adresses ne sépare plus Prénom/Nom, un
             seul champ "Nom" y contient les deux). -->
        <Border x:Name="PvPanel"
                Grid.Row="2"
                Background="White"
                BorderBrush="#6B7280"
                BorderThickness="1"
                CornerRadius="18"
                Padding="10"
                Effect="{StaticResource CardShadowEffect}"
                Margin="17,0,33,12"
                Visibility="Collapsed">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="PARTICIPANTS À LA SÉANCE" FontSize="12.5" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- ✅ NOUVEAU (18.08.2026, demande de Joe) : importe en une fois tous
                             les membres d'un groupe du Carnet d'adresses (voir ImportPvGroupButton_Click/
                             ImportPvGroup). Les doublons (même Nom+Entreprise déjà présents) sont
                             ignorés, et les nouveaux participants sont répartis gauche/droite comme
                             les ajouts manuels (voir AddPvParticipant), pour économiser la hauteur. -->
                        <Button x:Name="AddPvParticipantButton"
                                Content="+ Ajouter participant"
                                Style="{StaticResource SmallBlueButtonStyle}"
                                Height="30"
                                Margin="0,0,8,0"
                                Click="AddPvParticipantButton_Click"/>
                        <!-- ✅ "Importer un groupe" à droite (18.08.2026, demande de Joe). -->
                        <Button x:Name="ImportPvGroupButton"
                                Content="Importer un groupe ▾"
                                Style="{StaticResource OutlineBlueButtonStyle}"
                                Height="30"
                                Click="ImportPvGroupButton_Click"/>
                    </StackPanel>
                </Grid>

                <Popup x:Name="PvGroupImportPopup"
                       PlacementTarget="{Binding ElementName=ImportPvGroupButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="6"
                            MinWidth="180"
                            MaxHeight="300"
                            Effect="{StaticResource CardShadowEffect}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="288">
                            <StackPanel x:Name="PvGroupImportListPanel"/>
                        </ScrollViewer>
                    </Border>
                </Popup>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="26"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Nom" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="1" Text="Entreprise" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280"/>
                        </Grid>
                        <StackPanel x:Name="PvParticipantsLeftPanel"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="26"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Nom" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="1" Text="Entreprise" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280"/>
                        </Grid>
                        <StackPanel x:Name="PvParticipantsRightPanel"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border x:Name="TasksHeaderFixedBlock"
                Grid.Row="3"
                BorderBrush="#6B7280"
                BorderThickness="1,1,1,0"
                CornerRadius="18"
                Padding="10,10,10,2"
                Effect="{StaticResource CardShadowEffect}"
                Margin="17,0,33,0">
            <StackPanel>
                <Popup x:Name="TaskColumnFilterPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
                    <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="8" MinWidth="220" MaxHeight="380" Effect="{StaticResource CardShadowEffect}">
                        <StackPanel>
                            <CheckBox x:Name="TaskAlphaSortCheckBox"
                                      Content="Trier par ordre alphabétique (A→Z)"
                                      Margin="0,0,0,8"/>

                            <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Margin="0,0,0,6"/>

                            <CheckBox x:Name="TaskFilterSelectAllCheckBox"
                                      Content="(Tout sélectionner)"
                                      IsChecked="True"
                                      FontWeight="Bold"
                                      Click="TaskFilterSelectAllCheckBox_Click"
                                      Margin="0,0,0,6"/>

                            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="TaskFilterOptionsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding DisplayText}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="Annuler" Style="{StaticResource OutlineBlueButtonStyle}" Click="TaskColumnFilterCancel_Click" Margin="0,0,6,0"/>
                                <Button Content="OK" Style="{StaticResource SmallBlueButtonStyle}" Click="TaskColumnFilterApply_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- ✅ Largeur de colonne 0 ramenée de 178 à 98 (demande de Joe, 10.08.2026) :
                     "Supprimer définitivement" ajouté à droite poussait Voir Archives/Voir
                     Corbeille/Colonnes ▾ trop loin. La bordure gauche d'"Ajouter" s'aligne
                     désormais directement sur la colonne Bâtiment de cette grille-ci (98 =
                     largeur colonne case à cocher [28] + colonne N° [70]), au lieu de suivre la
                     référence "Entreprise" du Planning hebdo (178, ancien réglage du
                     31.07.2026). -->
                <Grid x:Name="TaskHeaderToolbar" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="98"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="TÂCHES"
                               FontSize="12.5"
                               FontWeight="Bold"
                               Foreground="Black"
                               VerticalAlignment="Center"/>

                    <!-- ✅ "Ajouter" décalé de 3mm (11.34px) vers la droite au total (demande de
                         Joe, 10.08.2026 : 2mm + 1mm supplémentaire). "Archiver sélection" ne bouge
                         pas (demande de Joe) : son propre Margin réduit d'autant (8 -> 4.22) pour
                         compenser exactement le décalage d'"Ajouter" et rester à la même position
                         absolue. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="AddTaskRowButton"
                                Content="Ajouter"
                                Style="{StaticResource SmallBlueButtonStyle}"
                                Height="30"
                                Margin="11.34,0,0,0"
                                Click="AddTaskRowButton_Click"/>

                        <!-- ✅ 30.07.2026 (demande de Joe) : archive la/les tâche(s)
                             sélectionnée(s) (comme "Supprimer", même sélection) au lieu de
                             les effacer, consultable/restaurable depuis "Archives tâches".
                             ✅ Repositionné juste après "Ajouter" (demande de Joe, 04.08.2026).
                             ✅ Grisé tant qu'aucune ligne n'est sélectionnée (demande de Joe,
                             04.08.2026), voir RefreshTaskSelectionButtonsState. -->
                        <Button x:Name="ArchiveTaskRowButton"
                                Content="Archiver sélection"
                                Style="{StaticResource ArchiveOutlineButtonStyle}"
                                Height="30"
                                Margin="4.22,0,0,0"
                                IsEnabled="False"
                                Click="ArchiveTaskRowButton_Click"/>

                        <!-- ✅ Renommé (demande de Joe, 04.08.2026) : ce bouton ne supprime pas
                             définitivement, il met à la corbeille (voir
                             RemoveTaskRowButton_Click, IsTrashed/TrashedAt), même principe
                             que "Déplacer dans la corbeille" sur Bons d'intervention.
                             ✅ Grisé tant qu'aucune ligne n'est sélectionnée (demande de Joe,
                             04.08.2026), voir RefreshTaskSelectionButtonsState. -->
                        <!-- ✅ Rapproché d'"Archiver sélection" (demande de Joe, 10.08.2026) : même
                             espacement (4.22px) entre les 3 boutons Ajouter/Archiver/Corbeille. -->
                        <Button x:Name="RemoveTaskRowButton"
                                Content="Déplacer dans la corbeille"
                                Style="{StaticResource SmallBlackButtonStyle}"
                                IsEnabled="False"
                                Height="30"
                                Margin="4.22,0,0,0"
                                Click="RemoveTaskRowButton_Click"/>

                        <!-- ✅ "Supprimer définitivement" (demande de Joe, 10.08.2026) : retire la
                             tâche directement, sans passer par la Corbeille (PermanentlyDeleteTaskRowButton_Click,
                             PlanningPage.xaml.cs), même style que "Voir Corbeille"/DangerSmallButtonStyle
                             ailleurs dans l'app (fond rouge clair, texte/bordure rouges) pour bien la
                             distinguer visuellement de "Déplacer dans la corbeille" (réversible). -->
                        <Button x:Name="PermanentlyDeleteTaskRowButton"
                                Content="Supprimer définitivement"
                                Style="{StaticResource SmallBlackButtonStyle}"
                                Background="#FEE2E2"
                                Foreground="#B91C1C"
                                BorderBrush="#B91C1C"
                                IsEnabled="False"
                                Height="30"
                                Margin="4.22,0,0,0"
                                Click="PermanentlyDeleteTaskRowButton_Click"/>
                    </StackPanel>

                    <!-- ✅ "Voir Archives"/"Voir Corbeille" déplacés ici (demande de Joe, 10.08.2026),
                         à droite de "Déplacer dans la corbeille". Bordure gauche de "Voir Archives"
                         alignée verticalement sur la bordure gauche de "Haut de page" (barre du
                         dessus) : alignement recalculé en live par AlignArchivesTrashButtons()
                         (PlanningPage.xaml.cs), pas possible à figer en dur en XAML puisque la
                         position de "Haut de page" dépend de la largeur de la fenêtre. -->
                    <StackPanel x:Name="ArchivesTrashButtonsPanel"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <Button x:Name="PlanningArchivesButton"
                                Content="Voir Archives"
                                Style="{StaticResource WeekNavButtonStyle}"
                                Background="#F3F4F6"
                                Height="30"
                                Padding="10,0"
                                Margin="0,0,6,0"
                                Click="PlanningArchivesButton_Click"/>
                        <Button x:Name="PlanningTrashButton"
                                Content="Voir Corbeille"
                                Style="{StaticResource WeekNavButtonStyle}"
                                Background="#FEE2E2"
                                Foreground="#B91C1C"
                                BorderBrush="#B91C1C"
                                Height="30"
                                Padding="10,0"
                                Click="PlanningTrashButton_Click"/>
                    </StackPanel>

                    <!-- ✅ Choix des colonnes à listes déroulantes affichées/masquées
                         (mémorisé entre les sessions via Db.GetTasksVisibleColumns/
                         SetTasksVisibleColumns). -->
                    <Button x:Name="TaskColumnsButton"
                            Grid.Column="3"
                            Content="Colonnes ▾"
                            Style="{StaticResource OutlineBlueButtonStyle}"
                            Height="30"
                            Click="TaskColumnsButton_Click"/>
                </Grid>

                <Popup x:Name="TaskColumnsPopup"
                       PlacementTarget="{Binding ElementName=TaskColumnsButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Effect="{StaticResource CardShadowEffect}">
                        <StackPanel>
                            <TextBlock Text="Colonnes visibles" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ColShowBuildingCheckBox" Content="Bâtiment" Margin="0,2" Click="TaskColumnVisibility_Changed"/>
                            <CheckBox x:Name="ColShowFloorCheckBox" Content="Étage" Margin="0,2" Click="TaskColumnVisibility_Changed"/>
                            <CheckBox x:Name="ColShowCategoryCheckBox" Content="Catégorie" Margin="0,2" Click="TaskColumnVisibility_Changed"/>
                            <CheckBox x:Name="ColShowCompanyCheckBox" Content="Intervenants" Margin="0,2" Click="TaskColumnVisibility_Changed"/>
                            <CheckBox x:Name="ColShowUrgencyCheckBox" Content="Urg." Margin="0,2" Click="TaskColumnVisibility_Changed"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- ✅ Margin haut 7.56px = 2mm (demande de Joe, 10.08.2026) : titres décalés vers le bas.
                     ✅ Bordure quadrillée (demande de Joe, 10.08.2026) : chaque cellule porte son propre
                     bord gauche/haut/bas (BorderThickness="1,1,0,1"), la dernière cellule ("Effectuée")
                     ferme aussi le bord droit, évite les doubles traits entre cellules adjacentes tout
                     en formant un contour complet autour de toute la ligne de titres. -->
                <StackPanel Orientation="Horizontal" Margin="0,7.56,0,0">
                    <!-- ✅ Case "tout sélectionner" (demande de Joe, 10.08.2026) : réutilise
                         TaskSelectAllCheckBox_Click, déjà écrit le 30.07.2026 pour la case
                         équivalente dans l'en-tête natif de TasksDataGrid (TaskSelectColumn),
                         mais jamais visible depuis que cet en-tête est masqué
                         (HeadersVisibility="None", remplacé par ce bloc détaché). Même x:Name,
                         sans collision : celui du DataGridTemplateColumn.HeaderTemplate vit dans
                         son propre NameScope (DataTemplate), jamais instancié tant que l'en-tête
                         natif reste masqué. -->
                    <Border Width="28" BorderBrush="#D1D5DB" BorderThickness="1,1,0,1">
                        <CheckBox x:Name="TaskSelectAllCheckBox"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Click="TaskSelectAllCheckBox_Click"/>
                    </Border>
                    <Border Width="70" BorderBrush="#D1D5DB" BorderThickness="1,1,0,1">
                        <TextBlock Text="N°" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="#111827"/>
                    </Border>
                    <!-- ✅ Fix désync titres/colonnes (18.08.2026, demande de Joe) : Visibility liée en plus
                         de Width, car ActualWidth d'une DataGridColumn ne retombe pas forcément à 0 quand
                         elle passe Visibility="Collapsed" (elle garde parfois sa dernière largeur mesurée) —
                         sans ce Binding la case de titre restait affichée à sa taille précédente et
                         décalait tous les titres suivants par rapport aux colonnes réellement visibles. -->
                    <Border Width="{Binding ActualWidth, Source={x:Reference TaskBuildingColumn}}"
                            Visibility="{Binding Visibility, Source={x:Reference TaskBuildingColumn}}"
                            BorderBrush="#D1D5DB" BorderThickness="1,1,0,1">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DataContext.BuildingLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="#111827"/>
                            <Button Content="▾" Tag="Building" Style="{StaticResource FilterHeaderButtonStyle}" Click="TaskColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Width="{Binding ActualWidth, Source={x:Reference TaskFloorColumn}}"
                            Visibility="{Binding Visibility, Source={x:Reference TaskFloorColumn}}"
                            BorderBrush="#D1D5DB" BorderThickness="1,1,0,1">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DataContext.FloorLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="#111827"/>
                            <Button Content="▾" Tag="Floor" Style="{StaticResource FilterHeaderButtonStyle}" Click="TaskColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Width="{Binding ActualWidth, Source={x:Reference TaskTodoColumn}}" BorderBrush="#D1D5DB" BorderThickness="1,1,0,1">
                        <TextBlock Text="Descriptif" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="#111827"/>
                    </Border>
                    <Border Width="56" BorderBrush="#D1D5DB" BorderThickness="1,1,0,1"/>
                    <Border Width="{Binding ActualWidth, Source={x:Reference TaskCategoryColumn}}"
                            Visibility="{Binding Visibility, Source={x:Reference TaskCategoryColumn}}"
                            BorderBrush="#D1D5DB" BorderThickness="1,1,0,1">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DataContext.TaskCategoryLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="#111827"/>
                            <Button Content="▾" Tag="Category" Style="{StaticResource FilterHeaderButtonStyle}" Click="TaskColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Width="{Binding ActualWidth, Source={x:Reference TaskCompanyColumn}}"
                            Visibility="{Binding Visibility, Source={x:Reference TaskCompanyColumn}}"
                            BorderBrush="#D1D5DB" BorderThickness="1,1,0,1">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DataContext.CompanyLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="#111827"/>
                            <Button Content="▾" Tag="Company" Style="{StaticResource FilterHeaderButtonStyle}" Click="TaskColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Width="{Binding ActualWidth, Source={x:Reference TaskUrgentColumn}}"
                            Visibility="{Binding Visibility, Source={x:Reference TaskUrgentColumn}}"
                            BorderBrush="#D1D5DB" BorderThickness="1,1,0,1">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DataContext.TaskUrgencyLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="#111827"/>
                            <Button Content="▾" Tag="Urgent" Style="{StaticResource FilterHeaderButtonStyle}" Click="TaskColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Width="90" BorderBrush="#D1D5DB" BorderThickness="1,1,1,1">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <TextBlock Text="Effectuée" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="#111827"/>
                            <Button Content="▾" Tag="Done" Style="{StaticResource FilterHeaderButtonStyle}" Click="TaskColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ✅ Ligne de séparation de repli (demande de Joe, 10.08.2026) : visible seulement
             quand TasksHeaderFixedBlock est masqué (grille Planning remontée), pour combler le
             vide laissé entre la barre Début/Fin/Haut de page et les sections qui suivent.
             Basculée par MainScrollViewer_ScrollChanged (PlanningPage.xaml.cs), même Grid.Row
             que TasksHeaderFixedBlock, jamais visible en même temps que lui. -->
        <Border x:Name="TasksHeaderCollapsedSeparator"
                Grid.Row="3"
                Height="1"
                Background="#6B7280"
                Margin="16,0,33,0"
                Visibility="Collapsed"/>

        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="4" VerticalScrollBarVisibility="Auto" ScrollChanged="MainScrollViewer_ScrollChanged">
            <Grid Margin="16,0,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1) Tâches -->
                <!-- ✅ Padding haut retiré (demande de Joe, 10.08.2026, "coller les 2 éléments") :
                     avec le Margin bas de TasksHeaderFixedBlock ramené à 0, ce Padding top de 10 était
                     le dernier contributeur à l'espace visible entre l'entête et la 1ère ligne de la
                     grille des tâches. -->
                <Border x:Name="TaskSectionBorder"
                        Grid.Row="0"
				        BorderBrush="#6B7280"
				        BorderThickness="1"
				        CornerRadius="18"
				        Padding="10,0,10,10"
		        Effect="{StaticResource CardShadowEffect}"
				        Margin="0,0,0,12">
                    <!-- ✅ En-tête de colonnes masqué (HeadersVisibility="None") : remplacé par le
                         bloc détaché placé en dur au-dessus du ScrollViewer (demande de Joe,
                         voir plus haut), avec ses propres Popups TaskColumnFilterPopup et
                         TaskColumnsPopup désormais définis là-bas. -->
                        <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="10" ClipToBounds="True" VerticalAlignment="Center" Margin="0,8,0,0">
                        <DataGrid x:Name="TasksDataGrid"
					          Style="{StaticResource PlanningGridStyle}"
					          HeadersVisibility="None"
					          AutoGenerateColumns="False"
						          CanUserAddRows="False"
						          RowHeaderWidth="0"
						          SelectionUnit="FullRow"
						          Background="White"
						          IsReadOnly="False"
						          CellEditEnding="TasksDataGrid_CellEditEnding"
						          SelectionChanged="TasksDataGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn x:Name="TaskSelectColumn" Header="" Width="28" CanUserResize="False">
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <!-- ✅ 30.07.2026 (demande de Joe) : case à cocher qui sélectionne
                                                 toutes les cases de la colonne. -->
                                            <CheckBox x:Name="TaskSelectAllCheckBox"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Click="TaskSelectAllCheckBox_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center"
											          VerticalAlignment="Center"
											          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="TaskRefColumn" Header="N°" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="0" Padding="0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource CompanyBgConverter}">
                                                                    <Binding Path="Company"/>
                                                                    <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Company}" Value="">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Company}" Value="{x:Null}">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <TextBlock Text="{Binding Ref}"
												           HorizontalAlignment="Center"
												           VerticalAlignment="Center"
												           FontWeight="SemiBold">
                                                    <TextBlock.Foreground>
                                                        <MultiBinding Converter="{StaticResource CompanyFgConverter}">
                                                            <Binding Path="Company"/>
                                                            <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Ref, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Center"
                                                     HorizontalContentAlignment="Center"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     FontWeight="SemiBold"
                                                     Padding="2,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- ✅ Plus de MaxWidth (30.07.2026, demande de Joe) : un mot long ne doit
                                     plus être coupé, ni dans les lignes ni dans l'entête, la colonne
                                     s'élargit maintenant librement pour l'accueillir (au lieu de tronquer,
                                     voir ancien commentaire du 16.07.2026 remplacé ici). -->
                                <DataGridTemplateColumn x:Name="TaskBuildingColumn" MinWidth="90" Width="Auto">
                                    <!-- ✅ Filtre Excel (demande de Joe) : Header (instance unique,
                                         permanente) au lieu de HeaderTemplate, nécessaire pour
                                         nommer le Border/Button et les retrouver depuis
                                         UpdateTaskFilterButtonIndicators (un HeaderTemplate est
                                         instancié par le système de présentation, ses éléments
                                         nommés ne deviennent pas des champs de la classe). Le
                                         binding dynamique du libellé (RelativeSource
                                         AncestorType=UserControl) fonctionne pareil ici. -->
                                    <DataGridTemplateColumn.Header>
                                        <Border x:Name="BuildingHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DataContext.BuildingLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center"/>
                                                <Button x:Name="BuildingFilterButton" Content="▾" Tag="Building" Style="{StaticResource FilterHeaderButtonStyle}" Click="TaskColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource GridComboStyle}"
											          ItemsSource="{Binding DataContext.Buildings, RelativeSource={RelativeSource AncestorType=UserControl}}"
											          SelectedItem="{Binding Building, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="TaskFloorColumn" MinWidth="80" Width="Auto">
                                    <DataGridTemplateColumn.Header>
                                        <Border x:Name="FloorHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DataContext.FloorLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center"/>
                                                <Button x:Name="FloorFilterButton" Content="▾" Tag="Floor" Style="{StaticResource FilterHeaderButtonStyle}" Click="TaskColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource GridComboStyle}"
											          ItemsSource="{Binding DataContext.Floors, RelativeSource={RelativeSource AncestorType=UserControl}}"
											          SelectedItem="{Binding Floor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ✅ N'affiche que la 1ère ligne en mode lecture (le texte complet peut
                                     être multi-lignes via l'éditeur agrandi) — édition rapide inline
                                     toujours possible (reste sur une seule ligne, comme avant). -->
                                <DataGridTemplateColumn x:Name="TaskTodoColumn" Header="Descriptif" MinWidth="120" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Todo, Converter={StaticResource TodoFirstLineConverter}}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Todo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     MaxLength="80"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     VerticalContentAlignment="Center"
                                                     LostFocus="TaskTodoTextBox_LostFocus"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- ✅ Éditeur agrandi du Descriptif (16.07.2026, demande de Joe) : ouvre
                                     TaskDescriptionWindow en modal pour saisir/consulter un texte long,
                                     avec bouton "Générer PDF" — le champ reste le même, juste plus
                                     confortable pour écrire beaucoup de texte. Crayon si 1 seule ligne ;
                                     texte "Voir +" (sans fond coloré) si plus d'une ligne. Icône/texte
                                     agrandis (demande de Joe, 16.07.2026, 2e passe). -->
                                <DataGridTemplateColumn x:Name="TaskExpandDescriptionColumn" Header="" Width="56" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Padding="4,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="Agrandir / éditer le descriptif"
                                                    Click="TaskExpandDescriptionButton_Click">
                                                <Grid>
                                                    <Path Data="{StaticResource IconEditGeometry}"
                                                          Stretch="Uniform"
                                                          Width="15"
                                                          Height="15"
                                                          Fill="#6B7280"
                                                          Visibility="{Binding Todo, Converter={StaticResource TodoShowPencilConverter}}"/>
                                                    <TextBlock Text="Voir +"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="#2563EB"
                                                               Visibility="{Binding Todo, Converter={StaticResource TodoShowVoirPlusConverter}}"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="TaskCategoryColumn" MinWidth="90" Width="Auto">
                                    <DataGridTemplateColumn.Header>
                                        <Border x:Name="CategoryHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DataContext.TaskCategoryLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center"/>
                                                <Button x:Name="CategoryFilterButton" Content="▾" Tag="Category" Style="{StaticResource FilterHeaderButtonStyle}" Click="TaskColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource GridComboStyle}"
											          ItemsSource="{Binding DataContext.TaskCategoriesWithBlank, RelativeSource={RelativeSource AncestorType=UserControl}}"
											          SelectedItem="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ✅ Déplacée entre Catégorie et Urg. (demande de Joe du 16.07.2026). -->
                                <DataGridTemplateColumn x:Name="TaskCompanyColumn" MinWidth="130" Width="Auto">
                                    <DataGridTemplateColumn.Header>
                                        <Border x:Name="CompanyHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DataContext.CompanyLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center"/>
                                                <Button x:Name="CompanyFilterButton" Content="▾" Tag="Company" Style="{StaticResource FilterHeaderButtonStyle}" Click="TaskColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource CompanyBgConverter}">
                                                                    <Binding Path="Company"/>
                                                                    <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Company}" Value="">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Company}" Value="{x:Null}">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <ComboBox Style="{StaticResource CompanyComboStyle}"
												          VerticalAlignment="Center"
												          Height="20"
												          ItemsSource="{Binding DataContext.Companies, RelativeSource={RelativeSource AncestorType=UserControl}}"
												          SelectedItem="{Binding Company, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <ComboBox.Foreground>
                                                        <MultiBinding Converter="{StaticResource CompanyFgConverter}">
                                                            <Binding Path="Company"/>
                                                            <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </ComboBox.Foreground>
                                                </ComboBox>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ✅ Retiré du sélecteur "Colonnes" (remplacé par Urg.) — reste
                                     masquée en permanence, comme avant l'ajout de ce sélecteur. -->
                                <DataGridTemplateColumn x:Name="TaskReserveColumn" Header="Concerne" Width="110" Visibility="Collapsed">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource GridComboStyle}"
											          ItemsSource="{Binding DataContext.Reserves, RelativeSource={RelativeSource AncestorType=UserControl}}"
											          SelectedItem="{Binding Reserve, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="TaskUrgentColumn" MinWidth="52" Width="Auto">
                                    <!-- ✅ Width Auto (au lieu de 52 fixe) : la colonne doit pouvoir
                                         s'élargir pour accueillir le bouton de filtre "▾" sous le
                                         libellé, MinWidth conservé comme largeur plancher. -->
                                    <DataGridTemplateColumn.Header>
                                        <Border x:Name="UrgentHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DataContext.TaskUrgencyLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center"/>
                                                <Button x:Name="UrgentFilterButton" Content="▾" Tag="Urgent" Style="{StaticResource FilterHeaderButtonStyle}" Click="TaskColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- ✅ Couleur selon la valeur (1=rouge, 2=orange, 3=jaune clair) via
                                                 converter (UrgencyBgConverter) plutôt que DataTrigger : binding
                                                 direct sur Background, sans dépendre du timing de sélection d'un
                                                 ComboBox éditable (IsEditable="True" sur GridComboStyle). -->
                                            <Border Background="{Binding Urgent, Converter={StaticResource UrgencyBgConverter}}" CornerRadius="4" Padding="0">
                                                <ComboBox Style="{StaticResource UrgencyComboStyle}"
												          ItemsSource="{Binding DataContext.TaskUrgenciesWithBlank, RelativeSource={RelativeSource AncestorType=UserControl}}"
												          SelectedItem="{Binding Urgent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												          Foreground="{Binding Urgent, Converter={StaticResource UrgencyFgConverter}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ✅ Largeur augmentée (16.07.2026, demande de Joe) : 61px coupait la
                                     dernière lettre de "Effectué" depuis l'agrandissement de la police
                                     des grilles (13→15). -->
                                <DataGridTemplateColumn x:Name="TaskDoneColumn" Width="90">
                                    <DataGridTemplateColumn.Header>
                                        <Border x:Name="DoneHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                                <TextBlock Text="Effectuée" HorizontalAlignment="Center"/>
                                                <Button x:Name="DoneFilterButton" Content="▾" Tag="Done" Style="{StaticResource FilterHeaderButtonStyle}" Click="TaskColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="DoneCellBorder" Background="Transparent" CornerRadius="4" Padding="0">
                                                <CheckBox x:Name="TaskDoneCheckBox"
												          HorizontalAlignment="Center"
												          VerticalAlignment="Center"
												          IsChecked="{Binding Done, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												          Click="TaskDoneCheckBox_Click"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Done}" Value="True">
                                                    <Setter TargetName="DoneCellBorder" Property="Background" Value="#C7F9C7"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        </Border>
                </Border>

                <!-- 2) Planning hebdo -->
                <Border x:Name="WeeklySectionBorder"
                        Grid.Row="1"
				        BorderBrush="#6B7280"
				        BorderThickness="1"
				        CornerRadius="18"
				        Padding="10"
		        Effect="{StaticResource CardShadowEffect}"
				        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ✅ 30.07.2026 (demande de Joe) : Grid (plutôt que DockPanel) pour que
                             "Ajouter" démarre à une position FIXE (178 = largeur colonne case à
                             cocher [28] + colonne Entreprise [MinWidth 150, valeur habituelle en
                             pratique]) et s'aligne verticalement avec le bord gauche de la colonne
                             "Lundi" de PlanningDataGrid ci-dessous, indépendamment de la largeur
                             du titre. Approximatif si un nom d'entreprise pousse la colonne
                             au-delà de 150 (colonne en Auto). -->
                        <Grid x:Name="WeeklyHeaderToolbar"
                              Grid.Row="0"
                              Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="178"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="PLANNING HEBDOMADAIRE"
							           FontSize="12.5"
							           FontWeight="Bold"
							           Foreground="Black"
							           VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="AddPlanningRowButton"
								        Content="Ajouter"
								        Style="{StaticResource SmallBlueButtonStyle}"
								        Height="30"
								        Click="AddPlanningRowButton_Click"/>

                                <Button x:Name="RemovePlanningRowButton"
								        Content="Supprimer"
								        Style="{StaticResource SmallBlackButtonStyle}"
								        Height="30"
								        Margin="8,0,0,0"
								        Click="RemovePlanningRowButton_Click"/>
                            </StackPanel>

                            <!-- ✅ Navigation de semaine + dates déplacées dans la zone figée en haut
                                 de page (19.07.2026, 2e demande de Joe), même ligne que "Générer PDF"
                                 -> toujours visibles au scroll. Voir Grid Grid.Row="0" (hors du
                                 ScrollViewer). -->

                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <!-- ✅ 30.07.2026 (demande de Joe) : commutateur Automatique/Manuel
                                     pour l'ajout des intervenants au planning depuis la liste des
                                     tâches, figé par semaine (voir AutoAddToggleButton_Click). -->
                                <Button x:Name="AutoAddToggleButton"
								        Content="Intervenant automatique"
								        Style="{StaticResource SmallBlueButtonStyle}"
								        Height="30"
								        ToolTip="Ajout automatique des intervenants au planning (choisis dans les tâches). Cliquer pour passer en manuel pour cette semaine."
								        Click="AutoAddToggleButton_Click"/>

                                <!-- ✅ Toutes les options de structure de la semaine regroupées sous
                                     un seul bouton (19.07.2026, demande de Joe : auparavant deux
                                     boutons séparés "Samedi/Dimanche ▾" et "Jours : 6 ▾"). Choix
                                     Samedi/Dimanche mémorisés PAR SEMAINE (voir LoadWeekState) ;
                                     structure 5/6 jours en mémoire pour la session (voir
                                     _weekDayCount). Placé tout à droite (30.07.2026, demande de
                                     Joe). -->
                                <Button x:Name="WeekStructureButton"
								        Content="Structurer la semaine ▾"
								        Style="{StaticResource OutlineBlueButtonStyle}"
								        Height="30"
								        Margin="8,0,0,0"
								        Click="WeekStructureButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <Popup x:Name="WeekStructurePopup"
                               PlacementTarget="{Binding ElementName=WeekStructureButton}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Background="White"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Effect="{StaticResource CardShadowEffect}">
                                <StackPanel>
                                    <TextBlock Text="Structure de la semaine" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                    <!-- ✅ 5 jours en premier (19.07.2026, demande de Joe). -->
                                    <RadioButton x:Name="WeekDayCount5RadioButton"
                                                 GroupName="WeekDayCount"
                                                 Content="5 jours ouvrés (+ weekend)"
                                                 Margin="0,2"
                                                 Click="WeekDayCount_Changed"/>
                                    <RadioButton x:Name="WeekDayCount6RadioButton"
                                                 GroupName="WeekDayCount"
                                                 Content="6 jours ouvrés (+ weekend)"
                                                 Margin="0,2"
                                                 Click="WeekDayCount_Changed"/>

                                    <!-- ✅ Déplacé depuis le haut de page (19.07.2026, demande de
                                         Joe) : même ComboBox, même gestionnaire
                                         (StartWeekdayCombo_SelectionChanged), juste regroupé ici.
                                         "Structure" avant "Début" (19.07.2026, 2e demande de Joe). -->
                                    <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,8,0,8"/>
                                    <TextBlock Text="Début de semaine" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="StartWeekdayCombo"
                                              Width="130"
                                              Height="24"
                                              HorizontalAlignment="Left"
                                              VerticalContentAlignment="Center"
                                              Margin="0,0,0,0"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectionChanged="StartWeekdayCombo_SelectionChanged"/>

                                    <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,8,0,8"/>
                                    <TextBlock Text="Colonnes visibles par semaine individuelle" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="WeekendShowSaturdayCheckBox" Content="Samedi" Margin="0,2" Click="WeekendColumnVisibility_Changed"/>
                                    <CheckBox x:Name="WeekendShowSundayCheckBox" Content="Dimanche" Margin="0,2" Click="WeekendColumnVisibility_Changed"/>

                                    <!-- ✅ Défauts Samedi/Dimanche indépendants (18.07.2026, demande de
                                         Joe) : cocher applique immédiatement à toutes les semaines déjà
                                         sauvegardées ET devient le défaut pour les nouvelles, voir
                                         Db.GetDefaultShowSaturday/GetDefaultShowSunday. Un utilisateur
                                         qui travaille tous les samedis mais jamais les dimanches ne coche
                                         que la première. -->
                                    <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,8,0,8"/>
                                    <TextBlock Text="Colonnes visibles toutes les semaines" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="WeekendSaturdayDefaultCheckBox"
                                              Content="Samedi par défaut"
                                              Margin="0,2"
                                              Click="WeekendSaturdayDefault_Changed"/>
                                    <CheckBox x:Name="WeekendSundayDefaultCheckBox"
                                              Content="Dimanche par défaut"
                                              Margin="0,2"
                                              Click="WeekendSundayDefault_Changed"/>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <Border Grid.Row="1" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                        <DataGrid x:Name="PlanningDataGrid"
						          Style="{StaticResource PlanningGridStyle}"
						          AutoGenerateColumns="False"
						          CanUserAddRows="False"
						          RowHeaderWidth="0"
						          Background="White"
						          IsReadOnly="False">
                            <DataGrid.Columns>

                                <!-- ✅ 29.07.2026 (demande de Joe) : case à cocher pour sélectionner
                                     les lignes à supprimer, même principe que TaskSelectColumn. -->
                                <DataGridTemplateColumn x:Name="PlanningSelectColumn" Header="" Width="28" CanUserResize="False">
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <!-- ✅ 30.07.2026 (demande de Joe) : case à cocher qui sélectionne
                                                 toutes les cases de la colonne. -->
                                            <CheckBox x:Name="PlanningSelectAllCheckBox"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Click="PlanningSelectAllCheckBox_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="PlanningCompanyColumn" MinWidth="150" Width="Auto">
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DataContext.CompanyLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource CompanyBgConverter}">
                                                                    <Binding Path="Company"/>
                                                                    <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Company}" Value="">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Company}" Value="{x:Null}">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <ComboBox Style="{StaticResource CompanyComboStyle}"
												          VerticalAlignment="Center"
												          Height="20"
												          ItemsSource="{Binding DataContext.Companies, RelativeSource={RelativeSource AncestorType=UserControl}}"
												          SelectedItem="{Binding Company, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <ComboBox.Foreground>
                                                        <MultiBinding Converter="{StaticResource CompanyFgConverter}">
                                                            <Binding Path="Company"/>
                                                            <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </ComboBox.Foreground>
                                                </ComboBox>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Jour 1" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="0">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource CellCompanyColorIfNotEmptyConverter}">
                                                        <Binding Path="D1"/>
                                                        <Binding Path="Company"/>
                                                        <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Border.Background>

                                                <TextBox Text="{Binding D1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												         FontWeight="SemiBold"
												         BorderThickness="0"
												         Background="Transparent"
												         Padding="6,0"
												         VerticalContentAlignment="Center">
                                                    <TextBox.Foreground>
                                                        <MultiBinding Converter="{StaticResource CellCompanyTextColorIfNotEmptyConverter}">
                                                            <Binding Path="D1"/>
                                                            <Binding Path="Company"/>
                                                            <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </TextBox.Foreground>
                                                </TextBox>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Jour 2" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="0">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource CellCompanyColorIfNotEmptyConverter}">
                                                        <Binding Path="D2"/>
                                                        <Binding Path="Company"/>
                                                        <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Border.Background>

                                                <TextBox Text="{Binding D2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												         FontWeight="SemiBold"
												         BorderThickness="0"
												         Background="Transparent"
												         Padding="6,0"
												         VerticalContentAlignment="Center">
                                                    <TextBox.Foreground>
                                                        <MultiBinding Converter="{StaticResource CellCompanyTextColorIfNotEmptyConverter}">
                                                            <Binding Path="D2"/>
                                                            <Binding Path="Company"/>
                                                            <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </TextBox.Foreground>
                                                </TextBox>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Jour 3" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="0">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource CellCompanyColorIfNotEmptyConverter}">
                                                        <Binding Path="D3"/>
                                                        <Binding Path="Company"/>
                                                        <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Border.Background>

                                                <TextBox Text="{Binding D3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												         FontWeight="SemiBold"
												         BorderThickness="0"
												         Background="Transparent"
												         Padding="6,0"
												         VerticalContentAlignment="Center">
                                                    <TextBox.Foreground>
                                                        <MultiBinding Converter="{StaticResource CellCompanyTextColorIfNotEmptyConverter}">
                                                            <Binding Path="D3"/>
                                                            <Binding Path="Company"/>
                                                            <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </TextBox.Foreground>
                                                </TextBox>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Jour 4" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="0">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource CellCompanyColorIfNotEmptyConverter}">
                                                        <Binding Path="D4"/>
                                                        <Binding Path="Company"/>
                                                        <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Border.Background>

                                                <TextBox Text="{Binding D4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												         FontWeight="SemiBold"
												         BorderThickness="0"
												         Background="Transparent"
												         Padding="6,0"
												         VerticalContentAlignment="Center">
                                                    <TextBox.Foreground>
                                                        <MultiBinding Converter="{StaticResource CellCompanyTextColorIfNotEmptyConverter}">
                                                            <Binding Path="D4"/>
                                                            <Binding Path="Company"/>
                                                            <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </TextBox.Foreground>
                                                </TextBox>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Jour 5" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="0">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource CellCompanyColorIfNotEmptyConverter}">
                                                        <Binding Path="D5"/>
                                                        <Binding Path="Company"/>
                                                        <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Border.Background>

                                                <TextBox Text="{Binding D5, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												         FontWeight="SemiBold"
												         BorderThickness="0"
												         Background="Transparent"
												         Padding="6,0"
												         VerticalContentAlignment="Center">
                                                    <TextBox.Foreground>
                                                        <MultiBinding Converter="{StaticResource CellCompanyTextColorIfNotEmptyConverter}">
                                                            <Binding Path="D5"/>
                                                            <Binding Path="Company"/>
                                                            <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </TextBox.Foreground>
                                                </TextBox>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ✅ Samedi DOIT être après le vendredi -->
                                <DataGridTemplateColumn x:Name="SaturdayColumn" Header="Samedi" Width="*" Visibility="Collapsed">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="0">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource CellCompanyColorIfNotEmptyConverter}">
                                                        <Binding Path="Sat"/>
                                                        <Binding Path="Company"/>
                                                        <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Border.Background>

                                                <TextBox Text="{Binding Sat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												         FontWeight="SemiBold"
												         BorderThickness="0"
												         Background="Transparent"
												         Padding="6,0"
												         VerticalContentAlignment="Center">
                                                    <TextBox.Foreground>
                                                        <MultiBinding Converter="{StaticResource CellCompanyTextColorIfNotEmptyConverter}">
                                                            <Binding Path="Sat"/>
                                                            <Binding Path="Company"/>
                                                            <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </TextBox.Foreground>
                                                </TextBox>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ✅ Dimanche : ajouté avec Samedi, DOIT rester avant "Jour 6"
                                     (lundi suivant). Visibilité pilotée indépendamment via la
                                     case à cocher "Dimanche" du bouton "Structurer la semaine ▾"
                                     (WeekStructurePopup) — masqué par défaut à chaque nouvelle
                                     semaine, comme Samedi. -->
                                <DataGridTemplateColumn x:Name="SundayColumn" Header="Dimanche" Width="*" Visibility="Collapsed">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="0">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource CellCompanyColorIfNotEmptyConverter}">
                                                        <Binding Path="Sun"/>
                                                        <Binding Path="Company"/>
                                                        <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Border.Background>

                                                <TextBox Text="{Binding Sun, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												         FontWeight="SemiBold"
												         BorderThickness="0"
												         Background="Transparent"
												         Padding="6,0"
												         VerticalContentAlignment="Center">
                                                    <TextBox.Foreground>
                                                        <MultiBinding Converter="{StaticResource CellCompanyTextColorIfNotEmptyConverter}">
                                                            <Binding Path="Sun"/>
                                                            <Binding Path="Company"/>
                                                            <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </TextBox.Foreground>
                                                </TextBox>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- ✅ Masquée en mode "5 jours" (18.07.2026, demande de Joe) : voir
                                     WeekStructureButton/WeekStructurePopup et _weekDayCount. Les
                                     données déjà saisies (D6) restent en mémoire même masquée, comme
                                     Samedi/Dimanche. -->
                                <DataGridTemplateColumn x:Name="Day6Column" Header="Jour 6" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="0">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource CellCompanyColorIfNotEmptyConverter}">
                                                        <Binding Path="D6"/>
                                                        <Binding Path="Company"/>
                                                        <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Border.Background>

                                                <TextBox Text="{Binding D6, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												         FontWeight="SemiBold"
												         BorderThickness="0"
												         Background="Transparent"
												         Padding="6,0"
												         VerticalContentAlignment="Center">
                                                    <TextBox.Foreground>
                                                        <MultiBinding Converter="{StaticResource CellCompanyTextColorIfNotEmptyConverter}">
                                                            <Binding Path="D6"/>
                                                            <Binding Path="Company"/>
                                                            <Binding Path="DataContext.CompanyColorMap" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </TextBox.Foreground>
                                                </TextBox>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                        </Border>
                    </Grid>
                </Border>

                <!-- 3) Image -->
                <Border x:Name="PlanSectionBorder"
                        Grid.Row="2"
				        BorderBrush="#6B7280"
				        BorderThickness="1"
				        CornerRadius="18"
				        Padding="10"
		        Effect="{StaticResource CardShadowEffect}"
				        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="92"/>
                        </Grid.ColumnDefinitions>

                        <!-- ✅ 31.07.2026 (demande de Joe) : Grid (comme les autres sections) pour que
                             "Ajouter image" s'aligne verticalement avec "Ajouter" de Planning hebdo
                             (référence fixe, 178px), au lieu d'un DockPanel classique. -->
                        <Grid x:Name="PlanHeaderToolbar"
                              Grid.Row="0"
                              Grid.ColumnSpan="3"
                              Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="178"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="IMAGE"
							           FontSize="12.5"
							           FontWeight="Bold"
							           Foreground="Black"
							           VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="PlanAddButton"
                                        Content="Ajouter image"
								        Style="{StaticResource SmallBlueButtonStyle}"
								        Height="30"
								        Click="PlanAdd_Click"/>

                                <Button x:Name="PlanRemoveButton"
                                        Content="Retirer image"
								        Style="{StaticResource SmallBlackButtonStyle}"
								        Height="30"
								        Margin="8,0,0,0"
								        Click="PlanRemove_Click"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button x:Name="AddImageToFavoritesButton"
                                        Content="☆ Ajouter Image aux favoris"
								        Style="{StaticResource SmallBlueButtonStyle}"
								        Height="30"
								        Click="AddSelectedImageToFavorites_Click"/>

                                <Button x:Name="ImageFavoritesButton"
                                        Content="Favoris ▾"
								        Style="{StaticResource OutlineBlueButtonStyle}"
								        Height="30"
								        Margin="8,0,0,0"
								        Click="ImageFavoritesButton_Click"/>

                                <Button x:Name="ResetStickersButton"
                                        Content="Reset stickers"
								        Style="{StaticResource SmallBlackButtonStyle}"
								        Height="30"
								        Margin="8,0,0,0"
								        Click="ResetPlacedStickers_Click"/>
                            </StackPanel>
                        </Grid>

                        <Popup x:Name="ImageFavoritesPopup"
                               PlacementTarget="{Binding ElementName=ImageFavoritesButton}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Background="White"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Effect="{StaticResource CardShadowEffect}">
                                <StackPanel Width="360">
                                    <TextBlock Text="Images favorites" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                    <TextBlock Text="Clique une image pour l'ajouter au plan."
                                               FontSize="10" Foreground="#6B7280" Margin="0,0,0,6"/>
                                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ImageFavoritesItemsControl" ItemsSource="{Binding ImageFavorites}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="4" Width="84" Height="104">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="84"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <Border Grid.Row="0"
                                                                BorderBrush="#D1D5DB"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Background="#FAFAFA">
                                                            <Image Source="{Binding ImageSource}"
                                                                   Stretch="UniformToFill"
                                                                   Cursor="Hand"
                                                                   MouseLeftButtonUp="ImageFavoriteThumbnail_MouseLeftButtonUp"/>
                                                        </Border>

                                                        <!-- ✅ Nom du favori (28.07.2026, demande de Joe) : pour les distinguer
                                                             une fois réduits en vignette, sans dépendre du seul visuel. -->
                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding Name}"
                                                                   FontSize="10"
                                                                   Foreground="#374151"
                                                                   TextAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="Wrap"
                                                                   MaxHeight="28"
                                                                   Margin="0,2,0,0"/>

                                                        <StackPanel Grid.Row="0"
                                                                    Orientation="Horizontal"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top"
                                                                    Margin="0,-5,-5,0">
                                                            <Button Content="✎"
                                                                    Width="18" Height="18"
                                                                    Padding="0"
                                                                    FontSize="9"
                                                                    Margin="0,0,2,0"
                                                                    ToolTip="Renommer"
                                                                    Style="{StaticResource SmallBlackButtonStyle}"
                                                                    Click="ImageFavoriteRename_Click"/>
                                                            <Button Content="✕"
                                                                    Width="18" Height="18"
                                                                    Padding="0"
                                                                    FontSize="10"
                                                                    ToolTip="Retirer des favoris"
                                                                    Style="{StaticResource SmallBlackButtonStyle}"
                                                                    Click="ImageFavoriteRemove_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <Border Grid.Row="1" Grid.Column="0"
                                MinHeight="380"
                                ClipToBounds="True"
						        BorderBrush="#D1D5DB"
						        BorderThickness="1"
						        CornerRadius="8"
						        Background="#FAFAFA"
						        Padding="8">
                            <Grid>
                                <Canvas x:Name="PlanCanvas"
								        Background="Transparent"
								        AllowDrop="True"
								        PreviewMouseLeftButtonDown="PlanCanvas_PreviewMouseLeftButtonDown"
								        PreviewMouseMove="PlanCanvas_PreviewMouseMove"
								        PreviewMouseLeftButtonUp="PlanCanvas_PreviewMouseLeftButtonUp">
                                    <!-- (contenu inchangé) -->
                                    <ItemsControl ItemsSource="{Binding PlacedPlanImages}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- ✅ Redimensionnement proportionnel uniquement (18.08.2026, demande de
                                                     Joe : "je ne dois pas pouvoir la déformer, car elle doit garder les
                                                     proportions") : le coin de redimensionnement libre (Thumb) est retiré,
                                                     remplacé par Ctrl+molette (voir PlacedPlanImage_PreviewMouseWheel),
                                                     qui agrandit/réduit toujours largeur ET hauteur du même facteur. -->
                                                <Border Width="{Binding Width}"
												        Height="{Binding Height}"
												        Background="Transparent"
												        PreviewMouseLeftButtonDown="PlacedPlanImage_PreviewMouseLeftButtonDown"
												        PreviewMouseMove="PlacedPlanImage_PreviewMouseMove"
												        PreviewMouseLeftButtonUp="PlacedPlanImage_PreviewMouseLeftButtonUp"
												        PreviewMouseRightButtonDown="PlacedPlanImage_RightClick"
												        PreviewMouseWheel="PlacedPlanImage_PreviewMouseWheel"
												        ToolTip="Glisser : déplacer • Ctrl+molette : agrandir/réduire • Clic droit : supprimer">
                                                    <!-- ✅ Contour visuel de sélection (19.07.2026, demande de Joe) : gris fin par
                                                         défaut, bleu et plus épais quand IsSelected. -->
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="#2563EB"/>
                                                                    <Setter Property="BorderThickness" Value="3"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Image Source="{Binding ImageSource}" Stretch="Uniform"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding PlacedStickers}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- ✅ Rectangulaire (Width indépendant de Height/Size) pour accueillir un
                                                     numéro de tâche à 4 chiffres au lieu d'un badge rond à 2 chiffres. -->
                                                <Border Width="{Binding Width}"
												        Height="{Binding Size}"
												        CornerRadius="6"
												        Background="{Binding ColorBrush}"
												        BorderBrush="#D1D5DB"
												        BorderThickness="1"
												        PreviewMouseLeftButtonDown="PlacedSticker_PreviewMouseLeftButtonDown"
												        PreviewMouseMove="PlacedSticker_PreviewMouseMove"
												        PreviewMouseLeftButtonUp="PlacedSticker_PreviewMouseLeftButtonUp"
												        PreviewMouseRightButtonDown="PlacedSticker_RightClick"
												        ToolTip="Clic : drag • Double-clic : éditer • Clic droit : retirer le sticker">
                                                    <TextBox Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													         FontWeight="Bold"
													         FontSize="12"
													         Foreground="{Binding TextColorHex}"
                                                             Style="{StaticResource PlacedStickerTextBoxStyle}"
                                                             PreviewMouseLeftButtonDown="PlacedStickerTextBox_PreviewMouseLeftButtonDown"
                                                             PreviewKeyDown="PlacedStickerTextBox_PreviewKeyDown"
                                                             LostFocus="PlacedSticker_EndEditOnLostFocus"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Grid>
                        </Border>

                        <Border x:Name="StickerBankPanel"
                                Grid.Row="1"
                                Grid.Column="2"
						        BorderBrush="#D1D5DB"
						        BorderThickness="1"
						        CornerRadius="8"
						        Background="White"
						        Padding="6">
                            <!-- (contenu inchangé) -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
								           Text="Stickers"
								           FontWeight="SemiBold"
								           Foreground="#111827"
								           Margin="0,0,0,6"
								           HorizontalAlignment="Center"/>

                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Stickers}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" HorizontalAlignment="Center"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="2"
												        Height="26"
												        Width="42"
												        Background="{Binding ColorBrush}"
												        BorderBrush="#D1D5DB"
												        BorderThickness="1"
												        HorizontalAlignment="Center"
												        PreviewMouseRightButtonDown="Sticker_RightClick"
												        PreviewMouseLeftButtonDown="StickerBank_PreviewMouseLeftButtonDown"
												        PreviewMouseMove="StickerBank_PreviewMouseMove"
												        PreviewMouseLeftButtonUp="StickerBank_PreviewMouseLeftButtonUp">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
															        BorderBrush="{TemplateBinding BorderBrush}"
															        BorderThickness="{TemplateBinding BorderThickness}"
															        CornerRadius="6"
															        Width="{TemplateBinding Width}"
															        Height="{TemplateBinding Height}">
                                                                <ContentPresenter HorizontalAlignment="Center"
																                  VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>

                                                    <TextBox Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													         FontWeight="Bold"
													         FontSize="12"
													         Foreground="{Binding TextColorHex}"
													         Background="Transparent"
													         BorderThickness="0"
													         MaxLength="4"
													         Width="36"
													         HorizontalContentAlignment="Center"
													         VerticalContentAlignment="Center"
													         HorizontalAlignment="Center"
													         VerticalAlignment="Center"
                                                             PreviewMouseLeftButtonDown="StickerBankTextBox_PreviewMouseLeftButtonDown"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- 4) Zones de texte -->
                <Border x:Name="TextZonesSectionBorder"
                        Grid.Row="3"
				        BorderBrush="#6B7280"
				        BorderThickness="1"
				        CornerRadius="18"
				        Padding="10"
		        Effect="{StaticResource CardShadowEffect}"
				        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ✅ 31.07.2026 (demande de Joe) : Grid (comme les autres sections) pour que
                             "Ajouter zone de texte" s'aligne verticalement avec "Ajouter" de Planning
                             hebdo (référence fixe, 178px), au lieu d'un DockPanel classique. -->
                        <Grid x:Name="TextZoneHeaderToolbar"
                              Grid.Row="0"
                              Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="178"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="ZONES DE TEXTE"
							           FontSize="12.5"
							           FontWeight="Bold"
							           Foreground="Black"
							           VerticalAlignment="Center"/>

                            <!-- ✅ Sélectionner tout / Copier / Coller déplacés sur la ligne "Police"
                                 (19.07.2026, 2e demande de Joe) : voir TextZoneFontToolbar. -->

                            <!-- ✅ "Supprimer" déplacé à côté de "Insérer image" (30.07.2026,
                                 demande de Joe) : voir TextZoneFontToolbar, Grid.Column="13". -->

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <!-- ✅ 30.07.2026 (demande de Joe) : "Ajouter"/"Retirer" déplacés à
                                     gauche, juste après le titre de section. -->
                                <Button Content="Ajouter zone de texte"
								        Style="{StaticResource SmallBlueButtonStyle}"
								        Height="30"
								        Click="TextZoneAdd_Click"/>

                                <Button Content="Retirer zone de texte"
								        Style="{StaticResource SmallBlackButtonStyle}"
								        Height="30"
								        Margin="8,0,0,0"
								        Click="TextZoneRemove_Click"/>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="TextZoneFontToolbar"
                                Grid.Row="1"
						        Background="White"
						        BorderBrush="#D1D5DB"
						        BorderThickness="1"
						        CornerRadius="10"
						        Padding="8"
						        Margin="0,0,0,10">
                            <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Police :" Foreground="#111827" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="FontFamilyCombo" Width="150" Height="26" Margin="8,0,16,0"
								          SelectionChanged="FontFamilyCombo_SelectionChanged"/>

                                <TextBlock Grid.Column="2" Text="Taille :" Foreground="#111827" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="3" x:Name="FontSizeCombo" Width="64" Height="26" Margin="8,0,16,0"
								          SelectionChanged="FontSizeCombo_SelectionChanged"/>

                                <ToggleButton Grid.Column="4" x:Name="BoldToggle" Width="40" Height="30" Margin="0,0,8,0"
								              Style="{StaticResource TextZoneToolToggleStyle}"
								              Background="White" Foreground="#111827"
								              Click="BoldToggle_Click"
								              ToolTip="Gras (police)">
                                    <TextBlock Text="G" FontSize="17" FontWeight="Bold"
									           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ToggleButton>

                                <ToggleButton Grid.Column="5" x:Name="ItalicToggle" Width="40" Height="30" Margin="0,0,8,0"
								              Style="{StaticResource TextZoneToolToggleStyle}"
								              Background="White" Foreground="#111827"
								              Click="ItalicToggle_Click"
								              ToolTip="Italique (police)">
                                    <TextBlock Text="I" FontSize="14" FontStyle="Italic" FontWeight="Normal"
									           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ToggleButton>

                                <ToggleButton Grid.Column="6" x:Name="UnderlineToggle" Width="40" Height="30" Margin="0,0,16,0"
								              Style="{StaticResource TextZoneToolToggleStyle}"
								              Background="White" Foreground="#111827"
								              Click="UnderlineToggle_Click"
								              ToolTip="Souligné (police)">
                                    <TextBlock Text="S" FontSize="14" FontWeight="Normal" TextDecorations="Underline"
									           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ToggleButton>

                                <Button Grid.Column="7" x:Name="FontColorButton" Width="56" Height="30" Margin="0,0,8,0"
								        Style="{StaticResource TextZoneToolButtonStyle}"
								        HorizontalAlignment="Left"
								        Background="White"
								        Click="FontColorButton_Click"
								        ToolTip="Couleur du texte (police)">
                                    <StackPanel>
                                        <Border BorderThickness="2"
										        CornerRadius="4"
										        Padding="0"
										        HorizontalAlignment="Center"
										        BorderBrush="{Binding ElementName=FontColorSwatch, Path=Background}">
                                            <TextBlock Text="A"
											           Foreground="#111827"
											           FontSize="16"
											           FontWeight="SemiBold"
											           HorizontalAlignment="Center"
											           VerticalAlignment="Center"
											           Margin="2,-1,2,0"/>
                                        </Border>
                                        <TextBlock Text="Texte" Foreground="#6B7280" FontSize="9" HorizontalAlignment="Center" Margin="0,-1,0,0"/>
                                        <Border x:Name="FontColorSwatch" Height="3" Background="#EF4444" CornerRadius="2" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="8" x:Name="FillColorButton" Width="56" Height="30"
								        Style="{StaticResource TextZoneToolButtonStyle}"
								        HorizontalAlignment="Left"
								        Background="White"
								        Click="FillColorButton_Click"
								        ToolTip="Couleur de remplissage (fond)">
                                    <StackPanel>
                                        <Border BorderThickness="2"
										        CornerRadius="4"
										        Padding="0"
										        HorizontalAlignment="Center"
										        BorderBrush="{Binding ElementName=FillColorSwatch, Path=Background}">
                                            <TextBlock Text="▧"
											           Foreground="#111827"
											           FontSize="14"
											           FontWeight="Normal"
											           HorizontalAlignment="Center"
											           VerticalAlignment="Center"
											           Margin="4,-1,4,0"/>
                                        </Border>
                                        <TextBlock Text="Rempl." Foreground="#6B7280" FontSize="9" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                                        <Border x:Name="FillColorSwatch" Height="3" Background="#FDE047" CornerRadius="2" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- ✅ Sélectionner tout / Copier / Coller, déplacés sur la ligne
                                     "Police" (19.07.2026, 2e demande de Joe), même look que les autres
                                     boutons de cette barre (fond blanc, bordure grise, hauteur 28). -->
                                <Button Grid.Column="9" Content="Sélectionner tout" Height="30"
								        Style="{StaticResource TextZoneToolButtonStyle}"
								        HorizontalAlignment="Left"
								        Margin="16,0,8,0" Padding="10,0"
								        Background="White" Foreground="#111827"
								        Click="TextZoneSelectAll_Click"
								        ToolTip="Sélectionner tout le texte de la zone active"/>

                                <Button Grid.Column="10" Content="Copier" Height="30"
								        Style="{StaticResource TextZoneToolButtonStyle}"
								        HorizontalAlignment="Left"
								        Margin="0,0,8,0" Padding="10,0"
								        Background="White" Foreground="#111827"
								        Click="TextZoneCopy_Click"
								        ToolTip="Copier le texte sélectionné"/>

                                <Button Grid.Column="11" Content="Coller" Height="30"
								        Style="{StaticResource TextZoneToolButtonStyle}"
								        HorizontalAlignment="Left"
								        Padding="10,0"
								        Background="White" Foreground="#111827"
								        Click="TextZonePaste_Click"
								        ToolTip="Coller dans la zone active"/>

                                <Button Grid.Column="12" Content="🖼 Insérer image" Height="30"
								        Style="{StaticResource TextZoneToolButtonStyle}"
								        HorizontalAlignment="Left"
								        Margin="16,0,0,0" Padding="10,0"
								        Background="White" Foreground="#111827"
								        Click="InsertImageIntoActiveTextZone_Click"
								        ToolTip="Insérer une image (PNG, JPG...) dans la zone active. Ctrl + molette sur l'image pour la redimensionner."/>

                                <!-- ✅ 30.07.2026 (demande de Joe) : "Supprimer" (vide juste le texte
                                     de la zone active, sans la masquer) déplacé à côté de "Insérer
                                     image", police et bordure rouges (au lieu de noir plein). -->
                                <Button Grid.Column="13" Content="Supprimer" Height="30"
								        Style="{StaticResource TextZoneToolButtonStyle}"
								        HorizontalAlignment="Left"
								        Margin="16,0,0,0" Padding="10,0"
								        Background="White" Foreground="#DC2626" BorderBrush="#DC2626"
								        Click="TextZoneClear_Click"/>

                            </Grid>

                            <Border x:Name="ResizeImageHintBorder"
                                    Background="#FEF3C7"
                                    BorderBrush="#FCD34D"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,4"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed">
                                <TextBlock FontSize="11" TextWrapping="Wrap">
                                    <Run Text="💡" FontFamily="Segoe UI Emoji"/>
                                    <Run Text=" Ctrl + molette sur l'image pour la redimensionner" Foreground="#92400E"/>
                                </TextBlock>
                            </Border>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="TextZonesLeftCol" Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition x:Name="TextZonesRightCol" Width="*"/>
                            </Grid.ColumnDefinitions>

                            <GridSplitter Grid.Column="1"
							              Width="6"
							              HorizontalAlignment="Stretch"
							              VerticalAlignment="Stretch"
							              Background="#E5E7EB"
							              ResizeBehavior="PreviousAndNext"
							              ResizeDirection="Columns"
							              ShowsPreview="True"/>

                            <StackPanel Grid.Column="0">
                                <Border CornerRadius="8" Padding="0" Margin="0,0,0,10"
								        Visibility="{Binding TextZones[0].Visible, Converter={StaticResource BoolToVis}}"
								        PreviewMouseDown="TextZone_Focus0">
                                    <Grid DataContext="{Binding TextZones[0]}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ComboBox Grid.Row="0" Height="26"
										          Style="{StaticResource RoundedComboBoxStyle}"
										          ItemsSource="{Binding DataContext.PlanningTextZonesWithBlank, RelativeSource={RelativeSource AncestorType=UserControl}}"
										          SelectedItem="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										          IsEditable="False"
										          Margin="0,0,0,8"
										          GotFocus="TextZone_Focus0"/>

                                        <RichTextBox x:Name="Rtb0" Grid.Row="1"
										            Style="{StaticResource TextZoneRichTextBoxStyle}"
										            GotFocus="Rtb_GotFocus"
										            TextChanged="Rtb_TextChanged"
										            PreviewMouseWheel="Rtb_PreviewMouseWheel"/>
                                    </Grid>
                                </Border>

                                <Border CornerRadius="8" Padding="0"
								        Visibility="{Binding TextZones[3].Visible, Converter={StaticResource BoolToVis}}"
								        PreviewMouseDown="TextZone_Focus3">
                                    <Grid DataContext="{Binding TextZones[3]}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ComboBox Grid.Row="0" Height="26"
										          Style="{StaticResource RoundedComboBoxStyle}"
										          ItemsSource="{Binding DataContext.PlanningTextZonesWithBlank, RelativeSource={RelativeSource AncestorType=UserControl}}"
										          SelectedItem="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										          IsEditable="False"
										          Margin="0,0,0,8"
										          GotFocus="TextZone_Focus3"/>

                                        <RichTextBox x:Name="Rtb3" Grid.Row="1"
										            Style="{StaticResource TextZoneRichTextBoxStyle}"
										            GotFocus="Rtb_GotFocus"
										            TextChanged="Rtb_TextChanged"
										            PreviewMouseWheel="Rtb_PreviewMouseWheel"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border CornerRadius="8" Padding="0" Margin="0,0,0,10"
								        Visibility="{Binding TextZones[1].Visible, Converter={StaticResource BoolToVis}}"
								        PreviewMouseDown="TextZone_Focus1">
                                    <Grid DataContext="{Binding TextZones[1]}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ComboBox Grid.Row="0" Height="26"
										          Style="{StaticResource RoundedComboBoxStyle}"
										          ItemsSource="{Binding DataContext.PlanningTextZonesWithBlank, RelativeSource={RelativeSource AncestorType=UserControl}}"
										          SelectedItem="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										          IsEditable="False"
										          Margin="0,0,0,8"
										          GotFocus="TextZone_Focus1"/>

                                        <RichTextBox x:Name="Rtb1" Grid.Row="1"
										            Style="{StaticResource TextZoneRichTextBoxStyle}"
										            GotFocus="Rtb_GotFocus"
										            TextChanged="Rtb_TextChanged"
										            PreviewMouseWheel="Rtb_PreviewMouseWheel"/>
                                    </Grid>
                                </Border>

                                <Border CornerRadius="8" Padding="0"
								        Visibility="{Binding TextZones[2].Visible, Converter={StaticResource BoolToVis}}"
								        PreviewMouseDown="TextZone_Focus2">
                                    <Grid DataContext="{Binding TextZones[2]}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ComboBox Grid.Row="0" Height="26"
										          Style="{StaticResource RoundedComboBoxStyle}"
										          ItemsSource="{Binding DataContext.PlanningTextZonesWithBlank, RelativeSource={RelativeSource AncestorType=UserControl}}"
										          SelectedItem="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										          IsEditable="False"
										          Margin="0,0,0,8"
										          GotFocus="TextZone_Focus2"/>

                                        <RichTextBox x:Name="Rtb2" Grid.Row="1"
										            Style="{StaticResource TextZoneRichTextBoxStyle}"
										            GotFocus="Rtb_GotFocus"
										            TextChanged="Rtb_TextChanged"
										            PreviewMouseWheel="Rtb_PreviewMouseWheel"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

            </Grid>
        </ScrollViewer>

    </Grid>
</UserControl>
