<!-- File: DashboardPage.xaml -->
<UserControl x:Class="Iziregi.Test.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820"
             d:DesignWidth="1280"
             Background="#F6F7FB">

    <UserControl.Resources>

        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ OK en surbrillance quand dirty -->
        <Style x:Key="OkHighlightButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="BorderBrush" Value="#F59E0B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ✅ Primary : hover bleu foncé + texte blanc (contraste net) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1E40AF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1D4ED8"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#93C5FD"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#93C5FD"/>
                                <Setter Property="Foreground" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
        </Style>

        <Style x:Key="ArchiveSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
            <Setter Property="Foreground" Value="#15803D"/>
            <Setter Property="BorderBrush" Value="#15803D"/>
        </Style>

        <!-- ✅ Bouton "Banque de projets" : avant, il réutilisait ButtonWithChevronStyle
             (un "▾" affiché à droite, comme pour un menu déroulant), ce qui n'a pas de sens
             ici puisque le clic ouvre directement une fenêtre (ProjectsWindow), pas un menu.
             Ce chevron prenait de la place et écrasait le texte "Banque de projets" contre
             le bord du bouton. Nouveau style dédié : pas de chevron, icône + texte centrés,
             texte qui peut passer sur 2 lignes proprement (TextWrapping) au lieu de déborder. -->
        <Style x:Key="ProjectBankButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Texte centré -->
        <Style x:Key="GridTextCellStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>

        <!-- CheckBox centrée -->
        <Style x:Key="GridCheckBoxCellStyle" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- ✅ IMPORTANT : pas de remplissage bleu dans les cellules à la sélection. Nommé
             (x:Key) pour pouvoir être réutilisé via BasedOn par des CellStyle spécifiques à
             une colonne (ex. colonne Sélection) SANS perdre cette règle (28.07.2026 : bug
             réapparu car un CellStyle par colonne, sans BasedOn, remplace entièrement celui-
             ci plutôt que de s'y ajouter). -->
        <Style x:Key="GridCellBaseStyle" TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#111827"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Foreground" Value="#111827"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ✅ En-têtes gras/noir/bordure (même raison que GridCellBaseStyle ci-dessus : nommé
             pour être réutilisable via BasedOn sans perdre ce style au passage). -->
        <Style x:Key="GridColumnHeaderBaseStyle" TargetType="DataGridColumnHeader">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- DataGrid -->
        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>

            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>

            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="44"/>

            <!-- ✅ Bordure extérieure du tableau : NOIR -->
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>

            <Setter Property="Background" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB"/>

            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>

            <Setter Property="FontSize" Value="12"/>
            <Setter Property="IsReadOnly" Value="False"/>

            <!-- ✅ Sélection : pas de remplissage, seulement bordure bleue épaisse -->
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="SnapsToDevicePixels" Value="True"/>

                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="BorderThickness" Value="0,2,0,2"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="BorderThickness" Value="0,2,0,2"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>

            <!-- ✅ IMPORTANT : pas de remplissage bleu dans les cellules -->
            <Setter Property="CellStyle" Value="{StaticResource GridCellBaseStyle}"/>

            <!-- ✅ En-têtes : gras + noir + bordure NOIRE -->
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridColumnHeaderBaseStyle}"/>
        </Style>

        <!-- Texte statut (base) -->
        <Style x:Key="StatusCellTextBaseStyle" TargetType="TextBlock" BasedOn="{StaticResource GridTextCellStyle}">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <!-- Zone Statut : pas de séparations verticales -->
        <Style x:Key="StatusHeaderNoVerticalSeparators" TargetType="DataGridColumnHeader">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <!-- ✅ FIX : cellules statut ne deviennent pas bleues à la sélection -->
        <Style x:Key="StatusCellNoVerticalSeparators" TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dernière colonne Statut : séparation à droite (avant Distribué le) -->
        <Style x:Key="StatusHeaderWithRightSeparator"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource StatusHeaderNoVerticalSeparators}">
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- ✅ FIX : idem pour la dernière cellule statut -->
        <Style x:Key="StatusCellWithRightSeparator"
               TargetType="DataGridCell"
               BasedOn="{StaticResource StatusCellNoVerticalSeparators}">
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Header "Statut" : gras + noir -->
        <Style x:Key="StatusHeaderTopText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- DatePicker compact -->
        <Style x:Key="GridDatePickerStyle" TargetType="DatePicker">
            <Setter Property="SelectedDateFormat" Value="Short"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="117"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Fond vert si date renseignée -->
        <Style x:Key="DateCellBorderStyle_Distributed" TargetType="Border">
            <Setter Property="Background" Value="#C7F9C7"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DistributedAt}" Value="{x:Null}">
                    <Setter Property="Background" Value="Transparent"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DateCellBorderStyle_Performed" TargetType="Border">
            <Setter Property="Background" Value="#C7F9C7"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PerformedAt}" Value="{x:Null}">
                    <Setter Property="Background" Value="Transparent"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- DatePickerTextBox : supprime le watermark -->
        <Style x:Key="NoWatermarkDatePickerTextBoxStyle" TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <TextBox Background="Transparent"
                                     BorderThickness="0"
                                     IsReadOnly="True"
                                     Foreground="#111827"
                                     TextAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding Path=SelectedDate,
                                                    RelativeSource={RelativeSource AncestorType={x:Type DatePicker}},
                                                    StringFormat=dd.MM.yyyy,
                                                    TargetNullValue=''}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fond gris si texte vide -->
        <Style x:Key="EmptyTextCellStyle" TargetType="TextBlock" BasedOn="{StaticResource GridTextCellStyle}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ✅ Filtres façon Excel sur les en-têtes de colonnes, portés depuis Archives (24.07.2026,
             demande de Joe) : remplace les anciennes puces "Tous/En cours/Lien expiré/Validé/
             Refusé/Annulé" + case de recherche. -->
        <Style x:Key="FilterHeaderButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterHeaderButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource FilterHeaderButtonStyle}">
            <Setter Property="Foreground" Value="#1D4ED8"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="FilterHeaderHighlightBorderStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ✅ Titre de page (28.07.2026, demande de Joe : même police que les autres pages,
             ex. "Comptabilité"). -->
        <TextBlock Grid.Row="0"
                   Text="Tableau de bord"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#111827"
                   Margin="4,-3,0,-2"/>

        <!-- ✅ Popup de filtre façon Excel, porté depuis Archives (24.07.2026, demande de Joe). -->
        <Popup x:Name="ColumnFilterPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
            <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="8" MinWidth="220" MaxHeight="380" Effect="{StaticResource CardShadowEffect}">
                <StackPanel>

                    <StackPanel x:Name="TextFilterPanel">
                        <CheckBox x:Name="AlphaSortCheckBox"
                                  Content="Trier par ordre alphabétique (A→Z)"
                                  Margin="0,0,0,8"/>

                        <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Margin="0,0,0,6"/>

                        <CheckBox x:Name="FilterSelectAllCheckBox"
                                  Content="(Tout sélectionner)"
                                  IsChecked="True"
                                  FontWeight="Bold"
                                  Click="FilterSelectAllCheckBox_Click"
                                  Margin="0,0,0,6"/>

                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="FilterOptionsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayText}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel x:Name="DateFilterPanel" Visibility="Collapsed">
                        <!-- ✅ Compteurs (28.07.2026, demande de Joe) : équivalent pour les colonnes
                             date des comptages par valeur des autres colonnes (une date étant
                             quasi toujours unique, on compte "renseigné" vs "non renseigné", avec
                             un libellé propre à chaque colonne). -->
                        <TextBlock x:Name="DateFilterCountsTextBlock"
                                   Foreground="#374151"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <CheckBox x:Name="DateAscCheckBox" Content="Trier par ordre croissant" Click="DateAscCheckBox_Click" Margin="0,0,0,4"/>
                        <CheckBox x:Name="DateDescCheckBox" Content="Trier par ordre décroissant" Click="DateDescCheckBox_Click" Margin="0,0,0,8"/>

                        <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Margin="0,0,0,8"/>

                        <TextBlock Text="Du" Foreground="#6B7280" Margin="0,0,0,2"/>
                        <DatePicker x:Name="DateFromPicker" Width="190" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                        <TextBlock Text="Au" Foreground="#6B7280" Margin="0,0,0,2"/>
                        <DatePicker x:Name="DateToPicker" Width="190" HorizontalAlignment="Left"/>

                        <Button Content="Réinitialiser les dates sélectionnées"
                                Style="{StaticResource SmallButtonStyle}"
                                Click="ResetDateRangeButton_Click"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Annuler" Style="{StaticResource SmallButtonStyle}" Click="ColumnFilterCancel_Click" Margin="0,0,6,0"/>
                        <Button Content="OK" Style="{StaticResource SmallButtonStyle}" Click="ColumnFilterApply_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- BARRE COMPACTE -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8"
                Margin="0,0,0,8"
                Effect="{StaticResource CardShadowEffect}">

            <!-- ✅ Bannière "dirty" en haut -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="DirtyBanner"
                        Grid.Row="0"
                        Background="#FEF3C7"
                        BorderBrush="#F59E0B"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,6"
                        Margin="0,0,0,8"
                        Visibility="Collapsed">
                    <TextBlock x:Name="DirtyBannerText"
                               Text="Modifications non enregistrées — clique sur OK."
                               Foreground="#92400E"
                               FontWeight="SemiBold"
                               FontSize="12"/>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="122"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ligne 1 : Bons actifs + actions ... Nom, Adresse -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <TextBlock Text="Bons actifs"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   HorizontalAlignment="Left"
                                   Margin="0,0,0,6"/>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="NewWorkOrderTopButton"
                                    Content="+ Nouveau bon"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="NewWorkOrder_Click"
                                    VerticalContentAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    Padding="10,0"
                                    Margin="0,0,6,0"/>

                            <Button x:Name="ArchiveSelectionButton"
                                    Content="Archiver sélection"
                                    Style="{StaticResource ArchiveSmallButtonStyle}"
                                    Click="ArchiveSelection_Click"
                                    IsEnabled="False"
                                    Margin="0,0,6,0"/>

                            <Button x:Name="TrashSelectionButton"
                                    Content="Déplacer dans la corbeille"
                                    Style="{StaticResource DangerSmallButtonStyle}"
                                    Click="TrashSelection_Click"
                                    IsEnabled="False"
                                    Margin="0,0,6,0"/>

                            <Button x:Name="RefreshTopButton"
                                    Content="Rafraîchir"
                                    Style="{StaticResource SmallButtonStyle}"
                                    Click="Refresh_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Ligne de séparation verticale entre "Bons actifs" et les compteurs -->
                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                            Width="1"
                            Background="Black"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Margin="0,2,0,2"/>

                    <!-- ✅ Compteurs (28.07.2026, demande de Joe) : colonne dédiée entre "Bons
                         actifs" et "Banque de dossiers". Les 3 badges sont alignés (même
                         largeur), le symbole "compteur" (jauge + aiguille, dessiné en
                         vectoriel plutôt qu'un emoji ambigu selon les polices) est donc placé à
                         gauche de la pile plutôt que dans le premier badge. Bons actifs/
                         archivés + tâches en cours de la page Planning (une tâche "en cours" =
                         au moins une info écrite dans une de ses colonnes, voir
                         CountInProgressPlanningTasks). -->
                    <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Top"
                                Margin="16,0,16,0">
                        <Grid Width="16" Height="16" Margin="0,7,8,0" VerticalAlignment="Top">
                            <Ellipse Stroke="#111827" StrokeThickness="1.4" Fill="White"/>
                            <Line X1="8" Y1="8" X2="11.5" Y2="4.5" Stroke="#111827" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse Width="3" Height="3" Fill="#111827"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Orientation="Vertical">
                            <Border Width="230" Background="#F3F4F6" CornerRadius="6" Padding="8,4" Margin="0,0,0,6">
                                <TextBlock FontSize="14" Foreground="#111827">
                                    <Run Text="Bons actifs : "/>
                                    <Run x:Name="ActiveWorkOrdersCountRun" Text="0" FontWeight="SemiBold"/>
                                </TextBlock>
                            </Border>
                            <Border Width="230" Background="#F3F4F6" CornerRadius="6" Padding="8,4" Margin="0,0,0,6">
                                <TextBlock FontSize="14" Foreground="#111827">
                                    <Run Text="Bons archivés : "/>
                                    <Run x:Name="ArchivedWorkOrdersCountRun" Text="0" FontWeight="SemiBold"/>
                                </TextBlock>
                            </Border>
                            <Border Width="230" Background="#DBEAFE" CornerRadius="6" Padding="8,4">
                                <TextBlock FontSize="14" Foreground="#111827">
                                    <Run Text="Tâches planning en cours : "/>
                                    <Run x:Name="TasksInProgressCountRun" Text="0" FontWeight="SemiBold"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- ✅ Dossier, sur une seule colonne, disposé comme dans les bons/PDF -->
                    <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" VerticalAlignment="Top">
                        <TextBlock x:Name="ProjectNameEditTextBox"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="ProjectAddressEditTextBox"
                                   FontSize="12"
                                   Foreground="#4B5563"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>

                        <TextBlock x:Name="ProjectZipCityEditTextBox"
                                   FontSize="12"
                                   Foreground="#4B5563"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="ProjectManagerLineTextBox"
                                   FontSize="12"
                                   Foreground="#4B5563"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>
                    </StackPanel>

                    <!-- Ligne de séparation verticale entre les compteurs et infos dossier -->
                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="3"
                            Width="1"
                            Background="Black"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Margin="0,2,0,2"/>

                    <!-- ✅ Ligne 2 : recherche (24.07.2026, demande de Joe : garder le champ de
                         recherche, à gauche de "Résumé demande") + Résumé demande. -->
                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,-15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Top">
                            <TextBlock Text="Recherche"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#6B7280"
                                       Margin="0,0,0,2"/>

                            <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6"
                                    Padding="8,0" Background="White" Height="26"
                                    HorizontalAlignment="Stretch">
                                <!-- ✅ Grid (pas StackPanel) : un StackPanel Horizontal ne force jamais ses
                                     enfants à s'étirer, même avec HorizontalAlignment="Stretch" — le TextBox
                                     se retrouvait avec une largeur quasi nulle et devenait impossible à cliquer. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Path Grid.Column="0"
                                          Data="{StaticResource IconSearchGeometry}"
                                          Width="11" Height="11" Stretch="Uniform"
                                          Fill="Transparent" StrokeThickness="1.6" StrokeLineJoin="Round"
                                          Stroke="#9CA3AF"
                                          VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="WorkOrderSearchBox"
                                             Grid.Column="1"
                                             BorderThickness="0"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Stretch"
                                             FontSize="12"
                                             Foreground="#374151"
                                             Background="Transparent"
                                             TextChanged="WorkOrderSearchBox_TextChanged"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Stretch">

                            <TextBlock Text="Résumé demande"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#6B7280"
                                       Margin="0,0,0,2"/>

                            <Border x:Name="SelectedWorkOrderDescriptionPreviewBorder"
                                    HorizontalAlignment="Stretch"
                                    BorderBrush="#2563EB"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Background="#F9FAFB"
                                    Padding="10,4">
                                <TextBlock x:Name="SelectedWorkOrderDescriptionPreviewTextBlock"
                                           Text=""
                                           Foreground="#374151"
                                           FontSize="12"
                                           TextAlignment="Left"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ✅ Choix du projet autorisé (hidden, remplacé par bandeau coloré) -->
                    <ComboBox x:Name="ProjectComboBox"
                          Grid.Row="0"
                          Grid.Column="0"
                          Height="26"
                          Width="110"
                          FontSize="12"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectionChanged="ProjectComboBox_SelectionChanged"
                          Visibility="Collapsed"/>

                    <!-- ✅ Accès Banque de projets : en haut à droite -->
                    <Button x:Name="ManageProjectsButton"
                        Grid.Row="0"
                        Grid.Column="6"
                        Width="122"
                        Height="48"
                        Style="{StaticResource ProjectBankButtonStyle}"
                        Click="ManageProjects_Click"
                        VerticalAlignment="Top"
                        ToolTip="Ouvrir la banque de dossiers">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <TextBlock Text="🗂"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="Banque de dossiers"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- TABLEAU DE BORD -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10"
                Effect="{StaticResource CardShadowEffect}">

            <Grid>
                <!-- ✅ Grille principale -->
                <DataGrid x:Name="WorkOrdersGrid"
                          Style="{StaticResource GridStyle}"
                          ColumnWidth="SizeToCells"
                          MouseDoubleClick="WorkOrdersGrid_MouseDoubleClick"
                          SelectionChanged="WorkOrdersGrid_SelectionChanged">

                    <DataGrid.Columns>

                        <!-- Sélection -->
                        <DataGridTemplateColumn Width="24" IsReadOnly="True" CanUserSort="False">
                            <!-- ✅ Centre explicitement le contenu de la cellule (28.07.2026, demande de
                                 Joe) : sans ça, DataGridCell garde son alignement par défaut et la case
                                 à cocher reste collée à gauche même si elle a elle-même Center. -->
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource GridCellBaseStyle}">
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <!-- ✅ Centre aussi la case "tout sélectionner" de l'en-tête (28.07.2026,
                                 demande de Joe) : le CellStyle ci-dessus ne s'applique qu'aux cellules
                                 de données, pas à l'en-tête de colonne. -->
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridColumnHeaderBaseStyle}">
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="SelectAllWorkOrdersCheckBox"
                                              Style="{StaticResource GridCheckBoxCellStyle}"
                                              Click="SelectAllWorkOrdersCheckBox_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource GridCheckBoxCellStyle}"
                                              IsChecked="{Binding IsBatchSelected}"
                                              Click="BatchSelectCheckBox_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- N° -->
                        <DataGridTextColumn Header="N°"
                                            Binding="{Binding BdrDisplay}"
                                            Width="70"
                                            ElementStyle="{StaticResource GridTextCellStyle}"
                                            IsReadOnly="True"/>

                        <!-- Concerne -->
                        <DataGridTextColumn Width="SizeToCells"
                                            MinWidth="110"
                                            Binding="{Binding Reserve}"
                                            ElementStyle="{StaticResource EmptyTextCellStyle}"
                                            IsReadOnly="True"
                                            CanUserSort="False">
                            <DataGridTextColumn.Header>
                                <Border x:Name="ConcerneHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock x:Name="ReserveHeaderTextBlock" Text="Concerne" HorizontalAlignment="Center"/>
                                        <Button x:Name="ConcerneFilterButton" Content="▾" Tag="Concerne"
                                                Style="{StaticResource FilterHeaderButtonStyle}"
                                                Click="ColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <!-- Demandé par -->
                        <DataGridTextColumn Width="SizeToCells"
                                            MinWidth="94"
                                            Binding="{Binding RequestedBy}"
                                            ElementStyle="{StaticResource GridTextCellStyle}"
                                            IsReadOnly="True"
                                            CanUserSort="False">
                            <DataGridTextColumn.Header>
                                <Border x:Name="RequestedByHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock x:Name="RequestedByHeaderTextBlock" Text="Demandé par" HorizontalAlignment="Center"/>
                                        <Button x:Name="RequestedByFilterButton" Content="▾" Tag="RequestedBy"
                                                Style="{StaticResource FilterHeaderButtonStyle}"
                                                Click="ColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <!-- Entreprise -->
                        <DataGridTextColumn Width="SizeToCells"
                                            MinWidth="98"
                                            Binding="{Binding PerformedBy}"
                                            ElementStyle="{StaticResource GridTextCellStyle}"
                                            IsReadOnly="True"
                                            CanUserSort="False">
                            <DataGridTextColumn.Header>
                                <Border x:Name="CompanyHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock x:Name="PerformedByHeaderTextBlock" Text="Entreprise" HorizontalAlignment="Center"/>
                                        <Button x:Name="CompanyFilterButton" Content="▾" Tag="Company"
                                                Style="{StaticResource FilterHeaderButtonStyle}"
                                                Click="ColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <!-- Date -->
                        <DataGridTextColumn Binding="{Binding RequestDate, StringFormat=dd.MM.yyyy}"
                                            Width="SizeToCells"
                                            MinWidth="70"
                                            ElementStyle="{StaticResource GridTextCellStyle}"
                                            IsReadOnly="True"
                                            CanUserSort="False">
                            <DataGridTextColumn.Header>
                                <Border x:Name="CreatedDateHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock Text="Créé le" HorizontalAlignment="Center"/>
                                        <Button x:Name="CreatedDateFilterButton" Content="▾" Tag="CreatedDate"
                                                Style="{StaticResource FilterHeaderButtonStyle}"
                                                Click="ColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <!-- ========================= -->
                        <!-- STATUT (5 colonnes) -->
                        <!-- ========================= -->

                        <!-- 1) Créé -->
                        <DataGridTemplateColumn Width="SizeToCells"
                                                HeaderStyle="{StaticResource StatusHeaderNoVerticalSeparators}"
                                                CellStyle="{StaticResource StatusCellNoVerticalSeparators}"
                                                IsReadOnly="True">
                            <DataGridTemplateColumn.Header>
                                <Grid/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInCreation}" Value="True">
                                                        <Setter Property="Background" Value="#C7F9C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSentToCompany}" Value="True">
                                                        <Setter Property="Background" Value="#C7F9C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsQuoteReceived}" Value="True">
                                                        <Setter Property="Background" Value="#C7F9C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSentToSigner}" Value="True">
                                                        <Setter Property="Background" Value="#C7F9C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsValidated}" Value="True">
                                                        <Setter Property="Background" Value="#C7F9C7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusCellTextBaseStyle}">
                                                    <Setter Property="Text" Value="Créé"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInCreation}" Value="True">
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSentToCompany}" Value="True">
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsQuoteReceived}" Value="True">
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSentToSigner}" Value="True">
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsValidated}" Value="True">
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 2) Demande devis envoyée -->
                        <DataGridTemplateColumn Width="SizeToCells"
                                                HeaderStyle="{StaticResource StatusHeaderNoVerticalSeparators}"
                                                CellStyle="{StaticResource StatusCellNoVerticalSeparators}"
                                                IsReadOnly="True">
                            <DataGridTemplateColumn.Header>
                                <Grid/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSentToCompany}" Value="True">
                                                        <Setter Property="Background" Value="#C7F9C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsQuoteReceived}" Value="True">
                                                        <Setter Property="Background" Value="#C7F9C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSentToSigner}" Value="True">
                                                        <Setter Property="Background" Value="#C7F9C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsValidated}" Value="True">
                                                        <Setter Property="Background" Value="#C7F9C7"/>
                                                    </DataTrigger>
                                                    <!-- Lien expire bientôt : jaune -->
                                                    <DataTrigger Binding="{Binding IsCompanyLinkExpiringSoon}" Value="True">
                                                        <Setter Property="Background" Value="#FEF9C3"/>
                                                        <Setter Property="ToolTip" Value="Lien entreprise expire bientôt — Relancer si nécessaire"/>
                                                    </DataTrigger>
                                                    <!-- ⚠ Lien entreprise expiré : orange (prioritaire car placé après jaune) -->
                                                    <DataTrigger Binding="{Binding IsCompanyLinkExpired}" Value="True">
                                                        <Setter Property="Background" Value="#FED7AA"/>
                                                        <Setter Property="ToolTip" Value="Lien entreprise expiré (> 9 jours) — Regénérer dans la fiche"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusCellTextBaseStyle}">
                                                    <Setter Property="Text" Value="Demande devis envoyée"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSentToCompany}" Value="True">
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsQuoteReceived}" Value="True">
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSentToSigner}" Value="True">
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsValidated}" Value="True">
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </DataTrigger>
                                                        <!-- J-X si expire bientôt -->
                                                        <DataTrigger Binding="{Binding IsCompanyLinkExpiringSoon}" Value="True">
                                                            <Setter Property="Text" Value="{Binding CompanyLinkDaysRemainingLabel}"/>
                                                            <Setter Property="Foreground" Value="#92400E"/>
                                                        </DataTrigger>
                                                        <!-- ⚠ texte + couleur si lien expiré -->
                                                        <DataTrigger Binding="{Binding IsCompanyLinkExpired}" Value="True">
                                                            <Setter Property="Text" Value="⚠ Lien expiré"/>
                                                            <Setter Property="Foreground" Value="#92400E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 3) Devis reçu -->
                        <DataGridTemplateColumn Width="SizeToCells"
                                                MinWidth="70"
                                                HeaderStyle="{StaticResource StatusHeaderNoVerticalSeparators}"
                                                CellStyle="{StaticResource StatusCellNoVerticalSeparators}"
                                                IsReadOnly="True">
                            <DataGridTemplateColumn.Header>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border x:Name="StatusHeaderBorder" Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource FilterHeaderHighlightBorderStyle}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                            <TextBlock Text="Statut" Style="{StaticResource StatusHeaderTopText}" HorizontalAlignment="Center"/>
                                            <Button x:Name="StatusFilterButton" Content="▾" Tag="Status"
                                                    Style="{StaticResource FilterHeaderButtonStyle}"
                                                    Click="ColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsQuoteReceived}" Value="True">
                                                        <Setter Property="Background" Value="#C7F9C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSentToSigner}" Value="True">
                                                        <Setter Property="Background" Value="#C7F9C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsValidated}" Value="True">
                                                        <Setter Property="Background" Value="#C7F9C7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusCellTextBaseStyle}">
                                                    <Setter Property="Text" Value="Devis reçu"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsQuoteReceived}" Value="True">
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSentToSigner}" Value="True">
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsValidated}" Value="True">
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 4) Demande validation envoyée -->
                        <DataGridTemplateColumn Width="SizeToCells"
                                                HeaderStyle="{StaticResource StatusHeaderNoVerticalSeparators}"
                                                CellStyle="{StaticResource StatusCellNoVerticalSeparators}"
                                                IsReadOnly="True">
                            <DataGridTemplateColumn.Header>
                                <Grid/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSentToSigner}" Value="True">
                                                        <Setter Property="Background" Value="#C7F9C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsValidated}" Value="True">
                                                        <Setter Property="Background" Value="#C7F9C7"/>
                                                    </DataTrigger>
                                                    <!-- Lien expire bientôt : jaune -->
                                                    <DataTrigger Binding="{Binding IsSignerLinkExpiringSoon}" Value="True">
                                                        <Setter Property="Background" Value="#FEF9C3"/>
                                                        <Setter Property="ToolTip" Value="Lien signataire expire bientôt — Relancer si nécessaire"/>
                                                    </DataTrigger>
                                                    <!-- ⚠ Lien signataire expiré : orange (prioritaire car placé après jaune) -->
                                                    <DataTrigger Binding="{Binding IsSignerLinkExpired}" Value="True">
                                                        <Setter Property="Background" Value="#FED7AA"/>
                                                        <Setter Property="ToolTip" Value="Lien signataire expiré (> 9 jours) — Regénérer dans la fiche"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusCellTextBaseStyle}">
                                                    <Setter Property="Text" Value="Demande validation envoyée"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSentToSigner}" Value="True">
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsValidated}" Value="True">
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </DataTrigger>
                                                        <!-- J-X si expire bientôt -->
                                                        <DataTrigger Binding="{Binding IsSignerLinkExpiringSoon}" Value="True">
                                                            <Setter Property="Text" Value="{Binding SignerLinkDaysRemainingLabel}"/>
                                                            <Setter Property="Foreground" Value="#92400E"/>
                                                        </DataTrigger>
                                                        <!-- ⚠ texte + couleur si lien expiré -->
                                                        <DataTrigger Binding="{Binding IsSignerLinkExpired}" Value="True">
                                                            <Setter Property="Text" Value="⚠ Lien expiré"/>
                                                            <Setter Property="Foreground" Value="#92400E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 5) Validé -->
                        <DataGridTemplateColumn Width="SizeToCells"
                                                HeaderStyle="{StaticResource StatusHeaderWithRightSeparator}"
                                                CellStyle="{StaticResource StatusCellWithRightSeparator}"
                                                IsReadOnly="True">
                            <DataGridTemplateColumn.Header>
                                <Grid/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ValidationDecision}" Value="Validé">
                                                        <Setter Property="Background" Value="#C7F9C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ValidationDecision}" Value="Annulé">
                                                        <Setter Property="Background" Value="#FFEDD5"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ValidationDecision}" Value="Refusé">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusCellTextBaseStyle}">
                                                    <Setter Property="Text" Value="{Binding ValidationDecision}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ValidationDecision}" Value="Validé">
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ValidationDecision}" Value="Annulé">
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ValidationDecision}" Value="Refusé">
                                                            <Setter Property="Foreground" Value="#111827"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Distribué le -->
                        <DataGridTemplateColumn Width="95" IsReadOnly="False">
                            <DataGridTemplateColumn.Header>
                                <Border x:Name="DistributedDateHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock Text="Distribué le" HorizontalAlignment="Center"/>
                                        <Button x:Name="DistributedDateFilterButton" Content="▾" Tag="DistributedDate"
                                                Style="{StaticResource FilterHeaderButtonStyle}"
                                                Click="ColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DateCellBorderStyle_Distributed}">
                                        <DatePicker Style="{StaticResource GridDatePickerStyle}"
                                                    SelectedDate="{Binding DistributedAt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    SelectedDateChanged="DistributedDate_SelectedDateChanged">
                                            <DatePicker.Resources>
                                                <Style TargetType="{x:Type DatePickerTextBox}"
                                                       BasedOn="{StaticResource NoWatermarkDatePickerTextBoxStyle}"/>
                                            </DatePicker.Resources>
                                        </DatePicker>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Effectué le -->
                        <DataGridTemplateColumn Width="95" IsReadOnly="False">
                            <DataGridTemplateColumn.Header>
                                <Border x:Name="PerformedDateHeaderBorder" Style="{StaticResource FilterHeaderHighlightBorderStyle}">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock Text="Effectué le" HorizontalAlignment="Center"/>
                                        <Button x:Name="PerformedDateFilterButton" Content="▾" Tag="PerformedDate"
                                                Style="{StaticResource FilterHeaderButtonStyle}"
                                                Click="ColumnFilterButton_Click" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DateCellBorderStyle_Performed}">
                                        <DatePicker Style="{StaticResource GridDatePickerStyle}"
                                                    SelectedDate="{Binding PerformedAt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    SelectedDateChanged="PerformedDate_SelectedDateChanged">
                                            <DatePicker.Resources>
                                                <Style TargetType="{x:Type DatePickerTextBox}"
                                                       BasedOn="{StaticResource NoWatermarkDatePickerTextBoxStyle}"/>
                                            </DatePicker.Resources>
                                        </DatePicker>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="Actions" Width="64" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button ToolTip="Archiver"
                                                Style="{StaticResource SmallButtonStyle}"
                                                Click="ArchiveWorkOrder_Click"
                                                Margin="0,0,1,0">
                                            <Path Data="{StaticResource IconArchiveGeometry}"
                                                  Width="12" Height="12" Stretch="Uniform"
                                                  Fill="Transparent" StrokeThickness="1.3" StrokeLineJoin="Round"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                        <Button ToolTip="Déplacer dans la corbeille"
                                                Style="{StaticResource DangerSmallButtonStyle}"
                                                Click="TrashWorkOrder_Click">
                                            <Path Data="{StaticResource IconTrashGeometry}"
                                                  Width="12" Height="12" Stretch="Uniform"
                                                  Fill="Transparent" StrokeThickness="1.3" StrokeLineJoin="Round"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- ✅ Archives (même zone que WorkOrdersGrid) -->
                <DataGrid x:Name="ArchivedGrid"
                          Visibility="Collapsed"
                          Style="{StaticResource GridStyle}"
                          ColumnWidth="SizeToCells"
                          MouseDoubleClick="ArchivedGrid_MouseDoubleClick"/>

                <!-- ✅ Corbeille (même zone que WorkOrdersGrid) -->
                <DataGrid x:Name="TrashedGrid"
                          Visibility="Collapsed"
                          Style="{StaticResource GridStyle}"
                          ColumnWidth="SizeToCells"
                          MouseDoubleClick="TrashedGrid_MouseDoubleClick"/>

                <!-- ✅ Retour en haut de la liste (25.07.2026, demande de Joe) -->
                <Button x:Name="ScrollToTopButton"
                        Click="ScrollToTopButton_Click"
                        Width="36" Height="36"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,14,14"
                        Panel.ZIndex="99"
                        Cursor="Hand"
                        ToolTip="Revenir en haut">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#992563EB"
                                    CornerRadius="18">
                                <Path Data="M 9 21 L 18 12 L 27 21"
                                      Stretch="None"
                                      Stroke="White"
                                      StrokeThickness="3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Opacity>0.8</Button.Opacity>
                </Button>

            </Grid>
        </Border>

    </Grid>
</UserControl>