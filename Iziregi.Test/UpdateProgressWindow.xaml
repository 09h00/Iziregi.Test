<!-- File: UpdateProgressWindow.xaml -->
<!-- ✅ Fenêtre affichée pendant le téléchargement de la mise à jour : avant cet ajout,
     l'application ne montrait rien pendant les 10-15 secondes de téléchargement, ce qui
     pouvait faire croire à l'utilisateur qu'elle était figée. -->
<Window x:Class="Iziregi.Test.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mise à jour Iziregi"
        Width="460"
        Height="180"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Topmost="True">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Mise à jour d'Iziregi"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#111827"/>

        <ProgressBar x:Name="ProgressBar"
                     Grid.Row="2"
                     Height="18"
                     Minimum="0"
                     Maximum="100"
                     Value="0"/>

        <TextBlock x:Name="StatusText"
                   Grid.Row="4"
                   Text="Téléchargement de la mise à jour..."
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="#374151"/>
    </Grid>
</Window>
