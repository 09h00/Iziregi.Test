<!-- File: DirectorPasswordWindow.xaml -->
<!-- ✅ NOUVEAU (18.08.2026, demande de Joe) : extrait de la page Paramètres > Admin (section
     "Mot de passe Directeur") en fenêtre séparée, renommé "Mot de passe général des dossiers"
     à l'écran (demande de Joe), le mécanisme sous-jacent (Db.SetDirectorPassword) ne change pas. -->
<Window x:Class="Iziregi.Test.DirectorPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mot de passe général des dossiers"
        Width="528"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Arial"
        Background="{StaticResource PageBackgroundBrush}">

    <Window.Resources>
        <!-- ✅ Modèle propre, pas BasedOn PrimaryButtonStyle (18.08.2026, correction demandée
             par Joe, "le bouton Fermer est toujours le même au survol") : PrimaryButtonStyle
             force un survol bleu directement sur la bordure via son propre ControlTemplate.Trigger,
             qui écrasait toute tentative de le changer depuis un style dérivé. -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ Bordure noire au survol (demande de Joe, 18.08.2026, valable pour tous les
             boutons "Fermer" de l'app). -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Mot de passe général des dossiers"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Foreground="#111827"
                   Margin="0,0,0,4"
                   TextWrapping="Wrap"/>

        <TextBlock Grid.Row="1"
                   Text="Déverrouille n'importe quel dossier verrouillé, quel que soit son propre mot de passe. Peut être transmis à un remplaçant sans lui donner accès à la page Admin."
                   FontSize="13"
                   Foreground="#6B7280"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14"/>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Text="" FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <!-- ✅ Formulaire de changement de mot de passe intégré (18.08.2026, demande de Joe :
             "on peut tout mettre dans la même fenêtre") : plus de fenêtres séparées
             (PasswordPromptWindow / NewPasswordWindow), tout se passe ici. "Mot de passe
             actuel" n'est affiché que si un mot de passe est déjà défini (rien à confirmer
             sinon), voir PopulateStatus. -->
        <StackPanel x:Name="CurrentPasswordSection" Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Mot de passe actuel" FontSize="13" Foreground="#6B7280" Margin="0,0,0,4"/>
            <PasswordBox x:Name="CurrentPasswordBox"
                         Height="34"
                         Padding="8,4"
                         BorderBrush="#D1D5DB"
                         BorderThickness="1"
                         Background="White"
                         VerticalContentAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="Nouveau mot de passe" FontSize="13" Foreground="#6B7280" Margin="0,0,0,4"/>
        <PasswordBox x:Name="NewPasswordBox"
                     Grid.Row="5"
                     Height="34"
                     Padding="8,4"
                     BorderBrush="#D1D5DB"
                     BorderThickness="1"
                     Background="White"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,10"/>

        <StackPanel Grid.Row="6" Margin="0,0,0,4">
            <TextBlock Text="Confirmer le nouveau mot de passe" FontSize="13" Foreground="#6B7280" Margin="0,0,0,4"/>
            <PasswordBox x:Name="ConfirmPasswordBox"
                         Height="34"
                         Padding="8,4"
                         BorderBrush="#D1D5DB"
                         BorderThickness="1"
                         Background="White"
                         VerticalContentAlignment="Center"/>
        </StackPanel>

        <TextBlock x:Name="ErrorTextBlock" Grid.Row="7" Text="" FontSize="12" Foreground="#B91C1C" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0"/>

        <!-- ✅ "Mot de passe oublié ?" à côté de "Changer le mot de passe" (18.08.2026, demande
             de Joe), au lieu d'être sur sa propre ligne. -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,10,0,14">
            <Button x:Name="ChangeButton" Content="Changer le mot de passe" Style="{StaticResource PrimaryButtonStyle}" FontWeight="Normal" Margin="0,0,8,0" Click="ChangeButton_Click"/>
            <Button Content="Mot de passe oublié ?" Style="{StaticResource SecondaryButtonStyle}" Click="ForgotPassword_Click"/>
        </StackPanel>

        <Border Grid.Row="9" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,0,0,14"/>

        <!-- ✅ Verrouillage dossiers, activable/désactivable par le directeur (18.08.2026,
             demande de Joe : remplace l'ancien bouton "Retirer la protection", qui supprimait
             le mot de passe général des dossiers lui-même. Ici, on désactive juste
             l'application des mots de passe de dossiers, sans rien effacer). Statut coloré
             (vert = activé, orange = désactivé) et bouton sous le statut, pas à côté. -->
        <StackPanel Grid.Row="10">
            <TextBlock Text="Le directeur décide si l'ouverture des dossiers exige un mot de passe. Désactiver ne supprime aucun mot de passe de dossier : les réactiver les remet en application tels quels."
                       FontSize="13"
                       Foreground="#6B7280"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <!-- ✅ Symbole de cadenas dessiné en vectoriel (18.08.2026, demande de Joe : "un
                 autre style de symbole" à la place de l'emoji couleur 🔒/🔓, "plus gros" et
                 "après le statut") : silhouette (corps plein + anse en trait), même logique
                 que les icônes vectorielles déjà utilisées ailleurs dans l'app (voir
                 IconEditGeometry etc. dans App.xaml) plutôt qu'un emoji clip-art. Couleur
                 pilotée depuis PopulateLockStatus (vert = activé, orange = désactivé). -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock x:Name="LockStatusTextBlock" Text="" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Grid x:Name="LockClosedIcon" Width="26" Height="26" Margin="8,0,0,0" VerticalAlignment="Center">
                    <Path x:Name="LockClosedBody" Data="M5,11 L19,11 L19,21 L5,21 Z"/>
                    <Path x:Name="LockClosedShackle" Data="M6,11 L6,7 L8,5 L16,5 L18,7 L18,11" StrokeThickness="2.2" StrokeLineJoin="Round" Fill="Transparent"/>
                </Grid>
                <!-- ✅ Anse raccourcie (18.08.2026, demande de Joe : "il n'est pas très beau,
                     mets en un avec la tige ouverte moins longue") : seul le côté gauche reste
                     ancré au corps, l'anse s'arrête juste au-dessus de l'encoche droite (petit
                     écart visible) au lieu de partir loin sur le côté. -->
                <Grid x:Name="LockOpenIcon" Width="26" Height="26" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <Path x:Name="LockOpenBody" Data="M5,11 L19,11 L19,21 L5,21 Z"/>
                    <Path x:Name="LockOpenShackle" Data="M6,11 L6,7 L8,5 L13,4 L17,5 L19,7" StrokeThickness="2.2" StrokeLineJoin="Round" Fill="Transparent"/>
                </Grid>
            </StackPanel>
            <Button x:Name="ToggleLockButton" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="ToggleLockButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Fermer" Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
